#!/usr/bin/env bun
import { createHash, randomUUID } from "node:crypto";
import { existsSync, mkdtempSync, readFileSync, realpathSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join, resolve } from "node:path";
import { parseArgs } from "node:util";
import { pathToFileURL } from "node:url";
import {
  buildContextEntries, convertToLlm, DEFAULT_COMPACTION_SETTINGS,
  parseSessionEntries, serializeConversation, sessionEntryToContextMessages,
} from "@earendil-works/pi-coding-agent";
import lockedSdkPackage from "../node_modules/@earendil-works/pi-coding-agent/package.json";
// Historical flattened-input replay condition; production compaction always uses its parent.
export const COMPACTION_MODEL = { provider: "openai", id: "gpt-6-luna" } as const;
import { checkpointText, COMPACTION_INSTRUCTIONS, requireCheckpointHeader } from "../config/pi-agent/pi-extensions/checkpoint-capture.ts";

// The default is the locked historical-input condition. Generation supplies the
// selected installed SDK's public conversion/serialization exports instead.
export function replayInput(text, entryId, serialization = { convertToLlm, serializeConversation }) {
  // Parse without SessionManager.open, which can migrate and rewrite the source.
  const entries = parseSessionEntries(text).filter(entry => entry.type !== "session");
  const original = entryId
    ? entries.find(entry => entry.id === entryId)
    : buildContextEntries(entries).find(entry => entry.type === "compaction");
  if (original?.type !== "compaction") throw new Error(entryId ? `No compaction entry ${entryId}` : "No compaction on the active branch");
  const context = buildContextEntries(entries, original.parentId);
  const cut = context.findIndex(entry => entry.id === original.firstKeptEntryId);
  if (cut < 0) throw new Error(`Recorded boundary ${original.firstKeptEntryId} is missing from the compaction's parent context`);
  const previous = context[0]?.type === "compaction" ? context[0] : undefined;
  const messages = context.slice(previous ? 1 : 0, cut).flatMap(sessionEntryToContextMessages);
  const conversation = serialization.serializeConversation(serialization.convertToLlm(messages));
  const prompt = [
    previous ? `<previous-checkpoint>\n${checkpointText(previous)}\n</previous-checkpoint>` : "",
    `<conversation>\n${conversation}\n</conversation>`,
  ].filter(Boolean).join("\n\n");
  return { original, prompt };
}

export function listCuts(text) {
  return parseSessionEntries(text).filter(entry => entry.type === "compaction").map(entry => {
    const cut = { id: entry.id, timestamp: entry.timestamp, parentId: entry.parentId, firstKeptEntryId: entry.firstKeptEntryId };
    try {
      const { prompt } = replayInput(text, entry.id);
      return { ...cut, characters: prompt.length, previous: prompt.startsWith("<previous-checkpoint>"), serialization: { implementation: "locked-sdk", version: lockedSdkPackage.version } };
    } catch (error) {
      // A damaged boundary must not hide a recorded cut or prevent listing others.
      return { ...cut, error: error.message };
    }
  });
}

// Keep historical branch/cut reconstruction on the locked SDK, but use the
// installed Pi's public serialization and model runtime. This historical replay
// does not reproduce production parent-prefix compaction. The locked SDK's auth backend
// can differ from the installed CLI's backend (for example plaintext vs keychain).
export async function createReplayRegistry(env = process.env) {
  const candidates = env.PI_PACKAGE_DIR ? [env.PI_PACKAGE_DIR] : [
    join(env.HOME ?? "", ".local/share/pi/node/node_modules/@earendil-works/pi-coding-agent"),
    "/opt/agent-pi/src/packages/coding-agent",
  ];
  const installed = candidates.find(path => existsSync(join(path, "package.json")));
  if (!installed) throw new Error("Installed Pi SDK not found; set PI_PACKAGE_DIR to the normal Pi package directory");
  const directory = realpathSync(installed);
  const manifest = JSON.parse(readFileSync(join(directory, "package.json"), "utf8"));
  const entry = manifest.exports?.["."]?.import;
  if (manifest.name !== "@earendil-works/pi-coding-agent" || typeof entry !== "string")
    throw new Error(`Installed Pi package has no public SDK entry: ${directory}`);
  const entrypoint = join(directory, entry);
  const { ModelRuntime, ModelRegistry, convertToLlm, serializeConversation } = await import(pathToFileURL(entrypoint).href);
  if (typeof ModelRuntime?.create !== "function" || typeof ModelRegistry !== "function" ||
      typeof convertToLlm !== "function" || typeof serializeConversation !== "function")
    throw new Error(`Installed Pi SDK lacks ModelRuntime/ModelRegistry/convertToLlm/serializeConversation: ${entrypoint}`);
  // No authPath or credentials override: the installed runtime owns its normal
  // default backend, including environment configuration and native keychain.
  const runtime = await ModelRuntime.create({ allowModelNetwork: false });
  const registry = new ModelRegistry(runtime);
  registry.replayRuntime = { directory, entrypoint, version: manifest.version, credentials: "installed-pi-default" };
  registry.replaySerialization = { convertToLlm, serializeConversation };
  return registry;
}

const sha256 = text => createHash("sha256").update(text).digest("hex");

// Library invocation shares the CLI path; only the model-registry boundary is injectable.
export async function main(args = process.argv.slice(2), createRegistry = createReplayRegistry) {
  const { positionals, values } = parseArgs({ args, options: {
    help: { type: "boolean", short: "h" },
    "list-cuts": { type: "boolean" },
    instructions: { type: "string" },
    provider: { type: "string" },
  }, allowPositionals: true });
  const usage = "Usage: dev/replay-compaction [--instructions FILE] [--provider ID] SESSION.jsonl [COMPACTION_ID]\n       dev/replay-compaction --list-cuts SESSION.jsonl\n\nReplays with the compaction model using normal Pi credentials.\nDefaults to the sole configured provider offering that model; --provider selects one explicitly.";
  if (values.help) { console.log(usage); return; }
  if (positionals.length < 1 || positionals.length > 2 || values.provider === "" || (values["list-cuts"] && (positionals.length !== 1 || values.instructions !== undefined || values.provider !== undefined))) throw new Error(usage);
  const [sessionPath, entryId] = positionals;
  const source = readFileSync(sessionPath, "utf8");
  if (values["list-cuts"]) {
    for (const cut of listCuts(source)) console.log(JSON.stringify(cut));
    return;
  }
  const { original, prompt: historicalPrompt } = replayInput(source, entryId);
  let prompt = historicalPrompt;
  const instructionsPath = values.instructions ?? COMPACTION_INSTRUCTIONS;
  const instructions = readFileSync(instructionsPath, "utf8");
  const output = mkdtempSync(join(tmpdir(), "compaction-replay-"));
  writeFileSync(join(output, "original.md"), checkpointText(original));
  writeFileSync(join(output, "input.txt"), prompt);
  writeFileSync(join(output, "instructions.md"), instructions);
  const metadata = {
    source: { path: resolve(sessionPath), sha256: sha256(source) },
    cut: { id: original.id, timestamp: original.timestamp, parentId: original.parentId, firstKeptEntryId: original.firstKeptEntryId },
    reconstruction: { implementation: "locked-sdk", version: lockedSdkPackage.version },
    input: { sha256: sha256(prompt), characters: prompt.length, serialization: { implementation: "locked-sdk", version: lockedSdkPackage.version } },
    instructions: { path: resolve(instructionsPath), sha256: sha256(instructions) },
    requestedModel: { id: COMPACTION_MODEL.id, provider: values.provider ?? null },
    model: null,
  };
  const saveMetadata = () => writeFileSync(join(output, "replay.json"), JSON.stringify(metadata, null, 2) + "\n");
  saveMetadata();
  try {
    const registry = await createRegistry();
    metadata.runtime = registry.replayRuntime ?? { credentials: "injected-test-registry" };
    if (registry.replaySerialization) {
      ({ prompt } = replayInput(source, original.id, registry.replaySerialization));
      metadata.input = { sha256: sha256(prompt), characters: prompt.length, serialization: {
        implementation: "installed-pi-public-sdk", version: registry.replayRuntime.version, entrypoint: registry.replayRuntime.entrypoint,
      } };
      writeFileSync(join(output, "input.txt"), prompt);
    }
    saveMetadata();
    // Availability and request-time auth belong to Pi's registry/runtime. A
    // provider pin from the extension is not evidence of configured credentials.
    const candidates = registry.getAvailable().filter(model => model.id === COMPACTION_MODEL.id &&
      (values.provider === undefined || model.provider === values.provider));
    if (!candidates.length) throw new Error(`${values.provider ? `${values.provider}/` : ""}${COMPACTION_MODEL.id} is unavailable with configured Pi credentials`);
    if (candidates.length > 1) throw new Error(`Multiple configured providers offer ${COMPACTION_MODEL.id}: ${candidates.map(model => model.provider).sort().join(", ")}; select --provider ID`);
    const model = candidates[0];
    metadata.model = { provider: model.provider, id: model.id };
    console.error(`Replaying ${sessionPath}, compaction ${original.id}; requesting ${model.provider}/${model.id}.`);
    const settings = {
      maxTokens: Math.min(Math.floor(0.8 * DEFAULT_COMPACTION_SETTINGS.reserveTokens), model.maxTokens || Infinity),
      cacheRetention: "none", reasoningEffort: "low", timeoutMs: 180000,
    };
    metadata.settings = settings;
    saveMetadata();
    const response = await registry.complete(model, {
      systemPrompt: instructions,
      messages: [{ role: "user", content: [{ type: "text", text: prompt }], timestamp: Date.now() }],
    }, {
      maxTokens: settings.maxTokens,
      signal: AbortSignal.timeout(settings.timeoutMs), cacheRetention: settings.cacheRetention,
      sessionId: randomUUID(), reasoningEffort: settings.reasoningEffort,
    });
    // Retain returned model output before acceptance checks so a rejected reply
    // remains inspectable. Do not persist runtime/auth/request internals.
    writeFileSync(join(output, "response.json"), JSON.stringify({
      content: response.content, usage: response.usage,
      stopReason: response.stopReason, errorMessage: response.errorMessage,
    }, null, 2) + "\n");
    if (["error", "length", "aborted"].includes(response.stopReason) || response.content.some(block => block.type === "toolCall")) {
      throw new Error(response.errorMessage || `Invalid summary: ${response.stopReason}`);
    }
    const summary = response.content.filter(block => block.type === "text").map(block => block.text).join("\n");
    requireCheckpointHeader(summary);
    writeFileSync(join(output, "new.md"), summary);
    writeFileSync(join(output, "usage.json"), JSON.stringify({ compaction: original.id, model: model.id, original: original.usage, replay: response.usage }, null, 2) + "\n");
    console.error(`Luna completed: ${response.usage.input} input tokens, ${response.usage.output} output tokens.`);
    console.log(`Saved comparison to ${output}\nCompare original.md and new.md manually.`);
    return output;
  } catch (error) {
    throw new Error(`${error.message}; replay inputs retained at ${output}`);
  }
}

if (import.meta.main) main().catch(error => { console.error(`Replay failed: ${error.message}`); process.exitCode = 1; });
