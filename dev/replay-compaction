#!/usr/bin/env bun
import { createHash, randomUUID } from "node:crypto";
import { mkdtempSync, readFileSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join, resolve } from "node:path";
import { parseArgs } from "node:util";
import {
  buildContextEntries, convertToLlm, DEFAULT_COMPACTION_SETTINGS, ModelRegistry,
  ModelRuntime, parseSessionEntries, serializeConversation, sessionEntryToContextMessages,
} from "@earendil-works/pi-coding-agent";
import codexSidecar from "../config/pi-agent/pi-extensions/codex-sidecar.ts";
import { checkpointText, COMPACTION_INSTRUCTIONS, COMPACTION_MODEL, requireCheckpointHeader } from "../config/pi-agent/pi-extensions/luna-compaction.ts";

export function replayInput(text, entryId) {
  // Parse without SessionManager.open, which can migrate and rewrite the source.
  const entries = parseSessionEntries(text).filter(entry => entry.type !== "session");
  const original = entryId
    ? entries.find(entry => entry.id === entryId)
    : buildContextEntries(entries).find(entry => entry.type === "compaction");
  if (original?.type !== "compaction") throw new Error(entryId ? `No compaction entry ${entryId}` : "No compaction on the active branch");
  const context = buildContextEntries(entries, original.parentId);
  const cut = context.findIndex(entry => entry.id === original.firstKeptEntryId);
  if (cut < 0) throw new Error(`Recorded boundary ${original.firstKeptEntryId} is missing from the compaction's parent context`);
  const previous = context[0]?.type === "compaction" ? context[0] : undefined;
  const messages = context.slice(previous ? 1 : 0, cut).flatMap(sessionEntryToContextMessages);
  const conversation = serializeConversation(convertToLlm(messages));
  const prompt = [
    previous ? `<previous-checkpoint>\n${checkpointText(previous)}\n</previous-checkpoint>` : "",
    `<conversation>\n${conversation}\n</conversation>`,
  ].filter(Boolean).join("\n\n");
  return { original, prompt };
}

export function listCuts(text) {
  return parseSessionEntries(text).filter(entry => entry.type === "compaction").map(entry => {
    const cut = { id: entry.id, timestamp: entry.timestamp, parentId: entry.parentId, firstKeptEntryId: entry.firstKeptEntryId };
    try {
      const { prompt } = replayInput(text, entry.id);
      return { ...cut, characters: prompt.length, previous: prompt.startsWith("<previous-checkpoint>") };
    } catch (error) {
      // A damaged boundary must not hide a recorded cut or prevent listing others.
      return { ...cut, error: error.message };
    }
  });
}

async function createReplayRegistry() {
  const runtime = await ModelRuntime.create({ allowModelNetwork: false });
  const registry = new ModelRegistry(runtime);
  // Use Pi's broker registration rather than discover credentials separately.
  codexSidecar({ registerProvider: registry.registerProvider.bind(registry) });
  return registry;
}

const sha256 = text => createHash("sha256").update(text).digest("hex");

// Library invocation shares the CLI path; only the model-registry boundary is injectable.
export async function main(args = process.argv.slice(2), createRegistry = createReplayRegistry) {
  const { positionals, values } = parseArgs({ args, options: {
    help: { type: "boolean", short: "h" },
    "list-cuts": { type: "boolean" },
    instructions: { type: "string" },
  }, allowPositionals: true });
  const usage = "Usage: dev/replay-compaction [--instructions FILE] SESSION.jsonl [COMPACTION_ID]\n       dev/replay-compaction --list-cuts SESSION.jsonl";
  if (values.help) { console.log(usage); return; }
  if (positionals.length < 1 || positionals.length > 2 || (values["list-cuts"] && (positionals.length !== 1 || values.instructions !== undefined))) throw new Error(usage);
  const [sessionPath, entryId] = positionals;
  const source = readFileSync(sessionPath, "utf8");
  if (values["list-cuts"]) {
    for (const cut of listCuts(source)) console.log(JSON.stringify(cut));
    return;
  }
  const { original, prompt } = replayInput(source, entryId);
  const instructionsPath = values.instructions ?? COMPACTION_INSTRUCTIONS;
  const instructions = readFileSync(instructionsPath, "utf8");
  const output = mkdtempSync(join(tmpdir(), "compaction-replay-"));
  writeFileSync(join(output, "original.md"), checkpointText(original));
  writeFileSync(join(output, "input.txt"), prompt);
  writeFileSync(join(output, "instructions.md"), instructions);
  const metadata = {
    source: { path: resolve(sessionPath), sha256: sha256(source) },
    cut: { id: original.id, timestamp: original.timestamp, parentId: original.parentId, firstKeptEntryId: original.firstKeptEntryId },
    input: { sha256: sha256(prompt), characters: prompt.length },
    instructions: { path: resolve(instructionsPath), sha256: sha256(instructions) },
    model: COMPACTION_MODEL,
  };
  const saveMetadata = () => writeFileSync(join(output, "replay.json"), JSON.stringify(metadata, null, 2) + "\n");
  saveMetadata();
  console.error(`Replaying ${sessionPath}, compaction ${original.id}; requesting ${COMPACTION_MODEL.id}.`);
  try {
    const registry = await createRegistry();
    const model = registry.find(COMPACTION_MODEL.provider, COMPACTION_MODEL.id);
    if (!model) throw new Error(`${COMPACTION_MODEL.id} is unavailable`);
    const settings = {
      maxTokens: Math.min(Math.floor(0.8 * DEFAULT_COMPACTION_SETTINGS.reserveTokens), model.maxTokens || Infinity),
      cacheRetention: "none", reasoningEffort: "low", timeoutMs: 180000,
    };
    metadata.settings = settings;
    saveMetadata();
    const response = await registry.complete(model, {
      systemPrompt: instructions,
      messages: [{ role: "user", content: [{ type: "text", text: prompt }], timestamp: Date.now() }],
    }, {
      maxTokens: settings.maxTokens,
      signal: AbortSignal.timeout(settings.timeoutMs), cacheRetention: settings.cacheRetention,
      sessionId: randomUUID(), reasoningEffort: settings.reasoningEffort,
    });
    if (["error", "length", "aborted"].includes(response.stopReason) || response.content.some(block => block.type === "toolCall")) {
      throw new Error(response.errorMessage || `Invalid summary: ${response.stopReason}`);
    }
    const summary = response.content.filter(block => block.type === "text").map(block => block.text).join("\n");
    requireCheckpointHeader(summary);
    writeFileSync(join(output, "new.md"), summary);
    writeFileSync(join(output, "usage.json"), JSON.stringify({ compaction: original.id, model: model.id, original: original.usage, replay: response.usage }, null, 2) + "\n");
    console.error(`Luna completed: ${response.usage.input} input tokens, ${response.usage.output} output tokens.`);
    console.log(`Saved comparison to ${output}\nCompare original.md and new.md manually.`);
    return output;
  } catch (error) {
    throw new Error(`${error.message}; replay inputs retained at ${output}`);
  }
}

if (import.meta.main) main().catch(error => { console.error(`Replay failed: ${error.message}`); process.exitCode = 1; });
