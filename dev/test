#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
if [ "${1:-}" = --test-environment-ready ]; then
	shift
else
	# Capture host installation metadata before test-environment replaces HOME.
	DOTFILES_TEST_PI_REVISION=
	for argument do
		if [ "$argument" = --containers ]; then
			DOTFILES_TEST_PI_REVISION=$(python3 "$root/tools/codex-sandbox/owned_images.py")
			break
		fi
	done
	export DOTFILES_TEST_PI_REVISION
	exec "$root/dev/test-environment" "$0" --test-environment-ready "$@"
fi
pi_revision=${DOTFILES_TEST_PI_REVISION:-}
unset DOTFILES_TEST_PI_REVISION

jobs=${TEST_JOBS:-8}
run_containers=0
run_lima=0
verbose=0

usage() {
	echo "usage: $0 [--containers] [--lima] [--jobs count] [--verbose]" >&2
}

while [ $# -gt 0 ]; do
	case $1 in
		--containers) run_containers=1;;
		--lima) run_lima=1;;
		-v|--verbose) verbose=1;;
		--jobs)
			shift
			[ $# -gt 0 ] || { usage; exit 2; }
			jobs=$1
			;;
		-h|--help) usage; exit 0;;
		*) usage; exit 2;;
	esac
	shift
done

case $jobs in
	''|*[!0-9]*|0) echo "test job count must be a positive integer" >&2; exit 2;;
esac

if ! command -v bun >/dev/null 2>&1; then
	echo "Bun is required for Pi tests; install Bun and add it to PATH before running dev/test (see dev/README.md#testing-and-probes)" >&2
	exit 1
fi

results=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-tests.XXXXXX")
trap 'rm -rf "$results"' EXIT HUP INT TERM
export results
export verbose
export PYTHONUNBUFFERED=1
export PYTHONDONTWRITEBYTECODE=1

cd "$root"
started=$(date +%s)
pytest_args="-n $jobs --dist loadfile --quiet --no-header --instafail -p no:cacheprovider"
if [ "$verbose" = 1 ]; then
	pytest_args="-n $jobs --dist loadfile --verbose --instafail -p no:cacheprovider"
fi
# pytest-sugar renders compact progress; pytest-instafail streams tracebacks.
# shellcheck disable=SC2086
if command -v pytest >/dev/null 2>&1 \
	&& pytest --help 2>/dev/null | grep -q -- --instafail \
	&& pytest --help 2>/dev/null | grep -q -- --numprocesses \
	&& pytest --help 2>/dev/null | grep -q -- --force-sugar
then
	# shellcheck disable=SC2086
	pytest $pytest_args
elif command -v uv >/dev/null 2>&1; then
	pytest_requirement=$(grep '^pytest==' install/test.txt)
	xdist_requirement=$(grep '^pytest-xdist==' install/test.txt)
	sugar_requirement=$(grep '^pytest-sugar==' install/test.txt)
	instafail_requirement=$(grep '^pytest-instafail==' install/test.txt)
	# shellcheck disable=SC2086
	uvx --from "$pytest_requirement" \
		--with "$xdist_requirement" \
		--with "$sugar_requirement" \
		--with "$instafail_requirement" \
		pytest $pytest_args
else
	echo "pytest with xdist, sugar, and instafail is required; install uv to run the pinned requirements in install/test.txt" >&2
	exit 1
fi

bb_command=${DOTFILES_TEST_BB_REAL:-bb}
"$bb_command" tools/extract-chat/tests/extract_chat_test.clj
if [ -n "${DOTFILES_TEST_JJ_REAL:-}" ]; then
	JJ_REAL=$DOTFILES_TEST_JJ_REAL "$bb_command" -cp tools/agent-split/src tools/agent-split/tests/run.clj
else
	"$bb_command" -cp tools/agent-split/src tools/agent-split/tests/run.clj
fi
"$bb_command" -cp tools/package-plan/src tools/package-plan/tests/run.clj
node tools/extract-chat-share/tests/extract_chat_share_test.js
node tools/codex-archive-old/tests/codex_archive_old_test.js
node --test tools/codex-sandbox/tests/tool_worker_test.mjs
node --test tools/codex-sandbox/tests/guest_skill_context_test.mjs
node --test tests/pi/native_prompt_sections.mjs tests/pi/native_web_search.mjs tests/pi/native_subscription_usage.mjs tests/pi/native_validate_skill.mjs
bun test tests/pi
bun test tools/codex-sandbox/tests/guest_tools_test.ts
bun test tools/codex-sandbox/tests/session_handoff_test.ts
bun test tools/codex-sandbox/tests/session_side_test.ts
if [ -n "${DOTFILES_TEST_JJ_REAL:-}" ]; then
	export JJ_PROXY_TEST_JJ="$DOTFILES_TEST_JJ_REAL"
fi
if [ "$(uname -s)" = Linux ]; then
	cargo test --manifest-path tools/jj-proxy/Cargo.toml
else
	cargo test --manifest-path tools/jj-proxy/Cargo.toml --lib --bins
fi

shell_files=$(find setup track bin dev lib libexec tests tools \
	-name __pycache__ -prune -o -type f \
	-exec grep -Il '^#!/bin/sh$' {} + 2>/dev/null || true)
if [ -n "$shell_files" ]; then
	printf '%s\n' "$shell_files" |
		xargs -n1 -P "$jobs" sh -n
fi

python3 -m json.tool install.conf.json >/dev/null
python3 -m json.tool lib/mimetypes.json >/dev/null
python3 -m json.tool tools/moonlander/moonlander-layout.json >/dev/null
python3 tools/shell-data/main.py lib/abbr.txt
python3 tools/shell-boundaries/main.py
python3 -c 'import tomllib; tomllib.load(open("config/mise.toml", "rb")); tomllib.load(open("config/mise.lock", "rb"))'

failed=0
if [ "$run_containers" = 1 ]; then
	printf 'Running Zulip proxy container integration...\n'
	python3 tools/zulip-proxy/tests/container_integration.py
	printf 'Running package planner bootstrap integration...\n'
	python3 tools/package-plan/tests/container.py
	printf 'Running codex sandbox runtime integration...\n'
	python3 tools/codex-sandbox/tests/image_runtime_integration.py --expected-revision "$pi_revision"
	container_results=$results/containers
	mkdir "$container_results"
	export container_results
	printf 'Running 4 container suites in parallel...\n'
	printf '%s\n' alpine:latest archlinux:latest fedora:latest ubuntu:26.04 |
		xargs -n1 -P 4 sh -c '
			image=$1
			name=${image%%:*}
			log="$container_results/$name.log"
			if dev/setup/container-test "$image" > "$log" 2>&1; then
				printf "%s\n" "$image" > "$container_results/$name.pass"
				if [ "$verbose" = 1 ]; then printf "PASS container %s\n" "$image"; fi
			else
				printf "%s\n" "$image" > "$container_results/$name.fail"
			fi
		' sh
	for marker in "$container_results"/*.fail; do
		[ -e "$marker" ] || continue
		image=$(cat "$marker")
		printf '\nFAIL container %s\n' "$image" >&2
		cat "${marker%.fail}.log" >&2
		failed=1
	done
	if [ "$failed" = 1 ]; then
		exit 1
	fi
fi

if [ "$run_lima" = 1 ]; then
	printf 'Running disposable Lima host, network, and runtime integration...\n'
	python3 tools/codex-sandbox/tests/lima_host_integration.py
fi

elapsed=$(($(date +%s) - started))
if [ "$run_containers" = 1 ]; then
	printf 'All checks and 4 container suites passed in %ss.\n' "$elapsed"
else
	printf 'All checks passed in %ss.\n' "$elapsed"
fi
