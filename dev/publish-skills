#!/usr/bin/env python3

import json
import shutil
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
PACKAGE_FILES = ("package.json", "LICENSE", "skills")


def stage_package(destination: Path) -> None:
    for relative in PACKAGE_FILES:
        source = ROOT / relative
        target = destination / relative
        if source.is_dir():
            shutil.copytree(source, target)
        else:
            shutil.copy2(source, target)
    shutil.copy2(ROOT / "skills/README.md", destination / "README.md")
    subprocess.run(
        [ROOT / "dev/generate-plugin-manifests", "--root", destination],
        check=True,
    )


def check_package(package: Path) -> int:
    result = subprocess.run(
        ["npm", "pack", str(package), "--json", "--ignore-scripts", "--offline"],
        cwd=package,
        capture_output=True,
        text=True,
    )
    if result.returncode:
        print(f"Archive check failed: npm pack exited {result.returncode}.", file=sys.stderr)
        if result.stderr:
            print(result.stderr.rstrip(), file=sys.stderr)
        return result.returncode

    try:
        [packed] = json.loads(result.stdout)
        with tarfile.open(package / packed["filename"]) as archive:
            actual = {member.name for member in archive.getmembers() if member.isfile()}
        required = {
            f"package/{relative}"
            for relative in (
                "package.json", "LICENSE", "README.md",
                ".codex-plugin/plugin.json", ".claude-plugin/plugin.json",
                ".claude-plugin/marketplace.json",
            )
        }
        required.update(
            f"package/{path.relative_to(package).as_posix()}"
            for path in (package / "skills").rglob("*") if path.is_file()
        )
        missing = sorted(required - actual)
        if missing:
            print("Archive check failed: missing files: " + ", ".join(missing), file=sys.stderr)
            return 1
        print(f"Validated {packed['name']}@{packed['version']}: "
              f"{len(actual)} archive files; no publication.")
    except (ValueError, KeyError, TypeError, OSError, tarfile.TarError) as error:
        print(f"Archive check failed: {error}", file=sys.stderr)
        return 1
    return 0


def main(arguments: list[str]) -> int:
    check = "--check" in arguments
    if check and arguments != ["--check"]:
        print("--check does not accept npm publish arguments.", file=sys.stderr)
        return 2
    with tempfile.TemporaryDirectory(prefix="judgement-yields-navigation-") as temporary:
        package = Path(temporary)
        stage_package(package)
        if check:
            return check_package(package)
        return subprocess.run(["npm", "publish", str(package), *arguments]).returncode


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
