#!/usr/bin/env python3
"""Run Pi and Dashboard together with private, disposable configuration."""

from __future__ import annotations

import argparse
import importlib.util
import json
import os
from pathlib import Path
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.request


ROOT = Path(__file__).resolve().parent.parent
DEFAULT_STATE = ROOT / "target/dashboard-trial"


def unused_port() -> int:
    with socket.socket() as listener:
        listener.bind(("127.0.0.1", 0))
        return listener.getsockname()[1]


def wait_for_http(origin: str, server: subprocess.Popen, log: Path) -> None:
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        if server.poll() is not None:
            raise RuntimeError(f"Dashboard exited with status {server.returncode}; see {log}")
        try:
            with urllib.request.urlopen(origin, timeout=1) as response:
                if response.status == 200:
                    return
        except OSError:
            time.sleep(0.1)
    raise TimeoutError(f"Dashboard did not become ready; see {log}")


def load_setup():
    path = ROOT / "libexec/setup/setup_dashboard.py"
    spec = importlib.util.spec_from_file_location("dashboard_setup", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--workspace", type=Path, default=Path.cwd(), help="Pi working directory")
    parser.add_argument("--state", type=Path, default=DEFAULT_STATE, help="private trial state")
    parser.add_argument("--port", type=int, default=8001, help="Dashboard HTTP port (default: 8001)")
    parser.add_argument(
        "--pi-package",
        type=Path,
        default=Path.home() / "src/llms/pi/packages/coding-agent",
        help="built local Pi coding-agent package",
    )
    return parser.parse_args()


def main() -> int:
    options = arguments()
    workspace = options.workspace.resolve()
    state = options.state.resolve()
    pi_package = options.pi_package.resolve()
    if not workspace.is_dir():
        raise ValueError(f"Workspace does not exist: {workspace}")
    if not (pi_package / "dist/index.js").is_file():
        raise ValueError(f"Build local Pi first; dist/index.js is missing under {pi_package}")

    setup = load_setup()
    mise_env = os.environ | {"MISE_GLOBAL_CONFIG_FILE": str(ROOT / "config/mise.toml")}
    install = Path(subprocess.run(
        ["mise", "where", f"{setup.TOOL}@{setup.pin()}"],
        env=mise_env, text=True, capture_output=True, check=True,
    ).stdout.strip()).resolve()
    core = setup.installed_core(install)

    home = state / "home"
    agent = home / ".pi/agent"
    dashboard = home / ".pi/dashboard"
    for directory in (agent, dashboard):
        directory.mkdir(parents=True, exist_ok=True)
    settings_source = state / "settings.json"
    settings_source.write_text(json.dumps({
        "packages": [{"source": "./pi-dashboard", "skills": []}],
        "extensions": [str(ROOT / "config/pi-agent/pi-extensions/ask-user.ts")],
        "quietStartup": True,
        "enableInstallTelemetry": False,
    }, indent=2) + "\n")
    settings = agent / "settings.json"
    if settings.is_symlink() or settings.exists():
        settings.unlink()
    settings.symlink_to(settings_source)

    tailnet_host = setup.tailscale_address()
    setup.configure(core, install, home, bind_host=tailnet_host)
    if not 1 <= options.port <= 65535:
        raise ValueError("Dashboard port must be between 1 and 65535")
    http_port = options.port
    pi_port = unused_port()
    while pi_port == http_port:
        pi_port = unused_port()
    config_path = dashboard / "config.json"
    config = json.loads(config_path.read_text())
    config.update({
        "bindHost": tailnet_host, "port": http_port, "piPort": pi_port,
        "autoStart": False, "autoShutdown": False, "listenOnLoopback": True,
        "registerAskUserTool": False,
        "tunnel": {"enabled": False},
        "pairing": {"acceptLanRequests": True},
        "mdns": {"enabled": False},
    })
    config_path.write_text(json.dumps(config, indent=2) + "\n")
    config_path.chmod(0o600)

    original_agent = Path.home() / ".pi/agent"
    models_store = original_agent / "models-store.json"
    if models_store.is_file():
        shutil.copyfile(models_store, agent / "models-store.json")
        (agent / "models-store.json").chmod(0o600)
    env = os.environ | {
        "HOME": str(home), "USERPROFILE": str(home),
        "XDG_CONFIG_HOME": str(home / ".config"),
        "XDG_DATA_HOME": str(home / ".local/share"),
        "XDG_CACHE_HOME": str(home / ".cache"),
        "PI_CODING_AGENT_DIR": str(agent),
        "PI_PACKAGE_DIR": str(pi_package),
        "PI_DASHBOARD_HOST": "127.0.0.1",
        "PI_DASHBOARD_PORT": str(http_port),
        "PI_DASHBOARD_PI_PORT": str(pi_port),
        # OAuth refresh tokens rotate. Share Pi's single keychain-backed
        # credential authority instead of copying a token into trial state.
        "PI_DASHBOARD_TRIAL_AUTH_DIR": str(original_agent),
    }
    origin = f"http://127.0.0.1:{http_port}"
    tailnet_origin = f"http://{tailnet_host}:{http_port}"
    tailnet_pairing_url = f"{tailnet_origin}/pair?request"
    log_path = state / "dashboard.log"
    cli = install / "bin/pi-dashboard"
    server = None
    try:
        with log_path.open("wb") as log:
            server = subprocess.Popen(
                [str(cli), "--host", tailnet_host, "--port", str(http_port),
                 "--pi-port", str(pi_port), "--no-tunnel"],
                cwd=workspace, env=env, stdout=log, stderr=subprocess.STDOUT,
                start_new_session=True,
            )
        wait_for_http(origin, server, log_path)
        opened = subprocess.run(
            [str(cli), "open", "--print", "--url", origin],
            cwd=workspace, env=env, text=True, capture_output=True, check=True,
        )
        urls = [line for line in opened.stdout.splitlines() if line.startswith(origin)]
        if len(urls) != 1:
            raise RuntimeError(f"Dashboard did not return one browser URL; see {log_path}")
        print("open this private Dashboard URL in your browser:", file=sys.stderr)
        print(urls[0], file=sys.stderr)
        print("open this Tailnet URL on your phone and complete pairing:", file=sys.stderr)
        print(tailnet_pairing_url, file=sys.stderr)
        try:
            input("press Enter after the page opens to start Pi... ")
        except EOFError:
            return 0
        return subprocess.run(
            ["node", str(ROOT / "dev/dashboard-trial-tui.mjs"), str(workspace)],
            cwd=workspace, env=env,
        ).returncode
    finally:
        if server is not None and server.poll() is None:
            os.killpg(server.pid, signal.SIGTERM)
            try:
                server.wait(timeout=10)
            except subprocess.TimeoutExpired:
                os.killpg(server.pid, signal.SIGKILL)
                server.wait()


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
