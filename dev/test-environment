#!/usr/bin/env python3
"""Run tests and probes with private HOME and no inherited sandbox authority."""

from __future__ import annotations

import os
from pathlib import Path
import signal
import shutil
import subprocess
import sys
import tempfile


def mise_tool_path(tool: str, environment: dict[str, str]) -> str:
    command = shutil.which(tool, path=environment.get("PATH"))
    if command is None or Path(command).resolve().name != "mise":
        return ""
    # Shims consult HOME for trust and tool selection. Resolve them before
    # changing HOME rather than letting a setup failure look like no matches.
    result = subprocess.run(
        [str(Path(command).resolve()), "which", tool], env=environment,
        text=True, capture_output=True, check=False,
    )
    if result.returncode:
        raise OSError(f"cannot resolve {tool} before isolation: {result.stderr.strip()}")
    path = result.stdout.strip()
    if not Path(path).is_absolute() or not os.access(path, os.X_OK):
        raise OSError(f"mise returned an invalid executable for {tool}: {path!r}")
    return path


def main(arguments: list[str]) -> int:
    environment = dict(os.environ)
    real_tools = {
        tool.lower(): (
            environment.get(f"DOTFILES_TEST_{tool}_REAL") or environment.get(f"{tool}_REAL")
            or mise_tool_path(tool.lower(), environment)
        )
        for tool in ("BB", "JAVA", "JJ", "RG")
    }
    environment.update({f"DOTFILES_TEST_{tool.upper()}_REAL": real for tool, real in real_tools.items()})
    key = "DOTFILES_TEST_SANDBOX_PROXY_DIR"
    environment[key] = environment.get(key) or environment.get("SANDBOX_PROXY_DIR", "")

    # Keep installed SDK discovery independent of the disposable HOME.
    if not environment.get("PI_PACKAGE_DIR"):
        package = Path.home() / ".local/share/pi/node/node_modules/@earendil-works/pi-coding-agent"
        if (package / "package.json").is_file():
            environment["PI_PACKAGE_DIR"] = str(package)
        else:
            environment.pop("PI_PACKAGE_DIR", None)
    if environment.get("PI_PACKAGE_DIR"):
        # Node resolves dependencies relative to this entrypoint. Installation
        # symlinks can hide the source checkout's node_modules from createRequire.
        environment["PI_PACKAGE_DIR"] = str(Path(environment["PI_PACKAGE_DIR"]).resolve())

    if not environment.get("DOTFILES_TEST_NVIM_PLUGINS"):
        data = Path(environment.get("XDG_DATA_HOME") or Path.home() / ".local/share")
        plugins = data / "nvim/lazy"
        if (plugins / "lazy.nvim/lua/lazy/init.lua").is_file():
            environment["DOTFILES_TEST_NVIM_PLUGINS"] = str(plugins.resolve())
        else:
            environment.pop("DOTFILES_TEST_NVIM_PLUGINS", None)

    for key in (
        "BB_REAL", "BB_SOURCE_ROOT", "JAVA_REAL", "JJ_REAL", "RG_REAL",
        "CLAUDECODE", "CODEX_THREAD_ID", "JJ_AGENT", "JJ_CONFIG", "PI_CODING_AGENT",
        "CODEX_SIDECAR_KEY", "CODEX_SIDECAR_URL", "SANDBOX_PROXY_DIR",
        "PI_MODEL_FILE", "PI_MODEL_SESSION_ID", "PI_CALL_MODEL",
        "PI_CODING_AGENT_DIR", "PI_CODING_AGENT_SESSION_DIR",
        "XDG_CONFIG_DIRS", "XDG_DATA_DIRS",
    ):
        environment.pop(key, None)
    environment["SANDBOX_PROXY_DEFAULT_DIR"] = "/nonexistent"
    # Fish's own interactive startup checks this before spawning detached
    # completion generation. Those jobs otherwise outlive the test child and
    # race removal of the private HOME.
    environment["FISH_UNIT_TESTS_RUNNING"] = "1"
    if not arguments:
        return 0

    # Stable source paths let Cargo reuse both downloads and compiled dependencies.
    # Never reuse the user's Cargo home: this directory is disposable test state.
    cargo_home = Path(environment.get("DOTFILES_TEST_CARGO_HOME")
        or Path(__file__).resolve().parent.parent / "target/test-environment/cargo").resolve()
    try:
        cargo_home.mkdir(mode=0o700, parents=True, exist_ok=True)
        if not os.access(cargo_home, os.W_OK | os.X_OK):
            raise OSError("directory requires write and search access")
    except OSError as error:
        raise OSError(f"cannot prepare Cargo test home {cargo_home}: {error}") from error
    environment["DOTFILES_TEST_CARGO_HOME"] = str(cargo_home)
    environment["CARGO_HOME"] = str(cargo_home)

    with tempfile.TemporaryDirectory(prefix="dotfiles-test-home-") as directory:
        home = Path(directory)
        environment["HOME"] = directory
        # Override command names, not their installation directories: siblings
        # such as Docker must retain their original PATH selection.
        tool_directory = home / ".test-tools"
        tool_directory.mkdir(mode=0o700)
        for tool, real in real_tools.items():
            if "/" in real:
                (tool_directory / tool).symlink_to(os.path.abspath(real))
        environment["PATH"] = str(tool_directory) + os.pathsep + environment.get("PATH", os.defpath)
        # HotSpot reads _JAVA_OPTIONS after other option sources. Retain caller
        # options but make the private home win over inherited home properties.
        environment["_JAVA_OPTIONS"] = (
            environment.get("_JAVA_OPTIONS", "") + f' -Duser.home="{directory}"'
        ).strip()
        # Babashka is a native image, not a JVM. Its preload hook also reaches
        # absolute binary paths and shebangs without replacing real-tool metadata.
        preload = Path(__file__).with_suffix(".clj").read_text()
        inherited_preloads = environment.get("BABASHKA_PRELOADS", "")
        if not inherited_preloads.startswith(preload):
            environment["BABASHKA_PRELOADS"] = preload + "\n" + inherited_preloads
        for key, relative in {
            "XDG_CONFIG_HOME": ".config", "XDG_CACHE_HOME": ".cache",
            "XDG_DATA_HOME": ".local/share", "XDG_STATE_HOME": ".local/state",
            "XDG_RUNTIME_DIR": ".runtime", "PI_SUBAGENT_TEMP_DIR": "tmp/subagents",
        }.items():
            path = home / relative
            path.mkdir(mode=0o700, parents=True, exist_ok=True)
            environment[key] = str(path)

        process = None
        previous = {}

        def forward(signum, _frame):
            if process is not None:
                try:
                    process.send_signal(signum)
                except ProcessLookupError:
                    pass

        # Cleanup requires waiting for a child rather than exec. Python avoids
        # POSIX background jobs' ignored SIGINT and redirected stdin.
        for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
            previous[signum] = signal.signal(signum, forward)
        try:
            process = subprocess.Popen(arguments, env=environment)
            return process.wait()
        finally:
            for signum, handler in previous.items():
                signal.signal(signum, handler)


if __name__ == "__main__":
    try:
        status = main(sys.argv[1:])
    except OSError as error:
        print(f"test-environment: {error}", file=sys.stderr)
        raise SystemExit(1)
    if status < 0:
        # Preserve native signal status, after removing the private HOME.
        signum = -status
        if signum != signal.SIGKILL:
            signal.signal(signum, signal.SIG_DFL)
        os.kill(os.getpid(), signum)
    raise SystemExit(status)
