#!/bin/sh
set -eu

DOTFILES_TEST_BB_REAL=${DOTFILES_TEST_BB_REAL:-${BB_REAL:-}}
DOTFILES_TEST_JAVA_REAL=${DOTFILES_TEST_JAVA_REAL:-${JAVA_REAL:-}}
DOTFILES_TEST_JJ_REAL=${DOTFILES_TEST_JJ_REAL:-${JJ_REAL:-}}
DOTFILES_TEST_RG_REAL=${DOTFILES_TEST_RG_REAL:-${RG_REAL:-}}
DOTFILES_TEST_SANDBOX_PROXY_DIR=${DOTFILES_TEST_SANDBOX_PROXY_DIR:-${SANDBOX_PROXY_DIR:-}}
export DOTFILES_TEST_BB_REAL DOTFILES_TEST_JAVA_REAL DOTFILES_TEST_JJ_REAL DOTFILES_TEST_RG_REAL
export DOTFILES_TEST_SANDBOX_PROXY_DIR

# Prefer private binaries over sandbox wrappers. Tests can still prepend fakes,
# while explicitly invoked wrappers resolve these binaries after skipping self.
for real_tool in "$DOTFILES_TEST_BB_REAL" "$DOTFILES_TEST_JAVA_REAL" \
        "$DOTFILES_TEST_JJ_REAL" "$DOTFILES_TEST_RG_REAL"; do
	case $real_tool in
		*/*) PATH=${real_tool%/*}:$PATH ;;
	esac
done
export PATH

unset BB_REAL BB_SOURCE_ROOT JAVA_REAL JJ_REAL RG_REAL
unset CLAUDECODE CODEX_THREAD_ID JJ_AGENT PI_CODING_AGENT
unset CODEX_SIDECAR_KEY CODEX_SIDECAR_URL SANDBOX_PROXY_DIR
SANDBOX_PROXY_DEFAULT_DIR=/nonexistent
export SANDBOX_PROXY_DEFAULT_DIR

exec "$@"
