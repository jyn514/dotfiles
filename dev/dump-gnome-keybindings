#!/bin/sh
set -eu

dump() {
	# dconf only shows modified keys, although this appears to be undocumented
	dpath=$1
	dumped=$(dconf dump /"$dpath"/) || return
	sed '/EVOLUTION-CALDAV/d; s#^\[\([^]]*\)\]#['"$dpath"'/\1]#; s#/\+\]$#]#' <<EOF || return
$dumped
EOF
	echo
}

export_keybindings() {
	# Child definitions can be retained without being selected in this list.
	media_keys=org/gnome/settings-daemon/plugins/media-keys
	registry=$(dconf read /"$media_keys"/custom-keybindings) || return
	if [ -n "$registry" ]; then
		printf '[%s]\ncustom-keybindings=%s\n\n' "$media_keys" "$registry" || return
	fi

	# from dconf dump / | rg Super -B2 | rg '^\['
	dump "$media_keys"/custom-keybindings || return
	dump org/gnome/desktop/wm/keybindings || return
	dump org/gnome/shell/keybindings || return
	dump org/gnome/shell/extensions/pop-shell || return
	dump desktop/ibus/panel/emoji
}

# Publish only after every native read and transformation succeeds.
snapshot=$(export_keybindings) || exit "$?"
printf '%s\n' "$snapshot"
