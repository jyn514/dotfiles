#!/usr/bin/env python3
"""Generate agent plugin metadata from the npm package manifest."""

import argparse
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent


def repository_url(package: dict) -> str:
    repository = package["repository"]
    url = repository["url"] if isinstance(repository, dict) else repository
    if url.startswith("git+"):
        url = url[4:]
    if url.endswith(".git"):
        url = url[:-4]
    return url


def manifests(package: dict) -> dict[str, dict]:
    name = package["name"]
    version = package["version"]
    description = package["description"]
    author = package["author"]
    repository = repository_url(package)
    common = {
        "name": name,
        "version": version,
        "description": description,
        "author": author,
        "repository": repository,
        "license": package["license"],
        "keywords": package["keywords"],
    }
    return {
        ".codex-plugin/plugin.json": common
        | {
            "skills": "./skills/",
            "interface": {
                "displayName": "Judgement Yields Navigation",
                "shortDescription": "Software design and maintenance workflows",
                "longDescription": "Composable workflows for software architecture, implementation planning, review, testing, documentation, and investigation.",
                "developerName": author["name"],
                "category": "Developer Tools",
                "capabilities": ["Guidance"],
                "defaultPrompt": [
                    "Choose the smallest useful design workflow for this change.",
                    "Review this change against repository evidence.",
                    "Find the highest-leverage project improvement.",
                ],
            },
        },
        ".claude-plugin/plugin.json": common,
        ".claude-plugin/marketplace.json": {
            "name": "jyn-plugins",
            "description": "Judgement Yields Navigation: composable skills for software design, review, documentation, and investigation",
            "owner": author,
            "plugins": [
                {
                    "name": name,
                    "version": version,
                    "source": "./",
                    "description": description,
                    "author": author,
                    "repository": repository,
                    "license": package["license"],
                    "keywords": package["keywords"],
                    "category": "Developer Tools",
                }
            ],
        },
        ".agents/plugins/marketplace.json": {
            "name": "jyn-plugins",
            "interface": {"displayName": "Judgement Yields Navigation"},
            "plugins": [
                {
                    "name": name,
                    "source": {"source": "npm", "package": name, "version": version},
                    "policy": {"installation": "AVAILABLE", "authentication": "ON_INSTALL"},
                    "category": "Developer Tools",
                }
            ],
        },
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path, default=ROOT)
    parser.add_argument("--check", action="store_true")
    arguments = parser.parse_args()
    package = json.loads((arguments.root / "package.json").read_text(encoding="utf-8"))
    stale = []
    for relative, manifest in manifests(package).items():
        path = arguments.root / relative
        rendered = json.dumps(manifest, indent=2) + "\n"
        if arguments.check:
            if not path.is_file() or path.read_text(encoding="utf-8") != rendered:
                stale.append(relative)
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(rendered, encoding="utf-8")
    if stale:
        parser.error("stale generated manifests: " + ", ".join(stale))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
