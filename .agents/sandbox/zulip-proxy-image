#!/bin/sh
set -eu

DOTFILES="$(dirname -- "$(dirname -- "$(realpath -- "$0")")")/.."
cd "$DOTFILES"

sources=$(mktemp)
hashes=$(mktemp)
trap 'rm -f "$sources" "$hashes"' EXIT HUP INT TERM
find tools/zulip-proxy -type f -print | LC_ALL=C sort > "$sources"
git hash-object --stdin-paths < "$sources" > "$hashes"
cache_key=$(/usr/bin/paste -d ' ' "$sources" "$hashes" | git hash-object --stdin)
image="zulip-proxy:$cache_key"
if ! image_id=$(docker image inspect --format '{{.Id}}' "$image" 2>/dev/null); then
	printf 'Building Zulip proxy image %s ...\n' "$image" >&2
	docker build -f tools/zulip-proxy/Dockerfile --tag "$image" . >&2
	image_id=$(docker image inspect --format '{{.Id}}' "$image")
fi
printf 'sha256:%s\n' "${image_id#sha256:}"
