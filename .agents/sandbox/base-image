#!/bin/sh
set -eu

sandbox=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
dockerfile="$sandbox/Dockerfile"
cache_key=$(git hash-object "$dockerfile")
image="dotfiles-sandbox-base:$cache_key"

exec "$sandbox/../../tools/codex-sandbox/sandbox-image" build --if-missing \
	--file "$dockerfile" --tag "$image" "$sandbox"
