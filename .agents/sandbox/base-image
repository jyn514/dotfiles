#!/bin/sh
set -eu

sandbox=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
dockerfile="$sandbox/Dockerfile"
cache_key=$(git hash-object "$dockerfile")
image="dotfiles-sandbox-base:$cache_key"

if ! image_id=$(docker image inspect --format '{{.Id}}' "$image" 2>/dev/null); then
	printf 'Building local sandbox base image %s ...\n' "$image" >&2
	docker build --file "$dockerfile" --tag "$image" "$sandbox" >&2
	image_id=$(docker image inspect --format '{{.Id}}' "$image")
fi

printf 'sha256:%s\n' "${image_id#sha256:}"
