#!/trusted/bin/sh
set -eu

[ "$#" -eq 2 ] || exit 2
left=$1
right=$2
patch=/tmp/jj-config/agent-split.patch

rm -rf -- "$right"/* "$right"/.[!.]* "$right"/..?*
cp -a -- "$left"/. "$right"/
# Hand-edited hunk counts must match the wrapper's recounting preflight.
git -C "$right" apply --recount --check < "$patch"
git -C "$right" apply --recount < "$patch"
