#!/usr/bin/env python3
"""Forward Jujutsu arguments to the configured generic sandbox proxy."""

from __future__ import annotations

import json
import os
from pathlib import Path
import socket
import struct
import sys


MAX_REQUEST = 1 << 20
MAX_RESPONSE = 24 << 20


def receive_exact(connection: socket.socket, length: int) -> bytes:
    chunks = bytearray()
    while len(chunks) < length:
        chunk = connection.recv(length - len(chunks))
        if not chunk:
            raise RuntimeError("proxy response ended early")
        chunks.extend(chunk)
    return bytes(chunks)


def main() -> int:
    proxy_dir = os.environ.get("SANDBOX_PROXY_DIR")
    if not proxy_dir:
        raise RuntimeError("sandbox proxy directory is not configured")
    current = Path.cwd().resolve(strict=True)
    if current != Path("/src") and Path("/src") not in current.parents:
        raise RuntimeError("current directory is outside the protected source tree; run from the mounted workspace")
    # Cwd addresses the invocation, not its permission or selected repository.
    # Keep selectors/filesets unchanged; only the server's launch authority can
    # authorize mutation or demote an unlisted sibling to inspection.
    inspect = bool(os.environ.get("JJ_PROXY_INSPECT"))
    argv = sys.argv[1:]
    request = {"version": 2, "mode": "inspect" if inspect else "mutate", "cwd": str(current), "argv": argv}
    if argv[:1] == ["--agent-split"]:
        if len(argv) != 4:
            raise RuntimeError("--agent-split requires PATCH MESSAGE REVISION")
        patch = Path(argv[1]).resolve(strict=True)
        request["argv"] = []
        request["agent_split"] = {
            "patch": patch.read_text(encoding="utf-8"),
            "message": argv[2],
            "revision": argv[3],
        }
    request.update(
        user=os.environ.get("JJ_USER"),
        email=os.environ.get("JJ_EMAIL"),
    )
    body = json.dumps(
        request,
        ensure_ascii=False, separators=(",", ":"),
    ).encode()
    if len(body) > MAX_REQUEST:
        raise RuntimeError("proxy request is too large")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(125)
        connection.connect(str(Path(proxy_dir) / "jj" / "socket"))
        connection.sendall(struct.pack(">I", len(body)) + body)
        connection.shutdown(socket.SHUT_WR)
        length = struct.unpack(">I", receive_exact(connection, 4))[0]
        if length > MAX_RESPONSE:
            raise RuntimeError("proxy response is too large")
        response = json.loads(receive_exact(connection, length))
        if connection.recv(1):
            raise RuntimeError("proxy response has trailing bytes")
    if set(response) != {"version", "exit", "stdout", "stderr"} or response["version"] != 2:
        raise RuntimeError("unsupported or malformed proxy response")
    sys.stdout.write(response["stdout"])
    sys.stderr.write(response["stderr"])
    return int(response["exit"])


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as error:
        print(f"jj proxy: {error}", file=sys.stderr)
        raise SystemExit(125)
