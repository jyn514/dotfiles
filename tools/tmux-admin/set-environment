#!/usr/bin/env python3
"""Synchronize the login environment variables owned by tmux configuration."""

from __future__ import annotations

import os
import subprocess
import sys


VARIABLES = ("EDITOR", "VISUAL", "PATH", "CARGO_HOME", "RUSTUP_HOME")


def exit_status(returncode: int) -> int:
    return returncode if returncode >= 0 else 128 - returncode


def main(arguments: list[str]) -> int:
    if len(arguments) != 1 or not os.path.isabs(arguments[0]):
        print("usage: set-environment /absolute/path/to/tmux", file=sys.stderr)
        return 2

    tmux = arguments[0]
    for name in VARIABLES:
        if name in os.environ:
            command = [tmux, "set-environment", name, os.environ[name]]
        else:
            command = [tmux, "set-environment", "-u", name]
        result = subprocess.run(command, check=False)
        if result.returncode:
            return exit_status(result.returncode)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
