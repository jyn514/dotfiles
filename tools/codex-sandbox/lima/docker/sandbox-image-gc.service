[Unit]
Description=Remove unused sandbox images created more than seven days ago
Requisite=docker.service
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
Restart=no
KillMode=control-group
TimeoutStartSec=30min
# Client state stays on tmpfs so a full guest disk cannot prevent cleanup.
ExecStart=/usr/bin/docker --config %t/sandbox-image-gc --host unix://%t/docker.sock image prune --all --force --filter until=168h
