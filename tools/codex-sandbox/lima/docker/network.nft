# bridge-nf-call-iptables/ip6tables must both remain zero in this namespace.
# nftables.py substitutes validated addresses from network-policy.json.
destroy table inet codex_sandbox
destroy table bridge codex_sandbox
table inet codex_sandbox {
    set prohibited {
        type ipv4_addr
        flags interval
        elements = { @PROHIBITED@ }
    }
    chain input {
        type filter hook input priority -10; policy accept;
        # Published-port proxies initiate connections from this namespace.
        # Permit their IPv4 replies, not container-initiated host connections.
        iifname { "cs-public", "csp*", "csl*" } meta nfproto ipv4 ct state established ct direction reply counter accept
        iifname { "cs-public", "csp*", "csl*" } counter reject
        iifname "cse*" meta nfproto ipv6 counter reject
    }
    chain forward {
        type filter hook forward priority -10; policy accept;
        iifname { "cs-public", "csp*", "csl*", "cse*" } meta nfproto ipv6 counter reject
        iifname "csl*" counter reject
        iifname "cs-public" oifname "cs-public" return
        iifname { "cs-public", "csp*" } ip daddr @DNS@ meta l4proto { tcp, udp } th dport 53 return
        iifname { "cs-public", "csp*" } ip daddr @prohibited counter reject
        iifname "cse*" oifname { "cs-public", "csl*", "cse*" } counter reject
    }
}

table bridge codex_sandbox {
    chain forward {
        type filter hook forward priority -10; policy accept;
        meta ibrname { "cs-public", "csp*", "csl*", "cse*" } ether type ip6 counter drop
    }
}
