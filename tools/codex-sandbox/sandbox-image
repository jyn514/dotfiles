#!/usr/bin/env python3
"""Build, resolve, refresh, or clean images in the admitted outer engine."""

import argparse
import importlib.util
import json
import os
from pathlib import Path
import signal
import subprocess
import sys

from sandbox_runtime import image_runtime
from image_resolver import resolve_policy
from owned_images import declaration, resolve_agent, source_paths, ROOT


def policy_module():
    path = Path(__file__).with_name('sandbox-proxies.py')
    spec = importlib.util.spec_from_file_location('sandbox_image_policy', path)
    if spec is None or spec.loader is None:
        raise RuntimeError('cannot load sandbox image policy')
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def execute():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--provider", choices=("lima", "lima-docker"),
                        help="override CODEX_SANDBOX_RUNTIME (default: lima-docker)")
    parser.add_argument("--state", type=Path)
    sub = parser.add_subparsers(dest="operation", required=True)
    resolve = sub.add_parser("resolve")
    resolve.add_argument("reference")
    build = sub.add_parser("build")
    build.add_argument("--tag", required=True)
    build.add_argument("--file", type=Path, required=True)
    build.add_argument("--build-arg", action="append", default=[])
    build.add_argument("--target")
    build.add_argument("--if-missing", action="store_true")
    build.add_argument("context", type=Path)
    bake = sub.add_parser('bake', help='resolve fresh Bake HCL or JSON from stdin')
    bake.add_argument('--platform', required=True)
    bake.add_argument('--mode', choices=('resolve', 'refresh', 'clean'), default='resolve')
    bake.add_argument('images', nargs='+')
    for operation in ('refresh', 'clean'):
        lifecycle = sub.add_parser(operation)
        lifecycle.add_argument('--repo', type=Path, default=Path.cwd())
        lifecycle.add_argument('images', nargs='*')
    args = parser.parse_args()
    runtime = image_runtime(args.provider, args.state)
    if args.operation == 'bake':
        if runtime.provider != 'lima-docker':
            raise ValueError('the bundled Bake resolver requires Lima-Docker')
        if runtime.build_platform() != args.platform:
            raise ValueError('Bake request platform differs from the admitted engine')
        from bake import resolve as resolve_bake
        images = resolve_bake(runtime, Path.cwd(), args.images,
                              declaration=sys.stdin.read(), operation=args.mode)
        print(json.dumps({'version': 1, 'images': images}, sort_keys=True))
        return
    if args.operation in {'refresh', 'clean'}:
        repo = args.repo.resolve(strict=True)
        manifest = policy_module().load_manifest(repo)
        policy = manifest.get('images')
        if policy is None:
            raise ValueError('refresh and clean require a version 2 image resolver')
        requested = set(args.images)
        all_images = not requested
        declared = {policy['base'], *[
            command['image-target'] for command in manifest['commands'].values()
            if command.get('image-target')
        ]}
        if not requested:
            requested = declared
        if not requested <= declared:
            raise ValueError('requested image is not declared by repository policy')
        images = resolve_policy(runtime, repo, policy, requested, operation=args.operation)
        results = {name: image.reference for name, image in images.items()}
        if all_images:
            from bake import resolve as resolve_bake
            helpers = ('auth', 'jj', 'zulip')
            results.update({
                'helper:' + name: reference
                for name, reference in resolve_bake(
                    runtime, ROOT, helpers, declaration=declaration(helpers),
                    captures=source_paths(helpers), operation=args.operation,
                ).items()
            })
            results['agent'] = resolve_agent(
                runtime, os.getuid(), os.getgid(), images[policy['base']].reference,
                operation=args.operation,
            )
        print(json.dumps(dict(sorted(results.items())), sort_keys=True))
        return
    if args.operation == "resolve":
        image = runtime.resolve_image(args.reference)
    else:
        if args.if_missing:
            try:
                image = runtime.resolve_image(args.tag)
            except subprocess.CalledProcessError:
                pass
            else:
                print(image.reference)
                return
        image = runtime.build(args.tag, args.file.resolve(strict=True),
                              args.context.resolve(strict=True),
                              build_args=args.build_arg, target=args.target)
    print(image.reference)


def main():
    def cancel(signum, _frame):
        # Unwind Bake captures and the runtime's detached builder groups.
        raise SystemExit(128 + signum)

    handlers = {signum: signal.signal(signum, cancel)
                for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)}
    try:
        execute()
    finally:
        for signum, handler in handlers.items():
            signal.signal(signum, handler)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, KeyError, OSError, subprocess.SubprocessError) as error:
        print(f"sandbox image: {error}", file=sys.stderr)
        sys.exit(1)
