# Prototype only: bridge-nf-call-iptables/ip6tables must both remain zero.
# The runner substitutes validated policy addresses.
destroy table inet codex_sandbox
destroy table bridge codex_sandbox
table inet codex_sandbox {
    set prohibited {
        type ipv4_addr
        flags interval
        elements = { @PROHIBITED@ }
    }
    chain input {
        type filter hook input priority -10; policy accept;
        iifname { "cs-public", "csl*" } counter reject
        iifname "cse*" meta nfproto ipv6 counter reject
    }
    chain forward {
        type filter hook forward priority -10; policy accept;
        iifname { "cs-public", "csl*", "cse*" } meta nfproto ipv6 counter reject
        iifname "csl*" counter reject
        iifname "cs-public" oifname "cs-public" return
        iifname "cs-public" ip daddr @DNS@ meta l4proto { tcp, udp } th dport 53 return
        iifname "cs-public" ip daddr @prohibited counter reject
        iifname "cse*" oifname { "cs-public", "csl*", "cse*" } counter reject
    }
}

table bridge codex_sandbox {
    chain forward {
        type filter hook forward priority -10; policy accept;
        meta ibrname { "cs-public", "csl*", "cse*" } ether type ip6 counter drop
    }
}
