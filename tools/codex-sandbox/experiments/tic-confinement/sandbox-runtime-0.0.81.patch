SRT 0.0.81: restore writable children after read-only parent mounts.
Upstream source: https://github.com/anthropic-experimental/sandbox-runtime
Base: v0.0.81, c40cf14a65d025e3cd27f071f13a73c12b3b1f92 (Apache-2.0).

This is an experimental upstream-source patch, not a launcher-installed fork.
Apply to a clean checkout of the base with patch -p1, then run the upstream
npm ci --ignore-scripts, npm run typecheck, and
bun test test/sandbox/linux-read-write-restores.test.ts.
The behavioral tests require Linux with working unprivileged bwrap namespaces;
they skip when that prerequisite is unavailable. Run them on a capable host.

The fix retains path resolution and containment checks and read/write denials.
Only restore ordering changes: read-only parent mounts precede writable children.
Later denyWrite mounts still take precedence.

--- a/src/sandbox/linux-sandbox-utils.ts
+++ b/src/sandbox/linux-sandbox-utils.ts
@@ -2055,16 +2055,14 @@
     return { source, dest }
   }
 
-  // tmpfs wiped any earlier write binds under this path — restore them.
+  // Resolve writes first so reads covered by a writable restore can be skipped.
+  // Emit the writes after the reads: a read-only parent bind would hide an
+  // earlier writable child bind, even though both paths are allowed.
   const restoredWrites: RestoredMount[] = []
   for (const writePath of allowedWritePaths) {
     const placement = restorePlacementOf(writePath)
     if (placement === undefined) continue
-    args.push('--bind', placement.source, placement.dest)
     restoredWrites.push(placement)
-    logForDebugging(
-      `[Sandbox Linux] Re-bound write path wiped by denyRead tmpfs: ${writePath}`,
-    )
   }
 
   // Re-allow specific paths within the denied directory (allowRead overrides denyRead).
@@ -2074,7 +2072,7 @@
   for (const allowPath of readAllowPaths) {
     const placement = restorePlacementOf(allowPath)
     if (placement === undefined) continue
-    // Skip only if a write path was re-bound just above AND covers
+    // Skip only if a write path will be re-bound below AND covers
     // allowPath. A write path that's an ancestor of the deny dir isn't
     // re-bound (it wasn't wiped), so allowPath under it still needs
     // its own ro-bind here.
@@ -2084,6 +2082,14 @@
     restoredReads.push(placement)
     logForDebugging(
       `[Sandbox Linux] Re-allowed read access within denied region: ${allowPath}`,
+    )
+  }
+  // tmpfs wiped any earlier write binds under this path. Restore them over
+  // the read-only parents; later denyWrite mounts still take precedence.
+  for (const placement of restoredWrites) {
+    args.push('--bind', placement.source, placement.dest)
+    logForDebugging(
+      `[Sandbox Linux] Re-bound write path wiped by denyRead tmpfs: ${placement.dest}`,
     )
   }
   return { restoredWrites, restoredReads }
--- /dev/null
+++ b/test/sandbox/linux-read-write-restores.test.ts
@@ -0,0 +1,113 @@
+import { afterEach, beforeEach, describe, expect, it } from 'bun:test'
+import { spawnSync } from 'node:child_process'
+import {
+  mkdirSync,
+  mkdtempSync,
+  realpathSync,
+  rmSync,
+  symlinkSync,
+  writeFileSync,
+} from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import {
+  cleanupBwrapMountPoints,
+  wrapCommandWithSandboxLinux,
+} from '../../src/sandbox/linux-sandbox-utils.js'
+import { quote } from '../../src/utils/shell-quote.js'
+import { bwrapCanNamespace } from '../helpers/bwrap-namespace.js'
+import { isLinux } from '../helpers/platform.js'
+
+// A read-only workspace must not hide its nested writable backing directory.
+// Exercise bwrap itself: finding a --bind in its argv misses a later parent mount.
+describe.if(isLinux && bwrapCanNamespace())(
+  'read restores containing writable backing directories',
+  () => {
+    const savedCwd = process.cwd()
+    let base: string
+    let project: string
+    let git: string
+    let store: string
+    let secret: string
+
+    beforeEach(() => {
+      base = realpathSync(mkdtempSync(join(tmpdir(), 'read-write-restore-')))
+      project = join(base, 'project')
+      git = join(project, '.git')
+      store = join(git, 'backing-store')
+      secret = join(base, 'secret')
+      mkdirSync(store, { recursive: true })
+      writeFileSync(join(project, 'README'), 'ordinary workspace data')
+      writeFileSync(join(git, 'config'), '[core]\n')
+      writeFileSync(join(store, 'protected'), 'protected store file')
+      writeFileSync(secret, 'outside secret')
+      symlinkSync(secret, join(project, 'redirected'))
+      process.chdir(project)
+    })
+
+    afterEach(() => {
+      process.chdir(savedCwd)
+      cleanupBwrapMountPoints({ force: true })
+      rmSync(base, { recursive: true, force: true })
+    })
+
+    it.each([
+      ['workspace only', [0], false],
+      ['parent before child', [0, 1, 2], false],
+      ['child before parent', [2, 1, 0], false],
+      ['write deny inside store', [0, 1], false],
+      ['write deny contains store', [0, 1], true],
+    ] as const)('%s', async (_name, readOrder, denyStore) => {
+      const readPaths = [project, git, store]
+      async function run(program: string, ...args: string[]) {
+        const wrapped = await wrapCommandWithSandboxLinux({
+          command: quote([program, ...args]),
+          needsNetworkRestriction: false,
+          allowAllUnixSockets: true,
+          readConfig: {
+            denyOnly: [base],
+            allowWithinDeny: readOrder.map(i => readPaths[i]!),
+          },
+          writeConfig: {
+            allowOnly: [store],
+            denyWithinAllow: [denyStore ? git : join(store, 'protected')],
+          },
+        })
+        const result = spawnSync(wrapped, {
+          shell: true,
+          cwd: project,
+          encoding: 'utf8',
+          timeout: 15000,
+        })
+        expect(result.error).toBeUndefined()
+        expect(result.signal).toBeNull()
+        return result
+      }
+
+      const readable = await run('/bin/cat', join(project, 'README'))
+      expect(readable.status).toBe(0)
+      expect(readable.stdout).toBe('ordinary workspace data')
+      for (const name of [
+        'future.sqlite',
+        'future.sqlite-wal',
+        'future.sqlite-shm',
+      ]) {
+        const result = await run('/usr/bin/touch', join(store, name))
+        if (denyStore) expect(result.status).not.toBe(0)
+        else expect(result.status).toBe(0)
+      }
+      for (const denied of [
+        join(project, 'must-not-create'),
+        join(git, 'config'),
+        join(store, 'protected'),
+      ]) {
+        expect((await run('/usr/bin/touch', denied)).status).not.toBe(0)
+      }
+      for (const denied of [secret, join(project, 'redirected')]) {
+        const result = await run('/bin/cat', denied)
+        expect(result.status).not.toBe(0)
+        expect(result.stdout).not.toContain('outside secret')
+      }
+    })
+  },
+)
