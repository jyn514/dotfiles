def parse_connection(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        if not separator or not re.fullmatch(r"[A-Z][A-Z0-9_]*", key):
            raise LauncherError(f"invalid Agent Docker connection setting: {line!r}")
        values[key] = value
    required = {
        "AGENT_DOCKER_SSH_USER", "AGENT_DOCKER_SSH_PORT",
        "DOCKER_HOST", "AGENT_DOCKER_SSHKEY",
    }
    if not required <= values.keys():
        raise LauncherError("Agent Docker connection settings are incomplete")
    return values


def resumable_arguments(arguments: list[str]) -> tuple[list[str], str | None]:
    if not arguments:
        session_id = str(uuid.uuid4())
        return ["--session-id", session_id], session_id
    if len(arguments) == 2 and arguments[0] == "--session" and arguments[1]:
        return arguments, arguments[1]
    if arguments.count("--session-id") == 1:
        index = arguments.index("--session-id")
        if index + 1 < len(arguments) and arguments[index + 1]:
            return arguments, arguments[index + 1]
    return arguments, None


def session_header(path: Path) -> tuple[str, Path]:
    try:
        with path.open("rb") as stream:
            line = stream.readline(1024 * 1024 + 1)
        if len(line) > 1024 * 1024:
            raise ValueError("session header is too large")
        header = json.loads(line)
        if not isinstance(header, dict) or header.get("type") != "session" \
                or not isinstance(header.get("id"), str) or not header["id"] \
                or not isinstance(header.get("cwd"), str) or not header["cwd"]:
            raise ValueError("session header is invalid")
        return header["id"], Path(header["cwd"]).expanduser().resolve()
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as error:
        raise LauncherError(f"Cannot inspect Pi session {path}: {error}") from error


def prepare_host_session(state: State) -> None:
    arguments = state.codex_arguments
    selected_cwd = state.host_working_directory.resolve()
    session_dir = os.environ.get("PI_CODING_AGENT_SESSION_DIR")
    if arguments.count("--session-dir") == 1:
        directory_index = arguments.index("--session-dir")
        if directory_index + 1 < len(arguments):
            session_dir = arguments[directory_index + 1]
    sessions = Path(session_dir).expanduser() if session_dir else state.home / ".pi/agent/sessions"
    if not sessions.is_absolute():
        sessions = selected_cwd / sessions
    for flag in ("--session", "--session-id"):
        if arguments.count(flag) != 1:
            continue
        index = arguments.index(flag)
        if index + 1 >= len(arguments):
            return
        value = arguments[index + 1]
        source = None
        if flag == "--session":
            if "/" not in value and "\\" not in value and not value.endswith(".jsonl"):
                candidates = []
                for path in sessions.rglob("*.jsonl"):
                    if not path.stem.rsplit("_", 1)[-1].startswith(value):
                        continue
                    try:
                        candidates.append((path, *session_header(path)))
                    except LauncherError:
                        continue
                matching = [(path, session_id, cwd) for path, session_id, cwd in candidates
                            if session_id.startswith(value)]
                matching.sort(key=lambda item: (item[2] != selected_cwd,
                                                item[1] != value, str(item[0])))
                source = matching[0][0] if matching else None
            else:
                source = Path(value).expanduser()
                if not source.is_absolute():
                    source = state.host_working_directory / source
                if not source.is_file():
                    return  # Let Pi report its normal missing-session error.
        else:
            if sessions.is_dir():
                candidates = []
                for path in sessions.rglob("*.jsonl"):
                    if not path.name.endswith(f"_{value}.jsonl"):
                        continue
                    try:
                        if session_header(path)[0] == value:
                            candidates.append(path)
                    except LauncherError:
                        continue
                matching = [path for path in candidates
                            if session_header(path)[1] == selected_cwd]
                if matching:
                    return
                if len(candidates) > 1:
                    raise LauncherError(f"Session ID {value} exists in multiple directories")
                source = candidates[0] if candidates else None
        if source is not None and session_header(source)[1] != selected_cwd:
            state.codex_arguments = [*arguments[:index], "--fork", str(source.resolve()),
                                     "--session-id", str(uuid.uuid4()), *arguments[index + 2:]]
        return


