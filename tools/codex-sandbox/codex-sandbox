        agent_docker_known_hosts=access / "known_hosts.sandbox",
        host_working_directory=Path.cwd().resolve(strict=True),
    )
    return state


def load_agent_docker(state: State) -> None:
    paths = (
        state.agent_docker_connection, state.agent_docker_key,
        state.agent_docker_known_hosts,
    )
    if not any(path.exists() for path in paths):
        print(
            f"warning: nested-containers requested but Agent Docker access is missing at "
            f"{state.agent_docker_access}; docker unavailable. "
            "Follow tools/agent-docker/README.md setup on the host, then restart the sandbox.",
            file=sys.stderr,
        )
        return
    if not all(path.is_file() for path in paths):
        raise LauncherError(f"Agent Docker access state is incomplete: {state.agent_docker_access}")
    values = parse_connection(state.agent_docker_connection)
    if (not re.fullmatch(r"[a-z_][a-z0-9_-]*", values["AGENT_DOCKER_SSH_USER"])
            or not values["AGENT_DOCKER_SSH_PORT"].isdigit()
            or not 0 < int(values["AGENT_DOCKER_SSH_PORT"]) < 65536
            or values["AGENT_DOCKER_SSHKEY"] != "/run/secrets/agent-docker-key"):
        raise LauncherError("invalid Agent Docker SSH identity, port, or key destination")
    prefix = (
        f"ssh://{values['AGENT_DOCKER_SSH_USER']}@host.docker.internal:"
        f"{values['AGENT_DOCKER_SSH_PORT']}"
    )
    host = values["DOCKER_HOST"]
    if host != prefix:
        raise LauncherError("Agent Docker connection does not use the expected host endpoint")
    state.agent_docker = values


def decode_tmux_registration(encoded: str) -> dict[str, object]:
    # Base64url padding is optional; Node's SDK publisher omits it.
    payload = json.loads(base64.urlsafe_b64decode(encoded + "=" * (-len(encoded) % 4)).decode())
    if not isinstance(payload, dict):
        raise ValueError("restart registration is not an object")
    return payload


def register_tmux_pane(state: State) -> None:
    pane = os.environ.get("TMUX_PANE")
    if pane is None:
        return
    # The SDK publishes the selected file after startup and on session switches.
    # CLI arguments (including --resume) cannot identify the current session.
    registration = base64.urlsafe_b64encode(json.dumps({
        "version": 2,
        "pane": pane,
        "repository": str(state.repository),
        "session": None,
        "cwd": str(state.host_working_directory),
        "token": secrets.token_hex(16),
    }, separators=(",", ":"), sort_keys=True).encode()).decode()
    run([
        "tmux", "set-option", "-p", "-t", pane,
        "@codex_sandbox_restart", registration,
    ], quiet=True)
    run([
        "tmux", "set-option", "-p", "-t", pane,
        "@codex_sandbox_command", "π",
    ], quiet=True)
    state.tmux_pane = pane
    state.tmux_registration = registration


def unregister_tmux_pane(state: State) -> None:
    if state.tmux_pane is None or state.tmux_registration is None:
        return
    current = run([
        "tmux", "show-option", "-p", "-v", "-t", state.tmux_pane,
        "@codex_sandbox_restart",
    ], check=False, capture=True, quiet=True)
    try:
        published = decode_tmux_registration(current.stdout.strip())
        original = decode_tmux_registration(state.tmux_registration)
    except (ValueError, UnicodeError):
        return
    # The SDK updates the selected session within this launch generation.
    if current.returncode == 0 and isinstance(published, dict) \
            and published.get("token") == original["token"]:
        run([
            "tmux", "set-option", "-p", "-u", "-t", state.tmux_pane,
            "@codex_sandbox_restart",
        ], check=False, quiet=True)
        run([
            "tmux", "set-option", "-p", "-u", "-t", state.tmux_pane,
            "@codex_sandbox_command",
        ], check=False, quiet=True)


def container_repository_path(home: Path, repository: Path) -> Path:
    source_root = (home / "src").resolve(strict=True)
    try:
        relative = repository.relative_to(source_root)
    except ValueError:
        return Path("/src/repository")
    if relative == Path("."):
        return Path("/src/repository")
    return Path("/src") / relative


def container_working_directory_path(
    repository: Path, container_repository: Path, working_directory: Path,
) -> Path:
    try:
        relative = working_directory.relative_to(repository)
    except ValueError as error:
        raise LauncherError("The launch directory is outside the repository workspace") from error
    return container_repository / relative


def existing_git_root() -> Path:
    try:
        result = run(["git", "rev-parse", "--show-toplevel"], capture=True, quiet=True)
    except subprocess.CalledProcessError as error:
        raise LauncherError("Pi requires an existing Git repository; run it inside a repository") from error
    return Path(result.stdout.strip()).resolve(strict=True)


@contextmanager
def validation_timing(name: str):
    started = time.monotonic()
    try:
        yield
    finally:
        if os.environ.get("CODEX_SANDBOX_TIMING"):
            print(f"Sandbox validation: {name}={time.monotonic() - started:.2f}s", file=sys.stderr)


def initialize_dotfiles(repository: Path) -> None:
    """Serialize initialization independently of session provisioning."""
    # The session coordination lock can be held during long builds/recovery.
    # Use a canonical-checkout initialization lock even for the existing case:
    # merely checking .jj first could observe another initializer's partial tree.
    repository = repository.resolve(strict=True)
    locks = Path.home() / ".cache/codex-sandbox-proxies/initialization"
    locks.mkdir(mode=0o700, parents=True, exist_ok=True)
    identity = hashlib.sha256(os.fsencode(repository)).hexdigest()
    with (locks / f"{identity}.lock").open("a+b") as initialization:
        with validation_timing("dotfiles initialization lock"):
            fcntl.flock(initialization, fcntl.LOCK_EX)
        entry = repository / ".jj"
        # lexists semantics: dangling symlinks and partial initialization are
        # existing metadata, not permission to replace it with a fresh store.
        if entry.exists() or entry.is_symlink():
            return
        # First initialization still respects the existing service authority.
        # Ordinary workspace validation below remains authoritative on reuse.
        with validation_timing("dotfiles initialization metadata"):
            directory = proxy_module().runtime_directory(repository)
        with (directory / "coordination.lock").open("a+b") as lock:
            with validation_timing("dotfiles coordination lock"):
                fcntl.flock(lock, fcntl.LOCK_EX)
            if entry.exists() or entry.is_symlink():
                return
            try:
                root = run(["git", "-C", str(repository), "rev-parse", "--show-toplevel"],
                           capture=True).stdout.strip()
                if Path(root).resolve(strict=True) != repository:
                    raise LauncherError(f"Dotfiles is not a Git checkout root: {repository}")
                run(["jj", "git", "init", "--colocate", str(repository)], cwd=repository)
            except subprocess.CalledProcessError as error:
                raise LauncherError(f"Dotfiles could not be initialized as a Jujutsu workspace: {repository}") from error


def active_repository_root(*, initialize_missing: bool) -> Path:
    try:
        result = run(["jj", "workspace", "root", "--ignore-working-copy"], capture=True)
    except subprocess.CalledProcessError:
        if not initialize_missing:
            raise LauncherError("The destination is not an existing Jujutsu workspace")
        repository = existing_git_root()
        entry = repository / ".jj"
        if entry.exists() or entry.is_symlink():
            raise LauncherError(f"Existing Jujutsu metadata requires repair: {repository}")
        try:
            run(["jj", "git", "init", "--colocate", str(repository)])
            result = run(["jj", "workspace", "root", "--ignore-working-copy"], capture=True)
        except subprocess.CalledProcessError as error:
            raise LauncherError("The current directory could not be initialized as a Jujutsu workspace") from error
    return Path(result.stdout.strip()).resolve(strict=True)


def discover_launch_workspaces(home: Path, repository: Path) -> list[WorkspaceLayout]:
    # Pure discovery is shared with /cd preflight: it must cover the same guest
    # writable workspaces without creating request locks or publishing authority.
    dotfiles = DOTFILES.resolve(strict=True)
    guest = container_repository_path(home, repository)
    with validation_timing("active workspace discovery"):
        active = discover_workspace(repository, guest, home, runner=run)
    dotfiles_guest = workspace_guest_root(
        home, repository, guest, dotfiles, reserved=[
            *active.metadata_mounts(),
            *((active.host_root, alias) for alias in active.repository_aliases()),
        ])
    workspaces = [active]
    if dotfiles != repository:
        with validation_timing("dotfiles workspace discovery"):
            workspaces.append(discover_workspace(dotfiles, dotfiles_guest, home, runner=run))
    return workspaces


def validate_repository(state: State, *, initialize_missing: bool = True) -> None:
    if initialize_missing:
        dotfiles = DOTFILES.resolve(strict=True)
        # Finish dotfiles initialization before active/session lifetime locks,
        # including when dotfiles and the active checkout are the same tree.
        with validation_timing("dotfiles initialization"):
            initialize_dotfiles(dotfiles)
    with validation_timing("active repository root"):
        repository = active_repository_root(initialize_missing=initialize_missing)
    if not initialize_missing:
        # validate-cd is active-only: no dotfiles lookup, guest mapping, request
        # locks, source-view allocation or authority publication belongs here.
        try:
            metadata = discover_repository_metadata(repository, runner=run)
        except WorkspaceError as error:
            raise LauncherError(str(error)) from error
        state.repository = metadata.host_root
        state.git_repository = metadata.git_dir
        state.git_mount_source = metadata.git_dir
        state.metadata_roots = (repository / ".jj", metadata.jj_repo,
                                metadata.git_dir, metadata.common_dir)
        return
    try:
        workspaces = discover_launch_workspaces(state.home, repository)
        active = workspaces[0]
        guest = active.guest_root
        with validation_timing("workspace request locks"):
            for workspace in workspaces:
                ensure_request_lock(workspace)
    except WorkspaceError as error:
        raise LauncherError(str(error)) from error
    state.repository = repository
    state.container_repository = guest
    state.git_repository = active.git_dir
    state.git_mount_source = active.git_dir
    state.workspaces = workspaces
    state.metadata_roots = tuple(dict.fromkeys(
        path for workspace in workspaces for path in (
            workspace.host_root / ".jj", workspace.jj_repo, workspace.git_dir, workspace.common_dir)))
    state.workspaces_file = temporary_file()
    state.workspaces_file.write_text(json.dumps([workspace.to_dict() for workspace in workspaces]))
    with validation_timing("workspace mount plan"):
        _workspace_mount_plan(state)
    proxy_module().use_repository_metadata(repository, (active.git_dir, active.common_dir))


def load_repository_policy(state: State) -> None:
    state.manifest = temporary_file()
    snapshot_arguments = [
        "snapshot", "--repo", str(state.repository), "--output", str(state.manifest),
        "--jj-image-command", str(DOTFILES / ".agents/sandbox/jj-proxy-image"),
    ]
    zuliprc = Path(os.environ.get("CODEX_SANDBOX_ZULIPRC", state.home / ".zuliprc"))
    if zuliprc.exists() or zuliprc.is_symlink():
        state.zuliprc = zuliprc
        snapshot_arguments += [
            "--zulip-image-command", str(DOTFILES / ".agents/sandbox/zulip-proxy-image"),
            "--zuliprc", str(zuliprc),
        ]
    state.policy_source_present = (
        state.repository / ".agents" / "sandbox" / "proxy-commands.json"
    ).is_file() or (
        state.repository / ".agents" / "sandbox" / "docker-bake.hcl"
    ).is_file()
    helper(*snapshot_arguments)
    snapshot = json.loads(state.manifest.read_text(encoding="utf-8"))
    bind_repository_policy(state, snapshot)
    if "zulip" not in snapshot["commands"]:
        state.zuliprc = None
    state.capabilities = frozenset(
        name for name, selected in snapshot.get("capabilities", {}).items() if selected
    )
    if "nested-containers" in state.capabilities:
        load_agent_docker(state)


