def run(
    arguments: list[str], *, check: bool = True, capture: bool = False,
    cwd: Path | None = None, quiet: bool = False, discard_stdout: bool = False,
    stdout_to_stderr: bool = False, input_text: str | None = None,
    builder: bool = False,
) -> subprocess.CompletedProcess[str]:
    if builder and OUTER_RUNTIME.provider == 'lima-docker':
        result = OUTER_RUNTIME.run_builder(arguments, cwd=cwd, capture=capture)
        if check:
            result.check_returncode()
        return result
    engine_command = arguments[:1] == ["docker"]
    if engine_command:
        arguments = OUTER_RUNTIME.argv(arguments[1:], cwd=cwd)
    stdout = None
    if capture:
        stdout = subprocess.PIPE
    elif quiet or discard_stdout:
        stdout = subprocess.DEVNULL
    elif stdout_to_stderr:
        stdout = sys.stderr
    result = subprocess.run(
        arguments, cwd=cwd, check=False, text=True, input=input_text,
        stdin=subprocess.DEVNULL if engine_command and input_text is None else None,
        stdout=stdout,
        stderr=subprocess.DEVNULL if quiet else None,
        timeout=30 if engine_command and OUTER_RUNTIME.provider == 'lima-docker' else None,
    )
    if check and result.returncode:
        raise subprocess.CalledProcessError(result.returncode, arguments)
    return result


@cache
def proxy_module():
    # Snapshot loads this on the main thread before concurrent startup begins.
    spec = importlib.util.spec_from_file_location("sandbox_proxies", PROXY_HELPER)
    assert spec is not None and spec.loader is not None
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    module.OUTER_RUNTIME = OUTER_RUNTIME
    return module


def helper(*arguments: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    # Short operations share the launcher's interpreter; lock/monitor lifetimes
    # remain separate processes so they can supervise and outlive these calls.
    result = subprocess.CompletedProcess([str(PROXY_HELPER), *arguments],
        proxy_module().main(list(arguments), runtime=OUTER_RUNTIME))
    if check:
        result.check_returncode()
    return result


def temporary_file() -> Path:
    descriptor, name = tempfile.mkstemp(dir=scratch_directory())
    os.close(descriptor)
    return Path(name)


def scratch_directory() -> Path | None:
    return OUTER_RUNTIME.host.state / "scratch" if isinstance(OUTER_RUNTIME, VMRuntime) else None


def proxy_flags() -> list[str]:
    if isinstance(OUTER_RUNTIME, VMRuntime):
        network = json.loads((OUTER_RUNTIME.host.state / "source/rootless-network.json").read_text())
        return ["--dns", network["dns"]]
    return ["--http-proxy=false"]


def create_relay_network(state: State, name: str, *, internal: bool) -> None:
    if isinstance(OUTER_RUNTIME, VMRuntime):
        OUTER_RUNTIME.create_relay_network(name, internal=internal, owner=state.resource_owner)
    else:
        run(["docker", "network", "create", *(["--internal"] if internal else []),
             "--opt", "isolate=true", name], discard_stdout=True)


def parse_connection(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        if not separator or not re.fullmatch(r"[A-Z][A-Z0-9_]*", key):
            raise LauncherError(f"invalid Agent Podman connection setting: {line!r}")
        values[key] = value
    required = {
        "AGENT_PODMAN_SSH_USER", "AGENT_PODMAN_SSH_PORT",
        "CONTAINER_HOST", "CONTAINER_SSHKEY",
    }
    if not required <= values.keys():
        raise LauncherError("Agent Podman connection settings are incomplete")
    return values


def resumable_arguments(arguments: list[str]) -> tuple[list[str], str | None]:
    if not arguments:
        session_id = str(uuid.uuid4())
        return ["--session-id", session_id], session_id
    if len(arguments) == 2 and arguments[0] in ("--session", "--session-id") and arguments[1]:
        return arguments, arguments[1]
    return arguments, None


def new_state(codex_arguments: list[str]) -> State:
    codex_arguments, _ = resumable_arguments(codex_arguments)
    home = Path(os.environ["HOME"])
    uid = os.getuid()
    suffix = f"{uid}-{secrets.token_hex(6)}"
    access = Path(os.environ.get("AGENT_PODMAN_ACCESS_DIR", home / ".agent-podman-access"))
    state = State(
        codex_arguments=codex_arguments,
        home=home,
        term=os.environ.get("TERM", "xterm-256color"),
        uid=uid,
        gid=os.getgid(),
        suffix=suffix,
        relay_link_network=f"codex-agent-podman-link-{suffix}",
        relay_egress_network=f"codex-agent-podman-egress-{suffix}",
        relay_container=f"codex-agent-podman-relay-{suffix}",
        codex_container=f"codex-sandbox-{suffix}",
        proxy_prefix=f"codex-command-proxy-{suffix}",
        codex_sidecar_container=f"codex-auth-proxy-{suffix}",
        editor_link_network=f"codex-host-editor-link-{suffix}",
        editor_egress_network=f"codex-host-editor-egress-{suffix}",
        editor_relay_container=f"codex-host-editor-relay-{suffix}",
        codex_auth_directory=Path(os.environ.get(
            "CODEX_SANDBOX_AUTH_DIR", home / ".codex-sandbox-auth",
        )),
        agent_podman_access=access,
        agent_podman_connection=access / "connection.env",
        agent_podman_key=access / "id_ed25519",
        agent_podman_known_hosts=access / "known_hosts.sandbox",
        host_working_directory=Path.cwd().resolve(strict=True),
    )
    load_agent_podman(state)
    return state


def load_agent_podman(state: State) -> None:
    paths = (
        state.agent_podman_connection, state.agent_podman_key,
        state.agent_podman_known_hosts,
    )
    if not any(path.exists() for path in paths):
        return
    if not all(path.is_file() for path in paths):
        raise LauncherError(f"Agent Podman access state is incomplete: {state.agent_podman_access}")
    values = parse_connection(state.agent_podman_connection)
    prefix = (
        f"ssh://{values['AGENT_PODMAN_SSH_USER']}@host.docker.internal:"
        f"{values['AGENT_PODMAN_SSH_PORT']}/"
    )
    host = values["CONTAINER_HOST"]
    if not host.startswith(prefix):
        raise LauncherError("Agent Podman connection does not use the expected host endpoint")
    values["SOCKET_PATH"] = host.removeprefix(prefix)
    state.agent_podman = values


def register_tmux_pane(state: State) -> None:
    pane = os.environ.get("TMUX_PANE")
    _, session_id = resumable_arguments(state.codex_arguments)
    if pane is None or session_id is None:
        return
    registration = base64.urlsafe_b64encode(json.dumps({
        "version": 1,
        "pane": pane,
        "repository": str(state.repository),
        "session": session_id,
        "token": secrets.token_hex(16),
    }, separators=(",", ":"), sort_keys=True).encode()).decode()
    run([
        "tmux", "set-option", "-p", "-t", pane,
        "@codex_sandbox_restart", registration,
    ], quiet=True)
    run([
        "tmux", "set-option", "-p", "-t", pane,
        "@codex_sandbox_command", "π",
    ], quiet=True)
    state.tmux_pane = pane
    state.tmux_registration = registration


def unregister_tmux_pane(state: State) -> None:
    if state.tmux_pane is None or state.tmux_registration is None:
        return
    current = run([
        "tmux", "show-option", "-p", "-v", "-t", state.tmux_pane,
        "@codex_sandbox_restart",
    ], check=False, capture=True, quiet=True)
    if current.returncode == 0 and current.stdout.strip() == state.tmux_registration:
        run([
            "tmux", "set-option", "-p", "-u", "-t", state.tmux_pane,
            "@codex_sandbox_restart",
        ], check=False, quiet=True)
        run([
            "tmux", "set-option", "-p", "-u", "-t", state.tmux_pane,
            "@codex_sandbox_command",
        ], check=False, quiet=True)


def container_repository_path(home: Path, repository: Path) -> Path:
    source_root = (home / "src").resolve(strict=True)
    try:
        relative = repository.relative_to(source_root)
    except ValueError:
        return Path("/src/repository")
    if relative == Path("."):
        return Path("/src/repository")
    return Path("/src") / relative


def container_working_directory_path(
    repository: Path, container_repository: Path, working_directory: Path,
) -> Path:
    try:
        relative = working_directory.relative_to(repository)
    except ValueError as error:
        raise LauncherError("The launch directory is outside the repository workspace") from error
    return container_repository / relative


def validate_repository(state: State) -> None:
    try:
        # Finding the mount root needs metadata, not a working-tree snapshot.
        result = run(["jj", "workspace", "root", "--ignore-working-copy"], capture=True)
    except subprocess.CalledProcessError:
        try:
            run(["jj", "git", "init"])
            result = run(["jj", "workspace", "root", "--ignore-working-copy"], capture=True)
        except subprocess.CalledProcessError as error:
            raise LauncherError("The current directory could not be initialized as a Jujutsu workspace") from error
    repository = Path(result.stdout.strip()).resolve(strict=True)
    jj = repository / ".jj"
    git = repository / ".git"
    if not jj.is_dir() or jj.is_symlink():
        raise LauncherError("The Jujutsu workspace root cannot be safely mounted")
    if not (git.is_dir() or git.is_file()):
        raise LauncherError("Git metadata is missing or invalid")
    if git.is_symlink():
        raise LauncherError("Symlinked Git metadata is not supported")
    if git.is_file() and git.lstat().st_nlink != 1:
        raise LauncherError("Git metadata entry must not be hard linked")
    try:
        result = run([
            "git", "-C", str(repository), "rev-parse", "--path-format=absolute",
            "--git-dir", "--git-common-dir",
        ], capture=True)
        lines = result.stdout.splitlines()
        if len(lines) != 2:
            raise LauncherError("Git returned an invalid metadata layout")
        git_roots = [Path(line).resolve(strict=True) for line in lines]
    except (subprocess.CalledProcessError, FileNotFoundError) as error:
        raise LauncherError("Git metadata indirection cannot be resolved safely") from error
    try:
        jj_repo_entry = jj / "repo"
        if jj_repo_entry.is_file() and not jj_repo_entry.is_symlink():
            if jj_repo_entry.lstat().st_nlink != 1:
                raise LauncherError("Jujutsu repository pointer must not be hard linked")
            value = jj_repo_entry.read_text(encoding="utf-8").strip()
            if not value or "\0" in value or "\n" in value or "\r" in value:
                raise LauncherError("Jujutsu repository pointer is invalid")
            target = Path(value)
            if not target.is_absolute():
                target = jj_repo_entry.parent / target
            jj_repo = target.resolve(strict=True)
        else:
            jj_repo = jj_repo_entry.resolve(strict=True)
    except (FileNotFoundError, UnicodeError) as error:
        raise LauncherError("Jujutsu repository metadata cannot be resolved safely") from error
    for root in (jj, jj_repo, *git_roots):
        if not root.is_dir() or root.is_symlink():
            raise LauncherError(f"Repository metadata directory is invalid: {root}")
    state.repository = repository
    state.metadata_roots = (jj, jj_repo, *git_roots)
    state.container_repository = container_repository_path(state.home, repository)
    state.container_working_directory = container_working_directory_path(
        repository, state.container_repository, state.host_working_directory,
    )
    state.manifest = temporary_file()
    snapshot_arguments = [
        "snapshot", "--repo", str(repository), "--output", str(state.manifest),
        "--jj-image-command", str(DOTFILES / ".agents/sandbox/jj-proxy-image"),
    ]
    zuliprc = Path(os.environ.get("CODEX_SANDBOX_ZULIPRC", state.home / ".zuliprc"))
    if zuliprc.exists() or zuliprc.is_symlink():
        state.zuliprc = zuliprc
        snapshot_arguments += [
            "--zulip-image-command", str(DOTFILES / ".agents/sandbox/zulip-proxy-image"),
            "--zuliprc", str(zuliprc),
        ]
    helper(*snapshot_arguments)


def image_sources() -> list[Path]:
    dockerfile = Path("tools/codex-sandbox/image/Dockerfile")
    sources = [dockerfile]
    for line in (DOTFILES / dockerfile).read_text(encoding="utf-8").splitlines():
        fields = line.split()
        if not fields or fields[0] != "COPY" or any(field.startswith("--from=") for field in fields[1:-1]):
            continue
        sources.extend(Path(field) for field in fields[1:-1] if not field.startswith(("--", "<<")))
    files: list[Path] = []
    for source in sources:
        absolute = DOTFILES / source
        if absolute.is_dir():
            files.extend(
                path.relative_to(DOTFILES) for path in absolute.rglob("*")
                if stat.S_ISREG(path.lstat().st_mode)
            )
        elif absolute.is_file():
            files.append(source)
    return sorted(set(files), key=lambda path: os.fsencode(path.as_posix()))


def image_cache_key(state: State, base_image: str) -> str:
    sources = image_sources()
    digests = run(
        ["git", "hash-object", *map(str, sources)], capture=True, cwd=DOTFILES,
    ).stdout.splitlines()
    if len(digests) != len(sources):
        raise LauncherError("Git returned an invalid sandbox image source digest list")
    lines = [
        f"BASE_IMAGE={base_image}", f"AGENT_UID={state.uid}", f"AGENT_GID={state.gid}",
        f"TERM={state.term}",
        *(f"{path.as_posix()} {digest}" for path, digest in zip(sources, digests, strict=True)),
    ]
    return run(
        ["git", "hash-object", "--stdin"], capture=True, cwd=DOTFILES,
        input_text="\n".join(lines) + "\n",
    ).stdout.strip()


def resolve_sidecar_image() -> str:
    builder = DOTFILES / "tools/codex-sandbox/auth-proxy/image"
    result = run([str(builder)], capture=True, cwd=DOTFILES, builder=True)
    output = result.stdout.strip()
    return OUTER_RUNTIME.builder_image(output)


def ensure_image(state: State, base_image: str) -> str:
    image = f"codex-sandbox:{image_cache_key(state, base_image)}"
    if isinstance(OUTER_RUNTIME, VMRuntime):
        try:
            return OUTER_RUNTIME.resolve_image(image).reference
        except subprocess.CalledProcessError:
            return OUTER_RUNTIME.build(image, DOTFILES / "tools/codex-sandbox/image/Dockerfile",
                DOTFILES, build_args=[f"AGENT_UID={state.uid}", f"AGENT_GID={state.gid}",
                    f"TERM={state.term}", f"BASE_IMAGE={base_image}"]).reference
    if run(["docker", "image", "inspect", image], check=False, quiet=True).returncode == 0:
        return image
    print(f"Building docker image {image} ...", end="", file=sys.stderr, flush=True)
    iidfile = temporary_file()
    try:
        run([
            "docker", "build", "--jobs", "4",
            "-f", "tools/codex-sandbox/image/Dockerfile",
            "--build-arg", f"AGENT_UID={state.uid}",
            "--build-arg", f"AGENT_GID={state.gid}",
            "--build-arg", f"TERM={state.term}", "--iidfile", str(iidfile),
            "--tag", image, "--build-arg", f"BASE_IMAGE={base_image}", ".",
        ], cwd=DOTFILES, stdout_to_stderr=True)
        built = iidfile.read_text(encoding="utf-8").strip()
        if not built:
            raise LauncherError("Docker did not report the built sandbox image ID")
    finally:
        iidfile.unlink(missing_ok=True)
    print(" done.", file=sys.stderr)
    return built


def ensure_network() -> None:
    try:
        OUTER_RUNTIME.ensure_public_network()
    except subprocess.CalledProcessError as error:
        detail = error.stderr or ''
        if isinstance(detail, bytes):
            detail = detail.decode(errors='replace')
        message = f"Sandbox network setup failed (exit {error.returncode})"
        if detail.strip():
            message += ': ' + detail.strip()
        raise LauncherError(message) from error


def acquire_lock(state: State) -> None:
    state.proxy_state = temporary_file()
    state.lock_ready = temporary_file()
    state.lock_coordinated = temporary_file()
    state.lock_release = temporary_file()
    state.lock_ready.unlink()
    state.lock_coordinated.unlink()
    state.lock_release.unlink()
    state.lock_process = subprocess.Popen([
        "python3", str(PROXY_HELPER), "hold-lock", "--repo", str(state.repository),
        "--ready", str(state.lock_ready), "--coordinated", str(state.lock_coordinated),
        "--release", str(state.lock_release), "--parent-pid", str(os.getpid()),
    ], stdin=subprocess.DEVNULL)
    while True:
        if state.lock_ready.exists():
            return
        if state.lock_process.poll() is not None:
            raise LauncherError("Could not join the sandbox proxy session")
        time.sleep(0.05)


def attach_proxies(state: State) -> list[str]:
    try:
        arguments = [
            "attach", "--repo", str(state.repository),
            "--container-repo", str(state.container_repository),
            "--prefix", state.proxy_prefix, "--session", str(state.lock_ready),
            "--state", str(state.proxy_state), "--helper-image", state.sidecar_image,
            "--network", SANDBOX_NETWORK, "--manifest", str(state.manifest),
        ]
        if state.zuliprc is not None:
            arguments += ["--zuliprc", str(state.zuliprc)]
        if state.prepared_images is not None:
            arguments += ['--images', str(state.prepared_images)]
        auth_directory = _secure_codex_auth_directory(state)
        if auth_directory is not None:
            arguments.append("--auth-enabled")
        helper(*arguments)
        sidecar_arguments = attach_codex_sidecar(state, auth_directory)
        return [*sidecar_arguments, *finalize_proxy_session(state)]
    finally:
        state.lock_coordinated.touch()


def prepare_relay(state: State) -> list[str]:
    values = state.agent_podman
    state.relay_link_created = True
    create_relay_network(state, state.relay_link_network, internal=True)
    state.relay_egress_created = True
    create_relay_network(state, state.relay_egress_network, internal=False)
    container_host = (
        f"ssh://{values['AGENT_PODMAN_SSH_USER']}@{state.relay_container}:"
        f"{state.relay_port}/{values['SOCKET_PATH']}"
    )
    return [
        "--network", state.relay_link_network,
        "--env", f"CONTAINER_HOST={container_host}",
        "--env", f"CONTAINER_SSHKEY={values['CONTAINER_SSHKEY']}",
        "--env", f"AGENT_PODMAN_KNOWN_HOSTS={state.container_known_hosts}",
        "--mount", f"type=bind,src={state.agent_podman_key},dst={values['CONTAINER_SSHKEY']},readonly",
        "--mount", f"type=bind,src={state.agent_podman_known_hosts},dst={state.container_known_hosts},readonly",
    ]


def start_relay(state: State) -> None:
    values = state.agent_podman
    # A failed run may still create a container; cleanup owns the name either way.
    state.relay_container_created = True
    run([
        "docker", "run", "--detach", "--name", state.relay_container,
        "--cap-drop=ALL", "--security-opt=no-new-privileges", "--read-only",
        "--network", state.relay_egress_network,
        "--network", state.relay_link_network, *proxy_flags(),
        "--entrypoint", "/usr/bin/socat", state.sidecar_image, "-d", "-d",
        f"TCP4-LISTEN:{state.relay_port},fork,reuseaddr",
        f"TCP4:{OUTER_RUNTIME.host_address}:{values['AGENT_PODMAN_SSH_PORT']}",
    ], discard_stdout=True)


def prepare_editor_relay(state: State) -> list[str]:
    state.editor_link_created = True
    create_relay_network(state, state.editor_link_network, internal=True)
    state.editor_egress_created = True
    create_relay_network(state, state.editor_egress_network, internal=False)
    state.host_editor = HostEditorBridge()
    state.host_editor.start()
    return [
        "--network", state.editor_link_network,
        "--env", f"CODEX_SANDBOX_EDITOR_ADDRESS={state.editor_relay_container}:2223",
        *([] if isinstance(OUTER_RUNTIME, VMRuntime) else ["--env", "CODEX_SANDBOX_EDITOR_TOKEN"]),
    ]


def start_editor_relay(state: State) -> None:
    assert state.host_editor is not None
    assert state.host_editor.port is not None
    relay_port = 2223
    state.editor_relay_created = True
    run([
        "docker", "run", "--detach", "--name", state.editor_relay_container,
        "--cap-drop=ALL", "--security-opt=no-new-privileges", "--read-only",
        "--network", state.editor_egress_network,
        "--network", state.editor_link_network, *proxy_flags(),
        "--pids-limit", "32", "--memory", "64m", "--cpus", "0.25",
        *([] if isinstance(OUTER_RUNTIME, VMRuntime) else ["--add-host", "host.docker.internal:host-gateway"]),
        "--entrypoint", "/usr/bin/socat", state.sidecar_image, "-d", "-d",
        f"TCP4-LISTEN:{relay_port},fork,reuseaddr",
        f"TCP4:{OUTER_RUNTIME.host_address}:{state.host_editor.port}",
    ], discard_stdout=True)
    def address(network):
        if isinstance(OUTER_RUNTIME, VMRuntime):
            return OUTER_RUNTIME.network_address(state.editor_relay_container, network)
        return run(["docker", "inspect", "--format",
            f'{{{{(index .NetworkSettings.Networks "{network}").IPAddress}}}}',
            state.editor_relay_container], capture=True).stdout.strip()
    relay_ip = address(state.editor_link_network)
    egress_ip = address(state.editor_egress_network)
    if not relay_ip or not egress_ip:
        raise LauncherError("host editor relay has incomplete network addresses")
    state.host_editor.allow_peers({relay_ip, egress_ip, "127.0.0.1"})
    # Until this allowlist is installed, the listener rejects every connection.


def _secure_codex_auth_directory(state: State) -> Path | None:
    directory = state.codex_auth_directory
    auth = directory / "auth.json"
    if not auth.exists():
        return None
    directory_stat = directory.lstat()
    auth_stat = auth.lstat()
    if directory.is_symlink() or not directory.is_dir():
        raise LauncherError(f"Codex sandbox authentication directory is invalid: {directory}")
    if directory_stat.st_uid != state.uid or stat.S_IMODE(directory_stat.st_mode) != 0o700:
        raise LauncherError(f"Codex sandbox authentication directory must be owned by uid {state.uid} with mode 0700: {directory}")
    if auth.is_symlink() or not auth.is_file() or auth_stat.st_nlink != 1:
        raise LauncherError(f"Codex sandbox authentication must be an unlinked regular file: {auth}")
    if auth_stat.st_uid != state.uid or stat.S_IMODE(auth_stat.st_mode) != 0o600:
        raise LauncherError(f"Codex sandbox authentication must be owned by uid {state.uid} with mode 0600: {auth}")
    if any(character in str(directory.resolve()) for character in (",", "\n", "\r")):
        raise LauncherError("Codex sandbox authentication path contains a mount delimiter")
    return directory.resolve()


def _sidecar_session_key() -> str:
    def encoded(value: bytes) -> str:
        return base64.urlsafe_b64encode(value).decode().rstrip("=")
    header = encoded(b'{"alg":"none","typ":"JWT"}')
    payload = encoded(json.dumps({
        "https://api.openai.com/auth": {"chatgpt_account_id": "sandbox"},
        "sid": secrets.token_hex(16),
    }, separators=(",", ":")).encode())
    return f"{header}.{payload}.{encoded(secrets.token_bytes(24))}"


def codex_sidecar_arguments(container: str, key: str) -> list[str]:
    return [
        "--env", f"CODEX_SIDECAR_URL=http://{container}:8787",
        "--env", f"CODEX_SIDECAR_KEY={key}",
        "--mount", f"type=bind,src={DOTFILES / 'tools/codex-sandbox/auth-proxy/pi-extension'},dst=/home/codex/.pi/agent/extensions/codex-sidecar,readonly",
    ]


def codex_sidecar_has_sandbox_network(container: str) -> bool:
    if isinstance(OUTER_RUNTIME, VMRuntime):
        try:
            OUTER_RUNTIME.network_address(container, SANDBOX_NETWORK)
            return True
        except (ValueError, OSError, subprocess.SubprocessError):
            return False
    result = run([
        "docker", "inspect", "--format",
        f'{{{{if index .NetworkSettings.Networks "{SANDBOX_NETWORK}"}}}}true{{{{end}}}}',
        container,
    ], check=False, capture=True, quiet=True)
    return result.returncode == 0 and result.stdout.strip() == "true"


def stop_codex_sidecar(container: str) -> None:
    run(["docker", "kill", container], check=False, quiet=True)
    run(["docker", "rm", container], check=False, quiet=True)


def start_codex_sidecar(state: State, auth_directory: Path) -> tuple[dict[str, str], list[str]]:
    key = _sidecar_session_key()
    container = state.codex_sidecar_container
    run([
        "docker", "run", "--detach", "--name", container,
        "--cap-drop=ALL", "--security-opt=no-new-privileges", "--read-only",
        "--user", f"{state.uid}:{state.gid}", "--network", SANDBOX_NETWORK,
        *proxy_flags(), "--pids-limit", "64", "--memory", "256m",
        "--cpus", "1", "--ulimit", "nofile=256:256",
        "--tmpfs", "/tmp:rw,noexec,nosuid,nodev,size=4m,mode=1777",
        "--mount", f"type=bind,src={auth_directory},dst=/var/lib/codex-auth",
        "--env", f"CODEX_SIDECAR_KEY={key}",
        "--entrypoint", "/trusted/bin/codex-auth-proxy", state.sidecar_image,
    ], discard_stdout=True)
    try:
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            result = run([
                "docker", "exec", container, "/usr/local/bin/python3", "-c",
                "import socket; socket.create_connection(('127.0.0.1',8787),1).close()",
            ], check=False, quiet=True)
            if result.returncode == 0:
                sidecar = {"container": container, "key": key, "image": state.sidecar_image}
                return sidecar, codex_sidecar_arguments(container, key)
            status = run([
                "docker", "inspect", "--format", "{{.State.Running}}", container,
            ], check=False, capture=True, quiet=True)
            if status.returncode or status.stdout.strip() != "true":
                raise LauncherError("Codex authentication sidecar exited before becoming ready")
            time.sleep(0.1)
        raise LauncherError("Codex authentication sidecar did not become ready")
    except Exception:
        stop_codex_sidecar(container)
        raise


def attach_codex_sidecar(state: State, auth_directory: Path | None = None) -> list[str]:
    proxy_state = json.loads(state.proxy_state.read_text(encoding="utf-8"))
    sidecar = proxy_state.get("auth")
    if auth_directory is None:
        if sidecar is None:
            print(
                "Codex authentication sidecar disabled; run 'codex-sandbox auth login' to enable it.",
                file=sys.stderr,
            )
            return []
        raise LauncherError("active sandbox proxy session has authentication enabled")
    if sidecar is None:
        sidecar, arguments = start_codex_sidecar(state, auth_directory)
        proxy_state["auth"] = sidecar
        state.proxy_state.write_text(json.dumps(proxy_state, sort_keys=True), encoding="utf-8")
        return arguments
    if not isinstance(sidecar, dict) or set(sidecar) != {"container", "key", "image"} or not all(
        isinstance(sidecar[field], str) and sidecar[field]
        for field in ("container", "key", "image")
    ):
        raise LauncherError("active sandbox proxy session has invalid authentication state")
    if sidecar["image"] != state.sidecar_image:
        raise LauncherError("active sandbox proxy session has invalid authentication state")
    if not codex_sidecar_has_sandbox_network(sidecar["container"]):
        raise LauncherError(
            "cached authentication sidecar is absent or belongs to another sandbox "
            "network; stop the active sandbox session before retrying"
        )
    return codex_sidecar_arguments(sidecar["container"], sidecar["key"])


def stage_skills(state: State) -> None:
    state.skills_tmp = Path(tempfile.mkdtemp(dir=scratch_directory()))
    source = state.home / ".agents/skills"
    try:
        state.skills_source = source.resolve(strict=True)
    except OSError as error:
        raise LauncherError(f"Agent skills directory is invalid: {source}") from error
    if not state.skills_source.is_dir():
        raise LauncherError(f"Agent skills directory is invalid: {source}")
    config = state.skills_tmp / "config"
    config.mkdir()
    for name in (
        "shared-agents.md", "pi-AGENTS.md", "breq.md", "coordination-dialect.md",
        "pi.json", "pi-mcp.json", "pi-keybindings.json", "pi-codex-subagents.json",
    ):
        shutil.copy2(DOTFILES / "config" / name, config / name)
    settings_path = config / "pi.json"
    settings = json.loads(settings_path.read_text(encoding="utf-8"))
    settings["externalEditor"] = "/opt/agent-tools/bin/host-editor"
    settings_path.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
    instruction_includes = []
    repository_instructions = state.repository / ".agents/sandbox/AGENTS.md"
    if repository_instructions.is_file():
        instruction_includes.append(f"@{state.container_repository}/.agents/sandbox/AGENTS.md")
    home_instructions = state.home / ".agents/sandbox/AGENTS.md"
    if home_instructions.is_file():
        shutil.copytree(
            home_instructions.parent, state.skills_tmp / "sandbox",
            symlinks=False, ignore_dangling_symlinks=True,
        )
        instruction_includes.append("@../../.agents/sandbox/AGENTS.md")
    if instruction_includes:
        agents = config / "pi-AGENTS.md"
        content = agents.read_text(encoding="utf-8").rstrip("\n")
        agents.write_text(
            content + "\n" + "\n".join(instruction_includes) + "\n",
            encoding="utf-8",
        )


def finalize_proxy_session(state: State) -> list[str]:
    state.proxy_args = temporary_file()
    # A shared join validated an existing publication under its lifetime lock;
    # it must not rewrite that publication after releasing coordination.
    operation = 'agent-args' if state.lock_ready.read_text().strip() == 'shared' else 'finalize'
    helper(
        operation, "--repo", str(state.repository),
        "--container-repo", str(state.container_repository),
        "--state", str(state.proxy_state), "--output", str(state.proxy_args),
        "--manifest", str(state.manifest),
    )
    arguments: list[str] = []
    for line in state.proxy_args.read_text(encoding="utf-8").splitlines():
        arguments.insert(0, line)
    return arguments


MAX_EDITOR_DOCUMENT_BYTES = 1024 * 1024
MAX_EDITOR_MESSAGE_BYTES = MAX_EDITOR_DOCUMENT_BYTES * 6 + 4096
EDITOR_REQUEST_TIMEOUT_SECONDS = 5


class HostEditorBridge:
    """Own the narrow guest-to-host text editor boundary for one sandbox."""

    def __init__(self) -> None:
        self.token = secrets.token_hex(32)
        self.stop_event = threading.Event()
        self.listener: socket.socket | None = None
        self.thread: threading.Thread | None = None
        self.port: int | None = None
        self.panes: set[str] = set()
        self.panes_lock = threading.Lock()
        self.allowed_peers: set[str] = set()
        self.allowed_peers_lock = threading.Lock()
        self.target_pane = os.environ.get("TMUX_PANE")
        self.editor = (
            os.environ.get("CODEX_SANDBOX_HOST_EDITOR")
            or os.environ.get("VISUAL")
            or os.environ.get("EDITOR")
            or "vi"
        )

    def start(self) -> None:
        listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        # Docker Desktop and rootless Podman do not expose one portable host-only
        # bind address. Use an ephemeral port and authenticate every request with
        # the session token; the guest receives only the private relay address.
        listener.bind(("0.0.0.0", 0))
        listener.listen(1)
        listener.settimeout(0.2)
        self.listener = listener
        self.port = listener.getsockname()[1]
        self.thread = threading.Thread(target=self._serve, name="host-editor-bridge", daemon=True)
        self.thread.start()

    def allow_peers(self, peers: set[str]) -> None:
        with self.allowed_peers_lock:
            self.allowed_peers = set(peers)

    def stop(self) -> None:
        self.stop_event.set()
        if self.listener is not None:
            self.listener.close()
        if self.thread is not None:
            self.thread.join(timeout=2)
        with self.panes_lock:
            panes = list(self.panes)
        for pane in panes:
            run(["tmux", "kill-pane", "-t", pane], check=False, quiet=True)

    @staticmethod
    def _receive_exact(connection: socket.socket, length: int) -> bytes:
        chunks: list[bytes] = []
        remaining = length
        while remaining:
            chunk = connection.recv(remaining)
            if not chunk:
                raise LauncherError("host editor request ended prematurely")
            chunks.append(chunk)
            remaining -= len(chunk)
        return b"".join(chunks)

    @staticmethod
    def _send(connection: socket.socket, value: dict[str, object]) -> None:
        payload = json.dumps(value, separators=(",", ":")).encode("utf-8")
        if len(payload) > MAX_EDITOR_MESSAGE_BYTES:
            raise LauncherError("host editor response is too large")
        connection.sendall(struct.pack(">I", len(payload)) + payload)

    def _serve(self) -> None:
        assert self.listener is not None
        while not self.stop_event.is_set():
            try:
                connection, address = self.listener.accept()
            except TimeoutError:
                continue
            except OSError:
                return
            with self.allowed_peers_lock:
                allowed = address[0] in self.allowed_peers
            if not allowed:
                connection.close()
                continue
            with connection:
                connection.settimeout(EDITOR_REQUEST_TIMEOUT_SECONDS)
                self._serve_connection(connection)

    def _serve_connection(self, connection: socket.socket) -> None:
        try:
            length = struct.unpack(">I", self._receive_exact(connection, 4))[0]
            if length > MAX_EDITOR_MESSAGE_BYTES:
                raise LauncherError("host editor request is too large")
            request = json.loads(self._receive_exact(connection, length).decode("utf-8"))
            if not isinstance(request, dict) or set(request) != {"version", "token", "content"} \
                    or type(request["version"]) is not int or request["version"] != 1 \
                    or not isinstance(request["token"], str) \
                    or not secrets.compare_digest(request["token"], self.token) \
                    or not isinstance(request["content"], str):
                raise LauncherError("invalid host editor request")
            if len(request["content"].encode("utf-8")) > MAX_EDITOR_DOCUMENT_BYTES:
                raise LauncherError("host editor document is too large")
            self._send(connection, {"version": 1, "status": "editing"})
            connection.settimeout(None)
            content = self._edit(request["content"])
            response = {"version": 1, "status": "complete", "content": content}
        except (LauncherError, OSError, UnicodeError, json.JSONDecodeError) as error:
            response = {"version": 1, "status": "failed", "error": str(error)}
        try:
            self._send(connection, response)
        except (LauncherError, OSError):
            pass

    def _edit(self, content: str) -> str:
        if "TMUX" not in os.environ or self.target_pane is None:
            raise LauncherError("host editor bridge requires a tmux pane")
        try:
            editor = shlex.split(self.editor)
        except ValueError as error:
            raise LauncherError("host editor command is malformed") from error
        if not editor:
            raise LauncherError("host editor command is empty")
        with tempfile.TemporaryDirectory(prefix="codex-host-editor-document-") as directory:
            document = Path(directory) / "prompt.md"
            status = Path(directory) / "status"
            document.write_text(content, encoding="utf-8")
            pane_command = shlex.join([
                str(HOST_EDITOR_PANE), str(status), "--", *editor, str(document),
            ])
            result = run([
                "tmux", "split-window", "-h", "-t", self.target_pane,
                "-P", "-F", "#{pane_id}", pane_command,
            ], check=False, capture=True, quiet=True)
            if result.returncode or not result.stdout.strip():
                raise LauncherError("could not open host editor pane")
            pane = result.stdout.strip()
            with self.panes_lock:
                self.panes.add(pane)
            try:
                while not status.exists():
                    if self.stop_event.wait(0.1):
                        raise LauncherError("host editor bridge stopped")
                    alive = run([
                        "tmux", "display-message", "-p", "-t", pane, "#{pane_id}",
                    ], check=False, quiet=True)
                    if alive.returncode:
                        raise LauncherError("host editor pane exited without a result")
                try:
                    exit_status = int(status.read_text(encoding="utf-8").strip())
                except (OSError, ValueError) as error:
                    raise LauncherError("host editor returned an invalid status") from error
                if exit_status:
                    raise LauncherError(f"host editor exited with status {exit_status}")
                result_content = document.read_text(encoding="utf-8")
                if len(result_content.encode("utf-8")) > MAX_EDITOR_DOCUMENT_BYTES:
                    raise LauncherError("host editor result is too large")
                return result_content
            finally:
                if self.stop_event.is_set():
                    run(["tmux", "kill-pane", "-t", pane], check=False, quiet=True)
                    with self.panes_lock:
                        self.panes.discard(pane)
                else:
                    alive = run([
                        "tmux", "display-message", "-p", "-t", pane, "#{pane_id}",
                    ], check=False, quiet=True)
                    if alive.returncode:
                        with self.panes_lock:
                            self.panes.discard(pane)


def report_container_timing(state: State) -> None:
    # Use daemon timestamps together: the VM and host clocks may differ.
    # Diagnostics must neither replace the agent's exit status nor block cleanup.
    try:
        result = subprocess.run(
            ["docker", "inspect", "--format",
             "{{json .Created}}|{{json .State.StartedAt}}|{{json .State.FinishedAt}}",
             state.codex_container],
            capture_output=True, text=True, timeout=5, check=True,
        )
        timestamps = [json.loads(value) for value in result.stdout.strip().split("|")]
        if not all(isinstance(value, str) for value in timestamps):
            raise ValueError("container timestamps are not strings")
        created, started, finished = (
            datetime.fromisoformat(value.replace("Z", "+00:00")) for value in timestamps
        )
        if not created <= started <= finished:
            raise ValueError("container did not complete its lifecycle")
        print(
            f"Sandbox container: creation to start={(started - created).total_seconds():.2f}s, "
            f"start to exit={(finished - started).total_seconds():.2f}s",
            file=sys.stderr,
        )
    except (OSError, subprocess.SubprocessError, ValueError, TypeError):
        print("Sandbox container timing: unavailable", file=sys.stderr)


def wait_for_monitored_agent(state: State) -> int:
    while True:
        try:
            return state.agent_process.wait(timeout=0.1)
        except subprocess.TimeoutExpired:
            status = state.monitor_process.poll()
            if status is not None and status != 0:
                raise LauncherError("proxy supervision failed; terminating sandbox")


def run_agent(state: State, arguments: list[str]) -> int:
    setup_started = time.monotonic()
    timing = bool(os.environ.get("CODEX_SANDBOX_TIMING"))
    state.codex_container_created = True
    def start_monitor() -> None:
        state.monitor_process = subprocess.Popen([
            "python3", str(PROXY_HELPER), "monitor", "--state", str(state.proxy_state),
            "--agent", state.codex_container,
        ], stdin=subprocess.DEVNULL, start_new_session=OUTER_RUNTIME.provider == 'lima-docker')

    if not isinstance(OUTER_RUNTIME, VMRuntime):
        start_monitor()
    git_layout = run([
        "git", "-C", str(state.repository), "rev-parse", "--path-format=absolute",
        "--git-dir", "--git-common-dir",
    ], capture=True).stdout.splitlines()
    protected = [state.repository / ".git", state.repository / ".jj"]
    external_git_roots: list[tuple[Path, Path]] = []
    for line in git_layout:
        path = Path(line).resolve(strict=True)
        if any(character in str(path) for character in (",", "\n", "\r")):
            raise LauncherError("Git metadata path contains a container-mount delimiter")
        try:
            path.relative_to(state.repository)
        except ValueError:
            relative = Path(os.path.relpath(path, state.repository))
            target = Path(os.path.normpath(state.container_repository / relative))
            try:
                target.relative_to("/src")
            except ValueError as error:
                raise LauncherError("Git metadata path escapes the container workspace") from error
            if not any(path.is_relative_to(root) for root, _ in external_git_roots):
                external_git_roots = [
                    (root, root_target)
                    for root, root_target in external_git_roots
                    if not root.is_relative_to(path)
                ]
                external_git_roots.append((path, target))
            continue
        if path not in protected:
            protected.append(path)
    repository_aliases: list[Path] = []
    for source, relative_target in external_git_roots:
        for metadata_target in (source, relative_target):
            alias = Path(os.path.normpath(
                metadata_target / os.path.relpath(state.repository, source)
            ))
            if metadata_target == source:
                if alias != state.repository:
                    raise LauncherError("Git metadata produced an invalid host worktree alias")
            else:
                try:
                    alias.relative_to("/src")
                except ValueError as error:
                    raise LauncherError("Git metadata produced an unsafe worktree alias") from error
                if alias == Path("/src"):
                    raise LauncherError("Git metadata worktree alias is too broad")
            if alias != state.container_repository and alias not in repository_aliases:
                repository_aliases.append(alias)
    pi_agent = state.home / ".pi/agent"
    if pi_agent.exists() and (pi_agent.is_symlink() or not pi_agent.is_dir()):
        raise LauncherError(f"Pi agent directory is invalid: {pi_agent}")
    pi_agent.mkdir(mode=0o700, parents=True, exist_ok=True)
    sessions = pi_agent / "sessions"
    if sessions.exists() and (sessions.is_symlink() or not sessions.is_dir()):
        raise LauncherError(f"Pi sessions directory is invalid: {sessions}")
    sessions.mkdir(mode=0o700, parents=True, exist_ok=True)
    # Pi's /reload resolves configured packages, installing missing npm packages,
    # repairing version mismatches, and refreshing eligible Git sources. Keep these
    # package stores writable and persistent; all other undeclared agent state stays
    # private to the sandbox so extensions cannot accidentally share runtime data.
    persistent_package_directories = []
    for directory in (pi_agent / "npm", pi_agent / "git"):
        if directory.exists() and (directory.is_symlink() or not directory.is_dir()):
            raise LauncherError(f"Pi package directory is invalid: {directory}")
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        persistent_package_directories.append(directory)
    pi_extensions = DOTFILES / "config/pi-extensions"
    if not pi_extensions.is_dir():
        raise LauncherError(f"Pi extensions directory is missing: {pi_extensions}")
    state.pi_agent_tmp = Path(tempfile.mkdtemp(prefix="codex-private-agent-", dir=scratch_directory()))
    os.chmod(state.pi_agent_tmp, 0o700)
    # Offline Pi needs the host's refreshed catalog. Copy it so guest updates
    # remain private and disappear with the rest of this sandbox's runtime state.
    model_catalog = pi_agent / "models-store.json"
    if model_catalog.exists():
        shutil.copyfile(model_catalog, state.pi_agent_tmp / model_catalog.name)
    for directory in ("extensions", "pi-codex-subagents"):
        (state.pi_agent_tmp / directory).mkdir(mode=0o700)
    state.pi_auth_mask = temporary_file()
    state.pi_auth_mask.write_text("{}\n", encoding="utf-8")

    command = [
        "docker", "run", "--name", state.codex_container, "-it",
        "--cap-drop=NET_RAW",
        "--network", SANDBOX_NETWORK, *proxy_flags(),
        *(["--mount", f"type=bind,src={state.github_credential},dst=/run/secrets/github-token,readonly",
           "--entrypoint", "/opt/agent-tools/bin/with-github-token"] if isinstance(OUTER_RUNTIME, VMRuntime)
          else ["--secret", "codex-github-token,type=env,target=GH_TOKEN"]),
        "--env", "JJ_AGENT=pi",
        *(["--env", "PI_TIMING=1"] if timing else []),
        "--mount", f"type=bind,src={state.pi_agent_tmp},dst=/home/codex/.pi/agent",
        "--mount", f"type=bind,src={sessions},dst=/home/codex/.pi/agent/sessions",
        *[
            item
            for directory in persistent_package_directories
            for item in (
                "--mount",
                f"type=bind,src={directory},dst=/home/codex/.pi/agent/{directory.name}",
            )
        ],
        "--mount", f"type=bind,src={state.pi_auth_mask},dst=/home/codex/.pi/agent/auth.json,readonly",
        "--mount", f"type=bind,src={state.skills_source},dst=/home/codex/.agents/skills",
        *(
            ["--mount", f"type=bind,src={state.skills_tmp / 'sandbox'},dst=/home/codex/.agents/sandbox,readonly"]
            if (state.skills_tmp / "sandbox").is_dir() else []
        ),
        "--mount", f"type=bind,src={state.skills_tmp / 'config/shared-agents.md'},dst=/home/codex/.agents/shared.md,readonly",
        "--mount", f"type=bind,src={state.skills_tmp / 'config/coordination-dialect.md'},dst=/home/codex/.agents/coordination-dialect.md,readonly",
        "--mount", f"type=bind,src={state.skills_tmp / 'config/pi-AGENTS.md'},dst=/home/codex/.pi/agent/AGENTS.md,readonly",
        "--mount", f"type=bind,src={state.skills_tmp / 'config/breq.md'},dst=/home/codex/.pi/agent/breq.md,readonly",
        "--mount", f"type=bind,src={state.skills_tmp / 'config/coordination-dialect.md'},dst=/home/codex/.pi/agent/coordination-dialect.md,readonly",
        "--mount", f"type=bind,src={state.skills_tmp / 'config/pi.json'},dst=/home/codex/.pi/agent/settings.json,readonly",
        "--mount", f"type=bind,src={state.skills_tmp / 'config/pi-mcp.json'},dst=/home/codex/.pi/agent/mcp.json,readonly",
        "--mount", f"type=bind,src={state.skills_tmp / 'config/pi-keybindings.json'},dst=/home/codex/.pi/agent/keybindings.json,readonly",
        "--mount", f"type=bind,src={state.skills_tmp / 'config/pi-codex-subagents.json'},dst=/home/codex/.pi/agent/pi-codex-subagents/config.json,readonly",
        "--mount", f"type=bind,src={pi_extensions},dst=/home/codex/.pi/agent/pi-extensions,readonly",
        "--mount", f"type=bind,src={state.home / '.codex/config.toml'},dst=/home/codex/.codex/config.toml,readonly",
        "--mount", f"type=bind,src={DOTFILES / 'config/codex.toml'},dst=/home/codex/.codex/dotfiles.config.toml,readonly",
        "--mount", f"type=bind,src={DOTFILES / 'config/codex-developer-instructions.md'},dst=/home/codex/.codex/developer-instructions.md,readonly",
        "--mount", f"type=bind,src={DOTFILES / 'config/breq.md'},dst=/home/codex/.codex/breq.md,readonly",
        *source_mounts(state.home / 'src', [state.container_repository, *repository_aliases,
                       *[target for _, target in external_git_roots]], state.skills_tmp / 'source-view'),
        "--mount", f"type=bind,src={state.repository},dst={state.container_repository},{OUTER_RUNTIME.nonrecursive_bind}",
        "--workdir", str(state.container_working_directory),
        *[
            item
            for target in repository_aliases
            for item in (
                "--mount",
                f"type=bind,src={state.repository},dst={target},readonly,{OUTER_RUNTIME.nonrecursive_bind}",
            )
        ],
        *[
            item
            for path in protected
            for item in (
                "--mount",
                f"type=bind,src={path},dst={state.container_repository / path.relative_to(state.repository)},readonly",
            )
        ],
        *[
            item
            for path, relative_target in external_git_roots
            for target in (path, relative_target)
            for item in (
                "--mount",
                f"type=bind,src={path},dst={target},readonly",
            )
        ],
        *arguments,
    ]
    agent_environment = os.environ.copy()
    assert state.host_editor is not None
    agent_environment["CODEX_SANDBOX_EDITOR_TOKEN"] = state.host_editor.token
    if timing:
        print(
            f"Sandbox launch setup: {time.monotonic() - setup_started:.2f}s; "
            f"starting docker run ({state.codex_container})",
            file=sys.stderr,
        )
    launch_started = time.monotonic()
    if isinstance(OUTER_RUNTIME, VMRuntime):
        image_index = command.index(state.image)
        # Keep create and attach under the runtime's existing producer ownership.
        # The session key may persist with this container; the GitHub token may not.
        # Create first so lost supervision can remove an existing container.
        with OUTER_RUNTIME.environment_file({"CODEX_SANDBOX_EDITOR_TOKEN": state.host_editor.token}) as environment:
            with OUTER_RUNTIME.workload(OUTER_RUNTIME.inspect_image(state.image), state.codex_container,
                    ["--interactive", "--tty", *command[5:image_index], *environment],
                    command[image_index + 1:], before_start=start_monitor) as process:
                state.agent_process = process
                result = wait_for_monitored_agent(state)
            state.codex_container_created = False
        return result
    state.agent_process = OUTER_RUNTIME.popen(command[1:], env=agent_environment)
    try:
        return state.agent_process.wait()
    except SignalExit as error:
        if state.agent_process.poll() is None:
            state.agent_process.send_signal(error.signum)
            try:
                state.agent_process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                state.agent_process.kill()
                state.agent_process.wait()
        raise
    finally:
        if timing:
            print(f"Sandbox docker run: {time.monotonic() - launch_started:.2f}s", file=sys.stderr)
            report_container_timing(state)


@contextmanager
def startup_workers(state: State, max_workers: int) -> Iterator[ThreadPoolExecutor]:
    executor = ThreadPoolExecutor(max_workers=max_workers)
    try:
        yield executor
    finally:
        # Signal handlers must not unwind cleanup while a worker creates resources.
        state.joining_workers = True
        try:
            executor.shutdown(wait=True)
        finally:
            state.joining_workers = False
        if state.deferred_signal is not None:
            raise SignalExit(state.deferred_signal)


def execute(state: State) -> int:
    started = time.monotonic()
    timings: list[tuple[str, float]] = []

    def phase(name: str, action: Callable[[], object]) -> object:
        phase_started = time.monotonic()
        try:
            return action()
        finally:
            timings.append((name, time.monotonic() - phase_started))

    phase("repository validation", lambda: validate_repository(state))
    if (OUTER_RUNTIME.provider != 'lima-docker' and
            (state.repository / '.agents/sandbox/bake').is_file() and
            not (state.repository / '.agents/sandbox/base-image').is_file()):
        raise LauncherError('repository uses Bake images; select CODEX_SANDBOX_RUNTIME=lima-docker')
    phase("skill staging", lambda: stage_skills(state))
    if isinstance(OUTER_RUNTIME, VMRuntime):
        phase("Lima share preflight", lambda: preflight_lima(state))
        state.github_credential = phase("GitHub boot credential", lambda: boot_credential(OUTER_RUNTIME))
    register_tmux_pane(state)
    def model_image() -> str:
        builder = state.repository / ".agents/sandbox/base-image"
        if builder.is_file() and os.access(builder, os.X_OK):
            base_image = phase(
                "base image resolution",
                lambda: run([str(builder)], capture=True, cwd=state.repository, builder=True).stdout.strip(),
            )
            if isinstance(OUTER_RUNTIME, VMRuntime):
                base_image = OUTER_RUNTIME.builder_image(base_image)
        else:
            base_image = "node:24-alpine3.22"
        return phase("model image resolution", lambda: ensure_image(state, base_image))

    prepared = OUTER_RUNTIME.provider == 'lima-docker'
    if prepared:
        # Supervise independent builders together on the signal-owning thread;
        # no container workers start until cancellation has no builds to drain.
        manifest = json.loads(state.manifest.read_text())
        base = state.repository / '.agents/sandbox/base-image'
        builders = {'auth': ([str(DOTFILES / 'tools/codex-sandbox/auth-proxy/image')], DOTFILES)}
        targets = ['base'] if (state.repository / '.agents/sandbox/bake').is_file() else []
        if base.is_file() and not targets:
            raise LauncherError('Lima-Docker requires .agents/sandbox/bake instead of executable base-image builds')
        for name, command in manifest['commands'].items():
            if command.get('image-target'):
                targets.append(command['image-target'])
            elif command.get('image-command'):
                builders['proxy:' + name] = (command['image-command'], state.repository)
            else:
                raise LauncherError(f'proxy {name} requires image-target for lima-docker')
        baked = phase('Bake image resolution', lambda: OUTER_RUNTIME.bake(state.repository, targets))
        built = phase('image builders', lambda: OUTER_RUNTIME.run_builders(builders))
        base_image = baked.get('base', 'node:24-alpine3.22')
        state.image = phase('model image resolution', lambda: ensure_image(state, base_image))

    def optional_relay(name: str, action: Callable[[], object]) -> None:
        try:
            phase(name, action)
        except Exception as error:
            print(f"warning: {name} failed: {error}", file=sys.stderr)

    # Keep these jobs owned until session exit so cleanup cannot race creation.
    with startup_workers(state, max_workers=6) as executor:
        model_future = executor.submit(lambda: state.image if prepared else model_image())
        sidecar_future = executor.submit(phase, "sidecar image resolution",
            lambda: OUTER_RUNTIME.builder_image(built['auth'].stdout.strip()) if prepared else resolve_sidecar_image())
        # Docker builds have finished. Read-only image checks overlap network
        # preparation, but attach must wait for their immutable references.
        images_future = executor.submit(phase, 'proxy image resolution',
            lambda: proxy_module().resolve_images(state.repository, manifest,
                builder_results={name: built['proxy:' + name] for name, command in manifest['commands'].items()
                                 if not command.get('image-target')}, baked_images=baked)) if prepared else None
        network_future = executor.submit(phase, "network setup", ensure_network)
        lock_future = executor.submit(phase, "proxy lock", lambda: acquire_lock(state))
        editor_future = executor.submit(
            phase, "host editor network setup", lambda: prepare_editor_relay(state),
        )
        relay_future = (
            executor.submit(phase, "Podman network setup", lambda: prepare_relay(state))
            if state.agent_podman is not None else None
        )
        state.sidecar_image = sidecar_future.result()
        network_future.result()
        lock_future.result()
        if images_future is not None:
            images = images_future.result()
            state.prepared_images = temporary_file()
            state.prepared_images.write_text(json.dumps(images))
        proxy_future = executor.submit(
            phase, "proxy startup", lambda: attach_proxies(state),
        )
        editor_arguments = editor_future.result()
        executor.submit(optional_relay, "host editor relay startup", lambda: start_editor_relay(state))
        relay_arguments = relay_future.result() if relay_future else []
        if relay_future:
            executor.submit(optional_relay, "Podman relay startup", lambda: start_relay(state))
        sidecar_arguments = proxy_future.result()
        state.image = model_future.result()
        arguments = [*editor_arguments, *relay_arguments, state.image,
            *(OUTER_RUNTIME.agent_command(state.image, state.codex_arguments)
              if isinstance(OUTER_RUNTIME, VMRuntime) else state.codex_arguments)]
        system = run(["uname", "-s"], capture=True).stdout.strip()
        if system == "Linux":
            print(
                "warning: native Linux sandboxing disables sudo elevation with cap-drop=ALL and no-new-privileges.\n"
                "warning: a Podman Machine micro-VM would allow container sudo without weakening host isolation.",
                file=sys.stderr,
            )
            arguments = ["--cap-drop=ALL", "--security-opt=no-new-privileges", *arguments]
        arguments = [*sidecar_arguments, *arguments]
        if os.environ.get("CODEX_SANDBOX_TIMING"):
            detail = ", ".join(f"{name}={elapsed:.2f}s" for name, elapsed in timings)
            print(f"Sandbox preparation: {time.monotonic() - started:.2f}s ({detail})", file=sys.stderr)
        return run_agent(state, arguments)


def preflight_lima(state: State) -> None:
    # Check sources before builds or container/network creation. Container
    # overlays still determine which parts of a shared source the agent sees.
    writable = [state.repository, state.skills_source, *state.metadata_roots]
    pi_agent = state.home / ".pi/agent"
    for name in ("sessions", "npm", "git"):
        directory = pi_agent / name
        if directory.is_symlink() or (directory.exists() and not directory.is_dir()):
            raise LauncherError(f"Pi persistent directory is invalid: {directory}")
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        writable.append(directory)
    readable = [state.home / "src", DOTFILES, state.skills_tmp,
                state.home / ".codex/config.toml"]
    if state.zuliprc is not None:
        readable.append(state.zuliprc)
    if _secure_codex_auth_directory(state) is not None:
        writable.append(state.codex_auth_directory)
    if state.agent_podman is not None:
        readable += [state.agent_podman_key, state.agent_podman_known_hosts]
    home = state.home.resolve(strict=True)
    for path in [*writable, *readable]:
        if home.is_relative_to(path.resolve(strict=True)):
            raise LauncherError(f"refusing to mount the whole home directory into a container: {path}")
    OUTER_RUNTIME.host.check_binds([
        *((path, True) for path in writable), *((path, False) for path in readable)])


def cleanup_resource(label: str, arguments: list[str]) -> bool:
    started = time.monotonic()
    try:
        result = run(arguments, check=False, quiet=True)
    except (OSError, ValueError):
        result = None
    elapsed = int(time.monotonic() - started)
    if result is None or result.returncode:
        print(f"warning: Cleaning up {label} failed after {elapsed}s.", file=sys.stderr)
    elif elapsed:
        print(f"Cleaning up {label}: done ({elapsed}s).", file=sys.stderr)
    return result is not None and result.returncode == 0


def cleanup(state: State) -> None:
    if state.cleaned:
        return
    state.cleaned = True
    cleanup_started = time.monotonic()
    previous = cleanup_started

    def timing(label: str) -> None:
        nonlocal previous
        now = time.monotonic()
        if os.environ.get("CODEX_SANDBOX_TIMING"):
            print(f"Sandbox cleanup: {label}={now - previous:.2f}s", file=sys.stderr)
        previous = now
    if state.host_editor is not None:
        state.host_editor.stop()
    timing("host editor")
    containers = []
    if state.codex_container_created:
        containers.append((
            f"Codex container {state.codex_container}",
            ["docker", "rm", "--force", state.codex_container],
        ))
    if state.relay_container_created:
        containers.append((
            f"relay container {state.relay_container}",
            ["docker", "rm", "--force", state.relay_container],
        ))
    if state.editor_relay_created:
        containers.append((
            f"host editor relay container {state.editor_relay_container}",
            ["docker", "rm", "--force", state.editor_relay_container],
        ))
    with ThreadPoolExecutor(max_workers=max(1, len(containers))) as executor:
        container_results = list(executor.map(lambda item: cleanup_resource(*item), containers))
    timing("containers")

    networks = []
    if state.relay_link_created:
        networks.append((
            f"relay network {state.relay_link_network}",
            ["docker", "network", "rm", state.relay_link_network],
        ))
    if state.relay_egress_created:
        networks.append((
            f"relay network {state.relay_egress_network}",
            ["docker", "network", "rm", state.relay_egress_network],
        ))
    if state.editor_link_created:
        networks.append((
            f"host editor link network {state.editor_link_network}",
            ["docker", "network", "rm", state.editor_link_network],
        ))
    if state.editor_egress_created:
        networks.append((
            f"host editor egress network {state.editor_egress_network}",
            ["docker", "network", "rm", state.editor_egress_network],
        ))
    def remove_network(item):
        if isinstance(OUTER_RUNTIME, VMRuntime):
            try:
                existing = OUTER_RUNTIME.run(["network", "ls", "--format", "{{.Name}}"],
                                             capture_output=True).stdout.splitlines()
                if item[1][-1] not in existing:
                    return True
                if OUTER_RUNTIME.relay_owner(item[1][-1]) != state.resource_owner:
                    raise LauncherError("relay network belongs to another creator")
            except (LauncherError, ValueError, OSError, subprocess.SubprocessError) as error:
                print(f"warning: {item[0]} retained: {error}", file=sys.stderr)
                return False
        return cleanup_resource(*item)

    with ThreadPoolExecutor(max_workers=max(1, len(networks))) as executor:
        network_results = list(executor.map(remove_network, networks))
    keep_scratch = isinstance(OUTER_RUNTIME, VMRuntime) and not all([*container_results, *network_results])
    if keep_scratch:
        state.recovery_record = temporary_file()
        recovery = {"runtime": runtime_identity(OUTER_RUNTIME),
            "owner": state.resource_owner, "containers": [item[1][-1] for item in containers],
            "networks": [item[1][-1] for item in networks],
            "skills": str(state.skills_tmp), "agent-state": str(state.pi_agent_tmp),
            "shared-state": str(state.proxy_state)}
        state.recovery_record.write_text(json.dumps(recovery))
        print(f"Lima cleanup incomplete; recovery state retained at {state.recovery_record}", file=sys.stderr)
        if state.monitor_process is not None and state.monitor_process.poll() is None:
            state.monitor_process.terminate()
    timing("networks")
    if state.skills_tmp is not None and not keep_scratch:
        removal_started = time.monotonic()
        try:
            shutil.rmtree(state.skills_tmp)
        except OSError:
            elapsed = int(time.monotonic() - removal_started)
            print(f"warning: Cleaning up staged skills {state.skills_tmp} failed after {elapsed}s.", file=sys.stderr)
    timing("skills")
    if state.pi_agent_tmp is not None and not keep_scratch:
        removal_started = time.monotonic()
        try:
            shutil.rmtree(state.pi_agent_tmp)
        except OSError:
            elapsed = int(time.monotonic() - removal_started)
            print(f"warning: Cleaning up private Pi state {state.pi_agent_tmp} failed after {elapsed}s.", file=sys.stderr)
    timing("Pi state")
    if state.lock_coordinated is not None:
        state.lock_coordinated.touch()
    if state.lock_release is not None:
        state.lock_release.touch()
    processes = [
        (name, process)
        for name, process in (("proxy lock", state.lock_process), ("proxy monitor", state.monitor_process))
        if process is not None
    ]

    def wait_process(item: tuple[str, subprocess.Popen[bytes]]) -> None:
        name, process = item
        process_started = time.monotonic()
        if (name == 'proxy monitor' and OUTER_RUNTIME.provider == 'lima-docker' and
                process.poll() in (None, -signal.SIGKILL)):
            # The Docker API waits are host children. Reap their entire owned
            # group even if SIGKILL prevented the monitor's finally block.
            try:
                os.killpg(process.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                process.wait(timeout=10)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait(timeout=5)
        else:
            process.wait()
        if os.environ.get("CODEX_SANDBOX_TIMING"):
            print(f"Sandbox cleanup: {name}={time.monotonic() - process_started:.2f}s", file=sys.stderr)

    with ThreadPoolExecutor(max_workers=max(1, len(processes))) as executor:
        list(executor.map(wait_process, processes))
    timing("proxy processes")
    for path in (
        state.proxy_state, state.proxy_args, state.manifest, state.pi_auth_mask, state.prepared_images,
        state.lock_ready, state.lock_coordinated, state.lock_release,
    ):
        if path is not None and not keep_scratch:
            path.unlink(missing_ok=True)
    timing("temporary files")
    if os.environ.get("CODEX_SANDBOX_TIMING"):
        print(f"Sandbox cleanup total: {time.monotonic() - cleanup_started:.2f}s", file=sys.stderr)


def login_codex_sidecar() -> int:
    home = Path(os.environ["HOME"])
    directory = Path(os.environ.get("CODEX_SANDBOX_AUTH_DIR", home / ".codex-sandbox-auth"))
    if directory.exists() and (directory.is_symlink() or not directory.is_dir()):
        raise LauncherError(f"Codex sandbox authentication directory is invalid: {directory}")
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(directory, 0o700)
    environment = os.environ.copy()
    environment["CODEX_HOME"] = str(directory)
    return subprocess.run(["codex", "login"], env=environment).returncode


def tmux_registrations() -> list[dict[str, object]]:
    result = run([
        "tmux", "list-panes", "-a", "-F",
        "#{pane_dead}\t#{pane_pid}\t#{@codex_sandbox_restart}",
    ], capture=True)
    registrations = []
    for line in result.stdout.splitlines():
        fields = line.split("\t", 2)
        if len(fields) != 3 or not fields[2]:
            continue
        dead_text, pid_text, encoded = fields
        try:
            payload = json.loads(base64.urlsafe_b64decode(encoded).decode())
            pid = int(pid_text) if pid_text else None
        except (ValueError, UnicodeError, json.JSONDecodeError) as error:
            raise LauncherError("tmux contains an invalid sandbox restart registration") from error
        dead = dead_text == "1"
        if dead_text not in {"0", "1"} or (not dead and (pid is None or pid <= 1)) \
                or not isinstance(payload, dict) or set(payload) != {
            "version", "pane", "repository", "session", "token",
        } or payload["version"] != 1 or not all(
            isinstance(payload[field], str) and payload[field]
            for field in ("pane", "repository", "session", "token")
        ):
            raise LauncherError("tmux contains an invalid sandbox restart registration")
        registrations.append({**payload, "dead": dead, "pid": pid})
    return registrations


def restart_all_tmux_sessions() -> int:
    if "TMUX" not in os.environ:
        raise LauncherError("restart-all must run inside tmux")
    registrations = tmux_registrations()
    if not registrations:
        raise LauncherError("tmux has no registered sandbox sessions")
    for registration in registrations:
        remain_on_exit = run([
            "tmux", "show-options", "-A", "-p", "-v", "-t", registration["pane"],
            "remain-on-exit",
        ], capture=True).stdout.strip()
        if remain_on_exit not in {"0", "1", "off", "on"}:
            raise LauncherError("tmux returned an invalid remain-on-exit setting")
        registration["remain_on_exit"] = remain_on_exit
        run([
            "tmux", "set-option", "-p", "-t", registration["pane"],
            "remain-on-exit", "on",
        ])
        if not registration["dead"]:
            os.kill(registration["pid"], signal.SIGTERM)
    panes = {registration["pane"] for registration in registrations}
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        active = {
            registration["pane"]
            for registration in tmux_registrations()
            if not registration["dead"]
        }
        if not panes.intersection(active):
            break
        time.sleep(0.1)
    else:
        raise LauncherError("sandbox panes did not stop within 15 seconds")
    for repository in sorted({str(item["repository"]) for item in registrations}):
        helper("reset", "--repo", repository)
    for registration in registrations:
        command = (
            shlex.join(["cd", registration["repository"]])
            + " && "
            + shlex.join(["pi", "--session", registration["session"]])
        )
        run(["tmux", "respawn-pane", "-k", "-t", registration["pane"], command])
        run([
            "tmux", "set-option", "-p", "-t", registration["pane"],
            "remain-on-exit", registration["remain_on_exit"],
        ])
    message = f"Restarted {len(registrations)} sandbox session(s)."
    run(["tmux", "display-message", "-d", "5000", message], check=False, quiet=True)
    print(message)
    return 0


def main(arguments: list[str]) -> int:
    with verification_scope():
        return launch(arguments)


def launch(arguments: list[str]) -> int:
    global OUTER_RUNTIME
    if arguments == ["restart-all"]:
        try:
            return restart_all_tmux_sessions()
        except (LauncherError, OSError, subprocess.CalledProcessError) as error:
            message = f"Sandbox restart failed: {error}"
            if "TMUX" in os.environ:
                try:
                    run([
                        "tmux", "display-message", "-d", "8000", message,
                    ], check=False, quiet=True)
                except OSError:
                    pass
            print(f"error: {error}", file=sys.stderr)
            return 1
    if arguments == ["auth", "login"]:
        try:
            return login_codex_sidecar()
        except (LauncherError, OSError) as error:
            print(f"error: {error}", file=sys.stderr)
            return 1
    state: State | None = None
    previous_handlers: dict[int, object] = {}

    def handle_signal(signum: int, _frame: object) -> None:
        if state is not None and state.joining_workers:
            state.deferred_signal = signum
            return
        raise SignalExit(signum)

    try:
        OUTER_RUNTIME = image_runtime(os.environ.get("CODEX_SANDBOX_RUNTIME", "podman"))
        proxy_module.cache_clear()
        state = new_state(arguments)
        for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
            previous_handlers[signum] = signal.signal(signum, handle_signal)
        result = execute(state)
        return result
    except SignalExit as error:
        return 128 + error.signum
    except (LauncherError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as error:
        diagnostic = error.stderr
        if isinstance(diagnostic, bytes):
            diagnostic = diagnostic.decode(errors='replace')
        print(diagnostic.rstrip() if diagnostic else f'error: {error}', file=sys.stderr)
        return error.returncode
    except OSError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    finally:
        for signum in previous_handlers:
            signal.signal(signum, signal.SIG_IGN)
        if state is not None:
            cleanup(state)
            unregister_tmux_pane(state)
        for signum, handler in previous_handlers.items():
            signal.signal(signum, handler)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
