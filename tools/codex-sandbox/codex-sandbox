def parse_connection(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        if not separator or not re.fullmatch(r"[A-Z][A-Z0-9_]*", key):
            raise LauncherError(f"invalid Agent Podman connection setting: {line!r}")
        values[key] = value
    required = {
        "AGENT_PODMAN_SSH_USER", "AGENT_PODMAN_SSH_PORT",
        "CONTAINER_HOST", "CONTAINER_SSHKEY",
    }
    if not required <= values.keys():
        raise LauncherError("Agent Podman connection settings are incomplete")
    return values


def resumable_arguments(arguments: list[str]) -> tuple[list[str], str | None]:
    if not arguments:
        session_id = str(uuid.uuid4())
        return ["--session-id", session_id], session_id
    if len(arguments) == 2 and arguments[0] == "--session" and arguments[1]:
        return arguments, arguments[1]
    if arguments.count("--session-id") == 1:
        index = arguments.index("--session-id")
        if index + 1 < len(arguments) and arguments[index + 1]:
            return arguments, arguments[index + 1]
    return arguments, None


def session_header(path: Path) -> tuple[str, Path]:
    try:
        with path.open("rb") as stream:
            line = stream.readline(1024 * 1024 + 1)
        if len(line) > 1024 * 1024:
            raise ValueError("session header is too large")
        header = json.loads(line)
        if not isinstance(header, dict) or header.get("type") != "session" \
                or not isinstance(header.get("id"), str) or not header["id"] \
                or not isinstance(header.get("cwd"), str) or not header["cwd"]:
            raise ValueError("session header is invalid")
        return header["id"], Path(header["cwd"]).expanduser().resolve()
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as error:
        raise LauncherError(f"Cannot inspect Pi session {path}: {error}") from error


def prepare_host_session(state: State) -> None:
    arguments = state.codex_arguments
    selected_cwd = state.host_working_directory.resolve()
    session_dir = os.environ.get("PI_CODING_AGENT_SESSION_DIR")
    if arguments.count("--session-dir") == 1:
        directory_index = arguments.index("--session-dir")
        if directory_index + 1 < len(arguments):
            session_dir = arguments[directory_index + 1]
    sessions = Path(session_dir).expanduser() if session_dir else state.home / ".pi/agent/sessions"
    if not sessions.is_absolute():
        sessions = selected_cwd / sessions
    for flag in ("--session", "--session-id"):
        if arguments.count(flag) != 1:
            continue
        index = arguments.index(flag)
        if index + 1 >= len(arguments):
            return
        value = arguments[index + 1]
        source = None
        if flag == "--session":
            if "/" not in value and "\\" not in value and not value.endswith(".jsonl"):
                candidates = []
                for path in sessions.rglob("*.jsonl"):
                    if not path.stem.rsplit("_", 1)[-1].startswith(value):
                        continue
                    try:
                        candidates.append((path, *session_header(path)))
                    except LauncherError:
                        continue
                matching = [(path, session_id, cwd) for path, session_id, cwd in candidates
                            if session_id.startswith(value)]
                matching.sort(key=lambda item: (item[2] != selected_cwd,
                                                item[1] != value, str(item[0])))
                source = matching[0][0] if matching else None
            else:
                source = Path(value).expanduser()
                if not source.is_absolute():
                    source = state.host_working_directory / source
                if not source.is_file():
                    return  # Let Pi report its normal missing-session error.
        else:
            if sessions.is_dir():
                candidates = []
                for path in sessions.rglob("*.jsonl"):
                    if not path.name.endswith(f"_{value}.jsonl"):
                        continue
                    try:
                        if session_header(path)[0] == value:
                            candidates.append(path)
                    except LauncherError:
                        continue
                matching = [path for path in candidates
                            if session_header(path)[1] == selected_cwd]
                if matching:
                    return
                if len(candidates) > 1:
                    raise LauncherError(f"Session ID {value} exists in multiple directories")
                source = candidates[0] if candidates else None
        if source is not None and session_header(source)[1] != selected_cwd:
            state.codex_arguments = [*arguments[:index], "--fork", str(source.resolve()),
                                     "--session-id", str(uuid.uuid4()), *arguments[index + 2:]]
        return


def new_state(codex_arguments: list[str]) -> State:
    codex_arguments, _ = resumable_arguments(codex_arguments)
    home = Path(os.environ["HOME"])
    uid = os.getuid()
    suffix = f"{uid}-{secrets.token_hex(6)}"
    access = Path(os.environ.get("AGENT_PODMAN_ACCESS_DIR", home / ".agent-podman-access"))
    state = State(
        codex_arguments=codex_arguments,
        home=home,
        term=os.environ.get("TERM", "xterm-256color"),
        uid=uid,
        gid=os.getgid(),
        suffix=suffix,
        gateway_link_network=f"codex-gateway-link-{suffix}",
        gateway_egress_network=f"codex-gateway-egress-{suffix}",
        gateway_container=f"codex-gateway-{suffix}",
        codex_container=f"codex-sandbox-{suffix}",
        proxy_prefix=f"codex-command-proxy-{suffix}",
        codex_sidecar_container=f"codex-auth-proxy-{suffix}",
        codex_auth_directory=Path(os.environ.get(
            "CODEX_SANDBOX_AUTH_DIR", home / ".codex-sandbox-auth",
        )),
        agent_podman_access=access,
        agent_podman_connection=access / "connection.env",
        agent_podman_key=access / "id_ed25519",
        agent_podman_known_hosts=access / "known_hosts.sandbox",
        host_working_directory=Path.cwd().resolve(strict=True),
    )
    return state


def load_agent_podman(state: State) -> None:
    paths = (
        state.agent_podman_connection, state.agent_podman_key,
        state.agent_podman_known_hosts,
    )
    if not any(path.exists() for path in paths):
        return
    if not all(path.is_file() for path in paths):
        raise LauncherError(f"Agent Podman access state is incomplete: {state.agent_podman_access}")
    values = parse_connection(state.agent_podman_connection)
    prefix = (
        f"ssh://{values['AGENT_PODMAN_SSH_USER']}@host.docker.internal:"
        f"{values['AGENT_PODMAN_SSH_PORT']}/"
    )
    host = values["CONTAINER_HOST"]
    if not host.startswith(prefix):
        raise LauncherError("Agent Podman connection does not use the expected host endpoint")
    values["SOCKET_PATH"] = host.removeprefix(prefix)
    state.agent_podman = values


def register_tmux_pane(state: State) -> None:
    pane = os.environ.get("TMUX_PANE")
    _, session_id = resumable_arguments(state.codex_arguments)
    if pane is None or session_id is None:
        return
    registration = base64.urlsafe_b64encode(json.dumps({
        "version": 1,
        "pane": pane,
        "repository": str(state.repository),
        "session": session_id,
        "token": secrets.token_hex(16),
    }, separators=(",", ":"), sort_keys=True).encode()).decode()
    run([
        "tmux", "set-option", "-p", "-t", pane,
        "@codex_sandbox_restart", registration,
    ], quiet=True)
    run([
        "tmux", "set-option", "-p", "-t", pane,
        "@codex_sandbox_command", "π",
    ], quiet=True)
    state.tmux_pane = pane
    state.tmux_registration = registration


def unregister_tmux_pane(state: State) -> None:
    if state.tmux_pane is None or state.tmux_registration is None:
        return
    current = run([
        "tmux", "show-option", "-p", "-v", "-t", state.tmux_pane,
        "@codex_sandbox_restart",
    ], check=False, capture=True, quiet=True)
    if current.returncode == 0 and current.stdout.strip() == state.tmux_registration:
        run([
            "tmux", "set-option", "-p", "-u", "-t", state.tmux_pane,
            "@codex_sandbox_restart",
        ], check=False, quiet=True)
        run([
            "tmux", "set-option", "-p", "-u", "-t", state.tmux_pane,
            "@codex_sandbox_command",
        ], check=False, quiet=True)


def container_repository_path(home: Path, repository: Path) -> Path:
    source_root = (home / "src").resolve(strict=True)
    try:
        relative = repository.relative_to(source_root)
    except ValueError:
        return Path("/src/repository")
    if relative == Path("."):
        return Path("/src/repository")
    return Path("/src") / relative


def container_working_directory_path(
    repository: Path, container_repository: Path, working_directory: Path,
) -> Path:
    try:
        relative = working_directory.relative_to(repository)
    except ValueError as error:
        raise LauncherError("The launch directory is outside the repository workspace") from error
    return container_repository / relative


def validate_repository(state: State, *, initialize_missing: bool = True) -> None:
    try:
        # Finding the mount root needs metadata, not a working-tree snapshot.
        result = run(["jj", "workspace", "root", "--ignore-working-copy"], capture=True)
    except subprocess.CalledProcessError:
        if not initialize_missing:
            raise LauncherError("The destination is not an existing Jujutsu workspace")
        try:
            run(["jj", "git", "init"])
            result = run(["jj", "workspace", "root", "--ignore-working-copy"], capture=True)
        except subprocess.CalledProcessError as error:
            raise LauncherError("The current directory could not be initialized as a Jujutsu workspace") from error
    repository = Path(result.stdout.strip()).resolve(strict=True)
    jj = repository / ".jj"
    if not jj.is_dir() or jj.is_symlink():
        raise LauncherError("The Jujutsu workspace root cannot be safely mounted")
    try:
        result = run(["jj", "git", "root", "--ignore-working-copy"], capture=True)
        git_repository = Path(result.stdout.strip()).resolve(strict=True)
        if not git_repository.is_dir() or git_repository.is_symlink():
            raise LauncherError("Git metadata is missing or invalid")
        result = run([
            "git", "-C", str(git_repository), "rev-parse", "--path-format=absolute",
            "--git-dir", "--git-common-dir",
        ], capture=True)
        lines = result.stdout.splitlines()
        if len(lines) != 2:
            raise LauncherError("Git returned an invalid metadata layout")
        git_roots = [Path(line).resolve(strict=True) for line in lines]
        git_mount_source = git_roots[0]
    except (subprocess.CalledProcessError, FileNotFoundError) as error:
        raise LauncherError("Git metadata indirection cannot be resolved safely") from error
    try:
        jj_repo_entry = jj / "repo"
        if jj_repo_entry.is_file() and not jj_repo_entry.is_symlink():
            if jj_repo_entry.lstat().st_nlink != 1:
                raise LauncherError("Jujutsu repository pointer must not be hard linked")
            value = jj_repo_entry.read_text(encoding="utf-8").strip()
            if not value or "\0" in value or "\n" in value or "\r" in value:
                raise LauncherError("Jujutsu repository pointer is invalid")
            target = Path(value)
            if not target.is_absolute():
                target = jj_repo_entry.parent / target
            jj_repo = target.resolve(strict=True)
        else:
            jj_repo = jj_repo_entry.resolve(strict=True)
    except (FileNotFoundError, UnicodeError) as error:
        raise LauncherError("Jujutsu repository metadata cannot be resolved safely") from error
    for root in (jj, jj_repo, *git_roots):
        if not root.is_dir() or root.is_symlink():
            raise LauncherError(f"Repository metadata directory is invalid: {root}")
    state.repository = repository
    state.git_repository = git_repository
    state.git_mount_source = git_roots[0]
    state.metadata_roots = (jj, jj_repo, *git_roots)
    proxy_module().use_repository_metadata(repository, tuple(git_roots))
    state.container_repository = container_repository_path(state.home, repository)
    state.container_working_directory = container_working_directory_path(
        repository, state.container_repository, state.host_working_directory,
    )


def load_repository_policy(state: State) -> None:
    state.manifest = temporary_file()
    snapshot_arguments = [
        "snapshot", "--repo", str(state.repository), "--output", str(state.manifest),
        "--jj-image-command", str(DOTFILES / ".agents/sandbox/jj-proxy-image"),
    ]
    zuliprc = Path(os.environ.get("CODEX_SANDBOX_ZULIPRC", state.home / ".zuliprc"))
    if zuliprc.exists() or zuliprc.is_symlink():
        state.zuliprc = zuliprc
        snapshot_arguments += [
            "--zulip-image-command", str(DOTFILES / ".agents/sandbox/zulip-proxy-image"),
            "--zuliprc", str(zuliprc),
        ]
    state.policy_source_present = (
        state.repository / ".agents" / "sandbox" / "proxy-commands.json"
    ).is_file() or (
        state.repository / ".agents" / "sandbox" / "docker-bake.hcl"
    ).is_file()
    helper(*snapshot_arguments)
    snapshot = json.loads(state.manifest.read_text(encoding="utf-8"))
    if "zulip" not in snapshot["commands"]:
        state.zuliprc = None
    state.capabilities = frozenset(
        name for name, selected in snapshot.get("capabilities", {}).items() if selected
    )
    if "nested-containers" in state.capabilities:
        load_agent_podman(state)


def resolve_sidecar_image() -> str:
    builder = DOTFILES / "tools/codex-sandbox/auth-proxy/image"
    result = run([str(builder)], capture=True, cwd=DOTFILES, builder=True)
    output = result.stdout.strip()
    return OUTER_RUNTIME.builder_image(output)


def ensure_network() -> None:
    try:
        OUTER_RUNTIME.ensure_public_network()
    except subprocess.CalledProcessError as error:
        detail = error.stderr or ''
        if isinstance(detail, bytes):
            detail = detail.decode(errors='replace')
        message = f"Sandbox network setup failed (exit {error.returncode})"
        if detail.strip():
            message += ': ' + detail.strip()
        raise LauncherError(message) from error


def acquire_lock(state: State) -> None:
    state.proxy_state = temporary_file()
    state.proxy_lock = SessionLock(proxy_module().runtime_directory(state.repository))


def load_accepted_session(state: State) -> None:
    state.manifest = temporary_file()
    state.prepared_images = temporary_file()
    accepted = temporary_file()
    try:
        helper(
            "join", "--repo", str(state.repository),
            "--container-repo", str(state.container_repository),
            "--state", str(state.proxy_state), "--manifest", str(state.manifest),
            "--images", str(state.prepared_images), "--accepted", str(accepted),
            "--uid", str(state.uid), "--gid", str(state.gid),
        )
        policy = json.loads(state.manifest.read_text(encoding="utf-8"))
        values = json.loads(accepted.read_text(encoding="utf-8"))
    finally:
        accepted.unlink(missing_ok=True)
    state.capabilities = frozenset(
        name for name, selected in policy.get("capabilities", {}).items() if selected
    )
    state.policy_source_present = values["source-present"]
    state.image = values["agent-image"]
    state.sidecar_image = values["helper-image"] or ""
    if "nested-containers" in state.capabilities:
        load_agent_podman(state)


def attach_proxies(state: State) -> list[str]:
    arguments = [
        "attach", "--repo", str(state.repository),
        "--container-repo", str(state.container_repository),
        "--prefix", state.proxy_prefix,
        *(["--shared"] if state.proxy_lock.shared else []),
        "--state", str(state.proxy_state),
        *(["--helper-image", state.sidecar_image] if state.sidecar_image else []),
        "--network", SANDBOX_NETWORK, "--manifest", str(state.manifest),
        "--agent-image", state.image, "--uid", str(state.uid), "--gid", str(state.gid),
        *(["--source-present"] if state.policy_source_present else []),
    ]
    if state.zuliprc is not None:
        arguments += ["--zuliprc", str(state.zuliprc)]
    if state.prepared_images is not None:
        arguments += ['--images', str(state.prepared_images)]
    auth_directory = _secure_codex_auth_directory(state)
    if auth_directory is not None:
        arguments.append("--auth-enabled")
    helper(*arguments)
    sidecar_arguments = attach_codex_sidecar(state, auth_directory)
    result = [*sidecar_arguments, *finalize_proxy_session(state)]
    state.proxy_lock.release_coordination()
    return result


class GatewayHandle:
    """Sole owner of one launch's staged, best-effort gateway resources."""

    def __init__(self, state: State, editor: bool, nested: bool, agent_room: bool = False) -> None:
        self.state = state
        self.editor = editor
        self.nested = nested
        self.agent_room = agent_room
        self.owner = uuid.uuid4().hex
        self.registry = ResourceRegistry(self.owner)
        self.resources = RelayResourcePlan(
            state.gateway_link_network, state.gateway_egress_network, state.gateway_container,
        )
        self.cancelled = threading.Event()
        self.bridge: HostEditorBridge | None = None
        self.agent_room_bridge: FixedTcpBridge | None = None
        self._logical: set[str] = set()
        self.created: set[str] = set()

    def presence(self, identity: str, inspect: Callable[[], ResourcePresence]) -> ResourcePresence:
        return ResourcePresence.OWNED if identity in self.created else inspect()

    def _register_logical(self, identity: str, *, depends_on: tuple[str, ...] = (),
                          remove: Callable[[], None] = lambda: None) -> None:
        self._logical.add(identity)
        self.registry.register(OwnedResource(
            identity, self.owner,
            lambda identity=identity: (ResourcePresence.OWNED if identity in self._logical
                                       else ResourcePresence.ABSENT),
            lambda identity=identity, remove=remove: (remove(), self._logical.discard(identity)),
            depends_on,
        ))

    def cleanup(self, primary_status: int = 0):
        self.cancelled.set()
        return self.registry.cleanup(primary_status)


def _gateway_network_presence(name: str, owner: str) -> ResourcePresence:
    return resource_presence(
        OUTER_RUNTIME, ResourceKind.NETWORK, name, owner,
        authority=ResourceOwnerAuthority.RELAY,
    )


def _gateway_container_presence(name: str, owner: str) -> ResourcePresence:
    return resource_presence(OUTER_RUNTIME, ResourceKind.CONTAINER, name, owner)


def _relay_recovery_directory(state: State) -> Path:
    return state.home / ".local/state/codex-sandbox/gateway-recovery"


def _relay_recovery_dirfd(state: State, *, create: bool) -> int | None:
    """Open the private recovery directory without following any path component."""
    flags = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(state.home, flags)
    try:
        for component in (".local", "state", "codex-sandbox", "gateway-recovery"):
            try:
                child = os.open(component, flags, dir_fd=fd)
            except FileNotFoundError:
                if not create:
                    return None
                os.mkdir(component, 0o700, dir_fd=fd)
                child = os.open(component, flags, dir_fd=fd)
            status = os.fstat(child)
            if (not stat.S_ISDIR(status.st_mode) or status.st_uid != os.getuid()
                    or (component == "gateway-recovery"
                        and stat.S_IMODE(status.st_mode) != 0o700)):
                os.close(child)
                raise LauncherError("gateway recovery path is not a private directory")
            os.close(fd)
            fd = child
        result, fd = fd, -1
        return result
    finally:
        if fd >= 0:
            os.close(fd)


def persist_relay_recovery(state: State, plan: RelayResourcePlan, owner: str,
                           remaining: tuple[str, ...]) -> Path | None:
    resources = plan.recovery_resources(remaining, owner)
    if not resources:
        return None
    directory = _relay_recovery_directory(state)
    dirfd = _relay_recovery_dirfd(state, create=True)
    assert dirfd is not None
    name = f"{owner}.json"
    temporary = f".{owner}.{secrets.token_hex(8)}.tmp"
    payload = {"version": 1, "runtime": runtime_identity(OUTER_RUNTIME),
               "owner": owner, "resources": resources}
    try:
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL
                             | getattr(os, "O_NOFOLLOW", 0), 0o600, dir_fd=dirfd)
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            json.dump(payload, output, sort_keys=True)
            output.flush()
            os.fsync(output.fileno())
        os.rename(temporary, name, src_dir_fd=dirfd, dst_dir_fd=dirfd)
        os.fsync(dirfd)
    finally:
        try:
            os.unlink(temporary, dir_fd=dirfd)
        except FileNotFoundError:
            pass
        os.close(dirfd)
    return directory / name


def _parse_relay_recovery(data: bytes) -> tuple[str, list[dict[str, object]]]:
    value = json.loads(data)
    if (not isinstance(value, dict) or set(value) != {"version", "runtime", "owner", "resources"}
            or isinstance(value.get("version"), bool) or value.get("version") != 1
            or value.get("runtime") != runtime_identity(OUTER_RUNTIME)
            or not isinstance(value.get("owner"), str)
            or not isinstance(value.get("resources"), list) or len(value["resources"]) > 4):
        raise LauncherError("invalid gateway recovery record")
    owner = value["owner"]
    parsed: list[dict[str, object]] = []
    identities: set[tuple[str, str]] = set()
    for item in value["resources"]:
        if (not isinstance(item, dict) or set(item) != {"kind", "name", "owner", "dependencies"}
                or item.get("owner") != owner or item.get("kind") not in {"network", "container"}
                or not isinstance(item.get("name"), str) or not item["name"]
                or not isinstance(item.get("dependencies"), list)
                or any(not isinstance(dependency, str) or not dependency
                       for dependency in item["dependencies"])
                or len(set(item["dependencies"])) != len(item["dependencies"])):
            raise LauncherError("invalid gateway recovery resource")
        identity = (item["kind"], item["name"])
        if identity in identities:
            raise LauncherError("duplicate gateway recovery resource")
        identities.add(identity)
        parsed.append(item)
    for item in parsed:
        if item["kind"] == "network" and item["dependencies"]:
            raise LauncherError("network recovery resource has dependencies")
        if any(("network", dependency) not in identities for dependency in item["dependencies"]):
            raise LauncherError("missing gateway recovery dependency")
    return owner, parsed


def recover_relays(state: State) -> None:
    if not hasattr(state, "home"):
        return
    try:
        dirfd = _relay_recovery_dirfd(state, create=False)
    except (OSError, LauncherError) as error:
        print(f"warning: gateway recovery directory retained: {error}", file=sys.stderr)
        return
    if dirfd is None:
        return
    try:
        names = sorted(name for name in os.listdir(dirfd) if name.endswith(".json"))[:64]
        for name in names:
            try:
                descriptor = os.open(name, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0), dir_fd=dirfd)
                with os.fdopen(descriptor, "rb") as source:
                    status = os.fstat(source.fileno())
                    if (not stat.S_ISREG(status.st_mode) or status.st_uid != os.getuid()
                            or stat.S_IMODE(status.st_mode) != 0o600 or status.st_size > 16384):
                        raise LauncherError("gateway recovery record is not a private regular file")
                    owner, resources = _parse_relay_recovery(source.read(16385))
                registry = ResourceRegistry(owner)
                for item in sorted(resources, key=lambda item: item["kind"] == "container"):
                    name_value = item["name"]
                    dependencies = tuple(f"network:{dependency}" for dependency in item["dependencies"])
                    if item["kind"] == "network":
                        registry.register(OwnedResource(
                            f"network:{name_value}", owner,
                            lambda name_value=name_value: _gateway_network_presence(name_value, owner),
                            lambda name_value=name_value: remove_owned_resource(
                                OUTER_RUNTIME, ResourceKind.NETWORK, name_value, owner,
                                authority=ResourceOwnerAuthority.RELAY)))
                    else:
                        registry.register(OwnedResource(
                            f"container:{name_value}", owner,
                            lambda name_value=name_value: _gateway_container_presence(name_value, owner),
                            lambda name_value=name_value: remove_owned_resource(
                                OUTER_RUNTIME, ResourceKind.CONTAINER, name_value, owner), dependencies))
                if registry.cleanup(0).remaining:
                    raise LauncherError("gateway resources retained")
            except (OSError, TypeError, ValueError, json.JSONDecodeError,
                    LifecycleError, LauncherError) as error:
                print(f"warning: gateway recovery retained {name}: {error}", file=sys.stderr)
            else:
                os.unlink(name, dir_fd=dirfd)
                os.fsync(dirfd)
    finally:
        os.close(dirfd)


def prepare_gateway(state: State) -> list[str]:
    capabilities = getattr(state, "capabilities", frozenset({"host-editor", "nested-containers"}))
    editor = "host-editor" in capabilities
    nested = "nested-containers" in capabilities and state.agent_podman is not None
    agent_room = "agent-room" in capabilities
    if not editor and not nested and not agent_room:
        return []
    handle = GatewayHandle(state, editor, nested, agent_room)
    state.gateway_handle = handle
    for name, internal in ((state.gateway_link_network, True),
                           (state.gateway_egress_network, False)):
        identity = f"network:{name}"
        handle.registry.register(OwnedResource(
            identity, handle.owner,
            lambda name=name, identity=identity: handle.presence(
                identity, lambda: _gateway_network_presence(name, handle.owner)),
            lambda name=name: remove_owned_resource(
                OUTER_RUNTIME, ResourceKind.NETWORK, name, handle.owner,
                authority=ResourceOwnerAuthority.RELAY),
        ))
        if handle.cancelled.is_set():
            raise LauncherError("gateway startup cancelled")
        create_relay_network(state, name, internal=internal, owner=handle.owner)
        handle.created.add(identity)
    if editor:
        handle.bridge = HostEditorBridge()
        handle._register_logical("bridge:host-editor", remove=handle.bridge.stop)
        handle.bridge.start()
    if agent_room:
        handle.agent_room_bridge = FixedTcpBridge(("127.0.0.1", 3000))
        handle._register_logical("bridge:agent-room", remove=handle.agent_room_bridge.stop)
        handle.agent_room_bridge.start()
    arguments = [
        "--network", state.gateway_link_network,
        *(["--env", f"CODEX_SANDBOX_EDITOR_ADDRESS={state.gateway_container}:2223"] if editor else []),
        *(["--env", f"CODEX_SANDBOX_AGENT_ROOM_ADDRESS={state.gateway_container}:2225"]
          if agent_room else []),
        *([] if isinstance(OUTER_RUNTIME, VMRuntime) or not editor else
          ["--env", "CODEX_SANDBOX_EDITOR_TOKEN"]),
    ]
    if nested:
        values = state.agent_podman
        arguments += [
            "--env", f"CONTAINER_HOST=ssh://{values['AGENT_PODMAN_SSH_USER']}@{state.gateway_container}:2222/{values['SOCKET_PATH']}",
            "--env", f"CONTAINER_SSHKEY={values['CONTAINER_SSHKEY']}",
            "--env", f"AGENT_PODMAN_KNOWN_HOSTS={state.container_known_hosts}",
            "--mount", f"type=bind,src={state.agent_podman_key},dst={values['CONTAINER_SSHKEY']},readonly",
            "--mount", f"type=bind,src={state.agent_podman_known_hosts},dst={state.container_known_hosts},readonly",
        ]
    return arguments


def start_gateway(state: State) -> None:
    handle = state.gateway_handle
    if handle is None:
        raise LauncherError("gateway was not prepared")
    editor_port = handle.bridge.port if handle.bridge is not None else None
    podman_port = ((state.agent_podman or {}).get("AGENT_PODMAN_SSH_PORT")
                   if handle.nested else None)
    agent_room_port = (handle.agent_room_bridge.port
                       if handle.agent_room_bridge is not None else None)
    if editor_port is None and podman_port is None and agent_room_port is None:
        raise LauncherError("gateway requires at least one selected listener")
    container_resource = f"container:{state.gateway_container}"
    handle.registry.register(OwnedResource(
        container_resource, handle.owner,
        lambda: handle.presence(container_resource, lambda: _gateway_container_presence(
            state.gateway_container, handle.owner)),
        lambda: remove_owned_resource(
            OUTER_RUNTIME, ResourceKind.CONTAINER, state.gateway_container, handle.owner),
        handle.resources.bound_topology()[container_resource],
    ))
    if handle.cancelled.is_set():
        raise LauncherError("gateway startup cancelled")
    run([
        "docker", "run", "--detach", "--name", state.gateway_container,
        "--label", f"dev.codex.service-owner={handle.owner}",
        "--cap-drop=ALL", "--security-opt=no-new-privileges", "--read-only",
        "--network", state.gateway_egress_network,
        "--network", state.gateway_link_network, *proxy_flags(),
        # Preserve the editor-only limits without throttling Podman build traffic.
        *([] if podman_port is not None else
          ["--pids-limit", "32", "--memory", "64m", "--cpus", "0.25"]),
        *([] if isinstance(OUTER_RUNTIME, VMRuntime) else ["--add-host", "host.docker.internal:host-gateway"]),
        "--entrypoint", "/trusted/bin/sandbox-gateway", state.sidecar_image,
        "--host", OUTER_RUNTIME.host_address,
        *(["--editor-port", str(editor_port)] if editor_port is not None else []),
        *(["--podman-port", podman_port] if podman_port is not None else []),
        *(["--agent-room-port", str(agent_room_port)] if agent_room_port is not None else []),
    ], discard_stdout=True)
    handle.created.add(container_resource)
    def address(network):
        if isinstance(OUTER_RUNTIME, VMRuntime):
            return OUTER_RUNTIME.network_address(state.gateway_container, network)
        return run(["docker", "inspect", "--format",
            f'{{{{(index .NetworkSettings.Networks "{network}").IPAddress}}}}',
            state.gateway_container], capture=True).stdout.strip()
    relay_ip = address(state.gateway_link_network)
    egress_ip = address(state.gateway_egress_network)
    if not relay_ip or not egress_ip:
        raise LauncherError("gateway has incomplete network addresses")
    address_resources = []
    for kind, value in (("relay", relay_ip), ("egress", egress_ip)):
        identity = f"address:{kind}-{value.replace('.', '-').replace(':', '-')}"
        handle._register_logical(identity, depends_on=(container_resource,))
        address_resources.append(identity)
    if handle.cancelled.is_set():
        raise LauncherError("gateway startup cancelled")
    if handle.bridge is not None:
        allowlist = "allowlist:host-editor"
        handle._register_logical(allowlist,
            depends_on=("bridge:host-editor", *address_resources))
        handle.bridge.allow_peers({relay_ip, egress_ip, "127.0.0.1"})
    if handle.agent_room_bridge is not None:
        allowlist = "allowlist:agent-room"
        handle._register_logical(allowlist,
            depends_on=("bridge:agent-room", *address_resources))
        handle.agent_room_bridge.allow_peers({relay_ip, egress_ip, "127.0.0.1"})
    # Until this allowlist is installed, the listener rejects every connection.


class KeychainHandle:
    """Sole lifecycle owner for one launch's best-effort R2 relay."""

    def __init__(self, state: State, link: str, egress: str, container: str) -> None:
        self.state, self.link, self.egress, self.container = state, link, egress, container
        self.owner = uuid.uuid4().hex
        self.registry = ResourceRegistry(self.owner)
        self.resources = RelayResourcePlan(link, egress, container)
        self.cancelled = threading.Event()
        self.bridge: HostKeychainBridge | None = None
        self.projected = False

    def cleanup(self, primary_status: int = 0):
        self.cancelled.set()
        return self.registry.cleanup(primary_status)


def start_keychain(state: State) -> list[str]:
    """Project the fixed R2 endpoint only after peer authorization is installed."""
    if sys.platform != 'darwin' or not Path('/usr/bin/security').is_file():
        return []
    link = f'codex-keychain-link-{state.suffix}'
    egress = f'codex-keychain-egress-{state.suffix}'
    container = f'codex-keychain-{state.suffix}'
    handle = KeychainHandle(state, link, egress, container)
    state.keychain_handle = handle
    try:
        def create_network(name: str, internal: bool) -> None:
            identity = f"network:{name}"
            handle.registry.register(OwnedResource(
                identity, handle.owner,
                lambda name=name: _gateway_network_presence(name, handle.owner),
                lambda name=name: remove_owned_resource(
                    OUTER_RUNTIME, ResourceKind.NETWORK, name, handle.owner,
                    authority=ResourceOwnerAuthority.RELAY)))
            if handle.cancelled.is_set():
                raise LauncherError('Keychain relay startup cancelled')
            create_relay_network(state, name, internal=internal, owner=handle.owner)

        # Register in each worker before creation and join both workers on every exit.
        with ThreadPoolExecutor(max_workers=2) as executor:
            networks = [executor.submit(create_network, name, internal)
                        for name, internal in ((link, True), (egress, False))]
            for network in networks:
                network.result()
        container_resource = f'container:{container}'
        handle.registry.register(OwnedResource(
            container_resource, handle.owner,
            lambda: _gateway_container_presence(container, handle.owner),
            lambda: remove_owned_resource(
                OUTER_RUNTIME, ResourceKind.CONTAINER, container, handle.owner),
            handle.resources.bound_topology()[container_resource]))
        bridge = handle.bridge = HostKeychainBridge()
        # The bridge depends on the relay so cleanup closes admission and joins
        # any prompt worker before removing the relay process.
        handle.registry.register(OwnedResource(
            'bridge:keychain', handle.owner,
            lambda: ResourcePresence.OWNED if handle.bridge is not None else ResourcePresence.ABSENT,
            bridge.stop, (container_resource,)))
        if handle.cancelled.is_set():
            raise LauncherError('Keychain relay startup cancelled')
        bridge.start()
        if handle.cancelled.is_set():
            raise LauncherError('Keychain relay startup cancelled')
        run([
            'docker', 'run', '--detach', '--name', container,
            '--label', f'dev.codex.service-owner={handle.owner}',
            '--cap-drop=ALL', '--security-opt=no-new-privileges', '--read-only',
            '--pids-limit', '32', '--memory', '64m', '--cpus', '0.25',
            '--network', egress, '--network', link, *proxy_flags(),
            *([] if isinstance(OUTER_RUNTIME, VMRuntime) else
              ['--add-host', 'host.docker.internal:host-gateway']),
            '--entrypoint', '/usr/bin/socat', state.sidecar_image,
            '-T', '260', 'TCP4-LISTEN:2224,fork,reuseaddr',
            f'TCP4:{OUTER_RUNTIME.host_address}:{bridge.port}',
        ], discard_stdout=True)
        peers = set()
        link_address = None
        for network in (link, egress):
            address = (OUTER_RUNTIME.network_address(container, network)
                       if isinstance(OUTER_RUNTIME, VMRuntime) else
                       run(['docker', 'inspect', '--format',
                            f'{{{{(index .NetworkSettings.Networks "{network}").IPAddress}}}}',
                           container], capture=True).stdout.strip())
            if not address:
                raise LauncherError('Keychain relay has incomplete network addresses')
            peers.add(address)
            if network == link:
                link_address = address
        if handle.cancelled.is_set():
            raise LauncherError('Keychain relay startup cancelled')
        # Token creation is bridge-local and per launch; authorization precedes projection.
        bridge.allow_peers(peers | {'127.0.0.1'})
        handle.projected = True
        return ['--network', link, '--env', f'CODEX_SANDBOX_KEYCHAIN_ADDRESS={link_address}:2224',
                *([] if isinstance(OUTER_RUNTIME, VMRuntime) else
                  ['--env', 'CODEX_SANDBOX_KEYCHAIN_TOKEN'])]
    except (OSError, ValueError, LauncherError, LifecycleError, subprocess.SubprocessError):
        # Close resource creation immediately. The supervisor remains the sole
        # shutdown owner and joins the bridge during normal cleanup.
        handle.cancelled.set()
        print('warning: Keychain relay unavailable', file=sys.stderr)
        return []


def _secure_codex_auth_directory(state: State) -> Path | None:
    directory = state.codex_auth_directory
    auth = directory / "auth.json"
    if not auth.exists():
        return None
    directory_stat = directory.lstat()
    auth_stat = auth.lstat()
    if directory.is_symlink() or not directory.is_dir():
        raise LauncherError(f"Codex sandbox authentication directory is invalid: {directory}")
    if directory_stat.st_uid != state.uid or stat.S_IMODE(directory_stat.st_mode) != 0o700:
        raise LauncherError(f"Codex sandbox authentication directory must be owned by uid {state.uid} with mode 0700: {directory}")
    if auth.is_symlink() or not auth.is_file() or auth_stat.st_nlink != 1:
        raise LauncherError(f"Codex sandbox authentication must be an unlinked regular file: {auth}")
    if auth_stat.st_uid != state.uid or stat.S_IMODE(auth_stat.st_mode) != 0o600:
        raise LauncherError(f"Codex sandbox authentication must be owned by uid {state.uid} with mode 0600: {auth}")
    if any(character in str(directory.resolve()) for character in (",", "\n", "\r")):
        raise LauncherError("Codex sandbox authentication path contains a mount delimiter")
    return directory.resolve()


def _persist_proxy_state(path: Path, state: dict[str, object]) -> None:
    proxy_module().write_atomic(path, json.dumps(state, sort_keys=True))


def _sidecar_session_key() -> str:
    def encoded(value: bytes) -> str:
        return base64.urlsafe_b64encode(value).decode().rstrip("=")
    header = encoded(b'{"alg":"none","typ":"JWT"}')
    payload = encoded(json.dumps({
        "https://api.openai.com/auth": {"chatgpt_account_id": "sandbox"},
        "sid": secrets.token_hex(16),
    }, separators=(",", ":")).encode())
    return f"{header}.{payload}.{encoded(secrets.token_bytes(24))}"


class CodexBrokerHandle:
    """The sole lifecycle and cleanup owner while a broker is unpublished."""

    def __init__(self, lifecycle: ServiceLifecycle, registry: ResourceRegistry,
                 record: dict[str, object]) -> None:
        self.lifecycle = lifecycle
        self.registry = registry
        self.record = record

    def schema3_record(self) -> dict[str, object]:
        return dict(self.record)

    def cleanup(self) -> None:
        self.lifecycle.transition(LifecycleState.STOPPING)
        self.record["lifecycle-state"] = "stopping"
        result = self.registry.cleanup(0)
        if result.remaining:
            self.lifecycle.transition(LifecycleState.CLEANUP_FAILED)
            self.record["lifecycle-state"] = "cleanup-failed"
            raise LauncherError("Codex broker cleanup failed; recovery authority retained")
        self.lifecycle.transition(LifecycleState.REMOVED)
        self.record["lifecycle-state"] = "removed"
        self.record["resource-status"] = {
            name: "removed" for name in self.record["resource-status"]
        }


def codex_sidecar_arguments(container: str, key: str) -> list[str]:
    return [
        "--env", f"CODEX_SIDECAR_URL=http://{container}:8787",
        "--env", f"CODEX_SIDECAR_KEY={key}",
        "--mount", f"type=bind,src={DOTFILES / 'tools/codex-sandbox/auth-proxy/pi-extension'},dst=/home/codex/.pi/agent/extensions/codex-sidecar,readonly",
    ]


def codex_sidecar_has_sandbox_network(container: str) -> bool:
    if isinstance(OUTER_RUNTIME, VMRuntime):
        try:
            OUTER_RUNTIME.network_address(container, SANDBOX_NETWORK)
            return True
        except (ValueError, OSError, subprocess.SubprocessError):
            return False
    result = run([
        "docker", "inspect", "--format",
        f'{{{{if index .NetworkSettings.Networks "{SANDBOX_NETWORK}"}}}}true{{{{end}}}}',
        container,
    ], check=False, capture=True, quiet=True)
    return result.returncode == 0 and result.stdout.strip() == "true"


def _codex_container_presence(container: str, owner: str) -> ResourcePresence:
    return resource_presence(OUTER_RUNTIME, ResourceKind.CONTAINER, container, owner)


def _remove_codex_container(container: str, owner: str) -> None:
    remove_owned_resource(OUTER_RUNTIME, ResourceKind.CONTAINER, container, owner)


def start_codex_sidecar(state: State, auth_directory: Path, *,
                        cancelled: threading.Event | None = None) -> tuple[CodexBrokerHandle, list[str]]:
    """Create one Caddy/profile-helper pair and durably own every resource."""
    # Cancellation owns the operation before resolver pulls, runtime inspection,
    # configuration publication, or any other externally visible work.
    if cancelled is not None and cancelled.is_set():
        raise LauncherError("Codex broker startup cancelled")
    key = _sidecar_session_key()
    caddy = state.codex_sidecar_container
    helper_container = caddy + "-helper"
    socket_volume = caddy + "-socket"
    application_network = caddy + "-application"
    refresh_network = caddy + "-refresh"
    owner = uuid.uuid4().hex
    helper_plan = resolved_plan(DOTFILES / "tools/codex-sandbox/auth-proxy",
                                state.sidecar_image, state.uid, state.gid)
    caddy_identity = resolve_caddy_image(OUTER_RUNTIME)
    configuration_bytes = generate_caddy_config(
        "codex", "chatgpt.com", token=key)
    configuration_path = state.proxy_state.parent / (caddy + ".json")
    configuration_digest = caddy_configuration_digest(configuration_bytes)
    pair_plan = EgressPairPlan(
        domain=CREDENTIAL_DOMAIN, service_owner=owner, caddy_name=caddy,
        helper_name=helper_container, socket_volume=socket_volume,
        configuration_path=configuration_path, configuration=configuration_bytes,
        caddy_image=caddy_identity, helper_image=state.sidecar_image,
        uid=state.uid, gid=state.gid,
        application_network=application_network, helper_network=refresh_network,
        public_networks=(("application-network", "application", application_network),
                         ("refresh-network", "refresh", refresh_network)),
        helper_mounts=(f"type=bind,src={auth_directory},dst=/var/lib/codex-auth",),
        helper_environment=(f"CADDY_PROFILE_TOKEN={key}",),
        helper_arguments=("--profile", "codex"),
        runtime_flags=tuple(proxy_flags()),
        extra_caddy_networks=(SANDBOX_NETWORK,),
    )
    implementation = pair_plan.implementation_identity(helper_plan.implementation_identity)
    lifecycle = ServiceLifecycle(helper_plan, owner, OwnerSet())
    for phase in (LifecycleState.RESOLVED, LifecycleState.PREPARING, LifecycleState.STARTING):
        lifecycle.transition(phase)
    registry = ResourceRegistry(owner)

    def presence(kind: str, name: str) -> ResourcePresence:
        return resource_presence(OUTER_RUNTIME, ResourceKind(kind), name, owner)
    def remove(kind: str, name: str) -> None:
        remove_owned_resource(OUTER_RUNTIME, ResourceKind(kind), name, owner)

    config_resource = "file:caddy-config"
    pair_resources = {
        "configuration": config_resource,
        "socket-volume": f"volume:{socket_volume}",
        "application-network": f"network:{application_network}",
        "refresh-network": f"network:{refresh_network}",
        "helper-container": f"container:{helper_container}",
        "caddy-container": f"container:{caddy}",
    }
    pair_dependencies = pair_plan.resource_topology().bind(pair_resources)
    def config_presence() -> ResourcePresence:
        try:
            return (ResourcePresence.OWNED if caddy_configuration_digest(configuration_path.read_bytes()) == configuration_digest
                    else ResourcePresence.MISMATCHED)
        except FileNotFoundError:
            return ResourcePresence.ABSENT
    def remove_config() -> None:
        configuration_path.unlink(missing_ok=True)
        directory = os.open(configuration_path.parent, os.O_DIRECTORY)
        try: os.fsync(directory)
        finally: os.close(directory)
    registry.register(OwnedResource(
        config_resource, owner, config_presence, remove_config,
        pair_dependencies[config_resource],
    ))
    resources = (("volume", socket_volume), ("network", application_network),
                 ("network", refresh_network))
    for kind, name in resources:
        registry.register(OwnedResource(f"{kind}:{name}", owner,
            lambda k=kind, n=name: presence(k, n), lambda k=kind, n=name: remove(k, n),
            pair_dependencies[f"{kind}:{name}"]))
    registry.register(OwnedResource(f"container:{helper_container}", owner,
        lambda: presence("container", helper_container), lambda: remove("container", helper_container),
        pair_dependencies[f"container:{helper_container}"]))
    registry.register(OwnedResource(f"container:{caddy}", owner,
        lambda: presence("container", caddy), lambda: remove("container", caddy),
        pair_dependencies[f"container:{caddy}"]))
    statuses = {"caddy-container": "intended", "helper-container": "intended",
                "socket-volume": "intended", "application-network": "intended",
                "refresh-network": "intended", "refresh-attachment": "intended"}
    record: dict[str, object] = {
        "container": caddy, "helper-container": helper_container, "socket-volume": socket_volume,
        "key": key, "image": caddy_identity.runtime_reference, "service-owner": owner,
        "implementation-identity": implementation, "helper-implementation": helper_plan.implementation_identity,
        "caddy-image-chain": caddy_identity.__dict__,
        "configuration": {"path": str(configuration_path), "digest": configuration_digest},
        "state-schema": STATE_SCHEMA, "lifecycle-state": "starting",
        "credential-domain": CREDENTIAL_DOMAIN, "network": application_network,
        "networks": {"agent-link": SANDBOX_NETWORK, "application": application_network,
                     "refresh": refresh_network},
        "refresh-attachment": {"container": helper_container, "network": refresh_network},
        "network-owner": {"kind": "admitted-runtime-public-egress",
                          "runtime": runtime_identity(OUTER_RUNTIME)},
        "endpoint": {"container": caddy, "port": ENDPOINT_PORT},
        "credential-volume": {"kind": "bind", "target": "/var/lib/codex-auth",
                              "identity": credential_source_identity(auth_directory),
                              "lifetime": "shared-session"},
        "token-lifetime": "shared-session", "runtime-owner": runtime_identity(OUTER_RUNTIME),
        "resource-status": statuses,
    }
    handle = CodexBrokerHandle(lifecycle, registry, record)
    partial = json.loads(state.proxy_state.read_text(encoding="utf-8"))
    partial["trusted-services"] = SESSION_LIFECYCLE_SCHEMA
    partial["auth"] = handle.schema3_record(); _persist_proxy_state(state.proxy_state, partial)
    try:
        def pair_effect(status, operation):
            operation()
            if status in statuses:
                statuses[status] = "created"
            partial["auth"] = handle.schema3_record(); _persist_proxy_state(state.proxy_state, partial)
            if status == "helper-container":
                statuses["refresh-attachment"] = "created"
        start_egress_pair(
            OUTER_RUNTIME, pair_plan, pair_effect,
            cancelled=lambda: cancelled is not None and cancelled.is_set(),
            error=LauncherError,
        )
        lifecycle.transition(LifecycleState.READY); record["lifecycle-state"] = "ready"
        partial["auth"] = handle.schema3_record(); _persist_proxy_state(state.proxy_state, partial)
        return handle, codex_sidecar_arguments(caddy, key)
    except BaseException as startup_error:
        lifecycle.transition(LifecycleState.FAILED); record["lifecycle-state"] = "failed"
        for name, status in list(statuses.items()):
            if status == "intended": statuses[name] = "unknown"
        try:
            partial["auth"] = handle.schema3_record(); _persist_proxy_state(state.proxy_state, partial)
            handle.cleanup(); partial.pop("auth", None); _persist_proxy_state(state.proxy_state, partial)
        except BaseException as cleanup_error:
            partial["auth"] = handle.schema3_record(); _persist_proxy_state(state.proxy_state, partial)
            startup_error.add_note(f"Codex pair cleanup failed; recovery state retained: {type(cleanup_error).__name__}")
        raise

def attach_codex_sidecar(state: State, auth_directory: Path | None = None) -> list[str]:
    proxy_state = json.loads(state.proxy_state.read_text(encoding="utf-8"))
    sidecar = proxy_state.get("auth")
    if auth_directory is None:
        if sidecar is None:
            print(
                "Codex authentication sidecar disabled; run 'codex-sandbox auth login' to enable it.",
                file=sys.stderr,
            )
            return []
        raise LauncherError("active sandbox proxy session has authentication enabled")
    if sidecar is None:
        handle, arguments = start_codex_sidecar(state, auth_directory)
        # Schema 3 remains the atomic representation; the lifecycle handle is
        # its only producer and cleanup owner.
        proxy_state["trusted-services"] = SESSION_LIFECYCLE_SCHEMA
        proxy_state["auth"] = handle.schema3_record()
        _persist_proxy_state(state.proxy_state, proxy_state)
        return arguments
    lifecycle_schema = proxy_state.get("trusted-services")
    if lifecycle_schema != SESSION_LIFECYCLE_SCHEMA:
        raise LauncherError("active sandbox proxy session has an unsupported lifecycle schema")
    try:
        record_kind, sidecar = parse_auth_record(sidecar, managed_required=True)
    except ValueError as error:
        raise LauncherError("active sandbox proxy session has invalid authentication state") from error
    if record_kind != "managed":
        raise LauncherError("active sandbox proxy session uses cleanup-only authentication state")
    if record_kind == "managed":
        helper_plan = resolved_plan(DOTFILES / "tools/codex-sandbox/auth-proxy",
                                    state.sidecar_image, state.uid, state.gid)
        caddy_identity = accepted_caddy_image(sidecar["caddy-image-chain"], OUTER_RUNTIME)
        material = {"caddy": caddy_identity.__dict__,
                    "configuration": sidecar["configuration"]["digest"],
                    "helper": helper_plan.implementation_identity}
        expected_implementation = "sha256:" + hashlib.sha256(
            json.dumps(material, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
        if (sidecar["runtime-owner"] != runtime_identity(OUTER_RUNTIME) or
                sidecar["image"] != caddy_identity.runtime_reference or
                sidecar["caddy-image-chain"] != caddy_identity.__dict__ or
                sidecar["helper-implementation"] != helper_plan.implementation_identity or
                sidecar["implementation-identity"] != expected_implementation or
                sidecar["credential-volume"]["identity"] != credential_source_identity(auth_directory)):
            raise LauncherError("active sandbox proxy session has invalid pair identity")
        try:
            caddy_snapshot = OUTER_RUNTIME.inspect_container(sidecar["container"])
            helper_snapshot = OUTER_RUNTIME.inspect_container(sidecar["helper-container"])
            validate_configuration_mount(caddy_snapshot, Path(sidecar["configuration"]["path"]),
                                         sidecar["configuration"]["digest"])
            network_labels = {}
            for role in ("application", "refresh"):
                inspected = OUTER_RUNTIME.run(
                    ["network", "inspect", sidecar["networks"][role]], capture_output=True)
                network = json.loads(inspected.stdout)[0]
                network_labels[role] = network.get(
                    "Labels", network.get("CNI", {}).get("nerdctlLabels", {})) or {}
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            raise LauncherError("cached authentication pair inspection failed") from error
        caddy_networks = OUTER_RUNTIME.container_networks(caddy_snapshot)
        helper_networks = OUTER_RUNTIME.container_networks(helper_snapshot)
        caddy_credentials = [m for m in caddy_snapshot.get("Mounts", [])
                             if m.get("Destination") == "/var/lib/codex-auth"]
        helper_credentials = [m for m in helper_snapshot.get("Mounts", [])
                              if m.get("Destination") == "/var/lib/codex-auth"]
        caddy_sockets = [m for m in caddy_snapshot.get("Mounts", [])
                         if m.get("Destination") == "/run/profile-helper"]
        helper_sockets = [m for m in helper_snapshot.get("Mounts", [])
                          if m.get("Destination") == "/run/profile-helper"]
        expected_labels = {"dev.codex.service-owner": sidecar["service-owner"],
                           "dev.codex.credential-domain": CREDENTIAL_DOMAIN}
        labels_match = all((snapshot.get("Config", {}).get("Labels", {}) or {}).get(key) == value
                           for snapshot in (caddy_snapshot, helper_snapshot)
                           for key, value in expected_labels.items())
        images_match = (OUTER_RUNTIME.container_matches_image(
                            sidecar["container"], OUTER_RUNTIME.inspect_image(sidecar["image"]),
                            snapshot=caddy_snapshot, labels=expected_labels)
                        and OUTER_RUNTIME.container_matches_image(
                            sidecar["helper-container"], OUTER_RUNTIME.inspect_image(state.sidecar_image),
                            snapshot=helper_snapshot, labels=expected_labels))
        if (set(caddy_networks) != {sidecar["networks"]["agent-link"], sidecar["networks"]["application"]}
                or set(helper_networks) != {sidecar["networks"]["refresh"]}
                or sidecar["network-owner"] != {"kind": "admitted-runtime-public-egress",
                                                 "runtime": runtime_identity(OUTER_RUNTIME)}
                or any(network_labels[role].get("dev.codex.service-owner") != sidecar["service-owner"]
                       or network_labels[role].get("dev.codex.credential-domain") != CREDENTIAL_DOMAIN
                       or network_labels[role].get("dev.codex.network-role") != role
                       for role in ("application", "refresh"))
                or not labels_match or not images_match
                or caddy_credentials or len(helper_credentials) != 1
                or helper_credentials[0].get("Source") != str(auth_directory)
                or helper_credentials[0].get("RW") is not True
                or len(caddy_sockets) != 1 or caddy_sockets[0].get("Name") != sidecar["socket-volume"]
                or caddy_sockets[0].get("RW") is not False
                or len(helper_sockets) != 1 or helper_sockets[0].get("Name") != sidecar["socket-volume"]
                or helper_sockets[0].get("RW") is not True):
            raise LauncherError("cached authentication pair runtime boundary changed")
    if not codex_sidecar_has_sandbox_network(sidecar["container"]):
        raise LauncherError(
            "cached authentication sidecar is absent or belongs to another sandbox "
            "network; stop the active sandbox session before retrying"
        )
    readiness = run([
        "docker", "exec", sidecar["container"], "wget", "-q", "-O", "/dev/null",
        "http://127.0.0.1:8787/ready",
    ], check=False, quiet=True)
    if readiness.returncode:
        raise LauncherError("cached authentication broker is not locally ready")
    return codex_sidecar_arguments(sidecar["container"], sidecar["key"])


@cache
def installed_config_sources() -> dict[str, Path]:
    data = json.loads((DOTFILES / "install.conf.json").read_text(encoding="utf-8"))
    links = next(section["link"] for section in data if "link" in section)
    return {target: DOTFILES / source for target, source in links.items()}


def installed_config_source(target: str) -> Path:
    try:
        return installed_config_sources()[target]
    except KeyError as error:
        raise LauncherError(f"Dotfiles install mapping is missing {target}") from error


def staged_config_path(state: State, role: str) -> Path:
    return state.skills_tmp / "config" / role


def stage_config_source(source: Path, destination: Path) -> None:
    if source.is_dir():
        shutil.copytree(source, destination)
    else:
        shutil.copy2(source, destination)


def stage_skills(state: State) -> None:
    state.skills_tmp = Path(tempfile.mkdtemp(dir=scratch_directory()))
    source = state.home / ".agents/skills"
    try:
        state.skills_source = source.resolve(strict=True)
    except OSError as error:
        raise LauncherError(f"Agent skills directory is invalid: {source}") from error
    if not state.skills_source.is_dir():
        raise LauncherError(f"Agent skills directory is invalid: {source}")
    config = state.skills_tmp / "config"
    config.mkdir()
    for role, (target, _) in STAGED_CONFIG.items():
        stage_config_source(installed_config_source(target), staged_config_path(state, role))
    settings_path = staged_config_path(state, "settings")
    settings = json.loads(settings_path.read_text(encoding="utf-8"))
    settings["externalEditor"] = "/opt/agent-tools/bin/host-editor"
    settings_path.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
    instruction_includes = []
    repository_instructions = state.repository / ".agents/sandbox/AGENTS.md"
    if repository_instructions.is_file():
        instruction_includes.append(f"@{state.container_repository}/.agents/sandbox/AGENTS.md")
    home_instructions = state.home / ".agents/sandbox/AGENTS.md"
    if home_instructions.is_file():
        shutil.copytree(
            home_instructions.parent, state.skills_tmp / "sandbox",
            symlinks=False, ignore_dangling_symlinks=True,
        )
        instruction_includes.append("@../../.agents/sandbox/AGENTS.md")
    if instruction_includes:
        agents = staged_config_path(state, "agents")
        content = agents.read_text(encoding="utf-8").rstrip("\n")
        agents.write_text(
            content + "\n" + "\n".join(instruction_includes) + "\n",
            encoding="utf-8",
        )


def finalize_proxy_session(state: State) -> list[str]:
    state.proxy_args = temporary_file()
    # A shared join validated an existing publication under its lifetime lock;
    # it must not rewrite that publication after releasing coordination.
    operation = 'agent-args' if state.proxy_lock.shared else 'finalize'
    helper(
        operation, "--repo", str(state.repository),
        "--container-repo", str(state.container_repository),
        "--state", str(state.proxy_state), "--output", str(state.proxy_args),
        "--manifest", str(state.manifest),
    )
    arguments: list[str] = []
    for line in state.proxy_args.read_text(encoding="utf-8").splitlines():
        arguments.insert(0, line)
    return arguments


with (Path(__file__).resolve().parent / "image/host-editor-protocol.json").open(
    encoding="utf-8",
) as stream:
    HOST_EDITOR_PROTOCOL = json.load(stream)
HOST_EDITOR_PROTOCOL_VERSION = HOST_EDITOR_PROTOCOL["version"]
MAX_EDITOR_DOCUMENT_BYTES = HOST_EDITOR_PROTOCOL["max_document_bytes"]
MAX_EDITOR_MESSAGE_BYTES = HOST_EDITOR_PROTOCOL["max_message_bytes"]
EDITOR_REQUEST_TIMEOUT_SECONDS = 5


class HostEditorBridge:
    """Own the narrow guest-to-host text editor boundary for one sandbox."""

    def __init__(self) -> None:
        self.token = secrets.token_hex(32)
        self.stop_event = threading.Event()
        self.listener: socket.socket | None = None
        self.thread: threading.Thread | None = None
        self.port: int | None = None
        self.panes: set[str] = set()
        self.panes_lock = threading.Lock()
        self.allowed_peers: set[str] = set()
        self.allowed_peers_lock = threading.Lock()
        self.target_pane = os.environ.get("TMUX_PANE")
        self.editor = (
            os.environ.get("CODEX_SANDBOX_HOST_EDITOR")
            or os.environ.get("VISUAL")
            or os.environ.get("EDITOR")
            or "vi"
        )

    def start(self) -> None:
        listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        # Docker Desktop and rootless Podman do not expose one portable host-only
        # bind address. Use an ephemeral port and authenticate every request with
        # the session token; the guest receives only the private relay address.
        listener.bind(("0.0.0.0", 0))
        listener.listen(1)
        listener.settimeout(0.2)
        self.listener = listener
        self.port = listener.getsockname()[1]
        self.thread = threading.Thread(target=self._serve, name="host-editor-bridge", daemon=True)
        self.thread.start()

    def allow_peers(self, peers: set[str]) -> None:
        with self.allowed_peers_lock:
            self.allowed_peers = set(peers)

    def stop(self) -> None:
        self.stop_event.set()
        if self.listener is not None:
            self.listener.close()
        if self.thread is not None:
            self.thread.join(timeout=2)
        with self.panes_lock:
            panes = list(self.panes)
        for pane in panes:
            run(["tmux", "kill-pane", "-t", pane], check=False, quiet=True)

    @staticmethod
    def _receive_exact(connection: socket.socket, length: int) -> bytes:
        chunks: list[bytes] = []
        remaining = length
        while remaining:
            chunk = connection.recv(remaining)
            if not chunk:
                raise LauncherError("host editor request ended prematurely")
            chunks.append(chunk)
            remaining -= len(chunk)
        return b"".join(chunks)

    @staticmethod
    def _send(connection: socket.socket, value: dict[str, object]) -> None:
        payload = json.dumps(value, separators=(",", ":")).encode("utf-8")
        if len(payload) > MAX_EDITOR_MESSAGE_BYTES:
            raise LauncherError("host editor response is too large")
        connection.sendall(struct.pack(">I", len(payload)) + payload)

    def _serve(self) -> None:
        assert self.listener is not None
        while not self.stop_event.is_set():
            try:
                connection, address = self.listener.accept()
            except TimeoutError:
                continue
            except OSError:
                return
            with self.allowed_peers_lock:
                allowed = address[0] in self.allowed_peers
            if not allowed:
                connection.close()
                continue
            with connection:
                connection.settimeout(EDITOR_REQUEST_TIMEOUT_SECONDS)
                self._serve_connection(connection)

    def _serve_connection(self, connection: socket.socket) -> None:
        try:
            length = struct.unpack(">I", self._receive_exact(connection, 4))[0]
            if length > MAX_EDITOR_MESSAGE_BYTES:
                raise LauncherError("host editor request is too large")
            request = json.loads(self._receive_exact(connection, length).decode("utf-8"))
            if not isinstance(request, dict) or set(request) != {"version", "token", "content"} \
                    or type(request["version"]) is not int \
                    or request["version"] != HOST_EDITOR_PROTOCOL_VERSION \
                    or not isinstance(request["token"], str) \
                    or not secrets.compare_digest(request["token"], self.token) \
                    or not isinstance(request["content"], str):
                raise LauncherError("invalid host editor request")
            if len(request["content"].encode("utf-8")) > MAX_EDITOR_DOCUMENT_BYTES:
                raise LauncherError("host editor document is too large")
            self._send(connection, {
                "version": HOST_EDITOR_PROTOCOL_VERSION, "status": "editing",
            })
            connection.settimeout(None)
            content = self._edit(request["content"])
            response = {
                "version": HOST_EDITOR_PROTOCOL_VERSION,
                "status": "complete", "content": content,
            }
        except (LauncherError, OSError, UnicodeError, json.JSONDecodeError) as error:
            response = {
                "version": HOST_EDITOR_PROTOCOL_VERSION,
                "status": "failed", "error": str(error),
            }
        try:
            self._send(connection, response)
        except (LauncherError, OSError):
            pass

    def _edit(self, content: str) -> str:
        if "TMUX" not in os.environ or self.target_pane is None:
            raise LauncherError("host editor bridge requires a tmux pane")
        try:
            editor = shlex.split(self.editor)
        except ValueError as error:
            raise LauncherError("host editor command is malformed") from error
        if not editor:
            raise LauncherError("host editor command is empty")
        with tempfile.TemporaryDirectory(prefix="codex-host-editor-document-") as directory:
            document = Path(directory) / "prompt.md"
            status = Path(directory) / "status"
            document.write_text(content, encoding="utf-8")
            pane_command = shlex.join([
                str(HOST_EDITOR_PANE), str(status), "--", *editor, str(document),
            ])
            result = run([
                "tmux", "split-window", "-h", "-t", self.target_pane,
                "-P", "-F", "#{pane_id}", pane_command,
            ], check=False, capture=True, quiet=True)
            if result.returncode or not result.stdout.strip():
                raise LauncherError("could not open host editor pane")
            pane = result.stdout.strip()
            with self.panes_lock:
                self.panes.add(pane)
            try:
                while not status.exists():
                    if self.stop_event.wait(0.1):
                        raise LauncherError("host editor bridge stopped")
                    alive = run([
                        "tmux", "display-message", "-p", "-t", pane, "#{pane_id}",
                    ], check=False, quiet=True)
                    if alive.returncode:
                        raise LauncherError("host editor pane exited without a result")
                try:
                    exit_status = int(status.read_text(encoding="utf-8").strip())
                except (OSError, ValueError) as error:
                    raise LauncherError("host editor returned an invalid status") from error
                if exit_status:
                    raise LauncherError(f"host editor exited with status {exit_status}")
                result_content = document.read_text(encoding="utf-8")
                if len(result_content.encode("utf-8")) > MAX_EDITOR_DOCUMENT_BYTES:
                    raise LauncherError("host editor result is too large")
                return result_content
            finally:
                if self.stop_event.is_set():
                    run(["tmux", "kill-pane", "-t", pane], check=False, quiet=True)
                    with self.panes_lock:
                        self.panes.discard(pane)
                else:
                    alive = run([
                        "tmux", "display-message", "-p", "-t", pane, "#{pane_id}",
                    ], check=False, quiet=True)
                    if alive.returncode:
                        with self.panes_lock:
                            self.panes.discard(pane)


def report_container_timing(state: State) -> None:
    # Use daemon timestamps together: the VM and host clocks may differ.
    # Diagnostics must neither replace the agent's exit status nor block cleanup.
    try:
        result = subprocess.run(
            ["docker", "inspect", "--format",
             "{{json .Created}}|{{json .State.StartedAt}}|{{json .State.FinishedAt}}",
             state.codex_container],
            capture_output=True, text=True, timeout=5, check=True,
        )
        timestamps = [json.loads(value) for value in result.stdout.strip().split("|")]
        if not all(isinstance(value, str) for value in timestamps):
            raise ValueError("container timestamps are not strings")
        created, started, finished = (
            datetime.fromisoformat(value.replace("Z", "+00:00")) for value in timestamps
        )
        if not created <= started <= finished:
            raise ValueError("container did not complete its lifecycle")
        print(
            f"Sandbox container: creation to start={(started - created).total_seconds():.2f}s, "
            f"start to exit={(finished - started).total_seconds():.2f}s",
            file=sys.stderr,
        )
    except (OSError, subprocess.SubprocessError, ValueError, TypeError):
        print("Sandbox container timing: unavailable", file=sys.stderr)


def wait_for_agent(state: State) -> int:
    try:
        return state.agent_process.wait()
    except SignalExit as error:
        if state.agent_process.poll() is None:
            state.agent_process.send_signal(error.signum)
            try:
                state.agent_process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                state.agent_process.kill()
                state.agent_process.wait()
        raise


def read_cd_request(state: State) -> tuple[Path, Path | None] | None:
    if state.cd_request is None:
        return None
    content = state.cd_request.read_text(encoding="utf-8")
    if not content:
        return None
    try:
        payload = json.loads(content)
        if not isinstance(payload, dict) or set(payload) != {"destination", "session"}:
            raise ValueError("invalid handoff request")
        if (not isinstance(payload["destination"], str) or not payload["destination"]
                or (payload["session"] is not None
                    and (not isinstance(payload["session"], str) or not payload["session"]))):
            raise ValueError("invalid handoff request")
        destination = Path(payload["destination"]).resolve(strict=True)
        session = (Path(payload["session"]).resolve(strict=True)
                   if payload["session"] is not None else None)
        if not destination.is_dir() or (session is not None and not session.is_file()):
            raise ValueError("handoff destination or session is unavailable")
        return destination, session
    except (json.JSONDecodeError, OSError, ValueError) as error:
        raise LauncherError(f"Invalid directory handoff: {error}") from error


def keychain_environment(state: State) -> dict[str, str]:
    handle = getattr(state, 'keychain_handle', None)
    if handle is None or not handle.projected or handle.bridge is None:
        return {}
    return {'CODEX_SANDBOX_KEYCHAIN_TOKEN': handle.bridge.token}


def prepare_host_pi_resources(state: State) -> None:
    if not host_pi_enabled():
        return
    cli = state.home / ".local/share/pi/node/node_modules/.bin/pi"
    try:
        package = cli.resolve(strict=True).parents[2]
    except (FileNotFoundError, IndexError) as error:
        raise LauncherError(f"Host Pi installation is invalid: {cli}") from error
    for relative in PI_RESOURCE_PATHS:
        resource = package / relative
        if not resource.exists():
            raise LauncherError(f"Host Pi resource is missing: {resource}")
    state.host_pi_package = package


def build_agent_command(
    state: State, arguments: list[str], *, host_pi: bool, timing: bool,
    protected: list[Path], repository_aliases: list[Path],
    external_git_roots: list[tuple[Path, Path]],
    persistent_package_directories: list[Path], sessions: Path,
    pi_extensions: Path,
) -> list[str]:
    """Construct and validate the agent container command without starting it."""
    command = [
        "docker", "run", "--name", state.codex_container, *([] if host_pi else ["-it"]),
        "--cap-drop=NET_RAW",
        "--network", SANDBOX_NETWORK, *proxy_flags(),
        *(["--mount", f"type=bind,src={state.github_credential},dst=/run/secrets/github-token,readonly",
           "--entrypoint", "/opt/agent-tools/bin/with-github-token"] if isinstance(OUTER_RUNTIME, VMRuntime)
          else ["--secret", "codex-github-token,type=env,target=GH_TOKEN",
                *(["--entrypoint", "node"] if host_pi else [])]),
        "--env", "JJ_AGENT=pi",
        *(["--env", "CODEX_SANDBOX_TOOL_WORKER=1"] if host_pi else []),
        "--env", "PI_MODEL_FILE=/home/codex/.pi/agent/runtime-model.json",
        "--env", f"PI_MODEL_SESSION_ID={state.pi_model_session_id}",
        "--env", f"TERM={state.term}",
        *(["--env", "PI_TIMING=1"] if timing else []),
        "--mount", f"type=bind,src={state.pi_agent_tmp},dst=/home/codex/.pi/agent",
        *([] if host_pi else ["--mount", f"type=bind,src={sessions},dst=/home/codex/.pi/agent/sessions"]),
        *[
            item
            for directory in ([] if host_pi else persistent_package_directories)
            for item in (
                "--mount",
                f"type=bind,src={directory},dst=/home/codex/.pi/agent/{directory.name}",
            )
        ],
        "--mount", f"type=bind,src={state.pi_auth_mask},dst=/home/codex/.pi/agent/auth.json,readonly",
        "--mount", f"type=bind,src={state.skills_source},dst=/home/codex/.agents/skills",
        # Host Pi passes its absolute skill paths to guest-backed tools.
        *(["--mount", f"type=bind,src={state.skills_source},dst={state.home / '.agents/skills'}"]
          if host_pi else []),
        *[
            item
            for relative in (PI_RESOURCE_PATHS if host_pi else ())
            for item in (
                "--mount",
                f"type=bind,src={state.host_pi_package / relative},"
                f"dst={GUEST_PI_PACKAGE / relative},readonly",
            )
        ],
        *(
            ["--mount", f"type=bind,src={state.skills_tmp / 'sandbox'},dst=/home/codex/.agents/sandbox,readonly"]
            if (state.skills_tmp / "sandbox").is_dir() else []
        ),
        *[
            item
            for role, (_, destination) in STAGED_CONFIG.items()
            for item in (
                "--mount",
                f"type=bind,src={staged_config_path(state, role)},dst={destination},readonly",
            )
        ],
        "--mount", f"type=bind,src={pi_extensions},dst=/home/codex/.pi/agent/pi-extensions,readonly",
        "--mount", f"type=bind,src={state.home / '.codex/config.toml'},dst=/home/codex/.codex/config.toml,readonly",
        "--mount", f"type=bind,src={installed_config_source('$HOME/.config/git/ignore')},dst=/home/codex/.gitignore,readonly",
        "--mount", f"type=bind,src={installed_config_source('$HOME/.codex/dotfiles.config.toml')},dst=/home/codex/.codex/dotfiles.config.toml,readonly",
        "--mount", f"type=bind,src={installed_config_source('$HOME/.codex/developer-instructions.md')},dst=/home/codex/.codex/developer-instructions.md,readonly",
        "--mount", f"type=bind,src={installed_config_source('$HOME/.codex/breq.md')},dst=/home/codex/.codex/breq.md,readonly",
        *source_mounts(state.home / 'src', [state.container_repository, *repository_aliases,
                       *[target for _, target in external_git_roots]], state.skills_tmp / 'source-view'),
        "--mount", f"type=bind,src={state.repository},dst={state.container_repository},{OUTER_RUNTIME.nonrecursive_bind}",
        "--mount", f"type=bind,src={state.git_mount_source},dst={state.container_repository / '.git'},readonly",
        "--workdir", str(state.container_working_directory),
        *[
            item
            for target in repository_aliases
            for item in (
                "--mount",
                f"type=bind,src={state.repository},dst={target},readonly,{OUTER_RUNTIME.nonrecursive_bind}",
            )
        ],
        *[
            item
            for path in protected
            for item in (
                "--mount",
                f"type=bind,src={path},dst={state.container_repository / path.relative_to(state.repository)},readonly",
            )
        ],
        *[
            item
            for path, relative_target in external_git_roots
            for target in (path, relative_target)
            for item in (
                "--mount",
                f"type=bind,src={path},dst={target},readonly",
            )
        ],
        *arguments,
    ]
    try:
        check_mount_destinations(command)
    except ValueError as error:
        raise LauncherError(str(error)) from error
    return command


def run_agent(state: State, arguments: list[str], *, host_pi: bool = False) -> int:
    setup_started = time.monotonic()
    timing = bool(os.environ.get("CODEX_SANDBOX_TIMING"))
    state.codex_container_created = True
    git_layout = run([
        "git", "-C", str(state.git_repository), "rev-parse", "--path-format=absolute",
        "--git-dir", "--git-common-dir",
    ], capture=True).stdout.splitlines()
    # A non-colocated workspace has no .git entry of its own. Mount the
    # backing Git metadata at the conventional workspace path in the guest.
    protected = [state.repository / ".jj"]
    git_roots: list[Path] = []
    for line in git_layout:
        path = Path(line).resolve(strict=True)
        if any(character in str(path) for character in (",", "\n", "\r")):
            raise LauncherError("Git metadata path contains a container-mount delimiter")
        if path not in git_roots:
            git_roots.append(path)
    external_git_roots: list[tuple[Path, Path]] = []
    for path in git_roots[1:]:
        try:
            path.relative_to(state.repository)
        except ValueError:
            relative = Path(os.path.relpath(path, state.repository))
            target = Path(os.path.normpath(state.container_repository / relative))
            try:
                target.relative_to("/src")
            except ValueError as error:
                raise LauncherError("Git metadata path escapes the container workspace") from error
            if not any(path.is_relative_to(root) for root, _ in external_git_roots):
                external_git_roots = [
                    (root, root_target)
                    for root, root_target in external_git_roots
                    if not root.is_relative_to(path)
                ]
                external_git_roots.append((path, target))
            continue
        if path not in protected:
            protected.append(path)
    repository_aliases: list[Path] = []
    for source, relative_target in external_git_roots:
        for metadata_target in (source, relative_target):
            alias = Path(os.path.normpath(
                metadata_target / os.path.relpath(state.repository, source)
            ))
            if metadata_target == source:
                if alias != state.repository:
                    raise LauncherError("Git metadata produced an invalid host worktree alias")
            else:
                try:
                    alias.relative_to("/src")
                except ValueError as error:
                    raise LauncherError("Git metadata produced an unsafe worktree alias") from error
                if alias == Path("/src"):
                    raise LauncherError("Git metadata worktree alias is too broad")
            if alias != state.container_repository and alias not in repository_aliases:
                repository_aliases.append(alias)
    pi_agent = state.home / ".pi/agent"
    if pi_agent.exists() and (pi_agent.is_symlink() or not pi_agent.is_dir()):
        raise LauncherError(f"Pi agent directory is invalid: {pi_agent}")
    pi_agent.mkdir(mode=0o700, parents=True, exist_ok=True)
    sessions = pi_agent / "sessions"
    if sessions.exists() and (sessions.is_symlink() or not sessions.is_dir()):
        raise LauncherError(f"Pi sessions directory is invalid: {sessions}")
    sessions.mkdir(mode=0o700, parents=True, exist_ok=True)
    # Pi's /reload resolves configured packages, installing missing npm packages,
    # repairing version mismatches, and refreshing eligible Git sources. Keep these
    # package stores writable and persistent; all other undeclared agent state stays
    # private to the sandbox so extensions cannot accidentally share runtime data.
    persistent_package_directories = []
    for directory in (pi_agent / "npm", pi_agent / "git"):
        if directory.exists() and (directory.is_symlink() or not directory.is_dir()):
            raise LauncherError(f"Pi package directory is invalid: {directory}")
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        persistent_package_directories.append(directory)
    pi_extensions = DOTFILES / "config/agents/pi/pi-extensions"
    if not pi_extensions.is_dir():
        raise LauncherError(f"Pi extensions directory is missing: {pi_extensions}")
    state.pi_agent_tmp = Path(tempfile.mkdtemp(prefix="codex-private-agent-", dir=scratch_directory()))
    os.chmod(state.pi_agent_tmp, 0o700)
    # Offline Pi needs the host's refreshed catalog. Copy it so guest updates
    # remain private and disappear with the rest of this sandbox's runtime state.
    model_catalog = pi_agent / "models-store.json"
    if model_catalog.exists():
        shutil.copyfile(model_catalog, state.pi_agent_tmp / model_catalog.name)
    for directory in ("extensions", "pi-codex-subagents"):
        (state.pi_agent_tmp / directory).mkdir(mode=0o700)
    state.pi_auth_mask = temporary_file()
    state.pi_auth_mask.write_text("{}\n", encoding="utf-8")
    state.pi_model_file = state.pi_agent_tmp / "runtime-model.json"
    state.pi_model_file.write_text(json.dumps({
        "session_id": state.pi_model_session_id,
        "provider": "",
        "modelId": "",
    }) + "\n", encoding="utf-8")
    os.chmod(state.pi_model_file, 0o600)
    command = build_agent_command(
        state, arguments, host_pi=host_pi, timing=timing, protected=protected,
        repository_aliases=repository_aliases, external_git_roots=external_git_roots,
        persistent_package_directories=persistent_package_directories, sessions=sessions,
        pi_extensions=pi_extensions,
    )
    reserved = {
        "CODEX_SANDBOX_EDITOR_ADDRESS", "CODEX_SANDBOX_EDITOR_TOKEN",
        "CODEX_SANDBOX_KEYCHAIN_ADDRESS", "CODEX_SANDBOX_KEYCHAIN_TOKEN",
        "CONTAINER_HOST", "CONTAINER_SSHKEY", "AGENT_PODMAN_KNOWN_HOSTS",
    }
    agent_environment = {key: value for key, value in os.environ.items() if key not in reserved}
    bridge_environment: dict[str, str] = {}
    if state.host_editor is not None:
        bridge_environment["CODEX_SANDBOX_EDITOR_TOKEN"] = state.host_editor.token
    bridge_environment.update(keychain_environment(state))
    agent_environment.update(bridge_environment)
    if host_pi:
        image_index = command.index(state.image)
        host_pi_bin = DOTFILES / "tools/codex-sandbox/sandbox-host-pi"
        state.cd_request = temporary_file()
        host_environment = dict(os.environ)
        pi_resource_paths = {
            str(state.host_pi_package / relative): str(GUEST_PI_PACKAGE / relative)
            for relative in PI_RESOURCE_PATHS
        }
        host_environment.update({
            "CODEX_SANDBOX_TOOL_CONTAINER": state.codex_container,
            "CODEX_SANDBOX_TOOL_CONNECT": str(DOTFILES / "tools/codex-sandbox/sandbox-tool-connect"),
            "CODEX_SANDBOX_GUEST_CWD": str(state.container_working_directory),
            "CODEX_SANDBOX_CD_REQUEST": str(state.cd_request),
            "CODEX_SANDBOX_CD_VALIDATE": str(DOTFILES / "tools/codex-sandbox/codex-sandbox"),
            "CODEX_SANDBOX_PI_RESOURCE_PATHS": json.dumps(pi_resource_paths),
            "PI_SUBAGENT_PI_BIN": str(host_pi_bin),
            "JJ_AGENT": "pi",
            "PI_MODEL_FILE": str(state.pi_model_file),
            "PI_MODEL_SESSION_ID": state.pi_model_session_id,
        })
        if state.handoff_origin is not None:
            host_environment["CODEX_SANDBOX_PREVIOUS_CWD"] = str(state.handoff_origin)
        worker_command = (["node", "/opt/agent-tools/bin/tool-worker.mjs"]
                          if isinstance(OUTER_RUNTIME, VMRuntime)
                          else ["/opt/agent-tools/bin/tool-worker.mjs"])
        with OUTER_RUNTIME.environment_file(bridge_environment) as environment:
            with OUTER_RUNTIME.workload(
                OUTER_RUNTIME.inspect_image(state.image), state.codex_container,
                [*command[4:image_index], *environment], worker_command,
            ) as worker:
                for _ in range(100):
                    if worker.poll() is not None:
                        raise LauncherError("guest tool worker exited during startup")
                    ready = OUTER_RUNTIME.run(
                        ["exec", state.codex_container, "test", "-S", "/tmp/codex-tool-worker.sock"],
                        check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    )
                    if ready.returncode == 0:
                        break
                    time.sleep(0.1)
                else:
                    raise LauncherError("guest tool worker did not become ready")
                state.agent_process = subprocess.Popen(
                    [str(host_pi_bin), *state.codex_arguments],
                    cwd=state.host_working_directory, env=host_environment,
                )
                worker_failed = threading.Event()
                def watch_worker() -> None:
                    worker.wait()
                    if state.agent_process is not None and state.agent_process.poll() is None:
                        worker_failed.set()
                        state.agent_process.terminate()
                threading.Thread(target=watch_worker, daemon=True).start()
                result = wait_for_agent(state)
                if worker_failed.is_set():
                    raise LauncherError("guest tool worker stopped while host Pi was running")
        state.codex_container_created = False
        return result
    if timing:
        print(
            f"Sandbox launch setup: {time.monotonic() - setup_started:.2f}s; "
            f"starting docker run ({state.codex_container})",
            file=sys.stderr,
        )
    launch_started = time.monotonic()
    if isinstance(OUTER_RUNTIME, VMRuntime):
        image_index = command.index(state.image)
        terminal_arguments = (["--interactive", "--tty"]
                              if sys.stdin.isatty() and sys.stdout.isatty() else [])
        # Keep create and attach under the runtime's existing producer ownership.
        # The session key may persist with this container; the GitHub token may not.
        # Create first so lost supervision can remove an existing container.
        with OUTER_RUNTIME.environment_file(bridge_environment) as environment:
            with OUTER_RUNTIME.workload(OUTER_RUNTIME.inspect_image(state.image), state.codex_container,
                    [*terminal_arguments, *command[5:image_index], *environment],
                    command[image_index + 1:]) as process:
                state.agent_process = process
                result = wait_for_agent(state)
            state.codex_container_created = False
        return result
    state.agent_process = OUTER_RUNTIME.popen(command[1:], env=agent_environment)
    try:
        return wait_for_agent(state)
    finally:
        if timing:
            print(f"Sandbox docker run: {time.monotonic() - launch_started:.2f}s", file=sys.stderr)
            report_container_timing(state)


class StartupExecutor(ThreadPoolExecutor):
    def __init__(self, max_workers: int) -> None:
        super().__init__(max_workers=max_workers)
        self.submitted: list[Future[object]] = []

    def submit(self, fn, /, *args, **kwargs):
        future = super().submit(fn, *args, **kwargs)
        self.submitted.append(future)
        return future


@contextmanager
def startup_workers(state: State, max_workers: int) -> Iterator[ThreadPoolExecutor]:
    executor = StartupExecutor(max_workers=max_workers)
    try:
        yield executor
    except BaseException:
        # Close every adapter's creation gate before waiting for in-flight effects.
        for handle in (getattr(state, "gateway_handle", None),
                       getattr(state, "keychain_handle", None)):
            if handle is not None:
                handle.cancelled.set()
        executor.shutdown(wait=False, cancel_futures=True)
        raise
    finally:
        # Signal handlers must not unwind cleanup while a worker creates resources.
        state.joining_workers = True
        try:
            pending = set(executor.submitted)
            while pending:
                _, pending = wait(pending, timeout=0.1)
                if state.deferred_signal is not None:
                    for handle in (getattr(state, "gateway_handle", None),
                                   getattr(state, "keychain_handle", None)):
                        if handle is not None:
                            handle.cancelled.set()
                    for future in pending:
                        future.cancel()
            executor.shutdown(wait=True, cancel_futures=True)
        finally:
            state.joining_workers = False
        if state.deferred_signal is not None:
            raise SignalExit(state.deferred_signal)


def execute(state: State) -> int:
    started = time.monotonic()
    timings: list[tuple[str, float]] = []

    def phase(name: str, action: Callable[[], object]) -> object:
        phase_started = time.monotonic()
        try:
            return action()
        except OSError as error:
            raise LauncherError(f"{name} failed: {error}") from error
        finally:
            timings.append((name, time.monotonic() - phase_started))

    phase("repository validation", lambda: validate_repository(state))
    if host_pi_enabled():
        phase("host session selection", lambda: prepare_host_session(state))
    phase("relay recovery", lambda: recover_relays(state))
    phase("proxy lock", lambda: acquire_lock(state))
    if state.proxy_lock.shared:
        phase("accepted session discovery", lambda: load_accepted_session(state))
        print(
            "notice: Reusing accepted sandbox image and proxies; repository image changes "
            "apply after all attached sessions exit.",
            file=sys.stderr,
        )
    else:
        phase("repository policy", lambda: load_repository_policy(state))
        print(
            "notice: Preparing sandbox image and proxies from current repository policy; "
            "a cold build may take several minutes.",
            file=sys.stderr,
        )
        if (OUTER_RUNTIME.provider != 'lima-docker' and
                (state.repository / '.agents/sandbox/bake').is_file() and
                not (state.repository / '.agents/sandbox/base-image').is_file()):
            raise LauncherError('repository uses Bake images; select CODEX_SANDBOX_RUNTIME=lima-docker')
    phase("skill staging", lambda: stage_skills(state))
    phase("host Pi resources", lambda: prepare_host_pi_resources(state))
    if isinstance(OUTER_RUNTIME, VMRuntime):
        phase("Lima share preflight", lambda: preflight_lima(state))
        state.github_credential = phase("GitHub boot credential", lambda: boot_credential(OUTER_RUNTIME))
    register_tmux_pane(state)
    sidecar_selected = bool(
        getattr(state, "capabilities", {"host-editor", "nested-containers"})
        or _secure_codex_auth_directory(state)
    )
    def model_image() -> str:
        builder = state.repository / ".agents/sandbox/base-image"
        if builder.is_file() and os.access(builder, os.X_OK):
            base_image = phase(
                "base image resolution",
                lambda: run([str(builder)], capture=True, cwd=state.repository, builder=True).stdout.strip(),
            )
            if isinstance(OUTER_RUNTIME, VMRuntime):
                base_image = OUTER_RUNTIME.builder_image(base_image)
        else:
            base_image = DEFAULT_BASE
        return phase(
            "model image resolution",
            lambda: resolve_agent(OUTER_RUNTIME, state.uid, state.gid, base_image),
        )

    prepared = None
    if OUTER_RUNTIME.provider == 'lima-docker' and not state.proxy_lock.shared:
        # Preparation owns all builder groups before container workers start.
        manifest = json.loads(state.manifest.read_text())
        prepared = phase('image preparation', lambda: prepare_launch_images(
            OUTER_RUNTIME, state.repository, manifest['commands'], include_base=True,
            auth_builder=(([
                str(DOTFILES / 'tools/codex-sandbox/auth-proxy/image')
            ], DOTFILES) if sidecar_selected else None),
            image_policy=manifest.get('images')))
        state.image = phase(
            'model image resolution',
            lambda: resolve_agent(OUTER_RUNTIME, state.uid, state.gid, prepared.base),
        )

    def optional_relay(name: str, action: Callable[[], object]) -> None:
        try:
            phase(name, action)
        except Exception as error:
            print(f"warning: {name} failed: {error}", file=sys.stderr)

    # Keep these jobs owned until session exit so cleanup cannot race creation.
    with startup_workers(state, max_workers=6) as executor:
        model_future = (None if prepared or state.proxy_lock.shared else executor.submit(model_image))
        sidecar_future = (None if prepared or state.proxy_lock.shared or not sidecar_selected else
                          executor.submit(phase, "sidecar image resolution", resolve_sidecar_image))
        network_future = executor.submit(phase, "network setup", ensure_network)
        gateway_future = executor.submit(
            phase, "gateway network setup", lambda: prepare_gateway(state),
        )
        if not state.proxy_lock.shared:
            state.sidecar_image = prepared.auth if prepared else (
                sidecar_future.result() if sidecar_future is not None else ""
            )
        keychain_future = (executor.submit(phase, 'Keychain relay startup', lambda: start_keychain(state))
                           if "flower-r2" in getattr(state, "capabilities", {"flower-r2"}) else None)
        network_future.result()
        if prepared is not None:
            state.prepared_images = temporary_file()
            state.prepared_images.write_text(json.dumps(prepared.proxies))
        proxy_future = executor.submit(
            phase, "proxy startup", lambda: attach_proxies(state),
        )
        gateway_arguments = gateway_future.result()
        if getattr(state, "gateway_handle", None) is not None:
            executor.submit(optional_relay, "gateway startup", lambda: start_gateway(state))
        sidecar_arguments = proxy_future.result()
        if model_future is not None:
            state.image = model_future.result()
        keychain_arguments = keychain_future.result() if keychain_future is not None else []
        host_pi = host_pi_enabled()
        agent_command = (["node", "/opt/agent-tools/bin/tool-worker.mjs"] if host_pi else
                         OUTER_RUNTIME.agent_command(state.image, state.codex_arguments)
                         if isinstance(OUTER_RUNTIME, VMRuntime) else state.codex_arguments)
        arguments = [*gateway_arguments, *keychain_arguments, state.image,
                     *agent_command]
        system = run(["uname", "-s"], capture=True).stdout.strip()
        if system == "Linux":
            print(
                "warning: native Linux sandboxing disables sudo elevation with cap-drop=ALL and no-new-privileges.\n"
                "warning: a Podman Machine micro-VM would allow container sudo without weakening host isolation.",
                file=sys.stderr,
            )
            arguments = ["--cap-drop=ALL", "--security-opt=no-new-privileges", *arguments]
        arguments = [*sidecar_arguments, *arguments]
        if os.environ.get("CODEX_SANDBOX_TIMING"):
            detail = ", ".join(f"{name}={elapsed:.2f}s" for name, elapsed in timings)
            print(f"Sandbox preparation: {time.monotonic() - started:.2f}s ({detail})", file=sys.stderr)
        return run_agent(state, arguments, host_pi=True) if host_pi else run_agent(state, arguments)


def preflight_lima(state: State) -> None:
    # Check sources before builds or container/network creation. Container
    # overlays still determine which parts of a shared source the agent sees.
    writable = [state.repository, state.skills_source, *state.metadata_roots]
    pi_agent = state.home / ".pi/agent"
    for name in ("sessions", "npm", "git"):
        directory = pi_agent / name
        if directory.is_symlink() or (directory.exists() and not directory.is_dir()):
            raise LauncherError(f"Pi persistent directory is invalid: {directory}")
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        writable.append(directory)
    readable = [state.home / "src", DOTFILES, state.skills_tmp,
                state.home / ".codex/config.toml"]
    host_pi_package = getattr(state, "host_pi_package", None)
    if host_pi_package is not None:
        readable += [host_pi_package / relative for relative in PI_RESOURCE_PATHS]
    if state.zuliprc is not None:
        readable.append(state.zuliprc)
    if _secure_codex_auth_directory(state) is not None:
        writable.append(state.codex_auth_directory)
    if state.agent_podman is not None:
        readable += [state.agent_podman_key, state.agent_podman_known_hosts]
    home = state.home.resolve(strict=True)
    for path in [*writable, *readable]:
        if home.is_relative_to(path.resolve(strict=True)):
            raise LauncherError(f"refusing to mount the whole home directory into a container: {path}")
    OUTER_RUNTIME.host.check_binds([
        *((path, True) for path in writable), *((path, False) for path in readable)])


def cleanup_resource(label: str, arguments: list[str]) -> bool:
    started = time.monotonic()
    try:
        result = run(arguments, check=False, quiet=True)
    except (OSError, ValueError):
        result = None
    elapsed = int(time.monotonic() - started)
    if result is None or result.returncode:
        print(f"warning: Cleaning up {label} failed after {elapsed}s.", file=sys.stderr)
    elif elapsed:
        print(f"Cleaning up {label}: done ({elapsed}s).", file=sys.stderr)
    return result is not None and result.returncode == 0


def cleanup(state: State) -> bool:
    if state.cleaned:
        return state.cleanup_succeeded
    state.cleaned = True
    cleanup_started = time.monotonic()
    previous = cleanup_started

    def timing(label: str) -> None:
        nonlocal previous
        now = time.monotonic()
        if os.environ.get("CODEX_SANDBOX_TIMING"):
            print(f"Sandbox cleanup: {label}={now - previous:.2f}s", file=sys.stderr)
        previous = now
    containers = []
    if state.codex_container_created:
        containers.append((
            f"Codex container {state.codex_container}",
            ["docker", "rm", "--force", state.codex_container],
        ))
    with ThreadPoolExecutor(max_workers=max(1, len(containers))) as executor:
        container_results = list(executor.map(lambda item: cleanup_resource(*item), containers))
    timing("containers")

    timing("host relays")
    networks = []
    def remove_network(item):
        if isinstance(OUTER_RUNTIME, VMRuntime):
            try:
                presence = resource_presence(
                    OUTER_RUNTIME, ResourceKind.NETWORK, item[1][-1], state.resource_owner,
                    authority=ResourceOwnerAuthority.RELAY,
                )
                if presence is ResourcePresence.ABSENT:
                    return True
                if presence is ResourcePresence.MISMATCHED:
                    raise LauncherError("relay network belongs to another creator")
            except (LauncherError, ValueError, OSError, subprocess.SubprocessError) as error:
                print(f"warning: {item[0]} retained: {error}", file=sys.stderr)
                return False
        return cleanup_resource(*item)

    with ThreadPoolExecutor(max_workers=max(1, len(networks))) as executor:
        network_results = list(executor.map(remove_network, networks))
    keychain_handle = getattr(state, 'keychain_handle', None)
    keychain_result = keychain_handle.cleanup(0) if keychain_handle is not None else None
    if keychain_result is not None:
        for failure in keychain_result.failures:
            print(f"warning: Cleaning up Keychain resource {failure.identity} failed ({failure.code}).",
                  file=sys.stderr)
        if keychain_result.remaining:
            try:
                path = persist_relay_recovery(
                    state, keychain_handle.resources, keychain_handle.owner,
                    keychain_result.remaining,
                )
                if path is not None:
                    print(f"warning: Keychain recovery state retained at {path}", file=sys.stderr)
            except (OSError, LauncherError) as error:
                print(f"warning: Keychain recovery state could not be persisted: {error}",
                      file=sys.stderr)
    gateway_result = (state.gateway_handle.cleanup(0)
                      if state.gateway_handle is not None else None)
    if gateway_result is not None:
        for failure in gateway_result.failures:
            print(f"warning: Cleaning up gateway resource {failure.identity} failed ({failure.code}).",
                  file=sys.stderr)
        if gateway_result.remaining:
            try:
                path = persist_relay_recovery(
                    state, state.gateway_handle.resources, state.gateway_handle.owner,
                    gateway_result.remaining,
                )
                if path is not None:
                    print(f"warning: gateway recovery state retained at {path}", file=sys.stderr)
            except (OSError, LauncherError) as error:
                print(f"warning: gateway recovery state could not be persisted: {error}", file=sys.stderr)
    timing("gateway")
    keep_scratch = (isinstance(OUTER_RUNTIME, VMRuntime)
                    and (not all([*container_results, *network_results])
                         or bool(gateway_result and gateway_result.remaining)
                         or bool(keychain_result and keychain_result.remaining)))
    if keep_scratch:
        state.recovery_record = temporary_file()
        recovery = {"runtime": runtime_identity(OUTER_RUNTIME),
            "owner": state.resource_owner, "containers": [item[1][-1] for item in containers],
            "networks": [item[1][-1] for item in networks],
            "skills": str(state.skills_tmp), "agent-state": str(state.pi_agent_tmp),
            "shared-state": str(state.proxy_state)}
        state.recovery_record.write_text(json.dumps(recovery))
        print(f"Lima cleanup incomplete; recovery state retained at {state.recovery_record}", file=sys.stderr)
    timing("networks")
    if state.skills_tmp is not None and not keep_scratch:
        removal_started = time.monotonic()
        try:
            shutil.rmtree(state.skills_tmp)
        except OSError:
            elapsed = int(time.monotonic() - removal_started)
            print(f"warning: Cleaning up staged skills {state.skills_tmp} failed after {elapsed}s.", file=sys.stderr)
    timing("skills")
    if state.pi_agent_tmp is not None and not keep_scratch:
        removal_started = time.monotonic()
        try:
            shutil.rmtree(state.pi_agent_tmp)
        except OSError:
            elapsed = int(time.monotonic() - removal_started)
            print(f"warning: Cleaning up private Pi state {state.pi_agent_tmp} failed after {elapsed}s.", file=sys.stderr)
    timing("Pi state")
    if state.proxy_lock is not None:
        state.proxy_lock.close()
    for path in (
        state.proxy_state, state.proxy_args, state.manifest, state.pi_auth_mask,
        state.prepared_images, getattr(state, "cd_request", None),
    ):
        if path is not None and not keep_scratch:
            path.unlink(missing_ok=True)
    timing("temporary files")
    if os.environ.get("CODEX_SANDBOX_TIMING"):
        print(f"Sandbox cleanup total: {time.monotonic() - cleanup_started:.2f}s", file=sys.stderr)
    state.cleanup_succeeded = (all([*container_results, *network_results])
                               and not bool(gateway_result and gateway_result.remaining)
                               and not bool(keychain_result and keychain_result.remaining))
    return state.cleanup_succeeded


def login_codex_sidecar() -> int:
    home = Path(os.environ["HOME"])
    directory = Path(os.environ.get("CODEX_SANDBOX_AUTH_DIR", home / ".codex-sandbox-auth"))
    if directory.exists() and (directory.is_symlink() or not directory.is_dir()):
        raise LauncherError(f"Codex sandbox authentication directory is invalid: {directory}")
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(directory, 0o700)
    environment = os.environ.copy()
    environment["CODEX_HOME"] = str(directory)
    return subprocess.run(["codex", "login"], env=environment).returncode


def tmux_registrations() -> list[dict[str, object]]:
    result = run([
        "tmux", "list-panes", "-a", "-F",
        "#{pane_dead}\t#{pane_pid}\t#{@codex_sandbox_restart}",
    ], capture=True)
    registrations = []
    for line in result.stdout.splitlines():
        fields = line.split("\t", 2)
        if len(fields) != 3 or not fields[2]:
            continue
        dead_text, pid_text, encoded = fields
        try:
            payload = json.loads(base64.urlsafe_b64decode(encoded).decode())
            pid = int(pid_text) if pid_text else None
        except (ValueError, UnicodeError, json.JSONDecodeError) as error:
            raise LauncherError("tmux contains an invalid sandbox restart registration") from error
        dead = dead_text == "1"
        if dead_text not in {"0", "1"} or (not dead and (pid is None or pid <= 1)) \
                or not isinstance(payload, dict) or set(payload) != {
            "version", "pane", "repository", "session", "token",
        } or payload["version"] != 1 or not all(
            isinstance(payload[field], str) and payload[field]
            for field in ("pane", "repository", "session", "token")
        ):
            raise LauncherError("tmux contains an invalid sandbox restart registration")
        registrations.append({**payload, "dead": dead, "pid": pid})
    return registrations


def restart_all_tmux_sessions() -> int:
    if "TMUX" not in os.environ:
        raise LauncherError("restart-all must run inside tmux")
    registrations = tmux_registrations()
    if not registrations:
        raise LauncherError("tmux has no registered sandbox sessions")
    for registration in registrations:
        remain_on_exit = run([
            "tmux", "show-options", "-A", "-p", "-v", "-t", registration["pane"],
            "remain-on-exit",
        ], capture=True).stdout.strip()
        if remain_on_exit not in {"0", "1", "off", "on"}:
            raise LauncherError("tmux returned an invalid remain-on-exit setting")
        registration["remain_on_exit"] = remain_on_exit
        run([
            "tmux", "set-option", "-p", "-t", registration["pane"],
            "remain-on-exit", "on",
        ])
        if not registration["dead"]:
            os.kill(registration["pid"], signal.SIGTERM)
    panes = {registration["pane"] for registration in registrations}
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        active = {
            registration["pane"]
            for registration in tmux_registrations()
            if not registration["dead"]
        }
        if not panes.intersection(active):
            break
        time.sleep(0.1)
    else:
        raise LauncherError("sandbox panes did not stop within 15 seconds")
    for repository in sorted({str(item["repository"]) for item in registrations}):
        helper("reset", "--repo", repository)
    for registration in registrations:
        command = (
            shlex.join(["cd", registration["repository"]])
            + " && "
            + shlex.join(["pi", "--session", registration["session"]])
        )
        run(["tmux", "respawn-pane", "-k", "-t", registration["pane"], command])
        run([
            "tmux", "set-option", "-p", "-t", registration["pane"],
            "remain-on-exit", registration["remain_on_exit"],
        ])
    message = f"Restarted {len(registrations)} sandbox session(s)."
    run(["tmux", "display-message", "-d", "5000", message], check=False, quiet=True)
    print(message)
    return 0


def main(arguments: list[str]) -> int:
    with verification_scope():
        return launch(arguments)


def launch(arguments: list[str]) -> int:
    global OUTER_RUNTIME
    if len(arguments) == 2 and arguments[0] == "validate-cd":
        try:
            # Validation is read-only even when an agent shell supplied jj author overrides.
            os.environ.pop("JJ_USER", None)
            os.environ.pop("JJ_EMAIL", None)
            os.environ["JJ_AGENT"] = "none"
            destination = Path(arguments[1]).expanduser().resolve(strict=True)
            if not destination.is_dir():
                raise LauncherError("The destination is not a directory")
            os.chdir(destination)
            checked = new_state([])
            validate_repository(checked, initialize_missing=False)
            print(json.dumps({"destination": str(checked.host_working_directory),
                              "repository": str(checked.repository)}))
            return 0
        except (LauncherError, OSError, ValueError, subprocess.CalledProcessError) as error:
            print(f"error: {error}", file=sys.stderr)
            return 1
    if arguments == ["restart-all"]:
        try:
            return restart_all_tmux_sessions()
        except (LauncherError, OSError, subprocess.CalledProcessError) as error:
            message = f"Sandbox restart failed: {error}"
            if "TMUX" in os.environ:
                try:
                    run([
                        "tmux", "display-message", "-d", "8000", message,
                    ], check=False, quiet=True)
                except OSError:
                    pass
            print(f"error: {error}", file=sys.stderr)
            return 1
    if arguments == ["auth", "login"]:
        try:
            return login_codex_sidecar()
        except (LauncherError, OSError) as error:
            print(f"error: {error}", file=sys.stderr)
            return 1
    state: State | None = None
    previous_handlers: dict[int, object] = {}

    def handle_signal(signum: int, _frame: object) -> None:
        if state is not None and state.joining_workers:
            state.deferred_signal = signum
            if getattr(state, "gateway_handle", None) is not None:
                state.gateway_handle.cancelled.set()
            return
        raise SignalExit(signum)

    try:
        OUTER_RUNTIME = image_runtime()
        proxy_module.cache_clear()
        for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
            previous_handlers[signum] = signal.signal(signum, handle_signal)
        next_arguments = arguments
        handoff_origin = None
        while True:
            state = new_state(next_arguments)
            state.handoff_origin = handoff_origin
            result = execute(state)
            request = (read_cd_request(state)
                       if result == 0 and host_pi_enabled()
                       else None)
            if request is None:
                return result
            if not cleanup(state):
                raise LauncherError("Old sandbox cleanup failed; directory handoff stopped")
            unregister_tmux_pane(state)
            origin = state.host_working_directory
            prior_arguments = state.codex_arguments
            state = None
            destination, session = request
            os.chdir(destination)
            handoff_origin = origin
            session_dir_arguments = []
            if prior_arguments.count("--session-dir") == 1:
                index = prior_arguments.index("--session-dir")
                if index + 1 < len(prior_arguments):
                    session_dir = Path(prior_arguments[index + 1]).expanduser()
                    if not session_dir.is_absolute():
                        session_dir = origin / session_dir
                    session_dir_arguments = ["--session-dir", str(session_dir)]
            next_arguments = [*session_dir_arguments,
                              *(["--fork", str(session)] if session is not None else []),
                              "--session-id", str(uuid.uuid4())]
    except SignalExit as error:
        return 128 + error.signum
    except (LauncherError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as error:
        diagnostic = error.stderr
        if isinstance(diagnostic, bytes):
            diagnostic = diagnostic.decode(errors='replace')
        print(diagnostic.rstrip() if diagnostic else f'error: {error}', file=sys.stderr)
        return error.returncode
    except OSError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    finally:
        for signum in previous_handlers:
            signal.signal(signum, signal.SIG_IGN)
        if state is not None:
            cleanup(state)
            unregister_tmux_pane(state)
        for signum, handler in previous_handlers.items():
            signal.signal(signum, handler)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
