def prepare_agent_mountpoints(state: State) -> None:
    # Linux uidmapped virtiofs leaves rootless runc unable to create a nested
    # mountpoint inside this host-owned, private bind. Create them beforehand.
    agent = Path("/home/codex/.pi/agent")
    for role, (_, destination) in STAGED_CONFIG.items():
        target = Path(destination)
        if not target.is_relative_to(agent):
            continue
        source = staged_config_path(state, role)
        mountpoint = state.pi_agent_tmp / target.relative_to(agent)
        mountpoint.parent.mkdir(parents=True, exist_ok=True)
        if source.is_dir():
            mountpoint.mkdir(exist_ok=True)
        else:
            mountpoint.touch(mode=0o600)
    (state.pi_agent_tmp / "pi-extensions").mkdir(exist_ok=True)
    (state.pi_agent_tmp / "pi-link").mkdir(exist_ok=True)
    (state.pi_agent_tmp / "extensions/codex-sidecar").mkdir(parents=True, exist_ok=True)
    for relative in PI_SESSION_DIRS:
        (state.pi_agent_tmp / relative).mkdir(parents=True, exist_ok=True)


def host_pi_resource_paths(state: State) -> dict[str, str]:
    paths = {
        str(state.home / source.removeprefix("$HOME/")): destination
        for source, destination in STAGED_CONFIG.values()
    }
    paths[str(state.home / ".pi/agent/pi-link")] = "/home/codex/.pi/agent/pi-link"
    paths[str(state.home / ".agents/skills")] = str(GUEST_AGENT_SKILLS)
    paths[str(state.home / ".agents/sandbox")] = "/home/codex/.agents/sandbox"
    paths.update({
        str(state.home / ".pi/agent" / relative): str(Path("/home/codex/.pi/agent") / relative)
        for relative in PI_SESSION_DIRS
    })
    paths.update({
        str(state.host_pi_package / relative): str(GUEST_PI_PACKAGE / relative)
        for relative in PI_RESOURCE_PATHS
    })
    source_root = (state.home / "src").resolve()
    paths[str(source_root)] = "/src"
    paths[str(state.repository)] = str(state.container_repository)
    paths.update({str(workspace.host_root): str(workspace.guest_root)
                  for workspace in getattr(state, "workspaces", [])})
    # Pi reads this host file, but the worker no longer stages an unused copy.
    # Advertise its authoritative source when the source view exposes it.
    agents_source = installed_config_source("$HOME/.pi/agent/AGENTS.md")
    for host_root, guest_root in (
        *((workspace.host_root, workspace.guest_root)
          for workspace in getattr(state, "workspaces", [])),
        (state.repository, state.container_repository), (source_root, Path("/src")),
    ):
        if agents_source.is_relative_to(host_root):
            paths[str(state.home / ".pi/agent/AGENTS.md")] = str(
                guest_root / agents_source.relative_to(host_root)
            )
            break
    return paths


def _workspace_mount_plan(state: State) -> dict[Path, tuple[Path, bool]]:
    workspaces = state.workspaces
    mounts: dict[Path, tuple[Path, bool]] = {}

    def add(source: Path, target: Path, readonly: bool) -> None:
        if target in mounts and mounts[target] != (source, readonly):
            raise LauncherError(f"Conflicting workspace mount destination: {target}")
        mounts[target] = (source, readonly)

    for workspace in workspaces:
        add(workspace.host_root, workspace.guest_root, False)
        for alias in workspace.repository_aliases():
            add(workspace.host_root, alias, True)
        for source, target in workspace.metadata_mounts():
            add(source, target, True)
        policy = workspace.host_root / ".agents/sandbox"
        agents = workspace.host_root / ".agents"
        if agents.is_symlink():
            raise LauncherError(f"Invalid sandbox policy parent: {agents}")
        if policy.exists() or policy.is_symlink():
            if policy.is_symlink() or not policy.is_dir():
                raise LauncherError(f"Invalid sandbox policy directory: {policy}")
            add(policy, workspace.guest_root / ".agents/sandbox", True)

    # A backing store may also be visible inside another writable workspace.
    # Overlay each such alias, rather than trusting its primary mount alone.
    protected = [(target, entry) for target, entry in mounts.items()
                 if entry[0] not in {workspace.host_root for workspace in workspaces}]
    for _, (source, readonly) in protected:
        if not readonly:
            continue
        for workspace in workspaces:
            if readonly and workspace.host_root.is_relative_to(source):
                raise LauncherError(f"Writable workspace is inside protected metadata: {workspace.host_root}")
            if source.is_relative_to(workspace.host_root):
                add(source, workspace.guest_root / source.relative_to(workspace.host_root), True)
    skills_source = getattr(state, "skills_source", None)
    if skills_source is not None:
        for _, (source, readonly) in protected:
            if readonly and source.is_relative_to(skills_source):
                add(source, GUEST_AGENT_SKILLS / source.relative_to(skills_source), True)
    return mounts


def agent_repository_mounts(state: State) -> list[str]:
    """Assemble one source view, then writable roots and protected overlays."""
    cached = getattr(state, "repository_mount_arguments", None)
    if cached is not None:
        return list(cached)
    if not getattr(state, "workspaces", None):
        raise LauncherError("Validated workspace authority is missing")
    mounts = _workspace_mount_plan(state)
    try:
        view = source_mounts(state.home / "src", list(mounts), state.skills_tmp / "source-view")
        # Source-view split binds can coincide with an explicit overlay; retain
        # only the latter, which owns the final access mode for that destination.
        result = []
        for index in range(0, len(view), 2):
            target = next(field[4:] for field in view[index + 1].split(",") if field.startswith("dst="))
            if Path(target) not in mounts:
                result.extend(view[index:index + 2])
        for target, (source, readonly) in sorted(mounts.items(), key=lambda item: len(item[0].parts)):
            options = "readonly" if readonly else OUTER_RUNTIME.nonrecursive_bind
            if readonly and source in {workspace.host_root for workspace in state.workspaces}:
                options += "," + OUTER_RUNTIME.nonrecursive_bind
            result += ["--mount", f"type=bind,src={source},dst={target},{options}"]
        check_mount_destinations(result)
        state.repository_mount_arguments = result
        return list(result)
    except ValueError as error:
        raise LauncherError(str(error)) from error



def tic_guard_arguments(state: State, command: list[str]) -> list[str]:
    # Accepted images can predate the image-owned guard while retaining the same
    # Pi revision. Stage independently of image selection and Tic availability.
    directory = state.skills_tmp.resolve(strict=True)
    metadata = directory.stat()
    if metadata.st_uid != os.getuid() or metadata.st_mode & 0o022:
        raise LauncherError('TicGit guard scratch directory has unsafe ownership or permissions')
    guard = directory / 'tic-guard'
    if any(character in str(guard) for character in ',\0\r\n'):
        raise LauncherError('TicGit guard path contains a mount delimiter')
    for index, argument in enumerate(command[:-1]):
        if argument != '--mount':
            continue
        fields = command[index + 1].split(',')
        options = dict(field.split('=', 1) for field in fields if '=' in field)
        if (options.get('type') != 'bind' or 'readonly' in fields or 'ro' in fields
                or options.get('readonly') == 'true'):
            continue
        source = options.get('src', options.get('source'))
        if source is None:
            raise LauncherError('guest-writable bind has no source')
        if guard.is_relative_to(Path(source).resolve(strict=True)):
            raise LauncherError('TicGit guard scratch overlaps a guest-writable mount')
    encoded = Path(__file__).resolve().with_name('image').joinpath('ti').read_bytes()
    if not guard.exists() and not guard.is_symlink():
        with guard.open('xb') as stream:
            stream.write(encoded)
            os.fchmod(stream.fileno(), 0o555)
    metadata = guard.lstat()
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid()
            or metadata.st_nlink != 1 or stat.S_IMODE(metadata.st_mode) != 0o555
            or guard.read_bytes() != encoded):
        raise LauncherError('TicGit staged guard identity or permissions mismatch')
    if isinstance(OUTER_RUNTIME, VMRuntime):
        OUTER_RUNTIME.check_binds([(str(guard), False)])
    arguments = ['--mount', f'type=bind,src={guard},dst=/libexec/sandbox-wrappers/ti,readonly']
    if not getattr(state, 'tic_environment', {}):
        # Also clear stale image-baked values, not just inherited host values.
        arguments += ['--env', 'SANDBOX_TIC_ENDPOINT=', '--env', 'SANDBOX_TIC_TOKEN=']
    return arguments


def build_agent_command(
    state: State, arguments: list[str], *, timing: bool,
    resource_paths: dict[str, str], guest_working_directory: Path,
    pi_extensions: Path,
) -> list[str]:
    """Construct and validate the agent container command without starting it."""
    command = [
        "docker", "run", "--name", state.codex_container,
        "--cap-drop=NET_RAW",
        "--network", SANDBOX_NETWORK, *proxy_flags(),
        *(["--mount", f"type=bind,src={state.github_credential},dst=/run/secrets/github-token,readonly",
           "--entrypoint", "/opt/agent-tools/bin/with-github-token"] if isinstance(OUTER_RUNTIME, VMRuntime) and state.github_credential is not None
          else (["--secret", "codex-github-token,type=env,target=GH_TOKEN", "--entrypoint", "node"]
                if not isinstance(OUTER_RUNTIME, VMRuntime) else ["--entrypoint", "node"])),
        "--env", "JJ_AGENT=pi",
        "--env", "CODEX_SANDBOX_TOOL_WORKER=1",
        "--env", "PI_MODEL_FILE=/home/codex/.pi/agent/runtime-model.json",
        "--env", f"PI_MODEL_SESSION_ID={state.pi_model_session_id}",
        "--env", f"TERM={state.term}",
        *(["--env", "PI_TIMING=1"] if timing else []),
        "--mount", f"type=bind,src={state.pi_agent_tmp},dst=/home/codex/.pi/agent",
        # Main and subagent Pi write on the host; expose their session stores read-only.
        *[
            item
            for relative in PI_SESSION_DIRS
            for item in (
                "--mount",
                f"type=bind,src={state.home / '.pi/agent' / relative},"
                f"dst={resource_paths[str(state.home / '.pi/agent' / relative)]},readonly",
            )
        ],
        "--mount", f"type=bind,src={state.skills_source},"
        f"dst={resource_paths[str(state.home / '.agents/skills')]}",
        *[
            item
            for relative in PI_RESOURCE_PATHS
            for item in (
                "--mount",
                f"type=bind,src={state.host_pi_package / relative},"
                f"dst={resource_paths[str(state.host_pi_package / relative)]},readonly",
            )
        ],
        *(
            ["--mount", f"type=bind,src={state.skills_tmp / 'sandbox'},dst=/home/codex/.agents/sandbox,readonly"]
            if (state.skills_tmp / "sandbox").is_dir() else []
        ),
        *[
            item
            for role, (source, _) in STAGED_CONFIG.items()
            for item in (
                "--mount",
                f"type=bind,src={staged_config_path(state, role)},"
                f"dst={resource_paths[str(state.home / source.removeprefix('$HOME/'))]},readonly",
            )
        ],
        "--mount", f"type=bind,src={pi_extensions},dst=/home/codex/.pi/agent/pi-extensions,readonly",
        "--mount", f"type=bind,src={installed_config_source('$HOME/.pi/agent/pi-link')},"
        f"dst={resource_paths[str(state.home / '.pi/agent/pi-link')]},readonly",
        "--mount", f"type=bind,src={state.home / '.codex/config.toml'},dst=/home/codex/.codex/config.toml,readonly",
        "--mount", f"type=bind,src={installed_config_source('$HOME/.config/git/ignore')},dst=/home/codex/.gitignore,readonly",
        "--mount", f"type=bind,src={installed_config_source('$HOME/.codex/dotfiles.config.toml')},dst=/home/codex/.codex/dotfiles.config.toml,readonly",
        "--mount", f"type=bind,src={installed_config_source('$HOME/.codex/developer-instructions.md')},dst=/home/codex/.codex/developer-instructions.md,readonly",
        "--mount", f"type=bind,src={installed_config_source('$HOME/.codex/breq.md')},dst=/home/codex/.codex/breq.md,readonly",
        *agent_repository_mounts(state),
        "--workdir", str(guest_working_directory),
        *arguments,
    ]
    # This is a fixed unavailable/forwarding guard, not a live TicGit client or
    # network projection. Bind it even for opt-out and failed startup, including
    # when reusing accepted images that lack the current image-owned wrapper.
    argument_index = len(command) - len(arguments)
    command[argument_index:argument_index] = tic_guard_arguments(state, command)
    try:
        check_mount_destinations(command)
    except ValueError as error:
        raise LauncherError(str(error)) from error
    return command


def run_agent(state: State, arguments: list[str]) -> int:
    setup_started = time.monotonic()
    timing = bool(os.environ.get("CODEX_SANDBOX_TIMING"))
    state.codex_container_created = True
    pi_agent = state.home / ".pi/agent"
    if pi_agent.exists() and (pi_agent.is_symlink() or not pi_agent.is_dir()):
        raise LauncherError(f"Pi agent directory is invalid: {pi_agent}")
    pi_agent.mkdir(mode=0o700, parents=True, exist_ok=True)
    for relative in PI_SESSION_DIRS:
        sessions = pi_agent / relative
        if sessions.is_symlink() or (sessions.exists() and not sessions.is_dir()):
            raise LauncherError(f"Pi persistent directory is invalid: {sessions}")
        sessions.mkdir(mode=0o700, parents=True, exist_ok=True)
    pi_extensions = DOTFILES / "config/pi-agent/pi-extensions"
    if not pi_extensions.is_dir():
        raise LauncherError(f"Pi extensions directory is missing: {pi_extensions}")
    state.pi_agent_tmp = Path(tempfile.mkdtemp(prefix="codex-private-agent-", dir=scratch_directory()))
    os.chmod(state.pi_agent_tmp, 0o700)
    # Offline Pi needs the host's refreshed catalog. Copy it so tool-worker
    # updates remain private and disappear with the rest of this sandbox state.
    model_catalog = pi_agent / "models-store.json"
    if model_catalog.exists():
        shutil.copyfile(model_catalog, state.pi_agent_tmp / model_catalog.name)
    for directory in ("extensions", "pi-codex-subagents"):
        (state.pi_agent_tmp / directory).mkdir(mode=0o700)
    prepare_agent_mountpoints(state)
    state.pi_model_file = state.pi_agent_tmp / "runtime-model.json"
    state.pi_model_file.write_text(json.dumps({
        "session_id": state.pi_model_session_id,
        "provider": "",
        "modelId": "",
    }) + "\n", encoding="utf-8")
    os.chmod(state.pi_model_file, 0o600)
    pi_resource_paths = host_pi_resource_paths(state)
    container_working_directory = container_working_directory_path(
        state.repository, Path(pi_resource_paths[str(state.repository)]),
        state.host_working_directory,
    )
    command = build_agent_command(
        state, arguments, timing=timing, resource_paths=pi_resource_paths,
        guest_working_directory=container_working_directory,
        pi_extensions=pi_extensions,
    )
    reserved = {
        "CODEX_SANDBOX_KEYCHAIN_ADDRESS", "CODEX_SANDBOX_KEYCHAIN_TOKEN",
        "SANDBOX_TIC_ENDPOINT", "SANDBOX_TIC_TOKEN",
        "DOCKER_HOST", "AGENT_DOCKER_SSHKEY", "AGENT_DOCKER_KNOWN_HOSTS",
    }
    agent_environment = {key: value for key, value in os.environ.items() if key not in reserved}
    bridge_environment: dict[str, str] = {}
    bridge_environment.update(keychain_environment(state))
    bridge_environment.update(getattr(state, 'tic_environment', {}))
    agent_environment.update(bridge_environment)
    image_index = command.index(state.image)
    host_pi_bin = DOTFILES / "tools/codex-sandbox/sandbox-host-pi"
    state.cd_request = temporary_file() if HOST_PI_BOOTSTRAP is None else None
    host_environment = {key: value for key, value in os.environ.items()
                        if key not in {'SANDBOX_TIC_ENDPOINT', 'SANDBOX_TIC_TOKEN'}}
    host_environment.update({
        "CODEX_SANDBOX_TOOL_CONTAINER": state.codex_container,
        "CODEX_SANDBOX_TOOL_CONNECT": str(DOTFILES / "tools/codex-sandbox/sandbox-tool-connect"),
        "CODEX_SANDBOX_GUEST_CWD": str(container_working_directory),
        "CODEX_SANDBOX_GUEST_REPO": str(state.container_repository),
        "CODEX_SANDBOX_CD_VALIDATE": str(DOTFILES / "tools/codex-sandbox/codex-sandbox"),
        "CODEX_SANDBOX_PI_RESOURCE_PATHS": json.dumps(pi_resource_paths),
        "PI_SUBAGENT_PI_BIN": str(host_pi_bin),
        "JJ_AGENT": "pi",
        "PI_MODEL_FILE": str(state.pi_model_file),
        "PI_MODEL_SESSION_ID": state.pi_model_session_id,
    })
    if state.cd_request is not None:
        host_environment["CODEX_SANDBOX_CD_REQUEST"] = str(state.cd_request)
    if state.handoff_origin is not None:
        host_environment["CODEX_SANDBOX_PREVIOUS_CWD"] = str(state.handoff_origin)
    if HOST_PI_BOOTSTRAP is not None:
        from host_pi_owner import HostPiOwner
        global HOST_PI_OWNER
        HOST_PI_OWNER = HostPiOwner(host_pi_bin, state.codex_arguments,
                                    state.host_working_directory, host_environment)
        HOST_PI_OWNER.original.pane = os.environ.get("TMUX_PANE")
    worker_io = {}
    if HOST_PI_BOOTSTRAP is not None:
        from host_pi_owner import OWNER_LOG_FD
        # Startup retains the build terminal, but this transport outlives it.
        worker_io = {"stdin": subprocess.DEVNULL,
                     "stdout": OWNER_LOG_FD, "stderr": OWNER_LOG_FD}
    worker_command = (["node", "/opt/agent-tools/bin/tool-worker.mjs"]
                      if isinstance(OUTER_RUNTIME, VMRuntime)
                      and state.github_credential is not None
                      else ["/opt/agent-tools/bin/tool-worker.mjs"])
    with OUTER_RUNTIME.environment_file(bridge_environment) as environment:
        with OUTER_RUNTIME.workload(
            OUTER_RUNTIME.inspect_image(state.image), state.codex_container,
            [*command[4:image_index], *environment], worker_command, **worker_io,
        ) as worker:
            for _ in range(100):
                if worker.poll() is not None:
                    raise LauncherError("guest tool worker exited during startup")
                ready = OUTER_RUNTIME.run(
                    ["exec", state.codex_container, "test", "-S", "/tmp/codex-tool-worker.sock"],
                    check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
                if ready.returncode == 0:
                    break
                time.sleep(0.1)
            else:
                raise LauncherError("guest tool worker did not become ready")
            if HOST_PI_BOOTSTRAP is not None:
                from host_pi_owner import send
                HOST_PI_OWNER.mark_bootstrapped()
                HOST_PI_OWNER.start()
                try:
                    send(HOST_PI_BOOTSTRAP, HOST_PI_OWNER.launch_spec(HOST_PI_OWNER.original))
                except OSError:
                    HOST_PI_OWNER.drop(HOST_PI_OWNER.original)
                try:
                    HOST_PI_OWNER.wait(worker)
                except RuntimeError as error:
                    raise LauncherError(str(error)) from error
                result = 0
            else:
                state.agent_process = subprocess.Popen(
                    [str(host_pi_bin), *state.codex_arguments],
                    cwd=state.host_working_directory, env=host_environment,
                )
                worker_failed = threading.Event()
                def watch_worker() -> None:
                    worker.wait()
                    if state.agent_process is not None and state.agent_process.poll() is None:
                        worker_failed.set()
                        state.agent_process.terminate()
                threading.Thread(target=watch_worker, daemon=True).start()
                result = wait_for_agent(state)
                if worker_failed.is_set():
                    raise LauncherError("guest tool worker stopped while host Pi was running")
    state.codex_container_created = False
    return result


class StartupExecutor(ThreadPoolExecutor):
    def __init__(self, max_workers: int) -> None:
        super().__init__(max_workers=max_workers)
        self.submitted: list[Future[object]] = []

    def submit(self, fn, /, *args, **kwargs):
        future = super().submit(fn, *args, **kwargs)
        self.submitted.append(future)
        return future


@contextmanager
def startup_workers(state: State, max_workers: int) -> Iterator[ThreadPoolExecutor]:
    executor = StartupExecutor(max_workers=max_workers)
    state.tic_cancelled = threading.Event()
    try:
        yield executor
    except BaseException:
        # Close every adapter's creation gate before waiting for in-flight effects.
        state.tic_cancelled.set()
        for handle in (getattr(state, "gateway_handle", None),
                       getattr(state, "keychain_handle", None)):
            if handle is not None:
                handle.cancelled.set()
        executor.shutdown(wait=False, cancel_futures=True)
        raise
    finally:
        # Signal handlers must not unwind cleanup while a worker creates resources.
        state.joining_workers = True
        try:
            pending = set(executor.submitted)
            while pending:
                _, pending = wait(pending, timeout=0.1)
                if state.deferred_signal is not None:
                    state.tic_cancelled.set()
                    for handle in (getattr(state, "gateway_handle", None),
                                   getattr(state, "keychain_handle", None)):
                        if handle is not None:
                            handle.cancelled.set()
                    for future in pending:
                        future.cancel()
            executor.shutdown(wait=True, cancel_futures=True)
        finally:
            state.joining_workers = False
        if state.deferred_signal is not None:
            raise SignalExit(state.deferred_signal)


def resolve_model_image(state: State, phase=None) -> str:
    if phase is None:
        def phase(_name, action):
            return action()
    builder = state.repository / ".agents/sandbox/base-image"
    if builder.is_file() and os.access(builder, os.X_OK):
        base_image = phase(
            "base image resolution",
            lambda: run([str(builder)], capture=True, cwd=state.repository, builder=True).stdout.strip(),
        )
        if isinstance(OUTER_RUNTIME, VMRuntime):
            base_image = OUTER_RUNTIME.builder_image(base_image)
    else:
        base_image = DEFAULT_BASE
    return phase("model image resolution", lambda: resolve_agent(OUTER_RUNTIME, state.uid, state.gid, base_image))


def prepare_declared_images(state: State, manifest: dict, sidecar_selected: bool):
    if OUTER_RUNTIME.provider != 'lima-docker' and not manifest.get('images'):
        return None
    return prepare_launch_images(
        OUTER_RUNTIME, state.repository, manifest['commands'], include_base=True,
        auth_builder=(([str(DOTFILES / 'tools/codex-sandbox/auth-proxy/image')], DOTFILES)
                      if sidecar_selected else None),
        image_policy=manifest.get('images'))


def prepare_cd_tic(state: State, *, sidecar_selected: bool) -> None:
    if 'tic' not in state.capabilities:
        return
    # Unlike fresh startup's optional service, /cd must finish deterministic
    # builds before its final record permits the old Pi to close.
    # Reuse the normal source-key cache; no broker, relay, or session is started.
    try:
        state.workspaces = discover_launch_workspaces(state.home, state.repository)
    except WorkspaceError as error:
        raise LauncherError(str(error)) from error
    state.skills_source = (state.home / '.agents/skills').resolve(strict=True)
    if not state.skills_source.is_dir():
        raise LauncherError(f'Agent skills directory is invalid: {state.skills_source}')
    _workspace_mount_plan(state)
    build = resolved_tic_build(state)
    try:
        context = inspect_tic_context(build, state.workspaces[0])
        if set(context) != {'user_name', 'user_email', 'namespace'}:
            raise LauncherError('TicGit trusted context returned invalid authority')
    except LauncherError as error:
        # Unsupported optional TicGit context must not prevent Pi from starting.
        # Build/cache and workspace authority errors above remain fatal; target
        # startup repeats inspection and disables TicGit through its usual owner.
        print(f'warning: TicGit unavailable for this session; continuing without it: {error}',
              file=sys.stderr)
    if not sidecar_selected:
        OUTER_RUNTIME.verify_builder_image(resolve_sidecar_image())


def prepare_cd_images(state: State) -> None:
    # Build through the normal image owners, without session locks, attachment
    # release, terminal takeover, or destination service startup. Normal launch
    # revalidates and reuses these content-addressed builds after the handoff.
    try:
        load_repository_policy(state)
        manifest = json.loads(state.manifest.read_text())
        sidecar_selected = bool((state.capabilities - {'tic'}) or _secure_codex_auth_directory(state))
        prepared = prepare_declared_images(state, manifest, sidecar_selected)
        if prepared is not None:
            resolve_agent(OUTER_RUNTIME, state.uid, state.gid, prepared.base)
        else:
            resolve_model_image(state)
            if sidecar_selected:
                resolve_sidecar_image()
            # Legacy proxy builders normally run during attach. Check them now
            # through that same owner, before the source attachment is released.
            module = proxy_module()
            try:
                module.resolve_images(state.repository, manifest)
            except module.ConfigError as error:
                raise LauncherError(str(error)) from error
        prepare_cd_tic(state, sidecar_selected=sidecar_selected)
    finally:
        if state.manifest is not None:
            state.manifest.unlink(missing_ok=True)


def execute(state: State) -> int:
    started = time.monotonic()
    timings: list[tuple[str, float]] = []

    def phase(name: str, action: Callable[[], object]) -> object:
        phase_started = time.monotonic()
        try:
            return action()
        except OSError as error:
            raise LauncherError(f"{name} failed: {error}") from error
        finally:
            timings.append((name, time.monotonic() - phase_started))

    phase("repository validation", lambda: validate_repository(state))
    if hasattr(state, "codex_arguments") and hasattr(state, "host_working_directory"):
        phase("host session selection", lambda: prepare_host_session(state))
    phase("proxy lock", lambda: acquire_lock(state))
    if state.proxy_lock.shared:
        phase("accepted session discovery", lambda: load_accepted_session(state))
        print(
            "notice: Reusing accepted sandbox image and proxies; repository image changes "
            "apply after all attached sessions exit.",
            file=sys.stderr,
        )
    else:
        phase("repository policy", lambda: load_repository_policy(state))
        print(
            "notice: Checking sandbox images and preparing services from current repository policy; "
            "cached resources are reused when valid; builds run only when needed.",
            file=sys.stderr,
        )
        manifest = (json.loads(state.manifest.read_text()) if getattr(state, "manifest", None) is not None
                    else {"commands": {}})
        phase("policy binding", lambda: bind_repository_policy(state, manifest))
    phase("relay recovery", lambda: recover_relays(state))
    phase("skill staging", lambda: stage_skills(state))
    if getattr(state, "workspaces", None):
        phase("workspace mounts", lambda: agent_repository_mounts(state))
    if hasattr(state, "home"):
        phase("host Pi resources", lambda: prepare_host_pi_resources(state))
    if isinstance(OUTER_RUNTIME, VMRuntime):
        phase("Lima share preflight", lambda: preflight_lima(state))
        state.github_credential = phase("GitHub boot credential", lambda: boot_credential(OUTER_RUNTIME))
    register_tmux_pane(state)
    sidecar_selected = bool(
        (getattr(state, "capabilities", {"nested-containers"}) - {'tic'})
        or _secure_codex_auth_directory(state)
    )
    def model_image() -> str:
        return resolve_model_image(state, phase)

    prepared = None
    if not state.proxy_lock.shared:
        # Preparation owns all builder groups before container workers start.
        prepared = phase('image preparation', lambda: prepare_declared_images(state, manifest, sidecar_selected))
        if prepared is not None:
            state.image = phase(
                'model image resolution',
                lambda: resolve_agent(OUTER_RUNTIME, state.uid, state.gid, prepared.base),
            )

    def optional_relay(name: str, action: Callable[[], object]) -> None:
        try:
            phase(name, action)
        except Exception as error:
            print(f"warning: {name} failed: {error}", file=sys.stderr)

    # Keep these jobs owned until session exit so cleanup cannot race creation.
    with startup_workers(state, max_workers=6) as executor:
        model_future = (None if prepared or state.proxy_lock.shared else executor.submit(model_image))
        sidecar_future = (None if prepared or state.proxy_lock.shared or not sidecar_selected else
                          executor.submit(phase, "sidecar image resolution", resolve_sidecar_image))
        network_future = executor.submit(phase, "network setup", ensure_network)
        gateway_future = executor.submit(
            phase, "gateway network setup", lambda: prepare_gateway(state),
        )
        if not state.proxy_lock.shared:
            state.sidecar_image = prepared.auth if prepared else (
                sidecar_future.result() if sidecar_future is not None else ""
            )
        keychain_future = (executor.submit(phase, 'Keychain relay startup', lambda: start_keychain(state))
                           if "flower-r2" in getattr(state, "capabilities", {"flower-r2"}) else None)
        network_future.result()
        if prepared is not None:
            state.prepared_images = temporary_file()
            state.prepared_images.write_text(json.dumps(prepared.proxies))
        proxy_future = executor.submit(
            phase, "proxy startup", lambda: attach_proxies(state),
        )
        gateway_arguments = gateway_future.result()
        if getattr(state, "gateway_handle", None) is not None:
            executor.submit(optional_relay, "gateway startup", lambda: start_gateway(state))
        if model_future is not None:
            state.image = model_future.result()
        # Tic consumes accepted workspace/build authority, not proxy publication.
        # All shared image inputs are settled before either worker can read them.
        tic_future = executor.submit(phase, 'TicGit startup', lambda: start_tic(state))
        sidecar_arguments = proxy_future.result()
        keychain_arguments = keychain_future.result() if keychain_future is not None else []
        tic_arguments = tic_future.result()
        agent_command = ["node", "/opt/agent-tools/bin/tool-worker.mjs"]
        arguments = [*gateway_arguments, *keychain_arguments, *tic_arguments, state.image,
                     *agent_command]
        arguments = [*sidecar_arguments, *arguments]
        if os.environ.get("CODEX_SANDBOX_TIMING"):
            detail = ", ".join(f"{name}={elapsed:.2f}s" for name, elapsed in timings)
            print(f"Sandbox preparation: {time.monotonic() - started:.2f}s ({detail})", file=sys.stderr)
        return run_agent(state, arguments)


def preflight_lima(state: State) -> None:
    # Check sources before builds or container/network creation. Container
    # overlays still determine which parts of a shared source the agent sees.
    writable = [state.repository, state.skills_source, *state.metadata_roots]
    for workspace in getattr(state, "workspaces", []):
        writable += [workspace.host_root, workspace.lock_file]
    writable = list(dict.fromkeys(writable))
    pi_agent = state.home / ".pi/agent"
    for name in ("sessions", "npm", "git"):
        directory = pi_agent / name
        if directory.is_symlink() or (directory.exists() and not directory.is_dir()):
            raise LauncherError(f"Pi persistent directory is invalid: {directory}")
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        writable.append(directory)
    readable = [state.home / "src", DOTFILES, state.skills_tmp,
                state.home / ".codex/config.toml"]
    if getattr(state, "workspaces", None):
        readable.append(proxy_module().runtime_directory(state.repository))
        if getattr(state, "workspaces_file", None) is not None:
            readable.append(state.workspaces_file)
    host_pi_package = getattr(state, "host_pi_package", None)
    if host_pi_package is not None:
        readable += [host_pi_package / relative for relative in PI_RESOURCE_PATHS]
    if state.zuliprc is not None:
        readable.append(state.zuliprc)
    if _secure_codex_auth_directory(state) is not None:
        writable.append(state.codex_auth_directory)
    if state.agent_docker is not None:
        readable += [state.agent_docker_key, state.agent_docker_known_hosts]
    home = state.home.resolve(strict=True)
    for path in [*writable, *readable]:
        if home.is_relative_to(path.resolve(strict=True)):
            raise LauncherError(f"refusing to mount the whole home directory into a container: {path}")
    OUTER_RUNTIME.check_binds([
        *((path, True) for path in writable), *((path, False) for path in readable)])


def cleanup_resource(label: str, arguments: list[str]) -> bool:
    started = time.monotonic()
    try:
        result = run(arguments, check=False, quiet=True)
    except (OSError, ValueError):
        result = None
    elapsed = int(time.monotonic() - started)
    if result is None or result.returncode:
        print(f"warning: Cleaning up {label} failed after {elapsed}s.", file=sys.stderr)
    elif elapsed:
        print(f"Cleaning up {label}: done ({elapsed}s).", file=sys.stderr)
    return result is not None and result.returncode == 0


def defer_proxy_cleanup(state: State) -> bool:
    """Leave a valid published session warm; a detached janitor removes it after idle."""
    if not getattr(state, "completed_successfully", False) or state.repository is None:
        return False
    runtime = proxy_module().runtime_directory(state.repository)
    lease = secrets.token_hex(16)
    lease_path = runtime / "idle-cleanup.lease"
    proxy_module().write_atomic(lease_path, lease)
    os.chmod(lease_path, 0o600)
    try:
        subprocess.Popen(
            [str(PROXY_HELPER), "idle-cleanup", "--repo", str(state.repository),
             "--delay", str(PROXY_IDLE_SECONDS), "--lease", lease],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            close_fds=True, start_new_session=True,
        )
    except OSError:
        try:
            if lease_path.read_text(encoding="utf-8") == lease:
                lease_path.unlink(missing_ok=True)
        except OSError:
            pass
        return False
    return True


def cleanup(state: State) -> bool:
    if state.cleaned:
        return state.cleanup_succeeded
    state.cleaned = True
    cleanup_started = time.monotonic()
    previous = cleanup_started

    def timing(label: str) -> None:
        nonlocal previous
        now = time.monotonic()
        if os.environ.get("CODEX_SANDBOX_TIMING"):
            print(f"Sandbox cleanup: {label}={now - previous:.2f}s", file=sys.stderr)
        previous = now
    containers = []
    if state.codex_container_created:
        containers.append((
            f"Codex container {state.codex_container}",
            ["docker", "rm", "--force", state.codex_container],
        ))
    with ThreadPoolExecutor(max_workers=max(1, len(containers))) as executor:
        container_results = list(executor.map(lambda item: cleanup_resource(*item), containers))
    timing("containers")

    tic_handle = getattr(state, 'tic_handle', None)
    # Admission must close on the owning thread before any independent cleanup
    # can block or fail. stop() still reaps the broker before its provider DAG.
    if tic_handle is not None:
        tic_handle.revoke()
    state.tic_environment = {}

    def stop_tic():
        started = time.monotonic()
        try:
            return tic_handle.stop(0) if tic_handle is not None else None
        finally:
            if os.environ.get("CODEX_SANDBOX_TIMING"):
                print(f"Sandbox cleanup: TicGit teardown={time.monotonic() - started:.2f}s (overlapped)",
                      file=sys.stderr)

    with ThreadPoolExecutor(max_workers=1) as tic_cleanup:
        tic_future = tic_cleanup.submit(stop_tic)
        networks = []
        def remove_network(item):
            if isinstance(OUTER_RUNTIME, VMRuntime):
                try:
                    presence = resource_presence(
                        OUTER_RUNTIME, ResourceKind.NETWORK, item[1][-1], state.resource_owner,
                        authority=ResourceOwnerAuthority.RELAY,
                    )
                    if presence is ResourcePresence.ABSENT:
                        return True
                    if presence is ResourcePresence.MISMATCHED:
                        raise LauncherError("relay network belongs to another creator")
                except (LauncherError, ValueError, OSError, subprocess.SubprocessError) as error:
                    print(f"warning: {item[0]} retained: {error}", file=sys.stderr)
                    return False
            return cleanup_resource(*item)

        with ThreadPoolExecutor(max_workers=max(1, len(networks))) as executor:
            network_results = list(executor.map(remove_network, networks))
        keychain_handle = getattr(state, 'keychain_handle', None)
        keychain_result = keychain_handle.cleanup(0) if keychain_handle is not None else None
        if keychain_result is not None:
            for failure in keychain_result.failures:
                print(f"warning: Cleaning up Keychain resource {failure.identity} failed ({failure.code}).",
                      file=sys.stderr)
            if keychain_result.remaining:
                try:
                    path = persist_relay_recovery(
                        state, keychain_handle.resources, keychain_handle.owner,
                        keychain_result.remaining,
                    )
                    if path is not None:
                        print(f"warning: Keychain recovery state retained at {path}", file=sys.stderr)
                except (OSError, LauncherError) as error:
                    print(f"warning: Keychain recovery state could not be persisted: {error}",
                          file=sys.stderr)
        gateway_result = (state.gateway_handle.cleanup(0)
                          if state.gateway_handle is not None else None)
        if gateway_result is not None:
            for failure in gateway_result.failures:
                print(f"warning: Cleaning up gateway resource {failure.identity} failed ({failure.code}).",
                      file=sys.stderr)
            if gateway_result.remaining:
                try:
                    path = persist_relay_recovery(
                        state, state.gateway_handle.resources, state.gateway_handle.owner,
                        gateway_result.remaining,
                    )
                    if path is not None:
                        print(f"warning: gateway recovery state retained at {path}", file=sys.stderr)
                except (OSError, LauncherError) as error:
                    print(f"warning: gateway recovery state could not be persisted: {error}", file=sys.stderr)
        timing("gateway")
        proxy_cleanup_succeeded = True
        if state.proxy_lock is not None:
            unpublished_state = (state.proxy_state
                                 if state.proxy_lock.coordination is not None else None)
            try:
                remove_proxies = lambda: proxy_module().reset_session(
                    proxy_module().runtime_directory(state.repository),
                    unpublished_state=unpublished_state,
                )
                if unpublished_state is None and getattr(state, "completed_successfully", False):
                    state.proxy_lock.finish(remove_proxies, defer=lambda: defer_proxy_cleanup(state))
                else:
                    state.proxy_lock.finish(remove_proxies)
            except (OSError, ValueError, RuntimeError, subprocess.SubprocessError, proxy_module().ConfigError) as error:
                proxy_cleanup_succeeded = False
                print(f"warning: Shared proxy cleanup failed; recovery metadata retained: {error}",
                      file=sys.stderr)
        timing("shared proxies")
        tic_result = tic_future.result()
    if tic_result is not None:
        for failure in tic_result.failures:
            print(f'warning: Cleaning up TicGit resource {failure.identity} failed ({failure.code}).',
                  file=sys.stderr)
        if tic_result.remaining and state.tic_resources is not None:
            try:
                persist_relay_recovery(state, state.tic_resources, tic_handle.owner, tic_result.remaining)
            except (OSError, LauncherError) as error:
                print(f'warning: TicGit relay recovery state could not be persisted: {error}',
                      file=sys.stderr)
    keep_scratch = (not proxy_cleanup_succeeded
                    or (isinstance(OUTER_RUNTIME, VMRuntime)
                        and (not all([*container_results, *network_results])
                             or bool(gateway_result and gateway_result.remaining)
                             or bool(keychain_result and keychain_result.remaining)
                             or bool(tic_result and tic_result.remaining))))
    if keep_scratch:
        state.recovery_record = temporary_file()
        recovery = {"runtime": runtime_identity(OUTER_RUNTIME),
            "owner": state.resource_owner, "containers": [item[1][-1] for item in containers],
            "networks": [item[1][-1] for item in networks],
            "skills": str(state.skills_tmp), "agent-state": str(state.pi_agent_tmp),
            "shared-state": str(state.proxy_state)}
        state.recovery_record.write_text(json.dumps(recovery))
        print(f"Sandbox cleanup incomplete; recovery state retained at {state.recovery_record}", file=sys.stderr)
    timing("TicGit join and recovery")
    if state.skills_tmp is not None and not keep_scratch:
        removal_started = time.monotonic()
        try:
            shutil.rmtree(state.skills_tmp)
        except OSError:
            elapsed = int(time.monotonic() - removal_started)
            print(f"warning: Cleaning up staged skills {state.skills_tmp} failed after {elapsed}s.", file=sys.stderr)
    timing("skills")
    if state.pi_agent_tmp is not None and not keep_scratch:
        removal_started = time.monotonic()
        try:
            shutil.rmtree(state.pi_agent_tmp)
        except OSError:
            elapsed = int(time.monotonic() - removal_started)
            print(f"warning: Cleaning up private Pi state {state.pi_agent_tmp} failed after {elapsed}s.", file=sys.stderr)
    timing("Pi state")
    for path in (
        state.proxy_state, state.proxy_args, state.manifest,
        state.prepared_images, getattr(state, "proxy_reused_marker", None),
        getattr(state, "cd_request", None),
        getattr(state, "workspaces_file", None),
    ):
        if path is not None and not keep_scratch:
            path.unlink(missing_ok=True)
    timing("temporary files")
    if os.environ.get("CODEX_SANDBOX_TIMING"):
        print(f"Sandbox cleanup total: {time.monotonic() - cleanup_started:.2f}s", file=sys.stderr)
    state.cleanup_succeeded = (all([*container_results, *network_results])
                               and proxy_cleanup_succeeded
                               and not bool(gateway_result and gateway_result.remaining)
                               and not bool(keychain_result and keychain_result.remaining)
                               and not bool(tic_result and tic_result.remaining))
    return state.cleanup_succeeded


def login_codex_sidecar() -> int:
    home = Path(os.environ["HOME"])
    directory = Path(os.environ.get("CODEX_SANDBOX_AUTH_DIR", home / ".codex-sandbox-auth"))
    if directory.exists() and (directory.is_symlink() or not directory.is_dir()):
        raise LauncherError(f"Codex sandbox authentication directory is invalid: {directory}")
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(directory, 0o700)
    environment = os.environ.copy()
    environment["CODEX_HOME"] = str(directory)
    environment.setdefault(
        "CODEX_DEVELOPER_INSTRUCTIONS_FILE",
        str(home / ".codex/developer-instructions.md"),
    )
    wrapper_directory = (DOTFILES / "bin").resolve()
    path_entries = []
    for entry in environment.get("PATH", "").split(os.pathsep):
        if Path(entry or ".").resolve() != wrapper_directory:
            path_entries.append(entry)
    codex = shutil.which("codex", path=os.pathsep.join(path_entries))
    if codex is None:
        raise LauncherError("real Codex executable not found on PATH")
    return subprocess.run([codex, "login"], env=environment).returncode


def tmux_registrations() -> list[dict[str, object]]:
    result = run([
        "tmux", "list-panes", "-a", "-F",
        "#{pane_dead}\t#{pane_pid}\t#{@codex_sandbox_restart}",
    ], capture=True)
    registrations = []
    for line in result.stdout.splitlines():
        fields = line.split("\t", 2)
        if len(fields) != 3 or not fields[2]:
            continue
        dead_text, pid_text, encoded = fields
        try:
            payload = decode_tmux_registration(encoded)
            pid = int(pid_text) if pid_text else None
        except (ValueError, UnicodeError, json.JSONDecodeError) as error:
            raise LauncherError("tmux contains an invalid sandbox restart registration") from error
        dead = dead_text == "1"
        valid_payload = isinstance(payload, dict) and type(payload.get("version")) is int
        if valid_payload:
            version = payload["version"]
            fields = {"version", "pane", "repository", "session", "token"}
            if version == 2:
                fields.add("cwd")
            valid_payload = version in {1, 2} and set(payload) == fields and all(
                isinstance(payload[field], str) and payload[field]
                for field in ("pane", "repository", "token")
            )
            if valid_payload:
                valid_payload = Path(payload["repository"]).is_absolute() and (
                    isinstance(payload["session"], str) and bool(payload["session"])
                    if version == 1 else
                    (payload["session"] is None or (isinstance(payload["session"], str)
                     and Path(payload["session"]).is_absolute()))
                    and isinstance(payload["cwd"], str) and Path(payload["cwd"]).is_absolute()
                )
        if dead_text not in {"0", "1"} or (not dead and (pid is None or pid <= 1)) or not valid_payload:
            raise LauncherError("tmux contains an invalid sandbox restart registration")
        registrations.append({**payload, "dead": dead, "pid": pid})
    return registrations


def restart_tmux_sessions(repository: Path | None = None) -> int:
    if "TMUX" not in os.environ:
        raise LauncherError("sandbox restart must run inside tmux")
    registrations = tmux_registrations()
    if repository is not None:
        registrations = [registration for registration in registrations
                         if Path(str(registration["repository"])).resolve() == repository]
    if not registrations:
        scope = f" for {repository}" if repository is not None else ""
        raise LauncherError(f"tmux has no registered sandbox sessions{scope}")
    # Check every selected session before changing panes or stopping any owner.
    # A launch-time ID cannot identify the session selected later in the UI.
    for registration in registrations:
        pane = registration["pane"]
        if registration.get("version") != 2:
            raise LauncherError(
                f"pane {pane} has a launch-time session registration; run /reload in that Pi pane "
                "before restarting. No sessions were stopped"
            )
        if registration["session"] is None:
            raise LauncherError(f"pane {pane} has no saved Pi session. No sessions were stopped")
        session = Path(registration["session"])
        cwd = Path(registration["cwd"])
        if not session.is_file():
            raise LauncherError(
                f"pane {pane}: Pi session file is missing: {session}; wait for the first assistant "
                "reply or resume a saved session. No sessions were stopped"
            )
        try:
            _, session_cwd = session_header(session)
        except LauncherError as error:
            raise LauncherError(f"pane {pane}: {error}. No sessions were stopped") from error
        if not cwd.is_dir() or not cwd.resolve().is_relative_to(Path(registration["repository"]).resolve()) \
                or session_cwd != cwd.resolve():
            raise LauncherError(
                f"pane {pane}: session and sandbox working directories differ; "
                "resume the session from its original directory. No sessions were stopped"
            )
    for registration in registrations:
        remain_on_exit = run([
            "tmux", "show-options", "-A", "-p", "-v", "-t", registration["pane"],
            "remain-on-exit",
        ], capture=True).stdout.strip()
        if remain_on_exit not in {"0", "1", "off", "on", "failed"}:
            raise LauncherError("tmux returned an invalid remain-on-exit setting")
        # Preserve startup errors without keeping panes after successful UI exit.
        registration["remain_on_exit"] = (
            "failed" if remain_on_exit in {"0", "off"} else remain_on_exit
        )
        run([
            "tmux", "set-option", "-p", "-t", registration["pane"],
            "remain-on-exit", "on",
        ])
        # Take ownership of the resume record before stopping the old owner.
        # Its generation-checked cleanup must not erase a failed restart's retry.
        registration["token"] = secrets.token_hex(16)
        payload = {key: registration[key] for key in
                   ("version", "pane", "repository", "session", "cwd", "token")}
        encoded = base64.urlsafe_b64encode(json.dumps(payload).encode()).decode()
        run([
            "tmux", "set-option", "-p", "-t", registration["pane"],
            "@codex_sandbox_restart", encoded,
        ])
        if not registration["dead"]:
            os.kill(registration["pid"], signal.SIGTERM)
    panes = {registration["pane"] for registration in registrations}
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        active = {
            registration["pane"]
            for registration in tmux_registrations()
            if not registration["dead"]
        }
        if not panes.intersection(active):
            break
        time.sleep(0.1)
    else:
        raise LauncherError("sandbox panes did not stop within 15 seconds")
    for reset_repository in sorted({str(item["repository"]) for item in registrations}):
        # Pane death is not owner cleanup: detached owners may still hold lifetime locks.
        helper("reset", "--repo", reset_repository, "--wait")
    for registration in registrations:
        command = (
            shlex.join(["cd", registration["cwd"]])
            + " && "
            + shlex.join(["pi", "--session", registration["session"]])
        )
        run([
            "tmux", "set-option", "-p", "-t", registration["pane"],
            "remain-on-exit", registration["remain_on_exit"],
        ])
        run(["tmux", "respawn-pane", "-k", "-t", registration["pane"], command])
    scope = f" for {repository}" if repository is not None else ""
    message = f"Restarted {len(registrations)} sandbox session(s){scope}."
    run(["tmux", "display-message", "-d", "5000", message], check=False, quiet=True)
    print(message)
    return 0


def main(arguments: list[str]) -> int:
    """Public CLI/import entry; interactive callers must have no live threads."""
    # This explicit first-use setting is host-only and consumed before Pi's
    # arguments are forwarded or the detached owner starts services.
    boundary = arguments.index('--') if '--' in arguments else len(arguments)
    source_options = [index for index, value in enumerate(arguments[:boundary])
                      if value == '--set-tic-native-source' or value.startswith('--set-tic-native-source=')]
    if source_options:
        try:
            if len(source_options) != 1:
                raise LauncherError('--set-tic-native-source may be supplied only once')
            index = source_options[0]
            if arguments[index] == '--set-tic-native-source':
                if index + 1 >= boundary:
                    raise LauncherError('--set-tic-native-source requires a native repository path')
                source, count = arguments[index + 1], 2
            else:
                source, count = arguments[index].split('=', 1)[1], 1
            if not source:
                raise LauncherError('--set-tic-native-source requires a native repository path')
            from tic_artifact import configure_native_source
            configure_native_source(Path.home(), Path(source), replace=True)
            arguments = arguments[:index] + arguments[index + count:]
        except (LauncherError, OSError, ValueError, subprocess.SubprocessError) as error:
            print(f'error: {error}', file=sys.stderr)
            return 1
    # Administrative and noninteractive interfaces retain their existing process
    # ownership. Interactive UI is separated before execute creates any resources.
    administrative = arguments[:1] in (["validate-cd"], ["prepare-cd"], ["restart"], ["restart-all"], ["auth"])
    options = arguments[:arguments.index("--")] if "--" in arguments else arguments
    noninteractive = any(argument in ("--print", "-p", "--export") for argument in options)
    for index, argument in enumerate(options):
        if argument == "--mode" and index + 1 < len(options):
            noninteractive |= options[index + 1] in ("rpc", "json")
        noninteractive |= argument in ("--mode=rpc", "--mode=json")
    if not administrative and not noninteractive:
        from host_pi_owner import detached_frontend
        if threading.active_count() != 1:
            raise LauncherError("interactive launcher must start before service threads")
        return detached_frontend(arguments, detached_owner_main)
    with verification_scope():
        return launch(arguments)


def cli_main(arguments: list[str]) -> int:
    """Script frontend alias: imports and direct invocation share one interface."""
    return main(arguments)


def detached_owner_main(arguments: list[str], bootstrap: socket.socket) -> int:
    global HOST_PI_BOOTSTRAP
    HOST_PI_BOOTSTRAP = bootstrap
    with verification_scope():
        return launch(arguments)


def launch(arguments: list[str]) -> int:
    global OUTER_RUNTIME
    if len(arguments) == 2 and arguments[0] in ("validate-cd", "prepare-cd"):
        try:
            # Validation is read-only even when an agent shell supplied jj author overrides.
            os.environ.pop("JJ_USER", None)
            os.environ.pop("JJ_EMAIL", None)
            os.environ["JJ_AGENT"] = "none"
            destination = Path(arguments[1]).expanduser().resolve(strict=True)
            if not destination.is_dir():
                raise LauncherError("The destination is not a directory")
            os.chdir(destination)
            checked = new_state([])
            validate_repository(checked, initialize_missing=False)
            if arguments[0] == "prepare-cd":
                OUTER_RUNTIME = image_runtime()
                proxy_module.cache_clear()
                prepare_cd_images(checked)
            print(json.dumps({"destination": str(checked.host_working_directory),
                              "repository": str(checked.repository)}))
            return 0
        except (LauncherError, OSError, ValueError, subprocess.CalledProcessError) as error:
            print(f"error: {error}", file=sys.stderr)
            return 1
    if arguments[:1] in (["restart"], ["restart-all"]):
        try:
            repository = None
            if arguments[:1] == ["restart"]:
                if len(arguments) != 3 or arguments[1] != "--repo":
                    raise LauncherError("usage: codex-sandbox restart --repo DIRECTORY")
                repository = Path(arguments[2]).expanduser().resolve(strict=True)
                if not repository.is_dir():
                    raise LauncherError("The repository is not a directory")
            elif arguments != ["restart-all"]:
                raise LauncherError("usage: codex-sandbox restart-all")
            return restart_tmux_sessions(repository)
        except (LauncherError, OSError, subprocess.CalledProcessError) as error:
            message = f"Sandbox restart failed: {error}"
            if "TMUX" in os.environ:
                try:
                    run([
                        "tmux", "display-message", "-d", "8000", message,
                    ], check=False, quiet=True)
                except OSError:
                    pass
            print(f"error: {error}", file=sys.stderr)
            return 1
    if arguments == ["auth", "login"]:
        try:
            return login_codex_sidecar()
        except (LauncherError, OSError) as error:
            print(f"error: {error}", file=sys.stderr)
            return 1
    state: State | None = None
    previous_handlers: dict[int, object] = {}

    def handle_signal(signum: int, _frame: object) -> None:
        if state is not None and state.joining_workers:
            state.deferred_signal = signum
            if getattr(state, "tic_cancelled", None) is not None:
                state.tic_cancelled.set()
            if getattr(state, "gateway_handle", None) is not None:
                state.gateway_handle.cancelled.set()
            return
        raise SignalExit(signum)

    try:
        # Lima's status lookup may delete PID files invisible in a caller's
        # sandbox. Reject non-repository launches before consulting the runtime.
        existing_git_root()
        OUTER_RUNTIME = image_runtime()
        proxy_module.cache_clear()
        for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
            previous_handlers[signum] = signal.signal(signum, handle_signal)
        next_arguments = arguments
        handoff_origin = None
        while True:
            state = new_state(next_arguments)
            state.handoff_origin = handoff_origin
            result = execute(state)
            state.completed_successfully = result == 0
            request = read_cd_request(state) if result == 0 and HOST_PI_BOOTSTRAP is None else None
            if request is None:
                return result
            if not cleanup(state):
                raise LauncherError("Old sandbox cleanup failed; directory handoff stopped")
            unregister_tmux_pane(state)
            origin = state.host_working_directory
            prior_arguments = state.codex_arguments
            state = None
            destination, session = request
            os.chdir(destination)
            handoff_origin = origin
            session_dir_arguments = []
            if prior_arguments.count("--session-dir") == 1:
                index = prior_arguments.index("--session-dir")
                if index + 1 < len(prior_arguments):
                    session_dir = Path(prior_arguments[index + 1]).expanduser()
                    if not session_dir.is_absolute():
                        session_dir = origin / session_dir
                    session_dir_arguments = ["--session-dir", str(session_dir)]
            next_arguments = [*session_dir_arguments,
                              *(["--fork", str(session)] if session is not None else []),
                              "--session-id", str(uuid.uuid4())]
    except SignalExit as error:
        return 128 + error.signum
    except (LauncherError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as error:
        diagnostic = error.stderr
        if isinstance(diagnostic, bytes):
            diagnostic = diagnostic.decode(errors='replace')
        print(diagnostic.rstrip() if diagnostic else f'error: {error}', file=sys.stderr)
        return error.returncode
    except OSError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    finally:
        for signum in previous_handlers:
            signal.signal(signum, signal.SIG_IGN)
        cleanup_succeeded = True
        if state is not None:
            cleanup_succeeded = cleanup(state)
            unregister_tmux_pane(state)
        if HOST_PI_OWNER is not None:
            HOST_PI_OWNER.finish(cleanup_succeeded)
        for signum, handler in previous_handlers.items():
            signal.signal(signum, handler)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
