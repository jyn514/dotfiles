def run(
    arguments: list[str], *, check: bool = True, capture: bool = False,
    cwd: Path | None = None, quiet: bool = False, discard_stdout: bool = False,
    stdout_to_stderr: bool = False, input_text: str | None = None,
) -> subprocess.CompletedProcess[str]:
    stdout = None
    if capture:
        stdout = subprocess.PIPE
    elif quiet or discard_stdout:
        stdout = subprocess.DEVNULL
    elif stdout_to_stderr:
        stdout = sys.stderr
    result = subprocess.run(
        arguments, cwd=cwd, check=False, text=True, input=input_text,
        stdout=stdout,
        stderr=subprocess.DEVNULL if quiet else None,
    )
    if check and result.returncode:
        raise subprocess.CalledProcessError(result.returncode, arguments)
    return result


def helper(*arguments: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return run(["python3", str(PROXY_HELPER), *arguments], check=check)


def temporary_file() -> Path:
    descriptor, name = tempfile.mkstemp()
    os.close(descriptor)
    return Path(name)


def parse_connection(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        if not separator or not re.fullmatch(r"[A-Z][A-Z0-9_]*", key):
            raise LauncherError(f"invalid Agent Podman connection setting: {line!r}")
        values[key] = value
    required = {
        "AGENT_PODMAN_SSH_USER", "AGENT_PODMAN_SSH_PORT",
        "CONTAINER_HOST", "CONTAINER_SSHKEY",
    }
    if not required <= values.keys():
        raise LauncherError("Agent Podman connection settings are incomplete")
    return values


def resumable_arguments(arguments: list[str]) -> tuple[list[str], str | None]:
    if not arguments:
        session_id = str(uuid.uuid4())
        return ["--session-id", session_id], session_id
    if len(arguments) == 2 and arguments[0] in ("--session", "--session-id") and arguments[1]:
        return arguments, arguments[1]
    return arguments, None


def new_state(codex_arguments: list[str]) -> State:
    codex_arguments, _ = resumable_arguments(codex_arguments)
    home = Path(os.environ["HOME"])
    uid = os.getuid()
    suffix = f"{uid}-{secrets.token_hex(6)}"
    access = Path(os.environ.get("AGENT_PODMAN_ACCESS_DIR", home / ".agent-podman-access"))
    state = State(
        codex_arguments=codex_arguments,
        home=home,
        term=os.environ.get("TERM", "xterm-256color"),
        uid=uid,
        gid=os.getgid(),
        suffix=suffix,
        relay_link_network=f"codex-agent-podman-link-{suffix}",
        relay_egress_network=f"codex-agent-podman-egress-{suffix}",
        relay_container=f"codex-agent-podman-relay-{suffix}",
        codex_container=f"codex-sandbox-{suffix}",
        proxy_prefix=f"codex-command-proxy-{suffix}",
        codex_sidecar_container=f"codex-auth-proxy-{suffix}",
        codex_auth_directory=Path(os.environ.get(
            "CODEX_SANDBOX_AUTH_DIR", home / ".codex-sandbox-auth",
        )),
        agent_podman_access=access,
        agent_podman_connection=access / "connection.env",
        agent_podman_key=access / "id_ed25519",
        agent_podman_known_hosts=access / "known_hosts.sandbox",
    )
    load_agent_podman(state)
    return state


def load_agent_podman(state: State) -> None:
    paths = (
        state.agent_podman_connection, state.agent_podman_key,
        state.agent_podman_known_hosts,
    )
    if not any(path.exists() for path in paths):
        return
    if not all(path.is_file() for path in paths):
        raise LauncherError(f"Agent Podman access state is incomplete: {state.agent_podman_access}")
    values = parse_connection(state.agent_podman_connection)
    prefix = (
        f"ssh://{values['AGENT_PODMAN_SSH_USER']}@host.docker.internal:"
        f"{values['AGENT_PODMAN_SSH_PORT']}/"
    )
    host = values["CONTAINER_HOST"]
    if not host.startswith(prefix):
        raise LauncherError("Agent Podman connection does not use the expected host endpoint")
    values["SOCKET_PATH"] = host.removeprefix(prefix)
    state.agent_podman = values


def register_tmux_pane(state: State) -> None:
    pane = os.environ.get("TMUX_PANE")
    _, session_id = resumable_arguments(state.codex_arguments)
    if pane is None or session_id is None:
        return
    registration = base64.urlsafe_b64encode(json.dumps({
        "version": 1,
        "pane": pane,
        "repository": str(state.repository),
        "session": session_id,
        "token": secrets.token_hex(16),
    }, separators=(",", ":"), sort_keys=True).encode()).decode()
    run([
        "tmux", "set-option", "-p", "-t", pane,
        "@codex_sandbox_restart", registration,
    ], quiet=True)
    run([
        "tmux", "set-option", "-p", "-t", pane,
        "@codex_sandbox_command", "π",
    ], quiet=True)
    state.tmux_pane = pane
    state.tmux_registration = registration


def unregister_tmux_pane(state: State) -> None:
    if state.tmux_pane is None or state.tmux_registration is None:
        return
    current = run([
        "tmux", "show-option", "-p", "-v", "-t", state.tmux_pane,
        "@codex_sandbox_restart",
    ], check=False, capture=True, quiet=True)
    if current.returncode == 0 and current.stdout.strip() == state.tmux_registration:
        run([
            "tmux", "set-option", "-p", "-u", "-t", state.tmux_pane,
            "@codex_sandbox_restart",
        ], check=False, quiet=True)
        run([
            "tmux", "set-option", "-p", "-u", "-t", state.tmux_pane,
            "@codex_sandbox_command",
        ], check=False, quiet=True)


def validate_repository(state: State) -> None:
    try:
        result = run(["jj", "workspace", "root"], capture=True)
    except subprocess.CalledProcessError:
        try:
            run(["jj", "git", "init"])
            result = run(["jj", "workspace", "root"], capture=True)
        except subprocess.CalledProcessError as error:
            raise LauncherError("The current directory could not be initialized as a Jujutsu workspace") from error
    repository = Path(result.stdout.strip()).resolve(strict=True)
    jj = repository / ".jj"
    git = repository / ".git"
    if not jj.is_dir() or jj.is_symlink():
        raise LauncherError("The Jujutsu workspace root cannot be safely mounted")
    if not (git.is_dir() or git.is_file()):
        raise LauncherError("Git metadata is missing or invalid")
    if git.is_symlink():
        raise LauncherError("Symlinked Git metadata is not supported")
    if git.is_file() and git.lstat().st_nlink != 1:
        raise LauncherError("Git metadata entry must not be hard linked")
    try:
        result = run([
            "git", "-C", str(repository), "rev-parse", "--path-format=absolute",
            "--git-dir", "--git-common-dir",
        ], capture=True)
        lines = result.stdout.splitlines()
        if len(lines) != 2:
            raise LauncherError("Git returned an invalid metadata layout")
        git_roots = [Path(line).resolve(strict=True) for line in lines]
    except (subprocess.CalledProcessError, FileNotFoundError) as error:
        raise LauncherError("Git metadata indirection cannot be resolved safely") from error
    try:
        jj_repo_entry = jj / "repo"
        if jj_repo_entry.is_file() and not jj_repo_entry.is_symlink():
            if jj_repo_entry.lstat().st_nlink != 1:
                raise LauncherError("Jujutsu repository pointer must not be hard linked")
            value = jj_repo_entry.read_text(encoding="utf-8").strip()
            if not value or "\0" in value or "\n" in value or "\r" in value:
                raise LauncherError("Jujutsu repository pointer is invalid")
            target = Path(value)
            if not target.is_absolute():
                target = jj_repo_entry.parent / target
            jj_repo = target.resolve(strict=True)
        else:
            jj_repo = jj_repo_entry.resolve(strict=True)
    except (FileNotFoundError, UnicodeError) as error:
        raise LauncherError("Jujutsu repository metadata cannot be resolved safely") from error
    for root in (jj, jj_repo, *git_roots):
        if not root.is_dir() or root.is_symlink():
            raise LauncherError(f"Repository metadata directory is invalid: {root}")
    state.repository = repository
    state.manifest = temporary_file()
    snapshot_arguments = [
        "snapshot", "--repo", str(repository), "--output", str(state.manifest),
        "--jj-image-command", str(DOTFILES / ".agents/sandbox/jj-proxy-image"),
    ]
    zuliprc = state.home / ".zuliprc"
    if zuliprc.exists() or zuliprc.is_symlink():
        state.zuliprc = zuliprc
        snapshot_arguments += [
            "--zulip-image-command", str(DOTFILES / ".agents/sandbox/zulip-proxy-image"),
            "--zuliprc", str(zuliprc),
        ]
    helper(*snapshot_arguments)


def image_sources() -> list[Path]:
    dockerfile = Path("tools/codex-sandbox/image/Dockerfile")
    sources = [dockerfile]
    for line in (DOTFILES / dockerfile).read_text(encoding="utf-8").splitlines():
        fields = line.split()
        if not fields or fields[0] != "COPY" or any(field.startswith("--from=") for field in fields[1:-1]):
            continue
        sources.extend(Path(field) for field in fields[1:-1] if not field.startswith(("--", "<<")))
    files: list[Path] = []
    for source in sources:
        absolute = DOTFILES / source
        if absolute.is_dir():
            files.extend(
                path.relative_to(DOTFILES) for path in absolute.rglob("*")
                if stat.S_ISREG(path.lstat().st_mode)
            )
        elif absolute.is_file():
            files.append(source)
    return sorted(set(files), key=lambda path: os.fsencode(path.as_posix()))


def image_cache_key(state: State, base_image: str) -> str:
    sources = image_sources()
    digests = run(
        ["git", "hash-object", *map(str, sources)], capture=True, cwd=DOTFILES,
    ).stdout.splitlines()
    if len(digests) != len(sources):
        raise LauncherError("Git returned an invalid sandbox image source digest list")
    lines = [
        f"BASE_IMAGE={base_image}", f"AGENT_UID={state.uid}", f"AGENT_GID={state.gid}",
        f"TERM={state.term}",
        *(f"{path.as_posix()} {digest}" for path, digest in zip(sources, digests, strict=True)),
    ]
    return run(
        ["git", "hash-object", "--stdin"], capture=True, cwd=DOTFILES,
        input_text="\n".join(lines) + "\n",
    ).stdout.strip()


def resolve_sidecar_image() -> str:
    builder = DOTFILES / "tools/codex-auth-proxy/image"
    result = run([str(builder)], capture=True, cwd=DOTFILES)
    output = result.stdout.strip()
    if not re.fullmatch(r"sha256:[0-9a-f]{64}", output):
        raise LauncherError("authentication proxy image command returned an invalid image ID")
    return output


def ensure_image(state: State, base_image: str) -> str:
    image = f"codex-sandbox:{image_cache_key(state, base_image)}"
    if run(["docker", "image", "inspect", image], check=False, quiet=True).returncode == 0:
        return image
    print(f"Building docker image {image} ...", end="", file=sys.stderr, flush=True)
    iidfile = temporary_file()
    try:
        run([
            "docker", "build", "--jobs", "4",
            "-f", "tools/codex-sandbox/image/Dockerfile",
            "--build-arg", f"AGENT_UID={state.uid}",
            "--build-arg", f"AGENT_GID={state.gid}",
            "--build-arg", f"TERM={state.term}", "--iidfile", str(iidfile),
            "--tag", image, "--build-arg", f"BASE_IMAGE={base_image}", ".",
        ], cwd=DOTFILES, stdout_to_stderr=True)
        built = iidfile.read_text(encoding="utf-8").strip()
        if not built:
            raise LauncherError("Docker did not report the built sandbox image ID")
    finally:
        iidfile.unlink(missing_ok=True)
    print(" done.", file=sys.stderr)
    return built


def ensure_network() -> None:
    if run(["docker", "network", "exists", SANDBOX_NETWORK], check=False, quiet=True).returncode == 0:
        return
    print("Creating sandbox network ...", end="", flush=True)
    arguments = [
        "docker", "network", "create", "--ignore", "--subnet", SANDBOX_SUBNET,
        "--gateway", SANDBOX_GATEWAY, "--ip-range", SANDBOX_IP_RANGE,
        "--opt", "isolate=true",
    ]
    for route in PROHIBITED_ROUTES:
        arguments += ["--route", f"{route},prohibit"]
    arguments.append(SANDBOX_NETWORK)
    if run(arguments, check=False, discard_stdout=True).returncode:
        raise LauncherError("Could not create the sandbox network")
    print(" done.")


def acquire_lock(state: State) -> None:
    state.proxy_state = temporary_file()
    state.lock_ready = temporary_file()
    state.lock_coordinated = temporary_file()
    state.lock_release = temporary_file()
    state.lock_ready.unlink()
    state.lock_coordinated.unlink()
    state.lock_release.unlink()
    state.lock_process = subprocess.Popen([
        "python3", str(PROXY_HELPER), "hold-lock", "--repo", str(state.repository),
        "--ready", str(state.lock_ready), "--coordinated", str(state.lock_coordinated),
        "--release", str(state.lock_release), "--parent-pid", str(os.getpid()),
    ])
    while True:
        if state.lock_ready.exists():
            return
        if state.lock_process.poll() is not None:
            raise LauncherError("Could not join the sandbox proxy session")
        time.sleep(0.05)


def attach_proxies(state: State) -> list[str]:
    try:
        arguments = [
            "attach", "--repo", str(state.repository), "--prefix", state.proxy_prefix,
            "--session", str(state.lock_ready),
            "--state", str(state.proxy_state), "--helper-image", state.sidecar_image,
            "--network", SANDBOX_NETWORK, "--manifest", str(state.manifest),
        ]
        if state.zuliprc is not None:
            arguments += ["--zuliprc", str(state.zuliprc)]
        auth_directory = _secure_codex_auth_directory(state)
        if auth_directory is not None:
            arguments.append("--auth-enabled")
        helper(*arguments)
        sidecar_arguments = attach_codex_sidecar(state, auth_directory)
        return [*sidecar_arguments, *finalize_proxy_session(state)]
    finally:
        state.lock_coordinated.touch()


def start_relay(state: State) -> list[str]:
    values = state.agent_podman
    run(["docker", "network", "create", "--internal", "--opt", "isolate=true", state.relay_link_network], discard_stdout=True)
    state.relay_link_created = True
    run(["docker", "network", "create", "--opt", "isolate=true", state.relay_egress_network], discard_stdout=True)
    state.relay_egress_created = True
    run([
        "docker", "run", "--detach", "--name", state.relay_container,
        "--cap-drop=ALL", "--security-opt=no-new-privileges", "--read-only",
        "--network", state.relay_egress_network, "--http-proxy=false",
        "--entrypoint", "/usr/bin/socat", state.sidecar_image, "-d", "-d",
        f"TCP4-LISTEN:{state.relay_port},fork,reuseaddr",
        f"TCP4:host.docker.internal:{values['AGENT_PODMAN_SSH_PORT']}",
    ], discard_stdout=True)
    state.relay_container_created = True
    run(["docker", "network", "connect", state.relay_link_network, state.relay_container])
    relay_ip = run([
        "docker", "inspect", "--format",
        f'{{{{(index .NetworkSettings.Networks "{state.relay_link_network}").IPAddress}}}}',
        state.relay_container,
    ], capture=True).stdout.strip()
    if not relay_ip:
        raise LauncherError("Agent Podman relay has no link address")
    container_host = (
        f"ssh://{values['AGENT_PODMAN_SSH_USER']}@{relay_ip}:"
        f"{state.relay_port}/{values['SOCKET_PATH']}"
    )
    print(f"Agent Podman relay ready at {relay_ip}:{state.relay_port}.")
    return [
        "--network", state.relay_link_network,
        "--env", f"CONTAINER_HOST={container_host}",
        "--env", f"CONTAINER_SSHKEY={values['CONTAINER_SSHKEY']}",
        "--env", f"AGENT_PODMAN_KNOWN_HOSTS={state.container_known_hosts}",
        "--mount", f"type=bind,src={state.agent_podman_key},dst={values['CONTAINER_SSHKEY']},readonly",
        "--mount", f"type=bind,src={state.agent_podman_known_hosts},dst={state.container_known_hosts},readonly",
    ]


def _secure_codex_auth_directory(state: State) -> Path | None:
    directory = state.codex_auth_directory
    auth = directory / "auth.json"
    if not auth.exists():
        return None
    directory_stat = directory.lstat()
    auth_stat = auth.lstat()
    if directory.is_symlink() or not directory.is_dir():
        raise LauncherError(f"Codex sandbox authentication directory is invalid: {directory}")
    if directory_stat.st_uid != state.uid or stat.S_IMODE(directory_stat.st_mode) != 0o700:
        raise LauncherError(f"Codex sandbox authentication directory must be owned by uid {state.uid} with mode 0700: {directory}")
    if auth.is_symlink() or not auth.is_file() or auth_stat.st_nlink != 1:
        raise LauncherError(f"Codex sandbox authentication must be an unlinked regular file: {auth}")
    if auth_stat.st_uid != state.uid or stat.S_IMODE(auth_stat.st_mode) != 0o600:
        raise LauncherError(f"Codex sandbox authentication must be owned by uid {state.uid} with mode 0600: {auth}")
    if any(character in str(directory.resolve()) for character in (",", "\n", "\r")):
        raise LauncherError("Codex sandbox authentication path contains a mount delimiter")
    return directory.resolve()


def _sidecar_session_key() -> str:
    def encoded(value: bytes) -> str:
        return base64.urlsafe_b64encode(value).decode().rstrip("=")
    header = encoded(b'{"alg":"none","typ":"JWT"}')
    payload = encoded(json.dumps({
        "https://api.openai.com/auth": {"chatgpt_account_id": "sandbox"},
        "sid": secrets.token_hex(16),
    }, separators=(",", ":")).encode())
    return f"{header}.{payload}.{encoded(secrets.token_bytes(24))}"


def codex_sidecar_arguments(container: str, key: str) -> list[str]:
    return [
        "--env", f"CODEX_SIDECAR_URL=http://{container}:8787",
        "--env", f"CODEX_SIDECAR_KEY={key}",
        "--mount", f"type=bind,src={DOTFILES / 'tools/codex-auth-proxy/pi-extension'},dst=/home/codex/.pi/agent/extensions/codex-sidecar,readonly",
    ]


def codex_sidecar_has_sandbox_network(container: str) -> bool:
    result = run([
        "docker", "inspect", "--format",
        f'{{{{if index .NetworkSettings.Networks "{SANDBOX_NETWORK}"}}}}true{{{{end}}}}',
        container,
    ], check=False, capture=True, quiet=True)
    return result.returncode == 0 and result.stdout.strip() == "true"


def stop_codex_sidecar(container: str) -> None:
    run(["docker", "kill", container], check=False, quiet=True)
    run(["docker", "rm", container], check=False, quiet=True)


def start_codex_sidecar(state: State, auth_directory: Path) -> tuple[dict[str, str], list[str]]:
    key = _sidecar_session_key()
    container = state.codex_sidecar_container
    run([
        "docker", "run", "--detach", "--name", container,
        "--cap-drop=ALL", "--security-opt=no-new-privileges", "--read-only",
        "--user", f"{state.uid}:{state.gid}", "--network", SANDBOX_NETWORK,
        "--http-proxy=false", "--pids-limit", "64", "--memory", "256m",
        "--cpus", "1", "--ulimit", "nofile=256:256",
        "--tmpfs", "/tmp:rw,noexec,nosuid,nodev,size=4m,mode=1777",
        "--mount", f"type=bind,src={auth_directory},dst=/var/lib/codex-auth",
        "--env", f"CODEX_SIDECAR_KEY={key}",
        "--entrypoint", "/trusted/bin/codex-auth-proxy", state.sidecar_image,
    ], discard_stdout=True)
    try:
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            result = run([
                "docker", "exec", container, "/usr/local/bin/python3", "-c",
                "import socket; socket.create_connection(('127.0.0.1',8787),1).close()",
            ], check=False, quiet=True)
            if result.returncode == 0:
                sidecar = {"container": container, "key": key, "image": state.sidecar_image}
                return sidecar, codex_sidecar_arguments(container, key)
            status = run([
                "docker", "inspect", "--format", "{{.State.Running}}", container,
            ], check=False, capture=True, quiet=True)
            if status.returncode or status.stdout.strip() != "true":
                raise LauncherError("Codex authentication sidecar exited before becoming ready")
            time.sleep(0.1)
        raise LauncherError("Codex authentication sidecar did not become ready")
    except Exception:
        stop_codex_sidecar(container)
        raise


def attach_codex_sidecar(state: State, auth_directory: Path | None = None) -> list[str]:
    proxy_state = json.loads(state.proxy_state.read_text(encoding="utf-8"))
    sidecar = proxy_state.get("auth")
    if auth_directory is None:
        if sidecar is None:
            print(
                "Codex authentication sidecar disabled; run 'codex-sandbox auth login' to enable it.",
                file=sys.stderr,
            )
            return []
        raise LauncherError("active sandbox proxy session has authentication enabled")
    if sidecar is None:
        sidecar, arguments = start_codex_sidecar(state, auth_directory)
        proxy_state["auth"] = sidecar
        state.proxy_state.write_text(json.dumps(proxy_state, sort_keys=True), encoding="utf-8")
        return arguments
    if not isinstance(sidecar, dict) or set(sidecar) != {"container", "key", "image"} or not all(
        isinstance(sidecar[field], str) and sidecar[field]
        for field in ("container", "key", "image")
    ):
        raise LauncherError("active sandbox proxy session has invalid authentication state")
    if sidecar["image"] != state.sidecar_image:
        raise LauncherError("active sandbox proxy session has invalid authentication state")
    if not codex_sidecar_has_sandbox_network(sidecar["container"]):
        raise LauncherError(
            "cached authentication sidecar is absent or belongs to another sandbox "
            "network; stop the active sandbox session before retrying"
        )
    return codex_sidecar_arguments(sidecar["container"], sidecar["key"])


def stage_skills(state: State) -> None:
    state.skills_tmp = Path(tempfile.mkdtemp())
    source = state.home / ".agents/skills"
    staged = state.skills_tmp / "skills"
    repository_links: list[tuple[Path, Path]] = []
    for path in source.rglob("*"):
        if not path.is_symlink():
            continue
        try:
            relative_target = path.resolve(strict=True).relative_to(state.repository)
        except (OSError, ValueError):
            continue
        repository_links.append((path.relative_to(source), relative_target))
    shutil.copytree(
        source, staged, symlinks=False, ignore_dangling_symlinks=True,
        dirs_exist_ok=True,
    )
    for relative_path, relative_target in repository_links:
        destination = staged / relative_path
        if destination.is_dir():
            shutil.rmtree(destination)
        else:
            destination.unlink(missing_ok=True)
        destination.symlink_to(Path("/src/work") / relative_target)
    config = state.skills_tmp / "config"
    config.mkdir()
    for name in (
        "shared-agents.md", "pi-AGENTS.md", "breq.md", "pi.json", "pi-mcp.json",
        "pi-keybindings.json", "pi-codex-subagents.json",
    ):
        shutil.copy2(DOTFILES / "config" / name, config / name)
    instruction_includes = []
    repository_instructions = state.repository / ".agents/sandbox/AGENTS.md"
    if repository_instructions.is_file():
        instruction_includes.append("@/src/work/.agents/sandbox/AGENTS.md")
    home_instructions = state.home / ".agents/sandbox/AGENTS.md"
    if home_instructions.is_file():
        shutil.copytree(
            home_instructions.parent, state.skills_tmp / "sandbox",
            symlinks=False, ignore_dangling_symlinks=True,
        )
        instruction_includes.append("@../../.agents/sandbox/AGENTS.md")
    if instruction_includes:
        agents = config / "pi-AGENTS.md"
        content = agents.read_text(encoding="utf-8").rstrip("\n")
        agents.write_text(
            content + "\n" + "\n".join(instruction_includes) + "\n",
            encoding="utf-8",
        )


def finalize_proxy_session(state: State) -> list[str]:
    state.proxy_args = temporary_file()
    helper(
        "finalize", "--repo", str(state.repository), "--state", str(state.proxy_state),
        "--output", str(state.proxy_args), "--manifest", str(state.manifest),
    )
    arguments: list[str] = []
    for line in state.proxy_args.read_text(encoding="utf-8").splitlines():
        arguments.insert(0, line)
    return arguments


def run_agent(state: State, arguments: list[str]) -> int:
    state.codex_container_created = True
    state.monitor_process = subprocess.Popen([
        "python3", str(PROXY_HELPER), "monitor", "--state", str(state.proxy_state),
        "--agent", state.codex_container,
    ])
    git_layout = run([
        "git", "-C", str(state.repository), "rev-parse", "--path-format=absolute",
        "--git-dir", "--git-common-dir",
    ], capture=True).stdout.splitlines()
    protected = [state.repository / ".git", state.repository / ".jj"]
    external_git_roots: list[tuple[Path, Path]] = []
    for line in git_layout:
        path = Path(line).resolve(strict=True)
        if any(character in str(path) for character in (",", "\n", "\r")):
            raise LauncherError("Git metadata path contains a container-mount delimiter")
        try:
            path.relative_to(state.repository)
        except ValueError:
            relative = Path(os.path.relpath(path, state.repository))
            target = Path(os.path.normpath(Path("/src/work") / relative))
            try:
                target.relative_to("/src")
            except ValueError as error:
                raise LauncherError("Git metadata path escapes the container workspace") from error
            if not any(path.is_relative_to(root) for root, _ in external_git_roots):
                external_git_roots = [
                    (root, root_target)
                    for root, root_target in external_git_roots
                    if not root.is_relative_to(path)
                ]
                external_git_roots.append((path, target))
            continue
        if path not in protected:
            protected.append(path)
    repository_aliases: list[Path] = []
    for source, relative_target in external_git_roots:
        for metadata_target in (source, relative_target):
            alias = Path(os.path.normpath(
                metadata_target / os.path.relpath(state.repository, source)
            ))
            if metadata_target == source:
                if alias != state.repository:
                    raise LauncherError("Git metadata produced an invalid host worktree alias")
            else:
                try:
                    alias.relative_to("/src")
                except ValueError as error:
                    raise LauncherError("Git metadata produced an unsafe worktree alias") from error
                if alias == Path("/src"):
                    raise LauncherError("Git metadata worktree alias is too broad")
            if alias != Path("/src/work") and alias not in repository_aliases:
                repository_aliases.append(alias)
    pi_agent = state.home / ".pi/agent"
    if pi_agent.exists() and (pi_agent.is_symlink() or not pi_agent.is_dir()):
        raise LauncherError(f"Pi agent directory is invalid: {pi_agent}")
    pi_agent.mkdir(mode=0o700, parents=True, exist_ok=True)
    sessions = pi_agent / "sessions"
    if sessions.exists() and (sessions.is_symlink() or not sessions.is_dir()):
        raise LauncherError(f"Pi sessions directory is invalid: {sessions}")
    sessions.mkdir(mode=0o700, parents=True, exist_ok=True)
    # Pi's /reload resolves configured packages, installing missing npm packages,
    # repairing version mismatches, and refreshing eligible Git sources. Keep these
    # package stores writable and persistent; all other undeclared agent state stays
    # private to the sandbox so extensions cannot accidentally share runtime data.
    persistent_package_directories = []
    for directory in (pi_agent / "npm", pi_agent / "git"):
        if directory.exists() and (directory.is_symlink() or not directory.is_dir()):
            raise LauncherError(f"Pi package directory is invalid: {directory}")
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        persistent_package_directories.append(directory)
    pi_extensions = DOTFILES / "config/pi-extensions"
    if not pi_extensions.is_dir():
        raise LauncherError(f"Pi extensions directory is missing: {pi_extensions}")
    state.pi_agent_tmp = Path(tempfile.mkdtemp(prefix="codex-private-agent-"))
    os.chmod(state.pi_agent_tmp, 0o700)
    for directory in ("extensions", "pi-codex-subagents"):
        (state.pi_agent_tmp / directory).mkdir(mode=0o700)
    state.pi_auth_mask = temporary_file()
    state.pi_auth_mask.write_text("{}\n", encoding="utf-8")

    command = [
        "docker", "run", "--name", state.codex_container, "-it",
        "--network", SANDBOX_NETWORK, "--http-proxy=false",
        "--secret", "codex-github-token,type=env,target=GH_TOKEN",
        "--env", "JJ_AGENT=pi",
        "--mount", f"type=bind,src={state.pi_agent_tmp},dst=/home/codex/.pi/agent",
        "--mount", f"type=bind,src={sessions},dst=/home/codex/.pi/agent/sessions",
        *[
            item
            for directory in persistent_package_directories
            for item in (
                "--mount",
                f"type=bind,src={directory},dst=/home/codex/.pi/agent/{directory.name}",
            )
        ],
        "--mount", f"type=bind,src={state.pi_auth_mask},dst=/home/codex/.pi/agent/auth.json,readonly",
        "--mount", f"type=bind,src={state.skills_tmp / 'skills'},dst=/home/codex/.agents/skills",
        *(
            ["--mount", f"type=bind,src={state.skills_tmp / 'sandbox'},dst=/home/codex/.agents/sandbox,readonly"]
            if (state.skills_tmp / "sandbox").is_dir() else []
        ),
        "--mount", f"type=bind,src={state.skills_tmp / 'config/shared-agents.md'},dst=/home/codex/.agents/shared.md,readonly",
        "--mount", f"type=bind,src={state.skills_tmp / 'config/pi-AGENTS.md'},dst=/home/codex/.pi/agent/AGENTS.md,readonly",
        "--mount", f"type=bind,src={state.skills_tmp / 'config/breq.md'},dst=/home/codex/.pi/agent/breq.md,readonly",
        "--mount", f"type=bind,src={state.skills_tmp / 'config/pi.json'},dst=/home/codex/.pi/agent/settings.json,readonly",
        "--mount", f"type=bind,src={state.skills_tmp / 'config/pi-mcp.json'},dst=/home/codex/.pi/agent/mcp.json,readonly",
        "--mount", f"type=bind,src={state.skills_tmp / 'config/pi-keybindings.json'},dst=/home/codex/.pi/agent/keybindings.json,readonly",
        "--mount", f"type=bind,src={state.skills_tmp / 'config/pi-codex-subagents.json'},dst=/home/codex/.pi/agent/pi-codex-subagents/config.json,readonly",
        "--mount", f"type=bind,src={pi_extensions},dst=/home/codex/.pi/agent/pi-extensions,readonly",
        "--mount", f"type=bind,src={state.home / '.codex/config.toml'},dst=/home/codex/.codex/config.toml,readonly",
        "--mount", f"type=bind,src={state.home / 'src'},dst=/src,readonly",
        "--mount", f"type=bind,src={state.repository},dst=/src/work,bind-nonrecursive=true",
        *[
            item
            for target in repository_aliases
            for item in (
                "--mount",
                f"type=bind,src={state.repository},dst={target},readonly,bind-nonrecursive=true",
            )
        ],
        *[
            item
            for path in protected
            for item in (
                "--mount",
                f"type=bind,src={path},dst={Path('/src/work') / path.relative_to(state.repository)},readonly",
            )
        ],
        *[
            item
            for path, relative_target in external_git_roots
            for target in (path, relative_target)
            for item in (
                "--mount",
                f"type=bind,src={path},dst={target},readonly",
            )
        ],
        *arguments,
    ]
    state.agent_process = subprocess.Popen(command)
    try:
        return state.agent_process.wait()
    except SignalExit as error:
        if state.agent_process.poll() is None:
            state.agent_process.send_signal(error.signum)
            try:
                state.agent_process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                state.agent_process.kill()
                state.agent_process.wait()
        raise


def execute(state: State) -> int:
    started = time.monotonic()
    timings: list[tuple[str, float]] = []

    def phase(name: str, action: Callable[[], object]) -> object:
        phase_started = time.monotonic()
        try:
            return action()
        finally:
            timings.append((name, time.monotonic() - phase_started))

    phase("repository validation", lambda: validate_repository(state))
    register_tmux_pane(state)
    builder = state.repository / ".agents/sandbox/base-image"
    if builder.is_file() and os.access(builder, os.X_OK):
        base_image = run([str(builder)], capture=True, cwd=state.repository).stdout.strip()
    else:
        base_image = "node:24-alpine3.22"
    with ThreadPoolExecutor(max_workers=2) as executor:
        model_image = executor.submit(ensure_image, state, base_image)
        sidecar_image = executor.submit(resolve_sidecar_image)
        state.image = phase("model image resolution", model_image.result)
        state.sidecar_image = phase("sidecar image resolution", sidecar_image.result)
    phase("network setup", ensure_network)
    phase("proxy lock", lambda: acquire_lock(state))
    with ThreadPoolExecutor(max_workers=2) as executor:
        proxy_future = executor.submit(
            phase, "proxy startup", lambda: attach_proxies(state),
        )
        relay_future = (
            executor.submit(phase, "Podman relay startup", lambda: start_relay(state))
            if state.agent_podman is not None else None
        )
        sidecar_arguments = proxy_future.result()
        relay_arguments = relay_future.result() if relay_future else []
    arguments = [*relay_arguments, state.image, *state.codex_arguments]
    system = run(["uname", "-s"], capture=True).stdout.strip()
    if system == "Linux":
        print(
            "warning: native Linux sandboxing disables sudo elevation with cap-drop=ALL and no-new-privileges.\n"
            "warning: a Podman Machine micro-VM would allow container sudo without weakening host isolation.",
            file=sys.stderr,
        )
        arguments = ["--cap-drop=ALL", "--security-opt=no-new-privileges", *arguments]
    phase("skill staging", lambda: stage_skills(state))
    arguments = [*sidecar_arguments, *arguments]
    if os.environ.get("CODEX_SANDBOX_TIMING"):
        detail = ", ".join(f"{name}={elapsed:.2f}s" for name, elapsed in timings)
        print(f"Sandbox startup: {time.monotonic() - started:.2f}s ({detail})", file=sys.stderr)
    return run_agent(state, arguments)


def cleanup_resource(label: str, arguments: list[str]) -> None:
    started = time.monotonic()
    try:
        result = run(arguments, check=False, quiet=True)
    except OSError:
        result = None
    elapsed = int(time.monotonic() - started)
    if result is None or result.returncode:
        print(f"warning: Cleaning up {label} failed after {elapsed}s.", file=sys.stderr)
    elif elapsed:
        print(f"Cleaning up {label}: done ({elapsed}s).", file=sys.stderr)


def cleanup(state: State) -> None:
    if state.cleaned:
        return
    state.cleaned = True
    started = time.monotonic()
    previous = started

    def timing(label: str) -> None:
        nonlocal previous
        now = time.monotonic()
        if os.environ.get("CODEX_SANDBOX_TIMING"):
            print(f"Sandbox cleanup: {label}={now - previous:.2f}s", file=sys.stderr)
        previous = now
    containers = []
    if state.codex_container_created:
        containers.append((
            f"Codex container {state.codex_container}",
            ["docker", "rm", "--force", state.codex_container],
        ))
    if state.relay_container_created:
        containers.append((
            f"relay container {state.relay_container}",
            ["docker", "rm", "--force", state.relay_container],
        ))
    with ThreadPoolExecutor(max_workers=max(1, len(containers))) as executor:
        list(executor.map(lambda item: cleanup_resource(*item), containers))
    timing("containers")

    networks = []
    if state.relay_link_created:
        networks.append((
            f"relay network {state.relay_link_network}",
            ["docker", "network", "rm", state.relay_link_network],
        ))
    if state.relay_egress_created:
        networks.append((
            f"relay network {state.relay_egress_network}",
            ["docker", "network", "rm", state.relay_egress_network],
        ))
    with ThreadPoolExecutor(max_workers=max(1, len(networks))) as executor:
        list(executor.map(lambda item: cleanup_resource(*item), networks))
    timing("networks")
    if state.skills_tmp is not None:
        started = time.monotonic()
        try:
            shutil.rmtree(state.skills_tmp)
        except OSError:
            elapsed = int(time.monotonic() - started)
            print(f"warning: Cleaning up staged skills {state.skills_tmp} failed after {elapsed}s.", file=sys.stderr)
    timing("skills")
    if state.pi_agent_tmp is not None:
        started = time.monotonic()
        try:
            shutil.rmtree(state.pi_agent_tmp)
        except OSError:
            elapsed = int(time.monotonic() - started)
            print(f"warning: Cleaning up private Pi state {state.pi_agent_tmp} failed after {elapsed}s.", file=sys.stderr)
    timing("Pi state")
    if state.lock_coordinated is not None:
        state.lock_coordinated.touch()
    if state.lock_release is not None:
        state.lock_release.touch()
    processes = [
        (name, process)
        for name, process in (("proxy lock", state.lock_process), ("proxy monitor", state.monitor_process))
        if process is not None
    ]

    def wait_process(item: tuple[str, subprocess.Popen[bytes]]) -> None:
        name, process = item
        process_started = time.monotonic()
        process.wait()
        if os.environ.get("CODEX_SANDBOX_TIMING"):
            print(f"Sandbox cleanup: {name}={time.monotonic() - process_started:.2f}s", file=sys.stderr)

    with ThreadPoolExecutor(max_workers=max(1, len(processes))) as executor:
        list(executor.map(wait_process, processes))
    timing("proxy processes")
    for path in (
        state.proxy_state, state.proxy_args, state.manifest, state.pi_auth_mask,
        state.lock_ready, state.lock_coordinated, state.lock_release,
    ):
        if path is not None:
            path.unlink(missing_ok=True)
    timing("temporary files")
    if os.environ.get("CODEX_SANDBOX_TIMING"):
        print(f"Sandbox cleanup total: {time.monotonic() - started:.2f}s", file=sys.stderr)


def login_codex_sidecar() -> int:
    home = Path(os.environ["HOME"])
    directory = Path(os.environ.get("CODEX_SANDBOX_AUTH_DIR", home / ".codex-sandbox-auth"))
    if directory.exists() and (directory.is_symlink() or not directory.is_dir()):
        raise LauncherError(f"Codex sandbox authentication directory is invalid: {directory}")
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(directory, 0o700)
    environment = os.environ.copy()
    environment["CODEX_HOME"] = str(directory)
    return subprocess.run(["codex", "login"], env=environment).returncode


def tmux_registrations() -> list[dict[str, str]]:
    result = run([
        "tmux", "list-panes", "-a", "-F", "#{@codex_sandbox_restart}",
    ], capture=True)
    registrations = []
    for encoded in result.stdout.splitlines():
        if not encoded:
            continue
        try:
            payload = json.loads(base64.urlsafe_b64decode(encoded).decode())
        except (ValueError, UnicodeError, json.JSONDecodeError) as error:
            raise LauncherError("tmux contains an invalid sandbox restart registration") from error
        if not isinstance(payload, dict) or set(payload) != {
            "version", "pane", "repository", "session", "token",
        } or payload["version"] != 1 or not all(
            isinstance(payload[field], str) and payload[field]
            for field in ("pane", "repository", "session", "token")
        ):
            raise LauncherError("tmux contains an invalid sandbox restart registration")
        registrations.append(payload)
    return registrations


def restart_all_tmux_sessions() -> int:
    if "TMUX" not in os.environ:
        raise LauncherError("restart-all must run inside tmux")
    registrations = tmux_registrations()
    if not registrations:
        raise LauncherError("tmux has no registered sandbox sessions")
    for registration in registrations:
        for _ in range(3):
            run(["tmux", "send-keys", "-t", registration["pane"], "C-c"])
            time.sleep(0.05)
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        if not tmux_registrations():
            break
        time.sleep(0.1)
    else:
        raise LauncherError("sandbox panes did not stop within 15 seconds")
    for repository in sorted({item["repository"] for item in registrations}):
        helper("reset", "--repo", repository)
    for registration in registrations:
        command = (
            shlex.join(["cd", registration["repository"]])
            + " && "
            + shlex.join(["pi", "--session", registration["session"]])
        )
        run(["tmux", "send-keys", "-t", registration["pane"], "-l", command])
        run(["tmux", "send-keys", "-t", registration["pane"], "Enter"])
    message = f"Restarted {len(registrations)} sandbox session(s)."
    run(["tmux", "display-message", "-d", "5000", message], check=False, quiet=True)
    print(message)
    return 0


def main(arguments: list[str]) -> int:
    if arguments == ["restart-all"]:
        try:
            return restart_all_tmux_sessions()
        except (LauncherError, OSError, subprocess.CalledProcessError) as error:
            message = f"Sandbox restart failed: {error}"
            if "TMUX" in os.environ:
                try:
                    run([
                        "tmux", "display-message", "-d", "8000", message,
                    ], check=False, quiet=True)
                except OSError:
                    pass
            print(f"error: {error}", file=sys.stderr)
            return 1
    if arguments == ["auth", "login"]:
        try:
            return login_codex_sidecar()
        except (LauncherError, OSError) as error:
            print(f"error: {error}", file=sys.stderr)
            return 1
    state: State | None = None
    previous_handlers: dict[int, object] = {}

    def handle_signal(signum: int, _frame: object) -> None:
        raise SignalExit(signum)

    try:
        state = new_state(arguments)
        for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
            previous_handlers[signum] = signal.signal(signum, handle_signal)
        result = execute(state)
        return result
    except SignalExit as error:
        return 128 + error.signum
    except LauncherError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as error:
        return error.returncode
    except OSError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    finally:
        for signum in previous_handlers:
            signal.signal(signum, signal.SIG_IGN)
        if state is not None:
            cleanup(state)
            unregister_tmux_pane(state)
        for signum, handler in previous_handlers.items():
            signal.signal(signum, handler)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
