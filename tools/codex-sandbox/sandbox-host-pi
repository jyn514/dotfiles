#!/usr/bin/env python3
"""Launch host Pi; attach agent sessions to the guest tool worker."""

import os
from pathlib import Path
import sys


def main() -> None:
    home = Path.home()
    pi_cli = home / ".local/share/pi/node/node_modules/.bin/pi"
    if not pi_cli.is_file():
        raise SystemExit(f"Host Pi is not installed at {pi_cli}")
    if sys.argv[1:2] == ["--export"]:
        # Extra flags can overwrite export mode and start an agent without guest tools.
        if len(sys.argv) not in (3, 4) or any(not argument for argument in sys.argv[2:]):
            raise SystemExit("Usage: pi --export SESSION.jsonl [OUTPUT.html]")
        os.execv(pi_cli, [str(pi_cli), *sys.argv[1:]])
    extensions = Path(__file__).resolve().parents[2] / "config/agents/pi/pi-extensions"
    old_sidecar = home / ".pi/agent/pi-extensions/codex-sidecar.ts"
    installed_index = home / ".pi/agent/pi-extensions/index.ts"
    args = []
    index = 1
    while index < len(sys.argv):
        if (sys.argv[index] in ("--extension", "-e") and index + 1 < len(sys.argv)
                and Path(sys.argv[index + 1]).expanduser() in (old_sidecar, installed_index)):
            # Drop the guest-only provider and replace the index with its source.
            index += 2
            continue
        args.append(sys.argv[index])
        index += 1
    os.execv(pi_cli, [str(pi_cli), "--extension", str(extensions / "index.ts"),
                      "--extension", str(extensions / "guest-tools.ts"), *args])


if __name__ == "__main__":
    main()
