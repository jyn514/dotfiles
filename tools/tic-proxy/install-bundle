#!/usr/bin/env python3
"""Stage a local bundle through the launcher's protected cache validation path.

No current-build record is written. Ordinary launches resolve their source key.
"""
import argparse
from pathlib import Path
import sys
from bundle import validate_bundle

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'codex-sandbox'))
from tic_artifact import resolve_bundle


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('bundle', type=Path)
    parser.add_argument('--prefix', type=Path, required=True)
    parser.add_argument('--guest-writable-root', type=Path, action='append', default=[])
    args = parser.parse_args()
    bundle = args.bundle.resolve(strict=True)
    _, manifest, _ = validate_bundle(bundle)
    print(resolve_bundle(args.prefix, manifest['client']['platform'], args.guest_writable_root,
                         None, local_bundle=bundle))


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError) as error:
        sys.exit(f'install-bundle: {error}')
