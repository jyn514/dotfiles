#!/usr/bin/env bb
;; Extract readable user/assistant turns from Pi, Codex, and Claude session JSON/JSONL files.
;;
;; Usage:
;;   extract-chat --session 019abcde-1234-7000-8000-0123456789ab
;;   extract-chat --archived --session 019abcde-1234-7000-8000-0123456789ab
;;   extract-chat --final-only ~/.codex/sessions
;;   extract-chat --extract-dir out ~/.codex/sessions
;;   extract-chat --native --extract-dir out ~/.pi/agent/sessions

(ns tools.extract-chat
  (:require [cheshire.core :as json]
            [clojure.java.io :as io]
            [clojure.java.shell :as shell]
            [clojure.string :as str])
  (:import (java.nio.file Files Path)))

(defn default-root
  ([environment] (default-root environment false))
  ([environment archived?]
   (str (or (get environment "CODEX_HOME")
            (str (System/getProperty "user.home") "/.codex"))
        (if archived? "/archived_sessions" "/sessions"))))

(defn- pi-root []
  (str (System/getProperty "user.home") "/.pi/agent/sessions"))

(defn- usage []
  (println "Usage: extract-chat [--archived] [--final-only] [--native] [--extract-dir DIR] [--session ID | FILE-or-DIR ...]")
  (println)
  (println "With no paths, recursively scans ~/.codex/sessions for .json and .jsonl files.")
  (println "With --archived, uses ~/.codex/archived_sessions for the implicit root.")
  (println "With --session, extracts the Codex or Pi session whose filename ends in ID.")
  (println "With --extract-dir, writes one Markdown file per session instead of printing to stdout.")
  (println "With --native, exports Pi sessions through pi --export to HTML; other formats stay Markdown.")
  (println "Native exports require pi on PATH and keep the full session, ignoring --final-only.")
  (println "Without --extract-dir, Pi chooses the HTML filename in the current directory."))

(defn- path [s]
  (.toPath (io/file s)))

(defn- regular-file? [^Path p]
  (Files/isRegularFile p (make-array java.nio.file.LinkOption 0)))

(defn- directory? [^Path p]
  (Files/isDirectory p (make-array java.nio.file.LinkOption 0)))

(defn- session-file? [^Path p]
  (let [s (str p)]
    (and (regular-file? p)
         (or (str/ends-with? s ".json")
             (str/ends-with? s ".jsonl")))))

(defn- files-under [^Path p]
  (if (directory? p)
    (with-open [stream (Files/walk p (make-array java.nio.file.FileVisitOption 0))]
      (->> (iterator-seq (.iterator stream))
           (filter session-file?)
           (sort-by str)
           doall))
    (when (session-file? p) [p])))

(defn- session-file-name-matches? [session ^Path file]
  (let [file-name (str (.getFileName file))
        stem (str/replace file-name #"\.jsonl?$" "")]
    (or (= session stem)
        (str/ends-with? stem (str "-" session))
        (str/ends-with? stem (str "_" session)))))

(defn- find-session [session archived?]
  (let [roots [(default-root (System/getenv) archived?)
               (when-not archived? (pi-root))]
        matches (->> roots
                     (remove nil?)
                     (mapcat #(files-under (path %)))
                     (filter #(session-file-name-matches? session %))
                     distinct)]
    (case (count matches)
      0 (throw (ex-info (str "No session found for " session)
                        {:session session :roots roots}))
      1 (first matches)
      (throw (ex-info (str "Multiple sessions found for " session)
                      {:session session :roots roots :matches matches})))))

(defn- read-json-lines [file]
  (with-open [r (io/reader (.toFile file))]
    (doall
     (for [line (line-seq r)
           :let [line (str/trim line)]
           :when (seq line)]
       (json/parse-string line true)))))

(defn- read-json-file [file]
  (let [value (json/parse-string (slurp (.toFile file)) true)]
    (cond
      (sequential? value) value
      (map? value) [value]
      :else [])))

(defn- read-events [file]
  (if (str/ends-with? (str file) ".jsonl")
    (read-json-lines file)
    (try
      (read-json-file file)
      (catch Exception _
        ;; Some exported session files are JSONL even when named .json.
        (read-json-lines file)))))

(defn- content-part-text [part]
  (cond
    (string? part) part
    (map? part)
    (case (:type part)
      "text" (:text part)
      "input_text" (or (:text part) (:input_text part))
      "output_text" (or (:text part) (:output_text part))
      nil (or (:text part) (:input_text part) (:output_text part))
      nil)
    :else nil))

(defn- content-text [content]
  (cond
    (nil? content) ""
    (string? content) content
    (map? content) (or (content-part-text content) "")
    (sequential? content) (str/join "\n" (keep content-part-text content))
    :else ""))

(defn- synthetic-codex-user-message? [text]
  (or (str/starts-with? text "# AGENTS.md instructions for ")
      (str/starts-with? text "<environment_context>")))

(defn- event-message [event]
  (when (map? event)
    (let [{event-type :type, :keys [payload]} event]
      (when (= "event_msg" event-type)
        (case (:type payload)
          "user_message"
          (when (seq (str/trim (:message payload)))
            {:role "user"
             :text (:message payload)})

          "agent_message"
          (when (seq (str/trim (:message payload)))
            {:role "assistant"
             :phase (:phase payload)
             :text (:message payload)})

          nil)))))

(defn- response-item-message [event]
  (when (map? event)
    (let [{event-type :type, :keys [payload]} event]
      (when (and (= "response_item" event-type)
                 (= "message" (:type payload))
                 (#{"user" "assistant"} (:role payload)))
        (let [text (content-text (:content payload))]
          (when (and (seq (str/trim text))
                     (not (and (= "user" (:role payload))
                               (synthetic-codex-user-message? text))))
            {:role (:role payload)
             :phase (:phase payload)
             :text text}))))))

(defn- claude-message [event]
  (when (map? event)
    (let [{event-type :type, :keys [message]} event]
      (when (case event-type ("assistant" "user") event-type nil)
        (let [role (or (:role message) event-type)
              text (content-text (:content message))]
          (when (and (case role ("assistant" "user") role nil)
                     (seq (str/trim text)))
            {:role role
             :text text}))))))

(defn- pi-message [event]
  (when (and (map? event) (= "message" (:type event)))
    (let [message (:message event)
          role (:role message)
          text (content-text (:content message))]
      (when (and (case role ("assistant" "user") role nil)
                 (seq (str/trim text)))
        {:role role
         :text text}))))

(defn- messages [events]
  (or (seq (keep event-message events))
      (seq (keep response-item-message events))
      (seq (keep claude-message events))
      (seq (keep pi-message events))))

(defn- codex-session-meta [events]
  (some (fn [{:keys [type payload timestamp]}]
          (when (and (= "session_meta" type)
                     (:session_id payload))
            {:session-id (:session_id payload)
             :timestamp (or (:timestamp payload) timestamp)}))
        events))

(defn- keep-message? [final-only? {:keys [role phase]}]
  (or (not final-only?)
      (= "user" role)
      (nil? phase)
      (= "final_answer" phase)))

(defn- role-heading [{:keys [role phase]}]
  (str "## "
       (case role
         "user" "User"
         "assistant" "Assistant"
         role)
       (when (and phase (not= phase "final_answer"))
         (str " (" phase ")"))))

(defn- read-session [final-only? file]
  (let [events (read-events file)]
    (merge {:file file
            :pi? (= "session" (:type (first events)))
            :messages (vec (filter #(keep-message? final-only? %)
                                   (messages events)))}
           (codex-session-meta events))))

(defn- session-markdown [{:keys [file messages]}]
  (when (seq messages)
    (str "# " file "\n\n"
         (str/join
          ""
          (for [message messages]
            (str (role-heading message) "\n\n"
                 (:text message) "\n\n"))))))

(defn- prefix? [prefix values]
  (and (<= (count prefix) (count values))
       (= prefix (subvec values 0 (count prefix)))))

(defn- without-replayed-prefixes [sessions]
  ;; Codex resumes and forks replay their history into a new rollout. A shared
  ;; session id plus an exact whole-conversation prefix identifies that replay.
  ;; An independently authored identical whole conversation under the same id
  ;; is indistinguishable and is treated as replay. Identical conversations with
  ;; different ids, and identical later turns that are not prefixes, remain.
  (loop [seen-by-id {}
         sessions sessions
         deduplicated []]
    (if-let [current (first sessions)]
      (let [session-id (:session-id current)
            prior-messages (when session-id (get seen-by-id session-id))
            prefix (->> prior-messages
                        (filter #(prefix? % (:messages current)))
                        (sort-by count)
                        last)
            current (update current :messages subvec (count prefix))]
        (recur (cond-> seen-by-id
                 session-id (update session-id (fnil conj [])
                                    (into (or prefix []) (:messages current))))
               (next sessions)
               (conj deduplicated current)))
      deduplicated)))

(defn- session-output-path [extract-dir file extension]
  (let [file-name (str (.getFileName ^Path file))
        output-name (str/replace file-name #"\.jsonl?$" extension)]
    (.toPath (io/file extract-dir output-name))))

(defn- export-pi-session [extract-dir file]
  (let [output-file (when extract-dir (session-output-path extract-dir file ".html"))
        args (cond-> ["pi" "--export" (.getAbsolutePath (.toFile ^Path file))]
               output-file (conj (.getAbsolutePath (.toFile ^Path output-file))))]
    (when output-file
      (io/make-parents (.toFile ^Path output-file)))
    (let [{:keys [exit out err]} (apply shell/sh args)]
      (when-not (zero? exit)
        (throw (ex-info (str "Pi export failed for " file ": " (str/trim err))
                        {:file (str file) :exit exit})))
      (print out)
      (binding [*out* *err*] (print err)))))

(defn- print-session [final-only? native? file]
  (let [{:keys [pi?] :as session} (read-session final-only? file)]
    (if (and native? pi?)
      (export-pi-session nil file)
      (when-let [markdown (session-markdown session)]
        (print markdown)))))

(defn- write-session [extract-dir native? {:keys [file pi?] :as session}]
  (if (and native? pi?)
    (export-pi-session extract-dir file)
    (when-let [markdown (session-markdown session)]
      (let [output-file (session-output-path extract-dir file ".md")]
        (io/make-parents (.toFile output-file))
        (spit (.toFile output-file) markdown)))))

(defn- parse-args [args]
  (loop [opts {:paths []}
         args (seq args)]
    (if-not args
      opts
      (let [arg (first args)]
        (cond
          (= "--native" arg)
          (recur (assoc opts :native? true) (next args))

          (= "--final-only" arg)
          (recur (assoc opts :final-only? true) (next args))

          (= "--archived" arg)
          (recur (assoc opts :archived? true) (next args))

          (= "-h" arg)
          (recur (assoc opts :help? true) (next args))

          (= "--help" arg)
          (recur (assoc opts :help? true) (next args))

          (= "--extract-dir" arg)
          (if-let [dir (second args)]
            (recur (assoc opts :extract-dir dir) (nnext args))
            (throw (ex-info "--extract-dir requires a directory" {:arg arg})))

          (str/starts-with? arg "--extract-dir=")
          (recur (assoc opts :extract-dir (subs arg (count "--extract-dir="))) (next args))

          (= "--session" arg)
          (if-let [session (second args)]
            (recur (assoc opts :session session) (nnext args))
            (throw (ex-info "--session requires an ID" {:arg arg})))

          (str/starts-with? arg "--session=")
          (recur (assoc opts :session (subs arg (count "--session="))) (next args))

          :else
          (recur (update opts :paths conj arg) (next args)))))))

(defn main [args]
  (let [{:keys [archived? final-only? native? help? paths extract-dir session]} (parse-args args)]
    (if help?
      (usage)
      (let [files (if session
                    [(find-session session archived?)]
                    (let [roots (if (seq paths)
                                  paths
                                  [(default-root (System/getenv) archived?)])]
                      (mapcat (comp files-under path) roots)))]
        (when (and
               (not (seq paths))
               (not session)
               (not extract-dir))
          (println "Cowardly refusing to extract all conversations to stdout")
          (usage)
          (System/exit 1))
        (if extract-dir
          (let [sessions (->> files
                              (map #(read-session final-only? %))
                              (sort-by (juxt :timestamp (comp str :file)))
                              without-replayed-prefixes)]
            (doseq [session sessions]
              (write-session extract-dir native? session)))
          (doseq [file files]
            (print-session final-only? native? file)))))))

(when (= *file* (System/getProperty "babashka.file"))
  (main *command-line-args*))
