#!/usr/bin/env bb
(ns jj-agent-split-editor
  (:require [babashka.fs :as fs]
            [babashka.process :as process]
            [clojure.string :as str]))

(defn- script-file []
  (if (not-empty *file*)
    *file*
    "tools/agent-split/src/scripts/agent-split-editor"))

(load-file (str (fs/file (fs/parent (fs/canonicalize (script-file)))
                         "temp.clj")))

(def temp-root (ns-resolve 'scripts.temp 'temp-root))

(load-file (str (fs/file (fs/parent (fs/canonicalize (script-file)))
                         "containment.clj")))

(defn- fail! [message]
  (binding [*out* *err*]
    (println (str "jj-agent-split-editor: " message)))
  (System/exit 1))

(defn- run!
  [& args]
  (let [result (apply process/shell
                      (merge {:out :string
                              :err :string
                              :shutdown nil
                              :continue true}
                             (when (map? (first args))
                               (first args)))
                      (if (map? (first args))
                        (rest args)
                        args))]
    (when-not (zero? (:exit result))
      (fail! (str "command failed: " (str/join " " (if (map? (first args))
                                                     (rest args)
                                                     args))
                  (when (seq (:err result))
                    (str "\n" (:err result))))))
    result))

(defn- diff-command [left right]
  ["git" "diff" "--no-index" "--binary" "--no-renames"
   "--src-prefix=a/" "--dst-prefix=b/" (str left) (str right)])

(defn- diff-output [left right]
  (let [result (apply process/shell
                      {:out :bytes
                       :err :string
                       :shutdown nil
                       :continue true}
                      (diff-command left right))]
    (when-not (#{0 1} (:exit result))
      (fail! (str "could not diff trees\n" (:err result))))
    (or ((ns-resolve 'scripts.containment 'decode-utf8) (:out result))
        (fail! "canonical diff contains non-UTF-8 text; selection is unsupported"))))

(defn- split-diff-paths [line]
  (when-let [[_ left right] (re-matches #"diff --git a/(.+) b/(.+)" line)]
    [left right]))

(defn- patch-file-paths [patch-text]
  (let [paths (atom [])
        saw-diff? (atom false)
        in-hunk? (atom false)]
    (doseq [line (str/split-lines patch-text)]
      (cond
        (str/starts-with? line "diff --git ")
        (if-let [[left right] (split-diff-paths line)]
          (do
            (reset! saw-diff? true)
            (reset! in-hunk? false)
            (swap! paths into [left right]))
          (fail! (str "malformed diff header: " line)))

        (str/starts-with? line "@@ ")
        (reset! in-hunk? true)

        ;; Hunk content can itself begin with --- or +++; only parse file headers.
        @in-hunk? nil

        (some #(str/starts-with? line %)
              ["rename from " "rename to " "copy from " "copy to "])
        (let [[_ path] (re-matches #"(?:rename|copy) (?:from|to) (.+)" line)]
          (swap! paths conj path))

        (or (str/starts-with? line "--- ")
            (str/starts-with? line "+++ "))
        (let [path (subs line 4)]
          (when-not (= "/dev/null" path)
            (if-let [[_ prefix file] (re-matches #"([ab])/(.+)" path)]
              (swap! paths conj file)
              (fail! (str "malformed patch path: " path)))))))
    (when-not @saw-diff?
      (fail! "malformed patch: no diff --git header found"))
    @paths))

(defn- unsafe-path? [path]
  (let [path (str path)]
    (or (str/blank? path)
        (str/starts-with? path "/")
        (some #{".."} (str/split path #"/")))))

(defn- validate-patch-paths! [tree patch-text]
  (let [root (.normalize (.toAbsolutePath (fs/path tree)))]
    (doseq [path (patch-file-paths patch-text)]
      (when (unsafe-path? path)
        (fail! (str "unsafe patch path: " path)))
      (let [resolved (.normalize (.resolve root path))]
        (when-not (str/starts-with? (str resolved) (str root))
          (fail! (str "patch path outside tree: " path)))))))

(defn- normalize-diff-paths [diff-text left right]
  (let [left-prefix (str (str/replace (str (.normalize (.toAbsolutePath (fs/path left)))) #"^/" "") "/")
        right-prefix (str (str/replace (str (.normalize (.toAbsolutePath (fs/path right)))) #"^/" "") "/")]
    (-> diff-text
        (str/replace left-prefix "")
        (str/replace right-prefix ""))))

(def diff-change-index (ns-resolve 'scripts.containment 'change-index))

(defn- validate-index-contained! [original selected]
  (doseq [[file selected-changes] selected]
    (let [original-changes (get original file)]
      (when-not (or (seq (:modes selected-changes)) (seq (:edits selected-changes))
                    (seq (:binary selected-changes)))
        (fail! (str "selected diff for " file " is empty or malformed")))
      (when-not ((ns-resolve 'scripts.containment 'contained?) original-changes selected-changes)
        (fail! (str "selected change for " file
                    " is not contained in original diff"))))))

(defn- validate-contained! [left right selected]
  (let [original (diff-change-index
                  (normalize-diff-paths (diff-output left right) left right))
        selected (diff-change-index
                  (normalize-diff-paths (diff-output left selected) left selected))]
    (validate-index-contained! original selected)))

(defn- copy-tree! [from to]
  (when (fs/exists? to)
    (fs/delete-tree to))
  (fs/create-dirs (fs/parent to))
  (run! "cp" "-a" (str from) (str to)))

(defn- apply-patch! [tree patch]
  ;; Match wrapper preflight when hand-selected hunks retain old counts.
  (let [check (process/shell {:dir (str tree)
                              :out :string
                              :err :string
                              :shutdown nil
                              :continue true}
                             "git" "apply" "--recount" "--check" (str patch))]
    (when-not (zero? (:exit check))
      (fail! (str "patch dry-run failed\n" (:err check)))))
  (run! {:dir (str tree)} "git" "apply" "--recount" (str patch)))

(defn- usage! []
  (fail! "usage: jj-agent-split-editor LEFT RIGHT with JJ_AGENT_SPLIT_PATCH set"))

(defn- main [args]
  (when-not (= 2 (count args))
    (usage!))
  (let [[left right] args
        patch (or (System/getenv "JJ_AGENT_SPLIT_PATCH")
                  (fail! "JJ_AGENT_SPLIT_PATCH is not set"))]
    (when-not (fs/directory? left)
      (fail! (str "left tree is not a directory: " left)))
    (when-not (fs/directory? right)
      (fail! (str "right tree is not a directory: " right)))
    (when-not (fs/regular-file? patch)
      (fail! (str "JJ_AGENT_SPLIT_PATCH does not name a file: " patch)))
    (let [patch-text (slurp patch)
          tmp-root (fs/create-temp-dir {:dir (str (temp-root))
                                        :prefix "jj-agent-split-editor"})
          selected (fs/file tmp-root "selected")
          remaining-patch (fs/file tmp-root "remaining.patch")]
      (try
        (validate-patch-paths! left patch-text)
        (copy-tree! left selected)
        (spit (str remaining-patch) patch-text)
        (apply-patch! selected remaining-patch)
        (validate-contained! left right selected)
        (copy-tree! selected right)
        (println "selected files:")
        (doseq [path (sort (distinct (patch-file-paths patch-text)))]
          (println (str "  " path)))
        (finally
          (fs/delete-tree tmp-root))))))

(main *command-line-args*)
