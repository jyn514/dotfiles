#!/bin/sh
set -eu

original_path=$PATH
if [ -n "${BB_REAL:-}" ]; then
	if [ ! -x "$BB_REAL" ]; then
		printf '%s\n' "bb wrapper: configured real bb is not executable" >&2
		exit 1
	fi
	real_bb=$BB_REAL
else
	source_path=$(realpath -- "$0") || exit 1
	root=$(CDPATH='' cd -- "${source_path%/*}/../.." && pwd -P) || exit 1
	. "$root/lib/shell/lib.sh"
	shim_resolve "$0" bb
	real_bb=$REAL
fi
# Keep sibling command wrappers available to every Babashka child process.
PATH=$original_path
export PATH

# babashka is a native image, so it never reaches the java wrapper. See that
# wrapper for why $TMPDIR has to be forced. Substrate VM options lead the
# command line, ahead of any task or subcommand.
tmpdir_opt=
if [ -n "${TMPDIR:-}" ]; then
	tmpdir_opt=-Djava.io.tmpdir=$TMPDIR
fi

if [ "${1:-}" = agent-split ]; then
	shift
	root=${BB_SOURCE_ROOT:-${root:-}}
	if [ -z "$root" ]; then
		source_path=$(realpath -- "$0") || exit 1
		root=$(CDPATH='' cd -- "${source_path%/*}/../.." && pwd -P) || exit 1
	fi
	exec "$real_bb" ${tmpdir_opt:+"$tmpdir_opt"} "$root/tools/agent-split/src/scripts/agent-split.clj" "$@"
fi

exec "$real_bb" ${tmpdir_opt:+"$tmpdir_opt"} "$@"
