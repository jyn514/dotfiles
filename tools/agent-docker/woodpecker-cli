#!/usr/bin/env python3
"""Run local Woodpecker pipelines beside the sandbox Docker service."""

from __future__ import annotations

import os
import re
import shlex
import signal
import subprocess
import sys
import uuid
from pathlib import Path
from urllib.parse import urlparse


class UsageError(Exception):
    pass


LOCAL_PATH_OPTIONS = (
    "--config",
    "-c",
    "--metadata-file",
    "--secrets-file",
    "--backend-docker-cert",
)


def parse_exec(argv: list[str]) -> tuple[Path, Path, list[int]]:
    if not argv or argv[0] != "exec":
        raise UsageError("only 'woodpecker-cli exec' is supported in the sandbox")

    repo_value: str | None = None
    repo_indexes: list[int] = []
    local_false = False
    index = 1
    while index < len(argv):
        arg = argv[index]
        if any(
            arg == option or arg.startswith(f"{option}=")
            for option in LOCAL_PATH_OPTIONS
        ):
            raise UsageError(f"{arg.split('=', 1)[0]} refers to an unstaged local path")
        if arg == "--repo-path":
            if index + 1 >= len(argv):
                raise UsageError("--repo-path requires a directory")
            repo_value = argv[index + 1]
            repo_indexes.extend((index, index + 1))
            index += 2
            continue
        if arg.startswith("--repo-path="):
            repo_value = arg.split("=", 1)[1]
            repo_indexes.append(index)
        if arg == "--local=false" or (
            arg == "--local"
            and index + 1 < len(argv)
            and argv[index + 1] == "false"
        ):
            local_false = True
        index += 1

    if local_false:
        raise UsageError("--local=false is not supported by the sandbox adapter")
    if repo_value is None or not repo_value:
        raise UsageError("exec requires exactly one --repo-path directory")
    repo_options = [
        i
        for i in repo_indexes
        if argv[i] == "--repo-path" or argv[i].startswith("--repo-path=")
    ]
    if len(repo_options) != 1:
        raise UsageError("exec requires exactly one --repo-path directory")

    # Woodpecker's exec command accepts one positional pipeline, after options.
    pipeline_index = len(argv) - 1
    if (
        pipeline_index < 1
        or pipeline_index in repo_indexes
        or argv[pipeline_index].startswith("-")
    ):
        raise UsageError("exec requires one positional pipeline file as its final argument")

    repo = Path(repo_value).expanduser().resolve(strict=True)
    pipeline = Path(argv[pipeline_index]).expanduser().resolve(strict=True)
    if not repo.is_dir():
        raise UsageError(f"repository is not a directory: {repo}")
    if not pipeline.is_file():
        raise UsageError(f"pipeline is not a file: {pipeline}")
    return repo, pipeline, repo_indexes + [pipeline_index]


def ssh_target() -> tuple[list[str], str]:
    host = os.environ.get("DOCKER_HOST", "")
    key = os.environ.get("AGENT_DOCKER_SSHKEY", "")
    known_hosts = os.environ.get("AGENT_DOCKER_KNOWN_HOSTS", "")
    parsed = urlparse(host)
    try:
        port = parsed.port
    except ValueError as error:
        raise UsageError(f"invalid port in DOCKER_HOST: {error}") from error
    if parsed.scheme != "ssh" or not parsed.hostname or not parsed.username or not port:
        raise UsageError("DOCKER_HOST must identify the agent Docker SSH service")
    if not re.fullmatch(r"[a-z_][a-z0-9_-]*", parsed.username):
        raise UsageError("DOCKER_HOST contains an invalid SSH user")
    if not key or not Path(key).is_file():
        raise UsageError("AGENT_DOCKER_SSHKEY does not name the mounted agent Docker key")
    if not known_hosts or not Path(known_hosts).is_file():
        raise UsageError("AGENT_DOCKER_KNOWN_HOSTS does not name the mounted host-key file")
    command = [
        "ssh", "-F", "/dev/null",
        "-o", "BatchMode=yes",
        "-o", "IdentitiesOnly=yes",
        "-o", "StrictHostKeyChecking=yes",
        "-o", f"UserKnownHostsFile={known_hosts}",
        "-o", "HostKeyAlias=agent-docker",
        "-o", "ConnectTimeout=10",
        "-o", "ServerAliveInterval=5",
        "-o", "ServerAliveCountMax=3",
        "-i", key,
        "-p", str(port),
        f"{parsed.username}@{parsed.hostname}",
    ]
    return command, parsed.username


def run_checked(command: list[str], *, stdin=None) -> None:
    result = subprocess.run(command, stdin=stdin)
    if result.returncode:
        recovery = ""
        if result.returncode == 255 and command and Path(command[0]).name == "ssh":
            recovery = (
                "; Agent Docker SSH is unavailable. On the host, run the "
                "dotfiles checkout's tools/agent-docker/vm.py start, then retry"
            )
        raise RuntimeError(
            f"command failed with exit status {result.returncode}: "
            f"{shlex.join(command[:2])}{recovery}"
        )


def encode_argv(argv: list[str]) -> bytes:
    return b"".join(os.fsencode(arg) + b"\0" for arg in argv)


def main(argv: list[str]) -> int:
    try:
        repo, pipeline, rewritten = parse_exec(argv)
        ssh, user = ssh_target()
    except (OSError, UsageError) as error:
        print(f"woodpecker-cli adapter: {error}", file=sys.stderr)
        return 2

    run_id = uuid.uuid4().hex
    run_dir = f"/home/{user}/.local/state/agent-docker/woodpecker-runs/{run_id}"
    supervisor = f"/home/{user}/.local/libexec/agent-docker/woodpecker-supervisor"
    print(f"woodpecker-cli adapter: repository {repo}", file=sys.stderr)
    print(f"woodpecker-cli adapter: remote run {run_id}", file=sys.stderr)

    child: subprocess.Popen[bytes] | None = None
    previous: dict[int, object] = {}

    def terminate(signum: int, _frame: object) -> None:
        try:
            subprocess.run(ssh + [supervisor, "terminate", run_id], timeout=50)
        except (OSError, subprocess.TimeoutExpired):
            pass
        # communicate may hold the child's wait lock when a signal arrives.
        # Unwind it before the finally block joins that child.
        raise SystemExit(128 + signum)

    # Cancellation owns staging as well as the remote pipeline process.
    for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        previous[signum] = signal.signal(signum, terminate)
    completed = False
    try:
        run_checked(ssh + [supervisor, "prepare", run_id])
        tar = subprocess.Popen(["tar", "-C", str(repo), "-cf", "-", "."], stdout=subprocess.PIPE)
        assert tar.stdout is not None
        transferred = False
        try:
            run_checked(ssh + [supervisor, "receive-repository", run_id], stdin=tar.stdout)
            transferred = True
        finally:
            tar.stdout.close()
            if not transferred and tar.poll() is None:
                tar.terminate()
                try:
                    tar.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    tar.kill()
                    tar.wait()
        if tar.wait():
            raise RuntimeError(f"repository transfer failed with tar exit status {tar.returncode}")

        try:
            relative_pipeline = pipeline.relative_to(repo)
            remote_pipeline = f"{run_dir}/repo/{relative_pipeline.as_posix()}"
        except ValueError:
            remote_pipeline = f"{run_dir}/pipeline"
            with pipeline.open("rb") as source:
                run_checked(ssh + [supervisor, "receive-pipeline", run_id], stdin=source)

        remote_argv = argv.copy()
        repo_indexes = rewritten[:-1]
        if len(repo_indexes) == 1:
            remote_argv[repo_indexes[0]] = f"--repo-path={run_dir}/repo"
        else:
            remote_argv[repo_indexes[1]] = f"{run_dir}/repo"
        remote_argv[rewritten[-1]] = remote_pipeline

        try:
            child = subprocess.Popen(
                ssh + [supervisor, "run", run_id], stdin=subprocess.PIPE
            )
            child.communicate(input=encode_argv([os.environ.get("WOODPECKER_SECRETS", ""), *remote_argv]))
            status = child.returncode
        finally:
            if child is not None and child.poll() is None:
                child.terminate()
                try:
                    child.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    child.kill()
                    child.wait()
        completed = True
        print(f"woodpecker-cli adapter: remote Woodpecker exit status {status}", file=sys.stderr)
        return status
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
        print(f"woodpecker-cli adapter: {error}", file=sys.stderr)
        return 1
    finally:
        for signum, handler in previous.items():
            signal.signal(signum, handler)
        if not completed:
            try:
                result = subprocess.run(ssh + [supervisor, "discard", run_id], timeout=20)
                if result.returncode:
                    raise RuntimeError("discard failed")
            except (OSError, RuntimeError, subprocess.TimeoutExpired):
                print(f"woodpecker-cli adapter: warning: could not discard remote run {run_id}",
                      file=sys.stderr)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
