#!/usr/bin/env node
// Extract readable user/assistant turns from a ChatGPT or Claude shared chat.
//
// Usage:
//   extract-chat-share [OPTIONS] FILE.html|URL

const fs = require("fs");
const path = require("path");
const { execFile } = require("node:child_process");
const { parseArgs } = require("node:util");

function usage(stream = process.stderr) {
  stream.write(`Usage: extract-chat-share [OPTIONS] FILE.html|URL

Extract readable turns from a ChatGPT or Claude shared conversation.
Claude URLs require Safari on macOS with JavaScript from Apple Events enabled.

Options:
  --user-heading TEXT       User heading (default: User)
  --assistant-heading TEXT  Assistant heading (default: Assistant)
  -h, --help                Show this help
`);
}

function parseArguments(argv) {
  if (argv.includes("-h") || argv.includes("--help")) {
    return { help: true };
  }

  const { values, positionals } = parseArgs({
    args: argv,
    allowPositionals: true,
    options: {
      "assistant-heading": { type: "string", default: "Assistant" },
      "user-heading": { type: "string", default: "User" },
    },
  });

  if (positionals.length !== 1) {
    throw new Error("Expected exactly one HTML file or URL");
  }

  return {
    input: positionals[0],
    headings: {
      user: values["user-heading"],
      assistant: values["assistant-heading"],
    },
  };
}

function isHttpUrl(input) {
  try {
    const url = new URL(input);
    return url.protocol === "http:" || url.protocol === "https:";
  } catch (_error) {
    return false;
  }
}

function parsedHttpUrl(input) {
  if (!isHttpUrl(input)) {
    return null;
  }

  return new URL(input);
}

function claudeShareId(input) {
  const url = parsedHttpUrl(input);

  if (!url || url.hostname !== "claude.ai") {
    return null;
  }

  const match =
    /^\/share\/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\/?$/i.exec(
      url.pathname
    );
  return match && match[1];
}

function isClaudeUrl(input) {
  const url = parsedHttpUrl(input);
  return url && url.hostname === "claude.ai";
}

async function readHtml(input, dependencies = {}) {
  const fetchPage = dependencies.fetch || globalThis.fetch;
  const readFile = dependencies.readFile || fs.readFileSync;

  if (!isHttpUrl(input)) {
    return readFile(input, "utf8");
  }

  const response = await fetchPage(input);

  if (!response.ok) {
    const status = [response.status, response.statusText].filter(Boolean).join(" ");
    throw new Error(`Could not fetch ${input}: ${status}`);
  }

  return response.text();
}

function enqueuePayloads(html) {
  const payloads = [];
  const pattern =
    /window\.__reactRouterContext\.streamController\.enqueue\(("(?:\\.|[^"\\])*")\);/g;
  let match;

  while ((match = pattern.exec(html)) !== null) {
    payloads.push(JSON.parse(match[1]));
  }

  return payloads;
}

function parseDataPayload(html) {
  for (const payload of enqueuePayloads(html)) {
    const trimmed = payload.trim();

    if (trimmed.startsWith("[")) {
      return JSON.parse(trimmed);
    }
  }

  throw new Error("Could not find ChatGPT share data payload");
}

function referenceKey(table, key) {
  const match = /^_(\d+)$/.exec(key);
  return match ? table[Number(match[1])] : key;
}

function resolveValue(table, value, seen = new Set()) {
  if (Number.isInteger(value) && value >= 0 && value < table.length) {
    if (seen.has(value)) {
      return undefined;
    }

    const nextSeen = new Set(seen);
    nextSeen.add(value);
    return resolveValue(table, table[value], nextSeen);
  }

  if (Array.isArray(value)) {
    return value.map((entry) => resolveValue(table, entry, new Set(seen)));
  }

  if (value && typeof value === "object") {
    const out = {};

    for (const [key, entry] of Object.entries(value)) {
      out[referenceKey(table, key)] = resolveValue(table, entry, new Set(seen));
    }

    return out;
  }

  if (value === -5) {
    return null;
  }

  return value;
}

function sharedConversation(root) {
  const route = root.loaderData && root.loaderData["routes/share.$shareId.($action)"];
  const data = route && route.serverResponse && route.serverResponse.data;

  if (!data || !data.mapping) {
    throw new Error("Could not find ChatGPT share conversation mapping");
  }

  return data;
}

function textFromPart(part) {
  if (typeof part === "string") {
    return part;
  }

  if (part && typeof part === "object") {
    return part.text || part.input_text || part.output_text || "";
  }

  return "";
}

function messageText(message) {
  const content = message && message.content;
  const parts = content && content.parts;

  if (!Array.isArray(parts)) {
    return "";
  }

  return parts.map(textFromPart).filter(Boolean).join("\n");
}

function roleHeading(role, headings) {
  switch (role) {
    case "user":
      return headings.user;
    case "assistant":
      return headings.assistant;
    case "system":
      return "System";
    case "tool":
      return "Tool";
    default:
      return role || "?";
  }
}

function formatTurns(turns, headings) {
  return turns
    .map((turn) => `## ${roleHeading(turn.role, headings)}\n\n${turn.text}\n\n`)
    .join("");
}

function extractTurns(html) {
  const table = parseDataPayload(html);
  const root = resolveValue(table, table[0]);
  const conversation = sharedConversation(root);

  return conversation.linear_conversation
    .map((entry) =>
      typeof entry === "string" ? conversation.mapping[entry] : entry
    )
    .filter(Boolean)
    .map((node) => node.message)
    .filter(Boolean)
    .map((message) => ({
      role: message.author && message.author.role,
      text: messageText(message),
    }))
    .filter((turn) => turn.text.trim().length > 0);
}

function extractClaudeTurns(snapshot) {
  if (!snapshot || !Array.isArray(snapshot.chat_messages)) {
    throw new Error("Could not find Claude share conversation messages");
  }

  return snapshot.chat_messages
    .map((message, position) => ({ message, position }))
    .sort((left, right) => {
      const leftIndex = left.message.index;
      const rightIndex = right.message.index;

      if (Number.isFinite(leftIndex) && Number.isFinite(rightIndex)) {
        return leftIndex - rightIndex;
      }

      return left.position - right.position;
    })
    .map(({ message }) => ({
      role: message.sender === "human" ? "user" : message.sender,
      text: Array.isArray(message.content)
        ? message.content
            .filter((part) => part && part.type === "text")
            .map((part) => part.text)
            .filter((text) => typeof text === "string" && text.length > 0)
            .join("\n")
        : "",
    }))
    .filter((turn) => turn.text.trim().length > 0);
}

function appleScriptPath() {
  const executable = fs.realpathSync(__filename);
  return path.join(path.dirname(executable), "extract-claude-share.applescript");
}

function executeFile(file, args, options, dependencies = {}) {
  const run = dependencies.execFile || execFile;

  return new Promise((resolve, reject) => {
    run(file, args, options, (error, stdout, stderr) => {
      if (!error) {
        resolve(stdout);
        return;
      }

      const detail = (stderr || error.message).trim();
      reject(new Error(detail));
    });
  });
}

async function runSafariSnapshot(shareUrl, apiPath, dependencies = {}) {
  const platform = dependencies.platform || process.platform;

  if (platform !== "darwin") {
    throw new Error("Claude share URLs require Safari on macOS");
  }

  try {
    return await executeFile(
      "/usr/bin/osascript",
      [appleScriptPath(), shareUrl, apiPath],
      { encoding: "utf8", maxBuffer: 64 * 1024 * 1024 },
      dependencies
    );
  } catch (error) {
    throw new Error(
      `Could not automate Safari: ${error.message}. ` +
        "Enable Develop > Allow JavaScript from Apple Events in Safari"
    );
  }
}

async function readClaudeSnapshot(shareUrl, snapshotId, dependencies = {}) {
  const apiPath =
    `/api/chat_snapshots/${snapshotId}` +
    "?rendering_mode=messages&render_all_tools=true";
  const runSafari = dependencies.runSafari || runSafariSnapshot;
  const output = await runSafari(shareUrl, apiPath, dependencies);
  let result;

  try {
    result = JSON.parse(output);
  } catch (_error) {
    throw new Error("Safari returned an invalid Claude snapshot response");
  }

  if (!result.ok) {
    const status = [result.status, result.statusText].filter(Boolean).join(" ");
    throw new Error(`Could not fetch ${shareUrl}: ${status || "request failed"}`);
  }

  try {
    return JSON.parse(result.body);
  } catch (_error) {
    throw new Error("Claude returned an invalid snapshot payload");
  }
}

async function loadTurns(input, dependencies = {}) {
  if (isClaudeUrl(input)) {
    const snapshotId = claudeShareId(input);

    if (!snapshotId) {
      throw new Error(
        "Expected a public Claude share URL like https://claude.ai/share/<uuid>"
      );
    }

    const snapshot = await readClaudeSnapshot(input, snapshotId, dependencies);
    return extractClaudeTurns(snapshot);
  }

  return extractTurns(await readHtml(input, dependencies));
}

async function main(argv, dependencies = {}) {
  if (argv.length === 0) {
    usage(process.stderr);
    return 2;
  }

  const command = parseArguments(argv);

  if (command.help) {
    usage(process.stdout);
    return 0;
  }

  const turns = await loadTurns(command.input, dependencies);
  process.stdout.write(formatTurns(turns, command.headings));

  return 0;
}

if (require.main === module) {
  main(process.argv.slice(2)).then(
    (exitCode) => {
      process.exitCode = exitCode;
    },
    (error) => {
      console.error(error.message);
      process.exitCode = 1;
    }
  );
}

module.exports = {
  claudeShareId,
  extractClaudeTurns,
  extractTurns,
  formatTurns,
  loadTurns,
  main,
  parseArguments,
  readClaudeSnapshot,
  readHtml,
  runSafariSnapshot,
};
