#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
. "$root/lib/shell/lib.sh"
shim_resolve "$0" java

# macOS derives java.io.tmpdir from confstr(_CS_DARWIN_USER_TEMP_DIR) and ignores
# $TMPDIR, so under an agent sandbox every temp file lands outside the write
# allowlist and fails with a bare "Operation not permitted". Outside a sandbox the
# two agree and this is a no-op. The flag leads so a caller's own -D still wins.
if [ "$#" -gt 0 ] && [ -n "${TMPDIR:-}" ]; then
	exec "$REAL" "-Djava.io.tmpdir=$TMPDIR" "$@"
fi

exec "$REAL" "$@"
