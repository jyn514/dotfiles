#!/usr/bin/env node
import { execFile } from "node:child_process";
import { readFile, writeFile } from "node:fs/promises";
import process from "node:process";
import { promisify } from "node:util";
import { fileURLToPath } from "node:url";

const execFileAsync = promisify(execFile);
const START = /^(<{7,}) conflict (\d+) of (\d+)$/;
const SNAPSHOT = /^(\+{7,}) (.*)$/;
const DIFF_SOURCE = /^(%{7,}) diff from: (.*)$/;
const DIFF_DESTINATION = /^(\\+)\s+to: (.*)$/;
const END = /^(>{7,}) conflict (\d+) of (\d+) ends$/;

export function parseConflicts(text) {
	const lines = text.replaceAll("\r\n", "\n").split("\n");
	const conflicts = [];
	let i = 0;
	let editNumber = 1;
	while (i < lines.length) {
		const start = lines[i].match(START);
		if (!start) {
			i++;
			continue;
		}
		const startLine = i;
		const endMarkerLength = start[1].length;
		let snapshot;
		let snapshotSource;
		let snapshotStartLine;
		const diffs = [];
		i++;
		while (i < lines.length && !END.test(lines[i])) {
			const snapshotHeader = lines[i].match(SNAPSHOT);
			if (snapshotHeader) {
				if (snapshot) throw new Error(`Conflict at line ${startLine + 1} has multiple snapshot sections`);
				snapshotSource = snapshotHeader[2];
				snapshot = [];
				i++;
				snapshotStartLine = i + 1;
				while (i < lines.length && !DIFF_SOURCE.test(lines[i]) && !END.test(lines[i])) snapshot.push(lines[i++]);
				continue;
			}
			const diffHeader = lines[i].match(DIFF_SOURCE);
			if (diffHeader) {
				const diffSource = diffHeader[2];
				i++;
				const destination = lines[i]?.match(DIFF_DESTINATION);
				if (!destination) throw new Error(`Conflict at line ${startLine + 1} has no diff destination`);
				const diff = [];
				i++;
				while (i < lines.length && !SNAPSHOT.test(lines[i]) && !DIFF_SOURCE.test(lines[i]) && !END.test(lines[i])) diff.push(lines[i++]);
				diffs.push({ source: diffSource, destination: destination[2], lines: diff });
				continue;
			}
			throw new Error(`Conflict at line ${i + 1} has an unrecognised section: ${lines[i]}`);
		}
		if (i >= lines.length) throw new Error(`Conflict at line ${startLine + 1} has no end marker`);
		const end = lines[i].match(END);
		if (!end || end[1].length !== endMarkerLength || end[2] !== start[2] || end[3] !== start[3]) {
			throw new Error(`Conflict at line ${startLine + 1} has a mismatched end marker`);
		}
		if (!snapshot || diffs.length === 0) throw new Error(`Conflict at line ${startLine + 1} is incomplete`);
		const conflict = {
			edit: editNumber++,
			kind: Number(start[2]),
			count: Number(start[3]),
			snapshotSource,
			snapshotStartLine,
			snapshot,
			diffs,
			startLine: startLine + 1,
			endLine: i + 1,
		};
		if (diffs.length === 1) {
			conflict.diffSource = diffs[0].source;
			conflict.diffDestination = diffs[0].destination;
			conflict.diff = diffs[0].lines;
		}
		conflicts.push(conflict);
		i++;
	}
	return conflicts;
}

function locate(lines, oldLines, edit, target) {
	if (oldLines.length === 0 && lines.length > 0) {
		throw new Error(`Edit ${edit} has no context to locate its insertion in the ${target}; resolve it manually against the inspected snapshots.`);
	}
	let at = -1;
	for (let index = 0; index <= lines.length - oldLines.length; index++) {
		if (oldLines.every((line, offset) => lines[index + offset] === line)) {
			if (at !== -1) throw new Error(`Edit ${edit} is ambiguous: its context occurs more than once in the ${target}; resolve it manually against the inspected snapshots.`);
			at = index;
		}
	}
	if (at === -1) throw new Error(`Edit ${edit} does not apply to its ${target}; resolve it manually against the inspected snapshots.`);
	return at;
}

function applyDiff(base, conflict, diff, edit) {
	const snapshot = conflict.snapshot;
	// Jujutsu encodes EOF changes as empty diff lines, not ordinary blank lines.
	// Reject mismatched states until that representation can be composed safely.
	const newlineStates = [diff.source, diff.destination, conflict.snapshotSource]
		.map((label) => label.trim().endsWith("(no terminating newline)"));
	if (newlineStates.some((state) => state !== newlineStates[0])) {
		throw new Error(`Edit ${edit} has differing terminating-newline states; resolve it manually against the inspected snapshots.`);
	}
	const oldLines = [];
	for (const line of diff.lines) {
		if (line.startsWith(" ") || line.startsWith("-")) {
			oldLines.push(line.slice(1));
		} else if (line.startsWith("+")) {
			// Added lines consume no text in either source snapshot.
		} else if (line.startsWith("\\ No newline at end of file")) {
			throw new Error(`Edit ${edit} contains an unsupported newline annotation; resolve it manually against the inspected snapshots.`);
		} else if (line !== "") {
			throw new Error(`Edit ${edit} contains an unrecognised diff line: ${line}`);
		}
	}
	// The historical file establishes provenance, not the replacement content.
	// Matching the current snapshot too prevents restoring obsolete diff context.
	locate(base, oldLines, edit, "base snapshot");
	const at = locate(snapshot, oldLines, edit, "destination snapshot");
	return {
		at,
		oldLength: oldLines.length,
		diffLines: diff.lines.filter((line) => /^[ +\-]/.test(line)),
	};
}

function sourceRevision(source) {
	const firstSource = source.trim().split(",", 1)[0].trim();
	const [changeId, commitId] = firstSource.split(/\s+/, 2);
	if (commitId && /^[0-9a-f]{8,40}$/i.test(commitId)) return commitId;
	if (/^[0-9a-f]{8,40}$/i.test(changeId)) return changeId;
	return changeId;
}

function selectionMap(selectedEdits, conflicts) {
	const known = new Map(conflicts.map((conflict) => [conflict.edit, conflict]));
	const selections = new Map();
	for (const value of selectedEdits) {
		const parts = String(value).split(":");
		if (parts.length > 2) throw new Error(`Edit ${value} does not identify a diff alternative`);
		const [editText, diffText = "1"] = parts;
		const edit = Number(editText);
		const diff = Number(diffText);
		if (!Number.isInteger(edit) || !known.has(edit)) throw new Error(`Edit ${value} does not exist in this file`);
		if (!Number.isInteger(diff) || diff < 1 || diff > known.get(edit).diffs.length) {
			throw new Error(`Edit ${value} does not identify a diff alternative`);
		}
		if (selections.has(edit)) throw new Error(`Conflict ${edit} was selected more than once`);
		selections.set(edit, diff);
	}
	return selections;
}

function lineEnding(line) {
	if (line?.endsWith("\r\n")) return "\r\n";
	if (line?.endsWith("\n")) return "\n";
	return undefined;
}

function renderResolution(text, offsets, conflict, result) {
	const parts = conflict.snapshot.map((_, index) => {
		const line = conflict.snapshotStartLine - 1 + index;
		return text.slice(offsets[line], offsets[line + 1] ?? text.length);
	});
	const replacement = [];
	let cursor = result.at;
	let removedEnding;
	const markerEnding = lineEnding(text.slice(offsets[conflict.startLine - 1], offsets[conflict.startLine]));
	for (const line of result.diffLines) {
		if (line[0] === " ") {
			replacement.push(parts[cursor++]);
			removedEnding = undefined;
		} else if (line[0] === "-") {
			removedEnding ??= lineEnding(parts[cursor]);
			cursor++;
		} else {
			const ending = removedEnding ?? lineEnding(parts[cursor]) ?? lineEnding(parts[cursor - 1]) ?? markerEnding;
			replacement.push(line.slice(1) + ending);
		}
	}
	const rendered = [...parts.slice(0, result.at), ...replacement, ...parts.slice(cursor)].join("");
	const end = offsets[conflict.endLine] ?? text.length;
	return text.slice(offsets[conflict.endLine - 1], end).endsWith("\n") ? rendered : rendered.replace(/\r?\n$/, "");
}

function composition(text, selectedEdits, resolveBase) {
	const conflicts = parseConflicts(text);
	const selections = selectionMap(selectedEdits, conflicts);
	const offsets = [0];
	for (const match of text.matchAll(/\n/g)) offsets.push(match.index + 1);
	const output = [];
	const resolutions = [];
	let cursor = 0;
	for (const conflict of conflicts) {
		const selectedDiff = selections.get(conflict.edit);
		if (selectedDiff === undefined) continue;
		const start = offsets[conflict.startLine - 1];
		const end = offsets[conflict.endLine] ?? text.length;
		output.push(text.slice(cursor, start));
		const diff = conflict.diffs[selectedDiff - 1];
		const base = resolveBase(diff.source, conflict, selectedDiff);
		if (!base) throw new Error(`No base snapshot was provided for edit ${conflict.edit}:${selectedDiff}`);
		const result = applyDiff(base, conflict, diff, `${conflict.edit}:${selectedDiff}`);
		output.push(renderResolution(text, offsets, conflict, result));
		resolutions.push({ conflict, ...result });
		cursor = end;
	}
	output.push(text.slice(cursor));
	return { text: output.join(""), resolutions, remaining: conflicts.length - selections.size };
}

export function compose(text, selectedEdits, resolveBase) {
	return composition(text, selectedEdits, resolveBase).text;
}

function formatPreview(path, resolutions) {
	const output = [];
	for (const { conflict, at, oldLength, diffLines } of resolutions) {
		output.push(`--- snapshot: ${path} (conflict ${conflict.edit})`, `+++ resolution: ${path} (conflict ${conflict.edit})`);
		const operations = [
			...conflict.snapshot.slice(0, at).map((line) => ` ${line}`),
			...diffLines,
			...conflict.snapshot.slice(at + oldLength).map((line) => ` ${line}`),
		];
		const ranges = [];
		const positions = [];
		let oldLine = 1;
		let newLine = 1;
		for (const [index, line] of operations.entries()) {
			positions.push({ oldLine, newLine });
			if (line[0] !== "+") oldLine++;
			if (line[0] !== "-") newLine++;
			if (line[0] === " ") continue;
			const start = Math.max(0, index - 3);
			const end = Math.min(operations.length, index + 4);
			const previous = ranges.at(-1);
			if (previous && start <= previous.end) previous.end = end;
			else ranges.push({ start, end });
		}
		if (!ranges.length) output.push("(no textual changes; conflict markers will be removed)");
		for (const { start, end } of ranges) {
			const hunk = operations.slice(start, end);
			const oldCount = hunk.filter((line) => line[0] !== "+").length;
			const newCount = hunk.filter((line) => line[0] !== "-").length;
			const oldStart = positions[start].oldLine - (oldCount === 0 ? 1 : 0);
			const newStart = positions[start].newLine - (newCount === 0 ? 1 : 0);
			output.push(`@@ -${oldStart},${oldCount} +${newStart},${newCount} @@`, ...hunk);
		}
	}
	return output.length ? output.join("\n") + "\n" : "";
}

async function composeFile(path, text, selectedEdits) {
	const baseCache = new Map();
	const conflicts = parseConflicts(text);
	const selections = selectionMap(selectedEdits, conflicts);
	for (const conflict of conflicts) {
		const selectedDiff = selections.get(conflict.edit);
		if (selectedDiff === undefined) continue;
		const source = conflict.diffs[selectedDiff - 1].source;
		const revision = sourceRevision(source);
		if (!baseCache.has(revision)) {
			const { stdout } = await execFileAsync(process.env.JJ_BIN ?? "jj", ["file", "show", "--revision", revision, "--", path]);
			const normalized = stdout.replaceAll("\r\n", "\n");
			baseCache.set(revision, normalized === "" ? [] : (normalized.endsWith("\n") ? normalized.slice(0, -1) : normalized).split("\n"));
		}
	}
	return composition(text, selectedEdits, (source) => baseCache.get(sourceRevision(source)));
}

function usage() {
	console.error(`Usage:
  jj-conflict inspect <file> [--json]
  jj-conflict apply <file> --edit <conflict>[:<diff>][,...] [--stdout | --preview]
  jj-conflict check <file...>`);
}

function parseEdits(value) {
	const edits = value.split(",").map((part) => part.trim());
	if (edits.some((edit) => !/^\d+(?::\d+)?$/.test(edit))) throw new Error("--edit expects comma-separated conflict[:diff] selections");
	return edits;
}

async function main(argv) {
	const [command, ...args] = argv;
	if (!command) {
		usage();
		return 2;
	}
	if (command === "check") {
		if (args.length === 0) {
			usage();
			return 2;
		}
		let failed = false;
		for (const path of args) {
			const text = await readFile(path, "utf8");
			const conflicts = parseConflicts(text);
			if (conflicts.length) {
				failed = true;
				console.error(`${path}: ${conflicts.length} unresolved conflict(s)`);
			}
		}
		return failed ? 1 : 0;
	}
	const path = args[0];
	if (!path || (command !== "inspect" && command !== "apply")) {
		usage();
		return 2;
	}
	const text = await readFile(path, "utf8");
	const conflicts = parseConflicts(text);
	if (command === "inspect") {
		const json = args.includes("--json");
		const report = conflicts.map(({ snapshot, diffs, ...conflict }) => ({
			...conflict,
			snapshot,
			alternatives: diffs.map((diff, index) => ({
				edit: `${conflict.edit}:${index + 1}`,
				source: diff.source,
				destination: diff.destination,
				changes: diff.lines.filter((line) => line.startsWith("-") || line.startsWith("+")),
			})),
			snapshotLines: snapshot.length,
		}));
		if (json) console.log(JSON.stringify({ path, conflicts: report }, null, 2));
		else for (const conflict of report) console.log(`conflict ${conflict.edit}: lines ${conflict.startLine}-${conflict.endLine}\n  snapshot ${conflict.snapshotSource}:\n    ${conflict.snapshot.join("\n    ")}\n  ${conflict.alternatives.map((alternative) => `${alternative.edit} ${alternative.destination}:\n    ${alternative.changes.join("\n    ")}`).join("\n  ")}`);
		return 0;
	}
	const editFlag = args.indexOf("--edit");
	if (editFlag === -1 || !args[editFlag + 1]) throw new Error("apply requires --edit <conflict>[:<diff>]");
	const stdout = args.includes("--stdout");
	const preview = args.includes("--preview");
	if (stdout && preview) throw new Error("cannot combine --stdout and --preview");
	const result = await composeFile(path, text, parseEdits(args[editFlag + 1]));
	if (preview) process.stdout.write(formatPreview(path, result.resolutions));
	else if (stdout) process.stdout.write(result.text);
	else await writeFile(path, result.text);
	console.error(`${path}: ${result.resolutions.length} resolved, ${result.remaining} unresolved; ${stdout || preview ? "not written" : "written"}.`);
	return 0;
}

if (process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]) {
	main(process.argv.slice(2)).then((code) => { process.exitCode = code; }).catch((error) => {
		console.error(`jj-conflict: ${error.message}`);
		process.exitCode = 1;
	});
}
