#!/usr/bin/env python3
"""Rename the current Codex session through a temporary app-server."""

import argparse
from contextlib import contextmanager
import json
import os
import selectors
import subprocess
import sys
import time


class AppServer:
    """The documented app-server stdio transport is newline-delimited JSON."""

    def __init__(self, process: subprocess.Popen) -> None:
        self.process = process
        self.pending = b""
        self.request_id = 0
        self.selector = selectors.DefaultSelector()
        self.selector.register(process.stdout, selectors.EVENT_READ)

    def connect(self) -> None:
        self.request("initialize", {"clientInfo": {"name": "codex_rename", "version": "1.0.0"}})
        self.send({"method": "initialized", "params": {}})

    def send(self, message: dict) -> None:
        self.process.stdin.write(json.dumps(message).encode() + b"\n")
        self.process.stdin.flush()

    def request(self, method: str, params: dict) -> dict:
        self.request_id += 1
        self.send({"id": self.request_id, "method": method, "params": params})
        deadline = time.monotonic() + 15
        while True:
            while b"\n" not in self.pending:
                remaining = deadline - time.monotonic()
                if remaining <= 0 or not self.selector.select(remaining):
                    raise RuntimeError("app-server reply timed out")
                data = os.read(self.process.stdout.fileno(), 65536)
                if not data:
                    raise RuntimeError("app-server closed before replying")
                self.pending += data
            line, self.pending = self.pending.split(b"\n", 1)
            message = json.loads(line)
            if "method" in message or message.get("id") != self.request_id:
                if time.monotonic() >= deadline:
                    raise RuntimeError("app-server reply timed out")
                continue
            if "error" in message:
                raise RuntimeError(message["error"]["message"])
            return message["result"]


@contextmanager
def temporary_server():
    process = subprocess.Popen(
        ["codex", "app-server", "--listen", "stdio://"],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE,
    )
    client = AppServer(process)
    try:
        yield client
    finally:
        client.selector.close()
        try:
            process.stdin.close()
        except BrokenPipeError:
            pass
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            process.terminate()
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()
        process.stdout.close()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("title", help="new name for the session identified by CODEX_THREAD_ID")
    args = parser.parse_args()
    if not args.title.strip() or "\n" in args.title or "\r" in args.title:
        parser.error("title must be a nonempty single line")
    thread_id = os.environ.get("CODEX_THREAD_ID")
    if not thread_id:
        parser.error("CODEX_THREAD_ID is unset; run this command inside a Codex session")
    phase = "starting a temporary Codex app-server"
    update_attempted = False
    try:
        print("starting a temporary Codex app-server", file=sys.stderr)
        with temporary_server() as client:
            client.connect()
            phase = "reading the current session"
            client.request("thread/read", {"threadId": thread_id, "includeTurns": False})
            phase = "renaming the current session"
            print(f"renaming current session to {json.dumps(args.title, ensure_ascii=False)}", file=sys.stderr)
            update_attempted = True
            client.request("thread/name/set", {"threadId": thread_id, "name": args.title})
            phase = "verifying the session name"
            after = client.request("thread/read", {"threadId": thread_id, "includeTurns": False})
            if after["thread"].get("name") != args.title:
                raise RuntimeError("read-back name differs from requested name")
        print(f"renamed current session to {json.dumps(args.title, ensure_ascii=False)} (verified)")
        return 0
    except (OSError, RuntimeError, ValueError, KeyError, TypeError) as error:
        recovery = ("name update is unverified; rerun this command to set and verify it"
                    if update_attempted else "name update was not sent; check that codex app-server can start")
        print(f"codex-rename: {phase} failed: {error}; {recovery}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
