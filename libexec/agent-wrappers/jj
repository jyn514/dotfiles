#!/usr/bin/env python3
"""JJ routing, invocation-scoped identity, and native author lifecycle."""
import errno
import importlib.util
import json
import os
from pathlib import Path
import shutil
import signal
import stat
import subprocess
import sys


class WrapperError(ValueError):
    pass


def load_router(path):
    spec = importlib.util.spec_from_file_location('_jj_route', path)
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def routing(argv, env):
    private = argv[:1] == ['--agent-split']
    if private and len(argv) != 4:
        raise WrapperError('--agent-split requires PATCH MESSAGE REVISION')
    if not env.get('SANDBOX_PROXY_DIR'):
        default = env.get('SANDBOX_PROXY_DEFAULT_DIR', '/run/sandbox-proxies')
        try:
            if stat.S_ISSOCK((Path(default) / 'jj/socket').stat().st_mode):
                env['SANDBOX_PROXY_DIR'] = default
        except OSError:
            pass
    helper = env.get('JJ_ROUTE_HELPER', '')
    if not helper and env.get('SANDBOX_PROXY_DIR'):
        helper = '/tools/jj-proxy/route.py'
        if not Path(helper).is_file():
            helper = str(Path(sys.argv[0]).resolve(strict=True).parent / '../../tools/jj-proxy/route.py')
    if helper and Path(helper).is_file():
        router = load_router(helper)
        result = router.route(['split'] if private else argv, env=env)
        # The producer's validator remains authoritative, including when a
        # configured producer is substituted. Execution also needs OS strings.
        router.check_result(result)
        for value in [*result['command'], result['workspace'], result['destination']]:
            if value is not None:
                os.fsencode(value)
                if '\0' in value:
                    raise WrapperError('invalid route result: NUL is not representable')
    elif helper or env.get('SANDBOX_PROXY_DIR'):
        raise WrapperError(f'route helper is missing: {helper}; rebuild the agent image')
    else:
        # No helper means no proc or tomllib dependency, and no selector parser.
        hooks = not any(arg.startswith(('--at-op', '-@', '-R', '--repository')) or
                        arg in ('--ignore-working-copy', '--help', '-h', '--version', '-V')
                        for arg in argv)
        result = dict(backend='native', command=argv[:1], hooks=hooks,
                      workspace=os.getcwd(), destination=None)
    if private and result['backend'] != 'proxy':
        raise WrapperError('--agent-split is proxy-only; use ordinary jj split in a local repository')
    return result


def valid_model(model):
    return isinstance(model, str) and bool(model) and not any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in model)


def pi_model(env):
    if 'PI_CALL_MODEL' in env:
        model = env['PI_CALL_MODEL']
        return model if valid_model(model) else ''
    if not env.get('PI_MODEL_FILE') or not env.get('PI_MODEL_SESSION_ID'):
        return ''
    try:
        data = json.loads(Path(env['PI_MODEL_FILE']).read_text())
        if (isinstance(data, dict) and data.get('session_id') == env['PI_MODEL_SESSION_ID']
                and isinstance(data.get('provider'), str) and data['provider']
                and valid_model(data.get('modelId'))):
            return data['modelId']
    except (OSError, ValueError):
        pass
    return ''


def codex_model(env):
    root = Path(env.get('CODEX_HOME') or str(Path(env.get('HOME', str(Path.home()))) / '.codex'))
    try:
        for directory in ('sessions', 'archived_sessions'):
            for base, _, files in os.walk(root / directory):
                for name in files:
                    if not name.endswith(env.get('CODEX_THREAD_ID', '') + '.jsonl'):
                        continue
                    model = ''
                    for line in (Path(base) / name).read_text().splitlines():
                        data = json.loads(line)
                        if data.get('type') == 'turn_context':
                            value = data.get('payload', {}).get('model')
                            if isinstance(value, str) and value:
                                model = value
                    return model
    except (OSError, ValueError, AttributeError):
        pass
    return ''


def identity(env, command):
    agent = (env.get('JJ_AGENT') or ('claude' if env.get('CLAUDECODE') else '')
             or ('pi' if env.get('PI_CODING_AGENT') else '')
             or ('codex' if env.get('CODEX_THREAD_ID') else ''))
    if agent == 'claude':
        env.update(JJ_USER='Claude Opus 4.8', JJ_EMAIL='lifer@jyn.dev')
    elif agent in ('pi', 'codex'):
        env['JJ_EMAIL'] = '325577925+one-esk-nineteen@users.noreply.github.com'
        if agent == 'pi':
            model = pi_model(env)
            env['JJ_USER'] = 'Pi ' + (model or 'unknown-model')
            if not model:
                print('jj wrapper: warning: could not determine active Pi model', file=sys.stderr)
        else:
            model = codex_model(env)
            env['JJ_USER'] = 'Codex' + (' ' + model if model else '')
            if not model and command in ('commit', 'split'):
                print('jj wrapper: warning: could not determine Codex model', file=sys.stderr)
            if model == 'gpt-5.3-codex-spark':
                env['JJ_EMAIL'] = '343-guilty-spark@jyn.dev'


def native_binary(env):
    if env.get('JJ_REAL'):
        if not os.access(env['JJ_REAL'], os.X_OK):
            raise WrapperError('configured real jj is not executable')
        return env['JJ_REAL']
    # Compare physical directories, but remove the invoked alias directory,
    # not the source wrapper's directory (which may not be on PATH at all).
    own = Path(sys.argv[0]).parent.resolve(strict=True)
    paths = []
    for entry in env.get('PATH', '').split(os.pathsep):
        if not entry:
            continue
        try:
            path = Path(entry).resolve(strict=True)
            if path.is_dir() and path != own:
                paths.append(str(path))
        except (OSError, RuntimeError):
            pass
    env['PATH'] = os.pathsep.join(paths)
    real = shutil.which('jj', path=env['PATH'])
    if not real:
        raise WrapperError('real jj not found on PATH')
    return real


def execution_error(error):
    print(f'jj wrapper: {error}', file=sys.stderr)
    return 127 if error.errno == errno.ENOENT else 126


def terminate(signum):
    signal.signal(signum, signal.SIG_DFL)
    os.kill(os.getpid(), signum)


def execute(argv, env):
    # Match Popen(restore_signals=True): Python ignores these at startup,
    # but that interpreter policy must not leak into an exec'ed native tool.
    for name in ('SIGPIPE', 'SIGXFZ', 'SIGXFSZ'):
        signum = getattr(signal, name, None)
        if signum is not None:
            signal.signal(signum, signal.SIG_DFL)
    try:
        os.execve(argv[0], argv, env)
    except OSError as error:
        return execution_error(error)


def wait_command(argv, env):
    """Keep inherited terminal streams and forward directly addressed signals."""
    child = None
    previous = {}
    cancelled = None

    def forward(signum, frame):
        nonlocal cancelled
        cancelled = signum
        if child is not None:
            try:
                child.send_signal(signum)
            except ProcessLookupError:
                pass
    try:
        for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT):
            previous[signum] = signal.signal(signum, forward)
        if cancelled is not None:
            terminate(cancelled)
        try:
            child = subprocess.Popen(argv, env=env)
        except OSError as error:
            status = execution_error(error)
        else:
            if cancelled is not None:
                forward(cancelled, None)
            status = child.wait()
    finally:
        for signum, handler in previous.items():
            signal.signal(signum, handler)
    # A cancelled hook is not an ordinary best-effort failure. Reap its child,
    # then terminate before a prehook can be followed by the requested write.
    # The signal, not the child's possibly-successful handler, owns cancellation.
    if cancelled is not None:
        terminate(cancelled)
    return status


def hook(argv, env):
    try:
        wait_command(argv, env)
    except OSError:
        pass


def main(argv):
    env = dict(os.environ)
    result = routing(argv, env)
    command = next(iter(result['command']), '')
    target = result['destination'] if result['destination'] is not None else result['workspace']
    identity(env, command)
    if result['backend'] == 'proxy':
        return execute(['/libexec/agent-wrappers/jj-proxy-client', *argv], env)
    try:
        real = native_binary(env)
    except WrapperError as error:
        print(f'jj wrapper: {error}', file=sys.stderr)
        return 1
    cleanup = bool(env.get('JJ_USER') and result['hooks'] and target)
    hook_argv = [real, '--repository', target or '', 'metaedit', '--update-author', '-r', '@', '--quiet']
    if cleanup and command in ('commit', 'split'):
        hook(hook_argv, env)
    if (not os.isatty(1) and command in ('diff', 'show') and
            not any(arg.startswith(('ui.diff-formatter=', '--config=ui.diff-formatter=')) for arg in argv)):
        argv = ['--config', 'ui.diff-formatter=:git', *argv]
    if not cleanup:
        return execute([real, *argv], env)
    status = wait_command([real, *argv], env)
    if status == 0:
        human_env = {key: value for key, value in env.items() if key not in ('JJ_USER', 'JJ_EMAIL')}
        hook(hook_argv, human_env)
    if status < 0:
        terminate(-status)
    return status


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, ValueError, RuntimeError, TypeError, KeyError, AttributeError) as error:
        print(f'jj wrapper: {error}', file=sys.stderr)
        sys.exit(125)
