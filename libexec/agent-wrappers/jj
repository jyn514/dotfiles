#!/bin/sh
set -eu

codex_version() {
  session_root=${CODEX_HOME:-$HOME/.codex}
  session=$(find "$session_root/sessions" "$session_root/archived_sessions" \
    -type f -name "*${CODEX_THREAD_ID:-}.jsonl" -print -quit 2>/dev/null) || return
  [ -n "$session" ] || return
  jq -r '
      select(.type == "turn_context")
      | .payload.model
      | select(. != null and . != "")
    ' "$session" | tail -n1
}

pi_model() {
  [ -n "${PI_MODEL_FILE:-}" ] || return 1
  [ -n "${PI_MODEL_SESSION_ID:-}" ] || return 1
  jq -er --arg session "$PI_MODEL_SESSION_ID" '
      select(type == "object"
        and .session_id == $session
        and (.provider | type) == "string"
        and (.provider | length) > 0
        and (.modelId | type) == "string"
        and (.modelId | length) > 0
        and (.modelId | test("^[^[:cntrl:]]+$")))
      | .modelId
    ' "$PI_MODEL_FILE" 2>/dev/null
}

is_jj_write() {
  case "$1" in
    commit|split) return 0 ;;
    *) return 1 ;;
  esac
}

# Discover stripped-environment sandbox sockets before asking the read-only
# router. Socket presence enables routing; it does not select the backend.
if [ -z "${SANDBOX_PROXY_DIR:-}" ]; then
  sandbox_proxy_default=${SANDBOX_PROXY_DEFAULT_DIR:-/run/sandbox-proxies}
  if [ -S "$sandbox_proxy_default/jj/socket" ]; then
    SANDBOX_PROXY_DIR=$sandbox_proxy_default
    export SANDBOX_PROXY_DIR
  fi
fi

private_split=false
if [ "${1:-}" = --agent-split ]; then
  if [ "$#" -ne 4 ]; then
    printf '%s\n' 'jj wrapper: --agent-split requires PATCH MESSAGE REVISION' >&2
    exit 125
  fi
  private_split=true
fi

# The image supplies the helper role. Source-checkout invocation also works;
# an older standalone host wrapper retains its native behavior without it.
route_helper=${JJ_ROUTE_HELPER:-}
if [ -z "$route_helper" ] && [ -n "${SANDBOX_PROXY_DIR:-}" ]; then
  route_helper=/tools/jj-proxy/route.py
fi
if [ -n "$route_helper" ] && [ ! -f "$route_helper" ] && [ -z "${JJ_ROUTE_HELPER:-}" ]; then
  source_path=$0
  while [ -L "$source_path" ]; do
    link=$(readlink "$source_path") || exit 125
    case "$link" in
      /*) source_path=$link ;;
      *) source_path=$(dirname -- "$source_path")/$link ;;
    esac
  done
  source_dir=$(CDPATH='' cd -- "$(dirname -- "$source_path")" && pwd -P) || exit 125
  route_helper=$source_dir/../../tools/jj-proxy/route.py
fi

backend=native
subcommand=${1:-}
hooks=true
hook_target=
if [ -n "$route_helper" ] && [ -f "$route_helper" ]; then
  if [ "$private_split" = true ]; then
    route=$(python3 "$route_helper" -- split) || exit "$?"
  else
    route=$(python3 "$route_helper" -- "$@") || exit "$?"
  fi
  if ! printf '%s\n' "$route" | jq -se '
      length == 1 and (.[0] |
        type == "object"
        and (.backend == "native" or .backend == "proxy")
        and (.workspace == null or (.workspace | type == "string" and startswith("/")))
        and (.destination == null or (.destination | type == "string" and startswith("/")))
        and (.command | type == "array" and all(.[]; type == "string"))
        and (.hooks | type) == "boolean")
    ' >/dev/null 2>&1; then
    printf '%s\n' 'jj wrapper: invalid route result; repository left unchanged' >&2
    exit 125
  fi
  backend=$(printf '%s\n' "$route" | jq -r .backend) || exit 125
  subcommand=$(printf '%s\n' "$route" | jq -r '.command[0] // ""') || exit 125
  hooks=$(printf '%s\n' "$route" | jq -r .hooks) || exit 125
  hook_target=$(printf '%s\n' "$route" | jq -r '.destination // .workspace // ""') || exit 125
elif [ -n "${SANDBOX_PROXY_DIR:-}" ] || [ -n "${JJ_ROUTE_HELPER:-}" ]; then
  printf '%s\n' "jj wrapper: route helper is missing: $route_helper; rebuild the agent image" >&2
  exit 125
else
  hook_target=$(pwd -P) || exit 125
  # A standalone host shim has no router. Skip unresolved selector hooks rather
  # than stamp a different workspace; ordinary host execution needs no Python.
  for arg in "$@"; do
    case "$arg" in
      --ignore-working-copy|--at-op*|-@*|--help|-h|--version|-V|-R*|--repository*) hooks=false ;;
    esac
  done
fi

if [ "$private_split" = true ] && [ "$backend" != proxy ]; then
  printf '%s\n' 'jj wrapper: --agent-split is proxy-only; use ordinary jj split in a local repository' >&2
  exit 125
fi

# Identity by agent, auto-detected from each runner's own env. Resolve it before
# forwarding sandbox calls so the trusted proxy can stamp the same identity.
agent=${JJ_AGENT:-${CLAUDECODE:+claude}}
agent=${agent:-${PI_CODING_AGENT:+pi}}
agent=${agent:-${CODEX_THREAD_ID:+codex}}
case "$agent" in
  claude) JJ_USER='Claude Opus 4.8'; JJ_EMAIL='lifer@jyn.dev' ;;
  pi)
    model=$(pi_model) || model=
    if [ -n "$model" ]; then
      JJ_USER="Pi $model"
    else
      JJ_USER='Pi unknown-model'
      printf '%s\n' "jj wrapper: warning: could not determine active Pi model" >&2
    fi
    JJ_EMAIL='325577925+one-esk-nineteen@users.noreply.github.com'
    ;;
  codex)
    # Session metadata is optional; lookup failure must reach the generic identity
    # fallback instead of letting set -e prevent the requested jj command.
    model=$(codex_version) || model=
    JJ_EMAIL='325577925+one-esk-nineteen@users.noreply.github.com'
    JJ_USER="Codex $model"

    case "$model" in
      "")
        if is_jj_write "$subcommand"; then
          printf '%s\n' "jj wrapper: warning: could not determine Codex model" >&2
        fi
        JJ_USER='Codex'
        ;;
      gpt-5.3-codex-spark)
        JJ_EMAIL='343-guilty-spark@jyn.dev'
        ;;
    esac
esac

if [ "$backend" = proxy ]; then
  export JJ_USER JJ_EMAIL
  exec /libexec/agent-wrappers/jj-proxy-client "$@"
fi

# Shim: stamp jj commits as the agent, not the human running the wrapper.
# Sandboxes keep the underlying binary outside PATH so alternate executable
# resolvers cannot bypass this wrapper. Other environments resolve the next jj.
if [ -n "${JJ_REAL:-}" ]; then
  if [ ! -x "$JJ_REAL" ]; then
    printf '%s\n' "jj wrapper: configured real jj is not executable" >&2
    exit 1
  fi
  real_jj=$JJ_REAL
else
  self_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
  # Canonicalize entries so aliases such as /lib and /usr/lib compare equal.
  # Empty and nonexistent entries are omitted; an empty PATH entry means cwd.
  original_path=$PATH
  filtered_path=
  while [ -n "$original_path" ]; do
    path_entry=${original_path%%:*}
    case "$original_path" in
      *:*) original_path=${original_path#*:} ;;
      *) original_path= ;;
    esac

    [ -n "$path_entry" ] || continue
    canonical_entry=$(CDPATH='' cd -- "$path_entry" 2>/dev/null && pwd -P) || continue
    [ "$canonical_entry" != "$self_dir" ] || continue

    filtered_path=${filtered_path:+$filtered_path:}$canonical_entry
  done
  PATH=$filtered_path
  export PATH
  real_jj=$(command -v jj) || {
    printf '%s\n' "jj wrapper: real jj not found on PATH" >&2
    exit 1
  }
fi

should_force_plain_diff() {
  [ ! -t 1 ] || return 1

  case "$1" in
    diff|show) return 0 ;;
    *) return 1 ;;
  esac
}

has_diff_formatter_config() {
  for arg in "$@"; do
    case "$arg" in
      ui.diff-formatter=*|--config=ui.diff-formatter=*) return 0 ;;
    esac
  done
  return 1
}

if [ -n "${JJ_USER:-}" ]; then
  # jj stamps author at change *creation*, committer at commit — so a change
  # born before this shim (or re-snapshotted by a bare jj) keeps a stale
  # author. Any command that records @ into a new commit inherits that author:
  # `commit` makes one, `split` makes two. Reset the working-copy author to our
  # identity first, so recorded commits have author == committer. Best-effort:
  # never block the command if metaedit has nothing to do.
  if [ "$hooks" = true ] && [ -n "$hook_target" ]; then
    case "$subcommand" in
      commit|split)
        env "JJ_USER=$JJ_USER" "JJ_EMAIL=$JJ_EMAIL" "$real_jj" \
          --repository "$hook_target" metaedit --update-author -r @ --quiet || true
        ;;
    esac
  fi

fi

if should_force_plain_diff "$subcommand" && ! has_diff_formatter_config "$@"; then
  set -- --config ui.diff-formatter=:git "$@"
fi

# JJ drops leading --config values if a subcommand has its own --config. Use
# native identity environment only for this invocation, not human-author cleanup.
if [ -n "${JJ_USER:-}" ]; then
  set -- env "JJ_USER=$JJ_USER" "JJ_EMAIL=$JJ_EMAIL" "$real_jj" "$@"
else
  set -- "$real_jj" "$@"
fi

if "$@"; then
  if [ -n "${JJ_USER:-}" ] && [ "$hooks" = true ] && [ -n "$hook_target" ]; then
    # Target bootstrap attribution at its destination, not the invoking repo.
    # Intentionally use the real jj config here, not the agent identity,
    # including when JJ_USER/JJ_EMAIL arrived as exported environment values.
    (
      unset JJ_USER JJ_EMAIL
      "$real_jj" --repository "$hook_target" metaedit --update-author -r @ --quiet
    ) || true
  fi
else
  exit "$?"
fi

exit 0
