#!/bin/sh
set -eu

for argument in "$@"; do
	case $argument in
		--pre|--pre=*|--pre-glob|--pre-glob=*)
			echo "rg wrapper: --pre is not permitted" >&2
			exit 2
			;;
		--hostname-bin|--hostname-bin=*)
			echo "rg wrapper: --hostname-bin is not permitted" >&2
			exit 2
			;;
	esac
done

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
. "$root/lib/shell/lib.sh"
shim_resolve "$0" rg

# Ignore RIPGREP_CONFIG_PATH so a configuration file cannot restore --pre.
exec "$REAL" --no-config "$@"
