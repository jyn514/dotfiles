+import { describe, expect, it, vi } from "vitest";
+import { PromptBus, type PromptResponse } from "../prompt-bus.js";
+import { connectPromptBusEvents } from "../prompt-bus-events.js";
+
+function events() {
+  const handlers = new Map<string, Set<(p: any) => void>>();
+  return {
+    on(name: string, handler: (p: any) => void) {
+      const set = handlers.get(name) ?? new Set();
+      handlers.set(name, set);
+      set.add(handler);
+      return () => { set.delete(handler); };
+    },
+    emit(name: string, payload: unknown) { for (const fn of [...handlers.get(name) ?? []]) fn(payload); },
+    count(name: string) { return handlers.get(name)?.size ?? 0; },
+  };
+}
+
+describe("session-scoped PromptBus discovery", () => {
+  it.each([true, false])("discovers either extension order (owner first: %s), replaces the adapter and detaches old callbacks", async (ownerFirst) => {
+    const eventBus = events();
+    const shown = vi.fn();
+    const bus = new PromptBus({ onDashboardRequest: shown });
+    let request: any;
+    let respond: (r: PromptResponse) => void = () => {};
+    const adapter = { name: "dotfiles-ask-user", onRequest: () => ({}), onResponse: vi.fn(), onCancel: vi.fn(), setRespond: (fn: typeof respond) => { respond = fn; } };
+    const discover = () => eventBus.on("prompt:set-bus-request", payload => {
+      request = payload.request;
+      eventBus.emit("prompt:register-adapter", adapter);
+    });
+    if (ownerFirst) discover();
+    const dispose = connectPromptBusEvents(eventBus, bus, () => true);
+    if (!ownerFirst) { discover(); eventBus.emit("prompt:request-bus", undefined); }
+    for (let i = 0; i < 5; i++) eventBus.emit("prompt:register-adapter", adapter);
+    expect(bus.adapterNames).toEqual(["dotfiles-ask-user"]);
+    const answer = request({ type: "select", pipeline: "dotfiles-ask-user", question: "Q", metadata: { kind: "queue-question" } });
+    const id = shown.mock.calls[0][0].id;
+    const staleRespond = respond;
+    dispose();
+    expect(eventBus.count("prompt:register-adapter")).toBe(0);
+    expect(eventBus.count("prompt:request-bus")).toBe(0);
+    staleRespond({ id, answer: "stale", source: "dotfiles-ask-user" });
+    expect(bus.pendingCount).toBe(1);
+    const staleRequest = request;
+    const replacement = new PromptBus();
+    const end = connectPromptBusEvents(eventBus, replacement, () => true);
+    expect(await staleRequest({ type: "select", pipeline: "x", question: "late" })).toMatchObject({ cancelled: true });
+    expect(replacement.pendingCount).toBe(0);
+    bus.cancel(id);
+    await answer;
+    end();
+  });
+});
