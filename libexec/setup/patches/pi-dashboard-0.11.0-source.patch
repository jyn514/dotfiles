+}
+
+function waitForSpawnFailure(ws: WebSocket): Promise<Record<string, unknown>[]> {
+  return new Promise((resolve, reject) => {
+    const messages: Record<string, unknown>[] = [];
+    const timeout = setTimeout(() => reject(new Error("spawn preflight response timeout")), 2000);
+    ws.on("message", (raw) => {
+      const message = JSON.parse(raw.toString()) as Record<string, unknown>;
+      if (message.type !== "spawn_result" && message.type !== "spawn_error") return;
+      messages.push(message);
+      if (messages.some((item) => item.type === "spawn_result")
+        && messages.some((item) => item.type === "spawn_error")) {
+        clearTimeout(timeout);
+        resolve(messages);
+      }
+    });
+  });
+}
