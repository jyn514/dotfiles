+    websockets.push(ws);
+    ws.once("open", () => resolve(ws));
+    ws.once("unexpected-response", (req, res) => { resolve(`http-${res.statusCode}`); res.resume(); req.destroy(); });
+    ws.once("error", e => resolve(`error:${e.message}`));
+  });
+}
