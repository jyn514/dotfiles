+/**
+ * Fixed downstream profile, not an upstream full-mode compatibility switch.
+ * Dashboard observes Pi and carries explicit human web controls/questions. Pi
+ * alone owns agent tools, prompts, provider credentials, roles and trust.
+ */
+import type { DashboardConfig } from "./config.js";
+
+export const WEB_ONLY_REFUSAL = "Disabled in the downstream web-only Dashboard: Pi owns agent policy, providers, credentials, roles and automation.";
+
+const disabledCommands = new Set([
+  "credentials_updated", "vault_snapshot", "mcp_token_minted", "path_grant_result",
+  "role_set", "role_remove", "role_preset_load", "role_preset_save", "role_preset_delete", "request_roles",
+  "flow_management", "flow_control", "plugin_emit_event", "plugin_action", "ui_management",
+  "git_commit_draft", "attach_proposal", "detach_proposal", "accept_replace_proposal", "dismiss_replace_proposal",
+  "openspec_get", "openspec_refresh", "openspec_bulk_archive",
+]);
+
+export function isWebOnlyDisabledCommand(type: unknown): boolean {
+  return typeof type === "string" && disabledCommands.has(type);
+}
+
+/** Refuse extra management before a route can write files or start model work. */
+export function isWebOnlyDisabledRoute(method: string, url: string): boolean {
+  const pathname = url.split("?", 1)[0];
+  const under = (prefix: string) => pathname === prefix || pathname.startsWith(prefix + "/");
+  if (["/api/providers", "/api/provider-auth", "/api/vault", "/api/roles", "/api/flows", "/api/automation", "/api/openspec", "/api/model-proxy", "/api/pi-trust"].some(under)) return true;
+  if (pathname === "/api/git/commit-draft") return true;
+  if (method === "GET" || method === "HEAD" || method === "OPTIONS") return false;
+  return [
+    "/api/plugins", "/api/config/plugins", "/api/auth/plugin-trust",
+    "/api/pi-settings", "/api/access", "/api/preferences/auto-name",
+    "/api/preferences/worktree-auto-init",
+  ].some(under);
+}
+
+/** Effective config cannot re-enable removed features through a browser save. */
+export function webOnlyConfig(config: DashboardConfig): DashboardConfig {
+  return {
+    ...config,
+    registerAskUserTool: false,
+    maxConcurrentSubagents: 0,
+    defaultModel: "",
+    defaultThinkingLevel: "",
+    reopenSessionsAfterShutdown: "off",
+    openspec: { ...config.openspec, enabled: false },
+    vault: { ...config.vault, deliveryEnabled: false },
+    piTrustMirror: { ...config.piTrustMirror, enabled: false, liveQuery: false },
+    agentPathGate: { ...config.agentPathGate, enabled: false },
+    accessGrants: { ...config.accessGrants, promptEnabled: false },
+    questions: { ...config.questions, autoBrief: false },
+    modelProxy: { ...config.modelProxy, enabled: false },
+  };
+}
