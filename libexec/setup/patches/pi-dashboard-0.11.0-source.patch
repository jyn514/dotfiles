+/** Session-scoped, optional cross-extension PromptBus discovery. No queue ownership. */
+import type { PromptAdapter, PromptBus, PromptRequest, PromptResponse } from "./prompt-bus.js";
+
+interface Events {
+  on(event: string, handler: (payload: any) => void): (() => void) | void;
+  emit(event: string, payload: unknown): void;
+}
+
+type ExternalAdapter = PromptAdapter & {
+  setRespond?: (respond: (response: PromptResponse) => void) => void;
+  setCancel?: (cancel: (id: string) => void) => void;
+};
+
+export function connectPromptBusEvents(events: Events, bus: PromptBus, isCurrent: () => boolean): () => void {
+  let disposed = false;
+  const active = () => !disposed && isCurrent();
+  const adapters = new Map<string, () => void>();
+  const offAdapter = events.on("prompt:register-adapter", (adapter: ExternalAdapter) => {
+    if (!active() || !adapter || typeof adapter.name !== "string") return;
+    adapters.get(adapter.name)?.();
+    adapters.set(adapter.name, bus.registerAdapter(adapter));
+    adapter.setRespond?.(response => { if (active()) bus.respond(response); });
+    adapter.setCancel?.(id => { if (active()) bus.cancel(id); });
+  });
+  const publish = () => {
+    if (!active()) return;
+    events.emit("prompt:set-bus-request", {
+      request: (options: Omit<PromptRequest, "id">) => active()
+        ? bus.request(options)
+        : Promise.resolve({ id: "", cancelled: true, source: "__bus__" } satisfies PromptResponse),
+    });
+  };
+  const offDiscovery = events.on("prompt:request-bus", publish);
+  publish();
+  return () => {
+    disposed = true;
+    if (typeof offAdapter === "function") offAdapter();
+    if (typeof offDiscovery === "function") offDiscovery();
+    for (const off of adapters.values()) off();
+    adapters.clear();
+  };
+}
