+  it.each([false, true])("finds a real non-localhost listener before/after launch (post-launch: %s)", async (postLaunch) => {
+    const listener = createServer((req, res) => {
+      if (req.url !== "/api/health") { res.writeHead(404).end(); return; }
+      res.setHeader("Content-Type", "application/json");
+      res.end(JSON.stringify({ ok: true, pid: process.pid }));
+    });
+    const lockDir = mkdtempSync(join(tmpdir(), "dashboard-bind-"));
+    await new Promise<void>((resolve, reject) => {
+      listener.once("error", reject);
+      listener.listen(0, host, resolve);
+    });
+    try {
+      const port = (listener.address() as AddressInfo).port;
+      console.info(`Native specific-bind extension fixture: ${host}:${port}`);
+      expect((await isDashboardRunning(port, "localhost", { timeoutMs: 100, retries: 0 })).running).toBe(false);
+      let calls = 0;
+      const probe = vi.fn(async (...args: Parameters<typeof isDashboardRunning>) => {
+        if (postLaunch && calls++ === 0) return { running: false };
+        return isDashboardRunning(...args);
+      });
+      const deps: AutoStartDeps = {
+        isDashboardRunning: probe,
+        discoverDashboard: vi.fn(async () => []),
+        launchServer: vi.fn(async () => ({ success: true, message: "fixture already ready" })),
+        notify: vi.fn(), log: () => {}, lockDir,
+        resolveCliPath: () => join(tmpdir(), "installed", "packages", "server", "src", "cli.ts"),
+      };
+      const result = await autoStartServer({ port, piPort: 19999, autoStart: true, bindHost: host }, deps);
+      expect(result.server).toEqual({ host, port, piPort: 19999 });
+      expect(probe.mock.calls.every(call => call[1] === host)).toBe(true);
+      expect(deps.launchServer).toHaveBeenCalledTimes(postLaunch ? 1 : 0);
+    } finally {
+      await new Promise<void>((resolve, reject) => listener.close(err => err ? reject(err) : resolve()));
+      rmSync(lockDir, { recursive: true, force: true });
+    }
+  });
+});
