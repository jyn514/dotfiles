+import { launchDashboardServer } from "@blackbelt-technology/pi-dashboard-shared/server-launcher.js";
+import { isDashboardRunning } from "@blackbelt-technology/pi-dashboard-shared/server-identity.js";
+import { canonicalBinding, deriveKey, httpPurpose, parseProof, verifyProofMac } from "@blackbelt-technology/pi-dashboard-shared/local-credential-proof.js";
+import { ensureLocalToken } from "../auth/local-token.js";
+import { cmdRestart, cmdStart } from "../cli.js";
+import type { ServerConfig } from "../server.js";
+
+describe("native CLI specific-bind lifecycle", () => {
+  const host = Object.values(networkInterfaces()).flat().find(a => a && a.family === "IPv4" && !a.internal)?.address ?? "127.0.0.2";
+  it("start readiness and restart reach the selected IP without a localhost listener", async () => {
+    let proof: unknown;
+    const token = ensureLocalToken();
+    let requests = 0;
+    const listener = createServer((req, res) => {
+      res.setHeader("Content-Type", "application/json");
+      if (req.url === "/api/health") { res.end(JSON.stringify({ ok: true, pid: process.pid })); return; }
+      if (req.url === "/api/restart") {
+        requests++;
+        proof = req.headers["x-pi-local-proof"];
+        if (req.method !== "POST" || !parseProof(proof) || !verifyProofMac(deriveKey(token), parseProof(proof)!, canonicalBinding(req.socket.localAddress!, req.socket.localPort!), httpPurpose(req.method, req.url)) || req.headers["x-pi-local-token"]) { res.writeHead(403).end(); return; }
+        res.end(JSON.stringify({ ok: true })); return;
+      }
+      res.writeHead(404).end();
+    });
+    await new Promise<void>((resolve, reject) => { listener.once("error", reject); listener.listen(0, host, resolve); });
+    try {
+      const port = (listener.address() as AddressInfo).port;
+      console.info(`Native specific-bind CLI fixture: ${host}:${port}`);
+      expect((await isDashboardRunning(port, "localhost", { timeoutMs: 100, retries: 0 })).running).toBe(false);
+      const config = { port, piPort: 19999, host, dev: false, tunnel: false } as ServerConfig;
+      let classified = 0;
+      const exit = vi.fn();
+      await cmdStart(config, {
+        classify: async () => classified++ === 0 ? { kind: "free" } : { kind: "owned", pid: process.pid },
+        launch: opts => {
+          const child = Object.assign(new EventEmitter(), { pid: process.pid, exitCode: null, signalCode: null, unref: () => {} }) as unknown as ChildProcess;
+          return launchDashboardServer({ ...opts, healthTimeoutMs: 200, _pollIntervalMs: 10, _resolveNativeLoader: () => "file:///fixture.mjs", _spawnNodeScript: () => child });
+        },
+        exit,
+      });
+      expect(exit).not.toHaveBeenCalled();
+      const cmdStopImpl = vi.fn(async () => {});
+      const cmdStartImpl = vi.fn(async () => {});
+      // No probe/fetch override: these are the CLI's real HTTP and proof owners.
+      await cmdRestart(config, { cmdStopImpl, cmdStartImpl });
+      expect(requests).toBe(1);
+      expect(parseProof(proof)).toBeDefined();
+      expect(cmdStopImpl).not.toHaveBeenCalled();
+      expect(cmdStartImpl).not.toHaveBeenCalled();
+    } finally {
+      await new Promise<void>((resolve, reject) => listener.close(err => err ? reject(err) : resolve()));
+    }
+  });
+});
