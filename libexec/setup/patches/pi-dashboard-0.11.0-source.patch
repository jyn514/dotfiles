+function tmux(socket: string, ...args: string[]): string {
+  return String(execFileSync("tmux", ["-L", socket, ...args], { encoding: "utf8" })).trim();
+}
+
+async function waitForFile(file: string): Promise<void> {
+  const deadline = Date.now() + 2_000;
