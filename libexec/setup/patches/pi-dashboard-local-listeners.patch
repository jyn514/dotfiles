+import fs from "node:fs";
+import http from "node:http";
+import net from "node:net";
+import os from "node:os";
+import path from "node:path";
+import { once } from "node:events";
+import { httpProofHeaders } from "@blackbelt-technology/pi-dashboard-shared/local-credential-proof.js";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import WebSocket from "ws";
+import { ensureLocalToken } from "../auth/local-token.js";
+import { createServer, type DashboardServer } from "../server.js";
+import { createTestServer, type TestServerHandle } from "../test-support/test-server.js";
+
+const addresses = Object.values(os.networkInterfaces()).flat().filter(a => a && a.family === "IPv4" && !a.internal).map(a => a!.address);
+const host = addresses[0] ?? "127.0.0.2";
+const cfgFile = path.join(os.homedir(), ".pi", "dashboard", "config.json");
+let savedConfig: Buffer | undefined;
+let handle: TestServerHandle | undefined;
+let failed: DashboardServer | undefined;
+const sockets: net.Socket[] = [];
+const websockets: WebSocket[] = [];
+
+function request(url: string, opts: { method?: string; headers?: Record<string, string>; body?: string } = {}): Promise<{ status: number; body: string }> {
+  return new Promise((resolve, reject) => {
+    const req = http.request(url, { method: opts.method ?? "GET", headers: opts.headers }, res => {
+      let body = "";
+      res.on("data", chunk => body += chunk);
+      res.on("end", () => resolve({ status: res.statusCode!, body }));
+    });
+    req.setTimeout(2000, () => req.destroy(new Error("HTTP fixture timed out")));
+    req.on("error", reject);
+    req.end(opts.body);
+  });
+}
+function connect(address: string, port: number): Promise<net.Socket> {
+  return new Promise((resolve, reject) => {
+    const socket = net.connect({ host: address, port });
+    sockets.push(socket);
+    socket.once("connect", () => resolve(socket));
+    socket.once("error", reject);
+  });
+}
+function wsOutcome(url: string, headers?: Record<string, string>): Promise<WebSocket | string> {
+  return new Promise(resolve => {
+    const ws = new WebSocket(url, { headers, handshakeTimeout: 2000 });
+    websockets.push(ws);
+    ws.once("open", () => resolve(ws));
+    ws.once("unexpected-response", (req, res) => { resolve(`http-${res.statusCode}`); res.resume(); req.destroy(); });
+    ws.once("error", e => resolve(`error:${e.message}`));
+  });
+}
+async function signed(url: string, method = "GET", body?: string) {
+  return request(url, { method, headers: { ...httpProofHeaders(ensureLocalToken(), url, method), ...(body ? { "content-type": "application/json" } : {}) }, body });
+}
+
+beforeEach(() => {
+  savedConfig = fs.existsSync(cfgFile) ? fs.readFileSync(cfgFile) : undefined;
+  fs.mkdirSync(path.dirname(cfgFile), { recursive: true });
+  fs.writeFileSync(cfgFile, JSON.stringify({ requireLocalProof: true, trustedNetworks: [], hostGateMode: "enforce" }));
+});
+afterEach(async () => {
+  for (const ws of websockets.splice(0)) ws.terminate();
+  for (const socket of sockets.splice(0)) socket.destroy();
+  await handle?.stop(); handle = undefined;
+  await failed?.stop(); failed = undefined;
+  if (savedConfig) fs.writeFileSync(cfgFile, savedConfig);
+  else fs.rmSync(cfgFile, { force: true });
+});
+
+describe(`native primary ${host} + IPv4 loopback HTTP`, () => {
+  it("defaults off, and enabling an already-loopback primary does not bind twice", async () => {
+    handle = await createTestServer({ host });
+    expect((await request(`http://${host}:${handle.httpPort}/api/health`)).status).toBe(200);
+    await expect(connect("127.0.0.1", handle.httpPort)).rejects.toMatchObject({ code: "ECONNREFUSED" });
+    await handle.stop(); handle = undefined;
+    handle = await createTestServer({ host: "127.0.0.1", listenOnLoopback: true });
+    expect((await request(`http://127.0.0.1:${handle.httpPort}/api/health`)).status).toBe(200);
+  });
+
+  it("shares HTTP/auth/WS, preserves endpoint-bound proofs, closes both edges and restarts cleanly", async () => {
+    handle = await createTestServer({ host, listenOnLoopback: true });
+    const port = handle.httpPort;
+    const primary = `http://${host}:${port}`;
+    const loopback = `http://127.0.0.1:${port}`;
+    const health = await Promise.all([primary, loopback].map(async base => {
+      const result = await request(`${base}/api/health`);
+      expect(result.status).toBe(200);
+      return JSON.parse(result.body);
+    }));
+    expect(health[0].pid).toBe(health[1].pid);
+    expect(health[0].instanceId).toBe(health[1].instanceId);
+    if (addresses[1]) await expect(connect(addresses[1], port)).rejects.toMatchObject({ code: "ECONNREFUSED" });
+    for (const base of [primary, loopback]) {
+      expect((await request(`${base}/api/config`)).status).toBe(403);
+      expect((await signed(`${base}/api/config`)).status).toBe(200);
+      expect((await request(`${base}/api/health`, { headers: { host: "unapproved.invalid" } })).status).toBe(403);
+      expect(await wsOutcome(base.replace("http:", "ws:") + "/ws")).not.toBeInstanceOf(WebSocket);
+      expect(await wsOutcome(base.replace("http:", "ws:") + "/ws?ticket=unknown")).not.toBeInstanceOf(WebSocket);
+      expect(await wsOutcome(base.replace("http:", "ws:") + "/ws", { host: "unapproved.invalid" })).not.toBeInstanceOf(WebSocket);
+      const ticketRes = await signed(`${base}/api/ws-ticket`, "POST", JSON.stringify({ scope: "browser" }));
+      expect(ticketRes.status).toBe(200);
+      const ticket = JSON.parse(ticketRes.body).data.ticket;
+      expect(await wsOutcome(base.replace("http:", "ws:") + `/ws?ticket=${ticket}`)).toBeInstanceOf(WebSocket);
+    }
+    expect(handle.server.browserGateway.wss.clients.size).toBe(2);
+    const url = `${loopback}/api/config`;
+    const token = ensureLocalToken();
+    const wrongEndpoint = httpProofHeaders(token, `${primary}/api/config`, "GET");
+    expect((await request(url, { headers: wrongEndpoint })).status).toBe(403);
+    expect((await request(`${primary}/api/config`, { headers: httpProofHeaders(token, url, "GET") })).status).toBe(403);
+    expect((await request(url, { headers: httpProofHeaders(token, url, "GET", { now: Date.now() - 60_000 }) })).status).toBe(403);
+    const oneUse = httpProofHeaders(token, url, "GET");
+    expect((await request(url, { headers: oneUse })).status).toBe(200);
+    expect((await request(url, { headers: oneUse })).status).toBe(403);
+    const beforeRestart = httpProofHeaders(token, url, "GET");
+    const idle = await connect("127.0.0.1", port);
+    const idleClosed = once(idle, "close");
+    const wsClosed = websockets.filter(ws => ws.readyState === WebSocket.OPEN).map(ws => once(ws, "close"));
+    await handle.stop(); handle = undefined;
+    await Promise.all([idleClosed, ...wsClosed]);
+    for (const address of [host, "127.0.0.1"]) await expect(connect(address, port)).rejects.toMatchObject({ code: "ECONNREFUSED" });
