+import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { execFileSync } from "@blackbelt-technology/pi-dashboard-shared/platform/exec.js";
+import { afterEach, describe, expect, it } from "vitest";
+import { buildTmuxMonitorScript } from "../spawn-process/process-manager.js";
+
+const sockets: string[] = [];
+const roots: string[] = [];
+
+function tmux(socket: string, ...args: string[]): string {
+  return String(execFileSync("tmux", ["-L", socket, ...args], { encoding: "utf8" })).trim();
+}
+
+async function waitForFile(file: string): Promise<void> {
+  const deadline = Date.now() + 2_000;
+  while (!existsSync(file) && Date.now() < deadline) {
+    await new Promise((resolve) => setTimeout(resolve, 10));
+  }
+}
+
+afterEach(() => {
+  for (const socket of sockets.splice(0)) {
+    try { tmux(socket, "kill-server"); } catch { /* already gone */ }
+  }
+  for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true });
+});
+
+describe.runIf(process.platform !== "win32" && existsSync("/usr/bin/tmux"))(
+  "tmux failure monitor with non-POSIX login shells",
+  () => {
+    for (const shell of ["/usr/bin/fish", "/usr/bin/zsh"]) {
+      it.runIf(existsSync(shell))(`captures failure under ${shell}`, async () => {
+        const root = mkdtempSync(join(tmpdir(), "dashboard-tmux-monitor-"));
+        roots.push(root);
+        const failure = join(root, "failure.log");
+        const monitor = join(root, "monitor.sh");
+        writeFileSync(
+          monitor,
+          buildTmuxMonitorScript("printf 'concrete failure\\n'; /bin/sh -c 'exit 7'", failure),
+          { mode: 0o700 },
+        );
+        const socket = `dashboard-monitor-${process.pid}-${sockets.length}`;
+        sockets.push(socket);
+        tmux(socket, "new-session", "-d", "-s", "holder");
+        tmux(socket, "set-option", "-g", "default-shell", shell);
+
+        const pane = tmux(
+          socket,
+          "new-window",
+          "-d",
+          "-P",
+          "-F",
+          "#{pane_id}",
+          "-t",
+          "holder",
+          "/bin/sh",
+          monitor,
+        );
+        await waitForFile(failure);
+        if (!existsSync(failure)) {
+          throw new Error(`pane did not publish failure under ${shell}`);
+        }
+
+        expect(readFileSync(failure, "utf8")).toContain("concrete failure");
+        expect(readFileSync(failure, "utf8")).toContain("[pi-dashboard-spawn-exit:7]");
+        expect(tmux(socket, "display-message", "-p", "-t", pane, "#{pane_dead}:#{pane_dead_status}"))
+          .toBe("1:7");
+        tmux(socket, "kill-pane", "-t", pane);
+      });
+    }
+  },
+);
