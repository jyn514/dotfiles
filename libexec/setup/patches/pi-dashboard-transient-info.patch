+import { describe, expect, it, vi } from "vitest";
+import { createMemoryEventStore } from "../persistence/memory-event-store.js";
+import { createDrainingWs } from "./helpers/draining-ws.js";
+import { buildLoadGatewayEx, flushAsync, seedReplayEvents, seedSessions } from "./helpers/load-fixtures.js";
+
+function setup() {
+  const seed = seedSessions({ focusedCwd: "/repo/a", idleCwds: [] });
+  const sessionId = seed.focusedSessionId;
+  const store = createMemoryEventStore(() => false);
+  seedReplayEvents(store, sessionId, 1, 16);
+  const { gateway } = buildLoadGatewayEx(seed.manager, { eventStore: store });
+  const ws = createDrainingWs({ drainRateBytesPerMs: 1 });
+  const send = vi.spyOn(ws, "send");
+  gateway.wss.emit("connection", ws, {});
+  ws.drainFully();
+  return {
+    gateway, sessionId, manager: seed.manager,
+    async subscribe() {
+      const from = send.mock.calls.length;
+      ws.emit("message", Buffer.from(JSON.stringify({ type: "subscribe", sessionId, lastSeq: 1 })));
+      await flushAsync(20);
+      return send.mock.calls.slice(from).map(([frame]) => JSON.parse(frame.toString())).filter((frame) => frame.type === "notify");
+    },
+  };
+}
+
+describe("notification retention", () => {
+  it.each(["info", undefined])("does not persist or replay info (%s)", async (level) => {
+    const rig = setup();
+    rig.gateway.appendNotify(rig.sessionId, { notifyId: "info", message: "peer joined", level: level as "info" | undefined });
+    expect(rig.manager.get(rig.sessionId)?.notifyLog ?? []).toEqual([]);
+    expect(await rig.subscribe()).toEqual([]);
+  });
+
+  it("does not replay old persisted info, but preserves outcomes and problems", async () => {
+    const rig = setup();
+    rig.manager.update(rig.sessionId, { notifyLog: [
+      { notifyId: "old-info", message: "old peer joined", level: "info" },
+      { notifyId: "old-omitted", message: "old default notification" },
+      { notifyId: "success", message: "finished", level: "success" },
+      { notifyId: "warning", message: "careful", level: "warning" },
+      { notifyId: "error", message: "failed", level: "error" },
+    ] });
+    expect((await rig.subscribe()).map((frame) => frame.notifyId)).toEqual(["success", "warning", "error"]);
+    rig.gateway.appendNotify(rig.sessionId, { notifyId: "new-warning", message: "careful again", level: "warning" });
+    expect(rig.manager.get(rig.sessionId)?.notifyLog?.map((entry) => entry.notifyId)).toEqual(["success", "warning", "error", "new-warning"]);
+    expect((await rig.subscribe()).map((frame) => frame.notifyId)).toEqual(["success", "warning", "error", "new-warning"]);
+  });
+});
