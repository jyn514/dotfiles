+import type { ServerToBrowserMessage } from "@blackbelt-technology/pi-dashboard-shared/browser-protocol.js";
+import { act, render, renderHook, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { Toast, useToast } from "../../components/primitives/Toast.js";
+import { useMessageHandler } from "../useMessageHandler.js";
+
+function setup(globalFloor = "all", sessionFloor?: string) {
+  const showToast = vi.fn();
+  let states = new Map();
+  const setSessionStates = vi.fn((update) => { states = update(states); });
+  const setters: any = { setSessionStates };
+  const deps: any = {
+    send: vi.fn(), navigate: vi.fn(), clearSpawningCwd: vi.fn(),
+    spawningCwdsRef: { current: new Set() }, subscribedRef: { current: new Set(["s1"]) },
+    pendingTerminalCwdRef: { current: null }, lastCreatedTerminalIdRef: { current: null },
+    maxSeqMapRef: { current: new Map() }, selectedSessionIdRef: { current: "s1" },
+    pendingSpawnsRef: { current: new Map() }, loadingHistoryTimersRef: { current: new Map() },
+    displayPrefs: { notifyMinLevel: globalFloor },
+    sessionsRef: { current: new Map([["s1", { displayPrefsOverride: { notifyMinLevel: sessionFloor } }]]) },
+    showToast,
+  };
+  const { result } = renderHook(() => useMessageHandler(setters, deps));
+  return {
+    dispatch: (level?: string) => result.current({ type: "notify", sessionId: "s1", notifyId: "n1", message: "peer joined", level } as ServerToBrowserMessage),
+    showToast, setSessionStates, states: () => states,
+  };
+}
+
+afterEach(() => vi.useRealTimers());
+
+describe("info notifications are transient", () => {
+  it.each(["info", undefined, "unknown"])("toasts normalized info (%s) without adding a chat row", (level) => {
+    const rig = setup();
+    rig.dispatch(level);
+    expect(rig.showToast).toHaveBeenCalledExactlyOnceWith("peer joined", "info");
+    expect(rig.setSessionStates).not.toHaveBeenCalled();
+  });
+
+  it.each(["success", "warning", "error"])("keeps %s notifications in chat", (level) => {
+    const rig = setup();
+    rig.dispatch(level);
+    expect(rig.showToast).not.toHaveBeenCalled();
+    expect(rig.states().get("s1").messages).toHaveLength(1);
+    expect(rig.states().get("s1").messages[0].args.params.level).toBe(level);
+  });
+
+  it.each(["success", "warnings", "errors"])("respects the %s notification floor", (floor) => {
+    const rig = setup(floor);
+    rig.dispatch("info");
+    expect(rig.showToast).not.toHaveBeenCalled();
+    expect(rig.setSessionStates).not.toHaveBeenCalled();
+  });
+
+  it("respects a per-session override of the global floor", () => {
+    const rig = setup("errors", "all");
+    rig.dispatch("info");
+    expect(rig.showToast).toHaveBeenCalledOnce();
+    const hidden = setup("all", "warnings");
+    hidden.dispatch("info");
+    expect(hidden.showToast).not.toHaveBeenCalled();
+  });
+
+  it.each([false, true])("expires the toast, with repeated parent renders: %s", (rerender) => {
+    vi.useFakeTimers();
+    function Harness() {
+      const toast = useToast();
+      return <><button onClick={() => toast.showToast("peer joined", "info")}>Notify</button><Toast messages={toast.messages} onDismiss={toast.dismissToast} /></>;
+    }
+    const view = render(<Harness />);
+    act(() => screen.getByText("Notify").click());
+    expect(screen.getByText("peer joined")).toBeTruthy();
+    for (let second = 0; second < 3; second++) {
+      act(() => vi.advanceTimersByTime(1000));
+      if (rerender) view.rerender(<Harness />);
+    }
+    act(() => vi.advanceTimersByTime(300));
+    expect(screen.queryByText("peer joined")).toBeNull();
+    view.unmount();
+  });
+});
