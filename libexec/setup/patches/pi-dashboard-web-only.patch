+    expect(await worktree.json()).toEqual({ autoInitWorktreeOnSpawn: false });
+  });
+
+  it("wires a broken managed bridge declaration to an immediate browser spawn failure", async () => {
+    const previousHome = process.env.HOME;
+    const home = fs.mkdtempSync(path.join(os.tmpdir(), "dashboard-preflight-server-"));
+    const agentDir = path.join(home, ".pi", "agent");
+    const declarationPath = path.join(agentDir, "pi-dashboard");
+    const settingsSource = path.join(home, "tracked-settings.json");
+    fs.mkdirSync(agentDir, { recursive: true });
+    fs.writeFileSync(settingsSource, JSON.stringify({
+      packages: [{ source: "./pi-dashboard", skills: [] }],
+    }));
+    fs.symlinkSync(settingsSource, path.join(agentDir, "settings.json"));
+    fs.symlinkSync(path.join(home, "missing-dashboard-extension"), declarationPath, "dir");
+    process.env.HOME = home;
+
+    let browser: WebSocket | undefined;
+    try {
+      server = await createServer(config);
+      await server.start();
+      browser = proofWebSocket(`ws://127.0.0.1:${server.httpPort()}/ws`);
+      await waitForOpen(browser);
+      const failure = waitForSpawnFailure(browser);
+      browser.send(JSON.stringify({
+        type: "spawn_session",
+        cwd: home,
+        requestId: "broken-bridge",
+      }));
+
+      const messages = await failure;
+      expect(messages).toContainEqual(expect.objectContaining({
+        type: "spawn_result",
+        success: false,
+        requestId: "broken-bridge",
+      }));
+      expect(messages).toContainEqual(expect.objectContaining({
+        type: "spawn_error",
+        code: "PREFLIGHT_FAILED",
+        reasons: [expect.objectContaining({
+          code: "DASHBOARD_BRIDGE_UNAVAILABLE",
+          message: expect.stringContaining(declarationPath),
+        })],
+      }));
+    } finally {
+      browser?.close();
+      if (previousHome === undefined) delete process.env.HOME;
+      else process.env.HOME = previousHome;
+    }
+  });
+});
