+const forwarders = readBridgeSource("bridge-handlers/forwarders.ts");
+
+describe("fixed web-only activation boundary", () => {
+  it("never activates provider/role managers, agent gates, context injection or credential delivery", () => {
+    for (const call of ["activateProviderRegister(pi)", "activateRoleManager(pi)", "claudeCompatExtension(", "awaitStartupProviderModels(", "createCredentialGuard(", "createCredentialGuardToolCallHandler(", "createMcpDashboardRegistrar(", "createVaultDelivery(", "createVaultRedaction(", "createPathGate(", "new FanoutAdmissionGate(", "registerProjectTrust(inst)", "registerDashboardContextInjector(", "onProviderChanged("]) {
+      expect(bridge, call).not.toContain(call);
+    }
+  });
+  it("never registers extra tools, changes PATH, mints MCP, overrides defaults or accepts system followups", () => {
+    for (const call of ["registerAskUserTool(pi)", "registerCanvasTool(pi)", "registerRoleModelTools(pi", "provisionOpenspecCli(", '"dashboard:enqueue-followup"', '"mcp/mint-token"', "inst.vaultDelivery.", "inst.applyDefaultModel("]) {
+      expect(lifecycle, call).not.toContain(call);
+    }
+    expect(forwarders).not.toContain("inst.runAutoNameOnTurnEnd()");
+    expect(forwarders).not.toContain("inst.enqueueSystemFollowup(");
+    expect(bridge).not.toContain("function enqueueSystemFollowup(");
+    expect(bridge).not.toContain("createAutoNamer(");
+  });
+  it("never starts the background GitHub PR probe", () => {
+    expect(bridge).toContain("createPassivePrStatusScheduler()");
+    expect(bridge).not.toContain("git.prStatusAsync(");
