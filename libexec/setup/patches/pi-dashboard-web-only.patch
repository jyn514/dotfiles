+import type { WebSocket } from "ws";
+
+import { createServer, type DashboardServer, type ServerConfig } from "../server.js";
+import { proofWebSocket } from "../test-support/local-credential-stamp.js";
+
+const config: ServerConfig = {
+  port: 0,
+  piPort: 0,
+  host: "127.0.0.1",
+  dev: true,
+  autoShutdown: false,
+  shutdownIdleSeconds: 0,
+  tunnel: false,
+  pingInterval: 0,
+};
+
+function waitForOpen(ws: WebSocket): Promise<void> {
+  return new Promise((resolve, reject) => {
+    ws.once("open", resolve);
+    ws.once("error", reject);
+  });
+}
+
+function waitForSpawnFailure(ws: WebSocket): Promise<Record<string, unknown>[]> {
+  return new Promise((resolve, reject) => {
+    const messages: Record<string, unknown>[] = [];
+    const timeout = setTimeout(() => reject(new Error("spawn preflight response timeout")), 2000);
+    ws.on("message", (raw) => {
+      const message = JSON.parse(raw.toString()) as Record<string, unknown>;
+      if (message.type !== "spawn_result" && message.type !== "spawn_error") return;
+      messages.push(message);
+      if (messages.some((item) => item.type === "spawn_result")
+        && messages.some((item) => item.type === "spawn_error")) {
+        clearTimeout(timeout);
+        resolve(messages);
+      }
+    });
+  });
+}
+
+describe("fixed web-only server boundary", () => {
+  let server: DashboardServer | undefined;
+  const previousNoMdns = process.env.PI_DASHBOARD_NO_MDNS;
+
+  beforeEach(() => {
+    process.env.PI_DASHBOARD_NO_MDNS = "1";
+    vi.spyOn(console, "log").mockImplementation(() => {});
+    vi.spyOn(console, "warn").mockImplementation(() => {});
+    vi.spyOn(console, "error").mockImplementation(() => {});
+  });
+
+  afterEach(async () => {
+    if (server) await server.stop();
+    server = undefined;
+    vi.restoreAllMocks();
+    if (previousNoMdns === undefined) delete process.env.PI_DASHBOARD_NO_MDNS;
+    else process.env.PI_DASHBOARD_NO_MDNS = previousNoMdns;
+  });
+
+  it("refuses agent-policy writes and reports stale automatic preferences as disabled", async () => {
+    server = await createServer(config);
+    await server.start();
+    const base = `http://127.0.0.1:${server.httpPort()}`;
+
+    for (const [method, path] of [
+      ["PUT", "/api/pi-settings"],
+      ["POST", "/api/access/grants"],
+      ["PATCH", "/api/preferences/auto-name"],
+      ["PATCH", "/api/preferences/worktree-auto-init"],
+    ] as const) {
+      const response = await fetch(base + path, {
+        method,
+        headers: { "content-type": "application/json" },
+        body: "{}",
+      });
+      expect(response.status, `${method} ${path}`).toBe(403);
+      expect(await response.json()).toMatchObject({ error: "web_only" });
+    }
+
+    const naming = await fetch(base + "/api/preferences/auto-name");
+    const worktree = await fetch(base + "/api/preferences/worktree-auto-init");
