+import type { EventForwardMessage } from "@blackbelt-technology/pi-dashboard-shared/protocol.js";
+import { describe, expect, it, vi } from "vitest";
+import { createInitialState, reduceEvent } from "../../../client/src/lib/chat/event-reducer.js";
+import { registerEnrichedForwarders, registerPassThroughForwarders } from "../../../extension/src/bridge-handlers/forwarders.js";
+import { makeStubInstance } from "../../../extension/src/__tests__/helpers/bridge-instance-stub.js";
+import { dispatchReload, type DispatchReloadContext, RELOAD_COMPACTING_MESSAGE } from "../rpc-keeper/dispatch-reload.js";
+import { extractSessionUpdates } from "../session/event-status-extraction.js";
+
+describe("web-only compaction observation", () => {
+  it.each(["session_compact", "session_compact_failed"])("refuses reload during idle compaction, then allows it after %s", async (terminal) => {
+    const session = { status: "idle", compacting: false };
+    let chat = createInitialState();
+    const sent: EventForwardMessage[] = [];
+    const { inst, pi } = makeStubInstance({
+      coalescer: { flush: vi.fn() } as never,
+      polling: {} as never,
+      connection: {
+        send: (message: EventForwardMessage) => {
+          sent.push(message);
+          Object.assign(session, extractSessionUpdates(message.event));
+          chat = reduceEvent(chat, message.event);
+        },
+      } as never,
+    });
+    registerEnrichedForwarders(inst);
+    registerPassThroughForwarders(inst);
+    const fire = async (type: string, payload: Record<string, unknown> = {}) => {
+      const handlers = pi.handlers.get(type);
+      expect(handlers, `registered ${type} observer`).toHaveLength(1);
+      for (const handler of handlers!) await handler({ type, ...payload }, {});
+    };
+    const respawn = vi.fn(async () => {});
+    const sendToSession = vi.fn(() => true);
+    const feedback = vi.fn();
+    const context: DispatchReloadContext = {
+      headlessPidRegistry: { getPid: () => 42, listSessions: () => [] },
+      getSession: () => session,
+      isSessionConnected: () => true,
+      sendToSession,
+      respawn,
+      emitCommandFeedback: feedback,
+    };
+    const preparation = { context: { messages: ["private context"] }, customInstructions: "private instructions" };
+    const before = JSON.stringify(preparation);
+    await fire("session_before_compact", preparation);
+    expect(JSON.stringify(preparation)).toBe(before);
+    expect(sent[0].event.data).toEqual({ type: "session_before_compact" });
+    expect(session).toEqual({ status: "idle", compacting: true });
+    expect(chat.messages).toEqual([]);
+    expect(await dispatchReload("S1", context)).toBe("refused");
+    expect(feedback).toHaveBeenCalledWith("S1", "/reload", "error", RELOAD_COMPACTING_MESSAGE);
+    expect(respawn).not.toHaveBeenCalled();
+    expect(sendToSession).not.toHaveBeenCalled();
+
+    await fire(terminal);
+    expect(session).toEqual({ status: "idle", compacting: false });
+    expect(await dispatchReload("S1", context)).toBe("respawn");
+    expect(respawn).toHaveBeenCalledOnce();
+  });
+});
