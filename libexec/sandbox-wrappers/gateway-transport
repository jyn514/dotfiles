#!/usr/bin/env python3
"""Run Docker through one command-owned, verified SSH connection."""
from __future__ import annotations

import os
import json
from pathlib import Path
import socket
import subprocess
import signal
import sys
import tempfile
import time
import threading
from urllib.parse import unquote, urlsplit

DEADLINE_SECONDS = float(os.environ.get("CODEX_SANDBOX_GATEWAY_RETRY_SECONDS", "15"))
RETRY_SECONDS = 0.1


def connect_until(address: tuple[str, int], deadline: float) -> socket.socket:
    last: OSError | None = None
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError(f"gateway did not become ready within {DEADLINE_SECONDS:g} seconds") from last
        try:
            connection = socket.create_connection(address, timeout=min(1.0, remaining))
            # The attempt timeout bounds connection establishment only. Once the
            # transport exists it is a transparent relay and may remain idle.
            connection.settimeout(None)
            return connection
        except InterruptedError:
            raise
        except OSError as error:
            last = error
            time.sleep(min(RETRY_SECONDS, max(0, deadline - time.monotonic())))


def stop_process_group(child: subprocess.Popen | None, signum: int = signal.SIGTERM) -> None:
    if child is None:
        return
    try:
        os.killpg(child.pid, signum)
    except ProcessLookupError:
        pass
    try:
        child.wait(timeout=5)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(child.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        child.wait()


def main(argv: list[str]) -> int:
    if not argv:
        print("gateway-transport: missing client", file=sys.stderr); return 2
    if argv[0] == "--connect":
        try:
            with connect_until((argv[1], int(argv[2])), time.monotonic() + DEADLINE_SECONDS) as upstream:
                def upload():
                    try:
                        while data := os.read(0, 65536):
                            upstream.sendall(data)
                        upstream.shutdown(socket.SHUT_WR)
                    except OSError:
                        pass
                # ProxyCommand exits on remote EOF even if its parent's input
                # remains open. This thread owns no subprocess or persistent state.
                threading.Thread(target=upload, daemon=True).start()
                while data := upstream.recv(65536):
                    sys.stdout.buffer.write(data)
                    sys.stdout.buffer.flush()
            return 0
        except (OSError, TimeoutError) as error:
            print(f"gateway transport failed: {error}", file=sys.stderr)
            return 255
    value = os.environ.get("DOCKER_HOST", "")
    parsed = urlsplit(value)
    if (parsed.scheme != "ssh" or parsed.hostname is None or parsed.port is None
            or parsed.username is None or parsed.path not in ("", "/")):
        print("docker: nested build service is unavailable; run tools/agent-docker/vm.py setup on the host",
              file=sys.stderr)
        return 125
    with tempfile.TemporaryDirectory(prefix="gateway-ssh-") as directory:
        home = Path(directory)
        config = home / "config"
        control = home / "control"
        config.write_text(
            "Host *\n  BatchMode yes\n  IdentitiesOnly yes\n  StrictHostKeyChecking yes\n"
            "  HostKeyAlias agent-docker\n  ConnectTimeout 20\n"
            "  ServerAliveInterval 5\n  ServerAliveCountMax 3\n"
            "  ControlMaster no\n  ControlPersist no\n"
            f"  ControlPath {json.dumps(str(control))}\n"
            f"  IdentityFile {json.dumps(os.environ['AGENT_DOCKER_SSHKEY'])}\n"
            f"  UserKnownHostsFile {json.dumps(os.environ['AGENT_DOCKER_KNOWN_HOSTS'])}\n"
            f"  ProxyCommand {Path(__file__).resolve()} --connect %h %p\n",
            encoding="utf-8",
        )
        config.chmod(0o600)
        (home / "ssh").symlink_to(Path(__file__).resolve().with_name("docker-ssh"))
        environment = os.environ.copy()
        # Keep HOME and Docker configuration: Buildx and credentials belong to
        # the sandbox, while only SSH identity/configuration is replaced.
        environment["PATH"] = str(home) + os.pathsep + environment.get("PATH", "")
        environment["AGENT_DOCKER_SSH_CONFIG"] = str(config)
        environment.pop("DOCKER_CONTEXT", None)
        environment.pop("DOCKER_TLS_VERIFY", None)
        environment.pop("DOCKER_CERT_PATH", None)
        master = None
        child = None
        previous = {}
        cancellation = None
        def terminate(signum, _frame):
            nonlocal cancellation
            # Record rather than raise: Popen must finish publishing ownership
            # before cleanup can terminate a just-created process group.
            cancellation = signum
        for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            previous[signum] = signal.signal(signum, terminate)
        try:
            # Foreground ownership avoids a detached ControlPersist process. The
            # private socket cannot reuse another invocation's credentials/host.
            master = subprocess.Popen([
                '/usr/bin/ssh', '-F', str(config), '-M', '-N', '-T',
                '-l', unquote(parsed.username), '-p', str(parsed.port), '--', parsed.hostname,
            ], env=environment, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                start_new_session=True)
            deadline = time.monotonic() + DEADLINE_SECONDS
            while not control.exists():
                if cancellation is not None:
                    return 128 + cancellation
                status = master.poll()
                if status is not None:
                    return status or 255
                if time.monotonic() >= deadline:
                    print('docker: verified SSH master did not become ready before the gateway deadline',
                          file=sys.stderr)
                    return 255
                time.sleep(0.01)
            if cancellation is not None:
                return 128 + cancellation
            child = subprocess.Popen(argv, env=environment, start_new_session=True)
            while child.poll() is None:
                if cancellation is not None:
                    return 128 + cancellation
                time.sleep(0.01)
            return 128 + cancellation if cancellation is not None else child.returncode
        finally:
            for signum in previous:
                signal.signal(signum, signal.SIG_IGN)
            try:
                stop_process_group(child, cancellation or signal.SIGTERM)
            finally:
                try:
                    stop_process_group(master)
                finally:
                    for signum, handler in previous.items():
                        signal.signal(signum, handler)

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
