#!/usr/bin/env python3
"""Model paginated list-and-repair, rejecting destructive maintenance commands."""
import json
import os
from pathlib import Path
import sys

if sys.argv[1:] != ["app-server", "--stdio"]:
    sys.exit("unexpected Codex arguments")
for line in sys.stdin:
    message = json.loads(line)
    with (Path(os.environ["CODEX_HOME"]) / "requests.jsonl").open("a") as log:
        log.write(line)
    if "id" not in message:
        continue
    reply = {"id": message["id"]}
    if message["method"] == "initialize":
        reply["result"] = {}
    elif message["method"] == "thread/list":
        if changed := os.environ.get("CODEX_IMPORT_TEST_CHANGE_DURING_SCAN"):
            Path(changed).write_text("changed while native scan was running\n")
        mode = os.environ.get("CODEX_IMPORT_TEST_MODE")
        if mode == "exit":
            sys.exit(7)
        if mode == "rpc-error":
            reply["error"] = {"code": -1, "message": "scan failed"}
        elif mode == "malformed":
            reply["result"] = {"data": None}
        else:
            cursor = message["params"].get("cursor")
            reply["result"] = {"data": [{"id": "example"}],
                               "nextCursor": "page-2" if cursor is None or mode == "repeat" else None}
    else:
        sys.exit("unexpected method")
    print(json.dumps(reply), flush=True)
