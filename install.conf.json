[
  {
    "defaults": {
      "link": {
        "create": true,
        "relink": true
      }
    }
  },
  {
    "link": {
      "$HOME/.codex/AGENTS.md": "config/agents/codex/AGENTS.md",
      "$HOME/.codex/breq.md": "config/agents/breq.md",
      "$HOME/.codex/dotfiles.config.toml": "config/agents/codex/codex.toml",
      "$HOME/.codex/developer-instructions.md": "config/agents/codex/codex-developer-instructions.md",
      "$HOME/.pi/agent/": {
        "glob": true,
        "path": "config/pi-agent/**",
        "exclude": [
          "config/pi-agent/pi-codex-subagents/agents/**"
        ]
      },
      "$HOME/.pi/agent/pi-codex-subagents/agents": "config/pi-agent/pi-codex-subagents/agents",
      "$HOME/.claude/CLAUDE.md": "config/agents/claude/CLAUDE.md",
      "$HOME/Library/LaunchAgents/": {
        "glob": true,
        "path": "config/LaunchAgents/*.plist"
      },
      "$HOME/.local/share/applications/": {
        "glob": true,
        "path": "config/applications/*.desktop"
      },
      "$HOME/.XCompose": "config/XCompose",
      "$HOME/.Xdefaults": "config/Xdefaults",
      "$HOME/.config/tmux/": {
        "glob": true,
        "path": "config/tmux/*"
      },
      "$HOME/.config/atuin/config.toml": "config/atuin.toml",
      "$HOME/.config/bacon/prefs.toml": "config/bacon.toml",
      "$HOME/.bash_aliases": "config/bash_aliases",
      "$HOME/.bash_logout": "config/bash_logout",
      "$HOME/.bashrc": "config/bashrc",
      "$HOME/.config/bat/config": "config/batconfig",
      "$HOME/.local/lib/cargo/config.toml": "config/cargo.toml",
      "$HOME/.claude/statusline-command.sh": "config/agents/claude/claude-statusline.sh",
      "$HOME/.config/claude/settings.json": "config/agents/claude/claude.json",
      "$HOME/.config/fish/config.fish": "config/config.fish",
      "$HOME/.config/fish/conf.d/mise-activate.fish": "config/mise-activate.fish",
      "$HOME/.config/containers/containers.conf": "config/containers.conf",
      "$HOME/.config/clojure/deps.edn": "config/deps.edn",
      "$HOME/.config/niri/config.kdl": "config/niri/config.kdl",
      "$HOME/.editorconfig": "config/editorconfig",
      "$HOME/.config/gdb/gdbearlyinit": "config/gdbearlyinit",
      "$HOME/.config/gdb/gdbinit": "config/gdbinit",
      "$HOME/.config/git/config": "config/gitconfig",
      "$HOME/.config/git/hooks": "config/githooks",
      "$HOME/.config/git/ignore": "config/gitignore",
      "$HOME/.config/glide/glide.ts": "config/glide.ts",
      "$HOME/.config/glide/glide-algorithms.ts": "config/glide-algorithms.ts",
      "$HOME/.config/grepme.toml": "config/grepme.toml",
      "$HOME/.config/helix": "config/helix",
      "$HOME/.config/readline/inputrc": "config/inputrc",
      "$JJ_CONFIG_PATH": "config/jj.toml",
      "$HOME/.config/kak/kakrc": "config/kakrc",
      "$HOME/.config/gitui/key_bindings.ron": "config/key_bindings.ron",
      "$HOME/.keybindings.ahk": "config/keybindings.ahk",
      "$HOME/.config/kitty/": {
        "glob": true,
        "path": "config/kitty/*.conf"
      },
      "$HOME/.config/lesskey": "config/lesskey",
      "$HOME/.config/nvim/": {
        "glob": true,
        "path": "config/nvim/**"
      },
      "$HOME/.config/mise/config.toml": "config/mise.toml",
      "$HOME/.config/mise/mise.lock": "config/mise.lock",
      "$HOME/.config/openbox/lubuntu-rc.xml": "config/openbox.xml",
      "$HOME/.profile": "config/profile",
      "$HOME/.config/pylintrc": "config/pylintrc",
      "$HOME/.config/clojure/rebel_readline.edn": "config/rebel_readline.edn",
      "$HOME/.selected_editor": "config/selected_editor",
      "$HOME/.agents/shared.md": "config/agents/shared-agents.md",
      "$HOME/.agents/irc.md": "config/agents/irc.md",
      "$HOME/.agents/contest-dialect.md": "config/agents/contest-dialect.md",
      "$HOME/.agents/coordination-dialect.md": "config/agents/coordination-dialect.md",
      "$HOME/.agents/sandbox/AGENTS.md": "config/agents/sandbox-AGENTS.md",
      "$HOME/.agents/skills": "skills",
      "$HOME/.julia/config/startup.jl": "config/startup.jl",
      "$HOME/.vimrc": "config/vimrc",
      "$HOME/.config/wezterm/wezterm.lua": "config/wezterm.lua",
      "$HOME/.config/youtube-dl/config": "config/youtube-dl",
      "$HOME/.config/fish/completions/__zoxide_z.fish": "config/z.fish",
      "$HOME/.zshenv": "config/zshenv",
      "$HOME/.config/zsh/": {
        "glob": true,
        "path": "config/zsh/.*"
      }
    }
  },
  {
    "create": [
      "$HOME/.local/state/zsh"
    ]
  }
]
