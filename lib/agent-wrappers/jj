#!/bin/sh
set -eu

codex_version() {
  session_root=${CODEX_HOME:-$HOME/.codex}
  session=$(find "$session_root/sessions" "$session_root/archived_sessions" \
    -type f -name "*${CODEX_THREAD_ID:-}.jsonl" -print -quit 2>/dev/null) || return
  [ -n "$session" ] || return
  jq -r '
      select(.type == "turn_context")
      | .payload.model
      | select(. != null and . != "")
    ' "$session" | tail -n1
}

is_jj_write() {
  case "$1" in
    commit|split) return 0 ;;
    *) return 1 ;;
  esac
}

# Identity by agent, auto-detected from each runner's own env. Resolve it before
# forwarding sandbox calls so the trusted proxy can stamp the same identity.
agent=${JJ_AGENT:-${CLAUDECODE:+claude}}
agent=${agent:-${CODEX_THREAD_ID:+codex}}
subcommand=${1:-}
case "$agent" in
  claude) JJ_USER='Claude Opus 4.8'; JJ_EMAIL='lifer@jyn.dev' ;;
  codex)
    model=$(codex_version)
    JJ_EMAIL='breq@jyn.dev'
    JJ_USER="Codex $model"

    case "$model" in
      "")
        if is_jj_write "$subcommand"; then
          printf '%s\n' "jj wrapper: warning: could not determine Codex model" >&2
        fi
        JJ_USER='Codex'
        ;;
      gpt-5.3-codex-spark)
        JJ_EMAIL='343-guilty-spark@jyn.dev'
        ;;
    esac
esac

if [ -n "${SANDBOX_PROXY_DIR:-}" ]; then
  export JJ_USER JJ_EMAIL
  exec /lib/agent-wrappers/jj-proxy-client "$@"
fi

# Shim: stamp jj commits as the agent, not the human running the wrapper.
# Lives in a dir prepended to PATH. Strips its own dir so the bare `jj`
# below resolves to the real binary (next on PATH) — no hardcoded path.
# Covers both the fish prompt and babashka tooling that calls `jj` via PATH.
self_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
# Canonicalize entries so aliases such as /lib and /usr/lib compare equal.
# Empty and nonexistent entries are omitted; an empty PATH entry means cwd.
original_path=$PATH
filtered_path=
while [ -n "$original_path" ]; do
  path_entry=${original_path%%:*}
  case "$original_path" in
    *:*) original_path=${original_path#*:} ;;
    *) original_path= ;;
  esac

  [ -n "$path_entry" ] || continue
  canonical_entry=$(CDPATH='' cd -- "$path_entry" 2>/dev/null && pwd -P) || continue
  [ "$canonical_entry" != "$self_dir" ] || continue

  filtered_path=${filtered_path:+$filtered_path:}$canonical_entry
done
PATH=$filtered_path
export PATH

should_force_plain_diff() {
  [ ! -t 1 ] || return 1

  case "$1" in
    diff|show) return 0 ;;
    *) return 1 ;;
  esac
}

has_diff_formatter_config() {
  for arg in "$@"; do
    case "$arg" in
      ui.diff-formatter=*|--config=ui.diff-formatter=*) return 0 ;;
    esac
  done
  return 1
}

if [ -n "${JJ_USER:-}" ]; then
  # jj stamps author at change *creation*, committer at commit — so a change
  # born before this shim (or re-snapshotted by a bare jj) keeps a stale
  # author. Any command that records @ into a new commit inherits that author:
  # `commit` makes one, `split` makes two. Reset the working-copy author to our
  # identity first, so recorded commits have author == committer. Best-effort:
  # never block the command if metaedit has nothing to do.
  case "$subcommand" in
    commit|split)
      jj --config "user.name=$JJ_USER" --config "user.email=$JJ_EMAIL" \
        metaedit --update-author -r @ --quiet || true
      ;;
  esac

  set -- --config "user.name=$JJ_USER" --config "user.email=$JJ_EMAIL" "$@"
fi

if should_force_plain_diff "$subcommand" && ! has_diff_formatter_config "$@"; then
  set -- --config ui.diff-formatter=:git "$@"
fi

if jj "$@"; then
  if [ -n "${JJ_USER:-}" ]; then
    # Intentionally use the real jj config here, not the agent identity.
    jj metaedit --update-author -r @ --quiet || true
  fi
else
  exit "$?"
fi

exit 0
