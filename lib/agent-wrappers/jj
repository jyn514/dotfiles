#!/bin/sh
# Shim: stamp jj commits as the agent, not the human running the wrapper.
# Lives in a dir prepended to PATH. Strips its own dir so the bare `jj`
# below resolves to the real binary (next on PATH) — no hardcoded path.
# Covers both the fish prompt and babashka tooling that calls `jj` via PATH.
self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
PATH=$(printf '%s' "$PATH" | tr : '\n' | grep -vxF "$self_dir" | tr '\n' :)
PATH=${PATH%:}   # drop trailing colon — an empty entry means cwd, a footgun
export PATH

codex_version() {
  find "${CODEX_HOME:-$HOME/.codex}/sessions" -name "*${CODEX_THREAD_ID}.jsonl" -print0 -quit \
    | xargs -0 jq -r '
        select(.type == "turn_context")
        | .payload.model
        | select(. != null and . != "")
      ' \
    | tail -n1
}

is_jj_write() {
  case "$1" in
    commit|split) return 0 ;;
    *) return 1 ;;
  esac
}

should_force_plain_diff() {
  [ ! -t 1 ] || return 1

  case "$1" in
    diff|show) return 0 ;;
    *) return 1 ;;
  esac
}

has_diff_formatter_config() {
  for arg in "$@"; do
    case "$arg" in
      ui.diff-formatter=*|--config=ui.diff-formatter=*) return 0 ;;
    esac
  done
  return 1
}

# Identity by agent, auto-detected from each runner's own env: Claude Code
# exports CLAUDECODE, Codex exports CODEX_THREAD_ID. JJ_AGENT overrides both
# if ever needed. An unknown caller (a human at the wrapper) falls through to
# the real jj's own config. Set via JJ_USER/JJ_EMAIL so every jj call below
# inherits one identity for both author and committer.
agent=${JJ_AGENT:-${CLAUDECODE:+claude}}
agent=${agent:-${CODEX_THREAD_ID:+codex}}
case "$agent" in
  claude) JJ_USER='Claude Opus 4.8'; JJ_EMAIL='lifer@jyn.dev' ;;
  codex)
    model=$(codex_version)
    if [ -z "$model" ]; then
      if is_jj_write "$1"; then
        printf '%s\n' "jj wrapper: warning: could not determine Codex model; stamping as Codex" >&2
      fi
      JJ_USER='Codex'
    else
      JJ_USER="Codex $model"
    fi
    JJ_EMAIL='breq@jyn.dev'
    ;;
esac

if [ -n "${JJ_USER:-}" ]; then
  export JJ_USER JJ_EMAIL
  # jj stamps author at change *creation*, committer at commit — so a change
  # born before this shim (or re-snapshotted by a bare jj) keeps a stale
  # author. Any command that records @ into a new commit inherits that author:
  # `commit` makes one, `split` makes two. Reset the working-copy author to our
  # identity first, so recorded commits have author == committer. Best-effort:
  # never block the command if metaedit has nothing to do.
  case "$1" in
    commit|split) jj metaedit --update-author -r @ || true ;;
  esac
fi

if should_force_plain_diff "$1" && ! has_diff_formatter_config "$@"; then
  exec jj --config ui.diff-formatter=:git "$@"
fi

exec jj "$@"
