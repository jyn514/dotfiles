#!/usr/bin/env python3

import subprocess
import sys
from collections.abc import Iterable


TRAILING_WHITESPACE = (b" ", b"\t", b"\r", b"\v", b"\f")


def check_diff(lines: Iterable[bytes]) -> bool:
    found = False
    patch_file = False
    binary_file = False

    for line in lines:
        if line.startswith(b"+++ "):
            path = line.rstrip(b"\r\n").lower()
            patch_file = path.endswith((b".diff", b'.diff"', b".patch", b'.patch"'))
            binary_file = path.endswith((b".pdf", b'.pdf"'))
            continue

        content = line[:-1] if line.endswith(b"\n") else line
        if patch_file and content == b"+ ":
            continue
        if (
            not binary_file
            and line.startswith(b"+")
            and content.endswith(TRAILING_WHITESPACE)
        ):
            sys.stdout.buffer.write(line)
            found = True

    return found


def main() -> int:
    process = subprocess.Popen(
        ["jj", "diff", "--git", *sys.argv[1:]],
        stdout=subprocess.PIPE,
    )
    assert process.stdout is not None
    found = check_diff(process.stdout)
    returncode = process.wait()
    if returncode:
        return returncode
    return 1 if found else 0


if __name__ == "__main__":
    raise SystemExit(main())
