{
  "linux": {
    "editor_mime_prefixes": [
      "text/"
    ],
    "editor_mime_roots": [
      "text/plain"
    ],
    "editor_mime_exceptions": [
      "application/javascript",
      "application/x-csh"
    ]
  },
  "macos": {
    "editor_utis": [
      "public.plain-text",
      "public.source-code"
    ],
    "editor_extension_exceptions": [
      "markdown",
      "md",
      "rs",
      "toml",
      "txt",
      "yaml",
      "yml"
    ],
    "json_handler": {
      "bundle_id": "dev.jyn.fx",
      "extensions": [
        "json"
      ],
      "name": "fx",
      "role": "Viewer",
      "utis": [
        "public.json"
      ]
    }
  }
}
