{
  "linux": {
    "editor_mime_prefixes": [
      "text/"
    ],
    "editor_mime_roots": [
      "text/plain"
    ],
    "editor_mime_exceptions": [
      "application/javascript",
      "application/x-csh"
    ]
  },
  "macos": {
    "editor_utis": [
      "public.plain-text",
      "public.source-code"
    ],
    "editor_extensions": [
      "ahk",
      "applescript",
      "bat",
      "c",
      "clj",
      "conf",
      "cow",
      "desktop",
      "edn",
      "fish",
      "graphql",
      "h",
      "ini",
      "jl",
      "jq",
      "js",
      "lock",
      "lua",
      "markdown",
      "md",
      "patch",
      "ps1",
      "py",
      "repo",
      "ron",
      "rs",
      "rules",
      "scm",
      "sed",
      "sh",
      "sublime-syntax",
      "swift",
      "tex",
      "timer",
      "toml",
      "ts",
      "txt",
      "typ",
      "vim",
      "xml",
      "yaml",
      "yml"
    ],
    "editor_ambiguous_extensions": [
      "ts"
    ],
    "json_handler": {
      "bundle_id": "dev.jyn.fx",
      "extensions": [
        "json"
      ],
      "name": "fx",
      "role": "Viewer",
      "utis": [
        "public.json"
      ]
    }
  }
}
