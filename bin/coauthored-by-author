#!/usr/bin/env bb

(ns coauthored-by-author
  (:require
   [babashka.fs :as fs]
   [cheshire.core :as json]
   [clojure.string :as str]))

(load-file (str (fs/path (fs/parent (fs/parent (fs/real-path *file*)))
                         "libexec" "rewrite-history.clj")))
(require '[dotfiles.rewrite-history :as history])

(def default-match #"(?i)^Claude\b")

(defn usage []
  (println "Usage: coauthored-by-author [--apply] [--keep-trailer] [--refs REF ...] [--match REGEX]")
  (println)
  (println "Find commits with a matching Co-Authored-By trailer and rewrite their")
  (println "primary author to the trailer identity using git-filter-repo. The matching")
  (println "trailer is removed unless --keep-trailer is passed.")
  (println)
  (println "Defaults:")
  (println "  --match '(?i)^Claude\\b'")
  (println "  --refs  HEAD")
  (println)
  (println "Without --apply, prints the commits that would be rewritten."))

(defn parse-args
  [args]
  (loop [args args
         opts {:apply? false
               :keep-trailer? false
               :refs []
               :match default-match}]
    (case (first args)
      nil (update opts :refs #(if (seq %) % ["HEAD"]))
      "--help" (assoc opts :help? true)
      "-h" (assoc opts :help? true)
      "--apply" (recur (rest args) (assoc opts :apply? true))
      "--keep-trailer" (recur (rest args) (assoc opts :keep-trailer? true))
      "--refs" (let [refs (take-while #(not (str/starts-with? % "--")) (rest args))]
                 (when-not (seq refs)
                   (throw (ex-info "--refs requires at least one ref" {})))
                 (recur (drop (inc (count refs)) args)
                        (update opts :refs into refs)))
      "--match" (let [pattern (second args)]
                  (when-not pattern
                    (throw (ex-info "--match requires a regex" {})))
                  (recur (nnext args) (assoc opts :match (re-pattern pattern))))
      (throw (ex-info (str "Unknown argument: " (first args)) {})))))

(defn commit-records
  [refs]
  (->> (history/commit-records [[:commit "%H"] [:author-name "%an"] [:author-email "%ae"] [:message "%B"]]
                              refs true)
       (map (fn [{:keys [commit author-name author-email message]}]
              {:commit commit
               :author {:name author-name :email author-email}
               :message message}))))

(defn parsed-trailers
  [message]
  (->> (history/shell {:in message
                       :out :string
                       :err :string
                       :continue true}
                      "git"
                      "interpret-trailers"
                      "--parse")
       ((fn [{:keys [exit out err]}]
          (if (zero? exit)
            out
            (throw (ex-info (str "git interpret-trailers failed\n" err)
                            {:exit exit})))))
       ;; Native --parse uses LF records; unfolded values can retain CR.
       (#(str/split % #"\n"))
       (keep (fn [line]
               (when-let [[_ token value] (re-matches #"([^:]+):[ \t]*([^\n]*)" line)]
                 [(str/lower-case token) value])))))

(defn parse-person
  [value]
  (when-let [[_ name email] (re-matches #"\s*(.*?)\s*<([^<>]+)>\s*" value)]
    {:name name
     :email email}))

(defn matching-coauthor
  [match-re message]
  (->> (parsed-trailers message)
       (filter (fn [[token _]] (= "co-authored-by" token)))
       (keep (fn [[_ value]]
               (when-let [person (parse-person value)]
                 (when (re-find match-re (:name person))
                   person))))
       first))

(defn candidates
  [{:keys [refs match]}]
  (->> (commit-records refs)
       (keep (fn [{:keys [commit author message]}]
               (when-let [person (matching-coauthor match message)]
                 (when (not= author person)
                   {:commit commit
                    :author author
                    :new-author person}))))))

(defn print-candidate
  [{:keys [commit author new-author]}]
  (println (format "%s  %s <%s>  ->  %s <%s>"
                   commit
                   (:name author)
                   (:email author)
                   (:name new-author)
                   (:email new-author))))

(defn callback-path []
  (str (fs/path (fs/parent (fs/parent (fs/real-path *file*)))
                "libexec" "coauthored-by-author.py")))

(defn temp-data-path []
  (let [root (or (System/getenv "TMPDIR") (System/getProperty "java.io.tmpdir"))]
    (str (java.nio.file.Files/createTempFile
          (.toPath (java.io.File. root))
          "coauthored-by-author-"
          ".json"
          (make-array java.nio.file.attribute.FileAttribute 0)))))

(defn apply-rewrite!
  [opts candidates]
  (when-not (seq candidates)
    (println "Nothing to rewrite.")
    (System/exit 0))
  (history/require-clean-worktree!)
  (let [data-path (temp-data-path)
        data {:authors (into {} (map (fn [{:keys [commit new-author]}]
                                      [(str/trim commit) new-author])
                                    candidates))
              :keep-trailer (:keep-trailer? opts)}]
    (try
      (spit data-path (json/generate-string data))
      (history/filter-repo!
       ["git" "filter-repo"]
       {:extra-env {"COAUTHORED_BY_AUTHOR_DATA" data-path}}
       [] (:refs opts) (callback-path))
      (finally
        (fs/delete data-path)))))

(defn -main
  [& args]
  (let [opts (parse-args args)]
    (if (:help? opts)
      (usage)
      (let [candidates (vec (candidates opts))]
        (history/preview! candidates print-candidate "No matching Co-Authored-By trailers found.")
        (when (:apply? opts)
          (apply-rewrite! opts candidates))))))

(history/run-main! -main *command-line-args*)
