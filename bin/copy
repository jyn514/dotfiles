#!/bin/sh

set -e

exists () {
	command -v "$1" >/dev/null 2>&1
}

fatal() {
	echo "$@" >&2
	exit 1
}

main() {
	mode=$1; shift

	# Installed X11 tools cannot use a Wayland-only session. Preserve X11
	# priority when DISPLAY is supplied (including SSH and mixed sessions).
	if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ] && exists wl-copy; then
		prog=wl-$mode
	# X11
	elif exists xclip; then
		prog=xclip
	# X11, no --type support
	elif exists xsel; then
		prog=xsel

	# Wayland
	elif exists wl-copy; then
		prog=wl-$mode

	# MacOS, no --type support currently.
	# might be possible to add using `osascript`.
	elif exists pbcopy; then
		if [ "$mode" = copy ]; then
			prog=pbcopy
		else
			prog=pbpaste
		fi
	else
		# TODO: windows
		fatal "no clipboard manager detected"
	fi

	# Accept only [--type VALUE] [--primary]; VALUE remains a literal operand.
	type_set=false
	if [ "${1:-}" = --type ]; then
		[ "$#" -ge 2 ] || fatal "--type requires an operand"
		case "$prog" in
			xclip|wl-copy|wl-paste)
				type=$2
				type_set=true
				shift; shift
				;;
			*) fatal "$prog doesn't support --type";;
		esac
	fi

	selection=clipboard
	if [ "${1:-}" = --primary ]; then
		selection=primary
		shift
	fi
	[ "$#" -eq 0 ] || fatal "unexpected argument: $1"

	# Build native argv directly: MIME values must never undergo splitting or globbing.
	case "$prog:$mode" in
		xclip:copy) set -- -in;;
		xclip:paste) set -- -out;;
		xsel:copy) set -- --input;;
		xsel:paste) set -- --output;;
		*) set --;;
	esac
	if [ "$type_set" = true ]; then
		case "$prog" in
			# xclip calls the requested MIME atom a target, not a type.
			xclip) set -- "$@" -target "$type";;
			*) set -- "$@" --type "$type";;
		esac
	fi
	case "$prog" in
		xclip) set -- "$@" -selection "$selection";;
		xsel) set -- "$@" "--$selection";;
		wl-copy|wl-paste)
			if [ "$selection" = primary ]; then
				set -- "$@" --primary
			fi
			;;
		pbcopy|pbpaste)
			if [ "$selection" = primary ]; then
				set -- "$@" -pboard find
			else
				set -- "$@" -pboard general
			fi
			;;
	esac
	"$prog" "$@"
}

mode=$(basename "$0")
case "$mode" in
	copy) ;;
	paste) ;;
	*) fatal "unknown operation $0";;
esac

main "$mode" "$@"
