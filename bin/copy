#!/bin/sh

set -e

exists () {
	command -v "$1" >/dev/null 2>&1
}

fatal() {
	echo "$@" >&2
	exit 1
}

main() {
	mode=$1; shift

	# X11
	if exists xclip; then
		prog=xclip
	# X11, no --type support
	elif exists xsel; then
		prog=xsel

	# Wayland
	elif exists wl-copy; then
		if [ "$mode" = copy ]; then
			prog=wl-copy
		else
			prog=wl-paste
		fi

	# MacOS, no --type support currently.
	# might be possible to add using `osascript`.
	elif exists pbcopy; then
		if [ "$mode" = copy ]; then
			prog=pbcopy
		else
			prog=pbpaste
		fi
	else
		# TODO: windows
		fatal "no clipboard manager detected"
	fi

	type_set=false
	if [ "$1" = --type ]; then
		case "$prog" in
			xclip|wl-copy|wl-paste)
				type=$2
				type_set=true
				shift; shift
				;;
			*) fatal "$prog doesn't support --type";;
		esac
	fi

	selection=clipboard
	if [ "${1:-}" = --primary ]; then
		selection=primary
	fi

	# Build native argv directly: MIME values must never undergo splitting or globbing.
	case "$prog:$mode" in
		xclip:copy) set -- -in;;
		xclip:paste) set -- -out;;
		xsel:copy) set -- --input;;
		xsel:paste) set -- --output;;
		*) set --;;
	esac
	if [ "$type_set" = true ]; then
		set -- "$@" --type "$type"
	fi
	case "$prog" in
		xclip) set -- "$@" -selection "$selection";;
		xsel) set -- "$@" "--$selection";;
		wl-copy|wl-paste)
			if [ "$selection" = primary ]; then
				set -- "$@" --primary
			fi
			;;
		pbcopy|pbpaste)
			if [ "$selection" = primary ]; then
				set -- "$@" -pboard find
			else
				set -- "$@" -pboard general
			fi
			;;
	esac
	"$prog" "$@"
}

mode=$(basename "$0")
case "$mode" in
	copy) ;;
	paste) ;;
	*) fatal "unknown operation $0";;
esac

main "$mode" "$@"
