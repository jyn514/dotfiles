#!/usr/bin/env python3
"""Compatibility launcher for the repository backup command.

This command retains the historical ``git-save`` name while sharing the
byte-safe implementation used by ``git-backup``.
"""

from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "tools" / "git-backup"))

from git_backup.main import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
