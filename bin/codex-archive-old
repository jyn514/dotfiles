#!/usr/bin/env node

const { spawn } = require("node:child_process");
const readline = require("node:readline");

function usage() {
  console.log(`Usage: codex-archive-old [--days N] [--apply]

Archive active interactive Codex sessions whose last update is older than N
days. The default is 7 days. Without --apply, show a dry run only.

Options:
  --days N   Retention window in whole days (default: 7)
  --apply    Archive the selected sessions
  -h, --help Show this help`);
}

function parseArgs(argv) {
  let days = 7;
  let apply = false;

  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--apply") {
      apply = true;
    } else if (arg === "--days") {
      const value = argv[index + 1];
      if (!value || !/^\d+$/.test(value) || Number(value) < 1) {
        throw new Error("--days requires a positive whole number");
      }
      days = Number(value);
      index += 1;
    } else if (arg === "-h" || arg === "--help") {
      usage();
      process.exit(0);
    } else {
      throw new Error(`unknown argument: ${arg}`);
    }
  }

  return { days, apply };
}

class AppServerClient {
  constructor() {
    this.nextId = 1;
    this.pending = new Map();
    this.stderr = "";
    this.process = spawn("codex", ["app-server"], {
      stdio: ["pipe", "pipe", "pipe"],
    });

    const lines = readline.createInterface({ input: this.process.stdout });
    lines.on("line", (line) => this.receive(line));
    this.process.stderr.on("data", (chunk) => {
      this.stderr += chunk;
    });
    this.process.on("exit", (code, signal) => {
      const detail = this.stderr.trim();
      const error = new Error(
        `Codex app-server exited (${code ?? signal})${detail ? `: ${detail}` : ""}`,
      );
      for (const { reject } of this.pending.values()) reject(error);
      this.pending.clear();
    });
  }

  receive(line) {
    let message;
    try {
      message = JSON.parse(line);
    } catch {
      return;
    }

    // JSON-RPC IDs are scoped independently in each direction. A server request
    // can reuse one of our pending request IDs, so only response-shaped messages
    // may resolve client requests.
    if (
      message.method !== undefined ||
      message.id === undefined ||
      (!Object.hasOwn(message, "result") && !Object.hasOwn(message, "error")) ||
      !this.pending.has(message.id)
    ) {
      return;
    }
    const { resolve, reject } = this.pending.get(message.id);
    this.pending.delete(message.id);
    if (message.error) reject(new Error(JSON.stringify(message.error)));
    else resolve(message.result);
  }

  send(message) {
    this.process.stdin.write(`${JSON.stringify(message)}\n`);
  }

  request(method, params) {
    const id = this.nextId;
    this.nextId += 1;
    return new Promise((resolve, reject) => {
      this.pending.set(id, { resolve, reject });
      this.send({ method, id, params });
    });
  }

  async initialize() {
    await this.request("initialize", {
      clientInfo: {
        name: "codex_archive_old",
        title: "Codex Session Maintenance",
        version: "1.0.0",
      },
    });
    this.send({ method: "initialized", params: {} });
  }

  async close() {
    if (this.process.exitCode !== null || this.process.signalCode !== null) return;

    await new Promise((resolve) => {
      const forceExit = setTimeout(() => {
        this.process.kill("SIGKILL");
      }, 1000);
      forceExit.unref();
      this.process.once("exit", () => {
        clearTimeout(forceExit);
        resolve();
      });
      this.process.stdin.end();
      this.process.kill("SIGTERM");
    });
  }
}

async function listOldThreads(client, cutoff) {
  const oldThreads = [];
  let cursor = null;

  do {
    const response = await client.request("thread/list", {
      archived: false,
      cursor,
      limit: 100,
      sortKey: "updated_at",
      sortDirection: "asc",
      useStateDbOnly: true,
    });
    if (!response || !Array.isArray(response.data)) {
      throw new Error("thread/list returned an invalid response");
    }

    for (const thread of response.data) {
      if (thread.updatedAt >= cutoff) return oldThreads;
      oldThreads.push(thread);
    }
    cursor = response.nextCursor;
  } while (cursor);

  return oldThreads;
}

function describe(thread) {
  const updated = new Date(thread.updatedAt * 1000).toISOString().slice(0, 10);
  const label = thread.name || thread.preview || "(untitled)";
  const shortLabel = label.replace(/\s+/g, " ").slice(0, 72);
  return `${updated}  ${thread.id}  ${shortLabel}`;
}

async function main() {
  const options = parseArgs(process.argv.slice(2));
  const cutoff = Math.floor(Date.now() / 1000) - options.days * 24 * 60 * 60;
  const client = new AppServerClient();

  try {
    await client.initialize();
    const threads = await listOldThreads(client, cutoff);
    const cutoffDate = new Date(cutoff * 1000).toISOString();

    console.log(
      `${options.apply ? "Archiving" : "Would archive"} ${threads.length} session(s) last updated before ${cutoffDate}.`,
    );
    for (const thread of threads.slice(0, 25)) console.log(describe(thread));
    if (threads.length > 25) console.log(`... and ${threads.length - 25} more`);

    if (!options.apply) {
      if (threads.length > 0) {
        console.log(`\nRun ~/.codex/scripts/codex-archive-old --days ${options.days} --apply to archive them.`);
      }
      return;
    }

    let archived = 0;
    for (const thread of threads) {
      await client.request("thread/archive", { threadId: thread.id });
      archived += 1;
      if (archived % 100 === 0) console.log(`Archived ${archived}/${threads.length}...`);
    }
    console.log(`Archived ${archived} session(s).`);
  } finally {
    await client.close();
  }
}

main().catch((error) => {
  console.error(`codex-archive-old: ${error.message}`);
  process.exitCode = 1;
});
