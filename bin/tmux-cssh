#!/bin/sh

set -eu

hosts=""
ssh_cmd=ssh
ssh_options=""
tmux_name="cssh"
tmux_attach_current_session="false"

usage() {
  echo "Usage: $0 [options] host [host ...]" >&2
  echo "" >&2
  echo "Spawns multiple synchronized SSH sessions inside a tmux session." >&2
  echo "" >&2
  echo "Options:" >&2
  echo "  -h                  Show help" >&2
  echo "  -c                  Use a different command instad of ssh" >&2
  echo "  -w                  Use the current tmux session and just spawn a new window instead" >&2
  echo "  -n <name>           Name of the tmux session or window (default: cssh)" >&2
  echo "  -o <ssh args>       Additional SSH arguments" >&2
}

while [ $# -ne 0 ]; do
  case $1 in
    -n)
      shift
      if [ $# -eq 0 ]; then
        usage
        exit 2
      fi
      tmux_name="$1"
      shift
      ;;
    -w)
      tmux_attach_current_session="true"
      shift
      ;;
    -c)
      shift
      if [ $# -eq 0 ]; then
        usage
        exit 2
      fi
      ssh_cmd="$1"
      shift
      ;;
    -o)
      shift
      if [ $# -eq 0 ]; then
        usage
        exit 2
      fi
      ssh_options="$1"
      shift
      ;;
    -h)
      usage
      exit 0
      ;;
    -*)
      usage
      exit 2
      ;;
    *)
      hosts="${hosts}${hosts:+ }$1"
      shift
      ;;
  esac
done

if [ -z "${hosts}" ]; then
  usage
  exit 2
fi

# Find a name for a new session
n=0
while tmux has-session -t "${tmux_name}-${n}" 2>/dev/null; do n=$((n + 1)); done
tmux_session="${tmux_name}-${n}"

if [ "${tmux_attach_current_session}" = "true" ]; then
	tmux_session=$(tmux display-message -p '#S') || exit
	# Find a name for a new window
	n=0
	windows=$(tmux list-windows -F '#W') || exit
	while printf '%s\n' "$windows" | grep -Fqx -- "${tmux_name}-${n}"; do n=$((n + 1)); done
	tmux_window="${tmux_name}-${n}"
fi

# If host doesn't look like a DNS name, it may be a CSSH cluster
if ! echo "${hosts}" | grep -q '[. ]'; then
  for cfg in "${HOME}/.clusterssh/clusters" /etc/clusters; do
    if [ -r "${cfg}" ]; then
      h="$(sed -n "s/^${hosts} //p" <"${cfg}")"
      if [ -n "${h}" ]; then
        hosts="${h}"
        break
      fi
    fi
    # If there was no corresponding cluster name,
    # just assume we have an unqualified domain name
  done
fi

# Open a new session and split into new panes for each SSH session
tmux_window_id=""
for host in ${hosts}; do
	if ! tmux has-session -t "${tmux_session}" 2>/dev/null; then
		pane=$(tmux new-session -P -F '#D' -s "${tmux_session}" -d "${ssh_cmd} ${ssh_options} ${host}") || exit
		tmux_window_id=""
	elif [ "${tmux_attach_current_session}" = "true" ]; then
		windows=$(tmux list-windows -F '#W') || exit
		if ! printf '%s\n' "$windows" | grep -Fqx -- "${tmux_window}"; then
			pane=$(tmux new-window -P -F '#D' -n "${tmux_window}" \
				"${ssh_cmd} ${ssh_options} ${host}") || exit
			tmux_window_id=""
		else
			pane=$(tmux split-window -P -F '#D' -t "$tmux_window_id" -d \
				"${ssh_cmd} ${ssh_options} ${host}") || exit
			# We have to reset the layout after each new pane otherwise the panes
			# quickly become too small to spawn any more.
			tmux select-layout -t "$tmux_window_id" tiled
		fi
	else
		pane=$(tmux split-window -P -F '#D' -t "$tmux_window_id" -d \
			"${ssh_cmd} ${ssh_options} ${host}") || exit
		# We have to reset the layout after each new pane otherwise the panes
		# quickly become too small to spawn any more.
		tmux select-layout -t "$tmux_window_id" tiled
	fi
	if [ -z "$tmux_window_id" ]; then
		# Retain the created window, not a name which may resolve in another session.
		tmux_window_id=$(tmux display-message -p -t "$pane" '#{window_id}') || exit
	fi
	tmux set-option -p -t "$pane" pane-border-format "${host}"
done

# Synchronize panes by default. Show hostnames.
tmux set-window-option -t "$tmux_window_id" synchronize-panes on
tmux set-window-option -t "$tmux_window_id" pane-border-status top
tmux set-option -t "$tmux_window_id" remain-on-exit failed

if [ -n "${TMUX:-}" ]; then
  # We are in a tmux, just switch to the new session
  tmux set-option -t "$pane" detach-on-destroy no-detached
  tmux switch-client -t "=${tmux_session}"
else
  # We are NOT in a tmux, attach to the new session
  tmux attach-session -t "=${tmux_session}"
fi
