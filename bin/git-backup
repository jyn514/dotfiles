#!/usr/bin/env python3
"""Stable launcher for the repository backup command."""

# .SCRIPTDOC
# Back up a Git repository to a local file. The resulting tar file contains a
# Git bundle and an xz-compressed checkout of the repository's default branch.
# The checkout keeps the backup useful on systems without Git.
#
# .SYNTAX
#
# $1 . . . URL or path of repository to back up
#
# $2 . . . Path to backup file (.tar is added automatically)
#
# .LICENSE
#
# Copyright 2018, Charles A. Daniels
# This software is distributed under the BSD 3-clause license. The full text
# is available in the repository LICENSE file.
# .ENDOC

from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "tools" / "git-backup"))

from git_backup.main import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
