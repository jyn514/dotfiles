#!/bin/sh

set -eu

DOTFILES="$(dirname -- "$(realpath -- "$0")")/.."
SANDBOX_PROXY_HELPER="$DOTFILES/lib/sandbox-proxies.py"
SANDBOX_NETWORK=codex-public-only
SANDBOX_SUBNET=10.254.254.0/24
SANDBOX_GATEWAY=10.254.254.1
SANDBOX_IP_RANGE=10.254.254.128/25
AGENT_PODMAN_ACCESS_DIR=${AGENT_PODMAN_ACCESS_DIR:-$HOME/.agent-podman-access}
AGENT_PODMAN_CONNECTION=$AGENT_PODMAN_ACCESS_DIR/connection.env
AGENT_PODMAN_KEY=$AGENT_PODMAN_ACCESS_DIR/id_ed25519
AGENT_PODMAN_KNOWN_HOSTS=$AGENT_PODMAN_ACCESS_DIR/known_hosts.sandbox
AGENT_PODMAN_CONTAINER_KNOWN_HOSTS=/run/secrets/agent-podman-known-hosts
AGENT_PODMAN_RELAY_PORT=2222
SESSION_SUFFIX=$(id -u)-$$
RELAY_LINK_NETWORK=codex-agent-podman-link-$SESSION_SUFFIX
RELAY_EGRESS_NETWORK=codex-agent-podman-egress-$SESSION_SUFFIX
RELAY_CONTAINER=codex-agent-podman-relay-$SESSION_SUFFIX
CODEX_CONTAINER=codex-sandbox-$SESSION_SUFFIX
AGENT_PODMAN_ENABLED=false
RELAY_LINK_CREATED=false
RELAY_EGRESS_CREATED=false
RELAY_CONTAINER_CREATED=false
CODEX_CONTAINER_CREATED=false
SANDBOX_PROXY_PREFIX=codex-command-proxy-$SESSION_SUFFIX
SANDBOX_PROXY_STATE=
SANDBOX_PROXY_ARGS=
SANDBOX_MANIFEST=
SANDBOX_MONITOR_PID=
SANDBOX_LOCK_READY=
SANDBOX_LOCK_RELEASE=
SANDBOX_LOCK_PID=
SKILLS_TMP=
TERM=${TERM:-xterm-256color}

die() {
	printf 'error: %s\n' "$*" >&2
	exit 1
}
if [ -e "$AGENT_PODMAN_CONNECTION" ] || [ -e "$AGENT_PODMAN_KEY" ] || [ -e "$AGENT_PODMAN_KNOWN_HOSTS" ]; then
	[ -f "$AGENT_PODMAN_CONNECTION" ] && [ -f "$AGENT_PODMAN_KEY" ] && \
		[ -f "$AGENT_PODMAN_KNOWN_HOSTS" ] || \
		die "Agent Podman access state is incomplete: $AGENT_PODMAN_ACCESS_DIR"
	# setup.sh created this trusted, user-owned file outside the agent workspace.
	# shellcheck source=/dev/null
	. "$AGENT_PODMAN_CONNECTION"
	upstream_prefix="ssh://$AGENT_PODMAN_SSH_USER@host.docker.internal:$AGENT_PODMAN_SSH_PORT/"
	AGENT_PODMAN_SOCKET_PATH=${CONTAINER_HOST#"$upstream_prefix"}
	AGENT_PODMAN_ENABLED=true
fi

ensure_network() {
  if docker network exists "$SANDBOX_NETWORK"; then
    return
  fi

  printf "Creating sandbox network ..."
	# Prohibit routes to non-public ranges.
	# The sandbox has no NET_ADMIN capability, so it cannot replace these routes.
  docker network create --ignore \
    --subnet "$SANDBOX_SUBNET" \
    --gateway "$SANDBOX_GATEWAY" \
    --ip-range "$SANDBOX_IP_RANGE" \
    --opt isolate=true \
		--route 0.0.0.0/8,prohibit \
		--route 10.0.0.0/8,prohibit \
		--route 100.64.0.0/10,prohibit \
		--route 127.0.0.0/8,prohibit \
		--route 169.254.0.0/16,prohibit \
		--route 172.16.0.0/12,prohibit \
		--route 192.0.0.0/24,prohibit \
		--route 192.168.0.0/16,prohibit \
		--route 198.18.0.0/15,prohibit \
		--route 224.0.0.0/4,prohibit \
		--route 240.0.0.0/4,prohibit \
    "$SANDBOX_NETWORK" >/dev/null \
    || return 1
  echo " done."
}

build_image() {
	(
		iidfile=$(mktemp)
		trap 'rm -f "$iidfile"' EXIT HUP INT TERM
		cd "$DOTFILES"
		docker build -f lib/agent-sandbox/Dockerfile \
			--build-arg "AGENT_UID=$(id -u)" \
			--build-arg "AGENT_GID=$(id -g)" \
			--build-arg "CODEX_HOME=$HOME/.codex" \
			--build-arg "TERM=$TERM" \
			--iidfile "$iidfile" \
			"$@" . 1>&2
		cat "$iidfile"
	)
}

image_cache_key() {
	base_image=$1
	(
		cd "$DOTFILES"
		{
			printf '%s\n' \
				"BASE_IMAGE=$base_image" \
				"AGENT_UID=$(id -u)" \
				"AGENT_GID=$(id -g)" \
				"CODEX_HOME=$HOME/.codex" \
				"TERM=$TERM"
			# The Dockerfile uses shell-form COPY with one source per instruction.
			# Heredoc COPY instructions create their content inline, so the
			# Dockerfile hash already accounts for them.
			{
				printf '%s\n' lib/agent-sandbox/Dockerfile
				awk '
					$1 == "COPY" {
						for (i = 2; i < NF; i++)
							if ($i ~ /^--from=/)
								next
						for (i = 2; i < NF; i++)
							if ($i !~ /^--/ && $i !~ /^<</)
								print $i
					}
				' lib/agent-sandbox/Dockerfile
			} |
				while IFS= read -r path; do
					find "$path" -type f -print
				done |
				LC_ALL=C sort |
				while IFS= read -r path; do
					printf '%s %s\n' "$path" "$(git hash-object "$path")"
				done
		} | git hash-object --stdin
	)
}

ensure_image() {
	base_image=$1
	cache_key=$(image_cache_key "$base_image")
	image="codex-sandbox:$cache_key"
	if docker image inspect "$image" >/dev/null 2>&1; then
		printf '%s\n' "$image"
		return
	fi

	printf 'Building docker image %s ...' "$image" >&2
	build_image --tag "$image" --build-arg "BASE_IMAGE=$base_image"
	printf ' done.\n' >&2
}

cleanup_resource() {
	label=$1
	shift
	started=$(date +%s)
	if "$@" >/dev/null 2>&1; then
    elapsed=$(($(date +%s) - started))
    if ! [ 0 = $elapsed ]; then
      printf 'Cleaning up %s: done (%ss).\n' "$label" "$elapsed" >&2
    fi
	else
		finished=$(date +%s)
		printf 'warning: Cleaning up %s failed after %ss.\n' "$label" "$((finished - started))" >&2
	fi
}

cleanup_relay() {
	status=$?
	trap - EXIT HUP INT TERM
	if [ "$CODEX_CONTAINER_CREATED" = true ]; then
		cleanup_resource "Codex container $CODEX_CONTAINER" \
			docker rm --force "$CODEX_CONTAINER"
	fi
	if [ -n "$SANDBOX_PROXY_STATE" ]; then
		python3 "$SANDBOX_PROXY_HELPER" stop --state "$SANDBOX_PROXY_STATE" || true
	fi
	if [ "$RELAY_CONTAINER_CREATED" = true ]; then
		cleanup_resource "relay container $RELAY_CONTAINER" \
			docker rm --force "$RELAY_CONTAINER"
	fi
	if [ "$RELAY_LINK_CREATED" = true ]; then
		cleanup_resource "relay network $RELAY_LINK_NETWORK" \
			docker network rm "$RELAY_LINK_NETWORK"
	fi
	if [ "$RELAY_EGRESS_CREATED" = true ]; then
		cleanup_resource "relay network $RELAY_EGRESS_NETWORK" \
			docker network rm "$RELAY_EGRESS_NETWORK"
	fi
	if [ -n "$SKILLS_TMP" ]; then
		cleanup_resource "staged skills $SKILLS_TMP" rm -rf "$SKILLS_TMP"
	fi
	if [ -n "$SANDBOX_LOCK_RELEASE" ]; then
		: > "$SANDBOX_LOCK_RELEASE"
	fi
	if [ -n "$SANDBOX_LOCK_PID" ]; then
		wait "$SANDBOX_LOCK_PID" || true
	fi
	if [ -n "$SANDBOX_MONITOR_PID" ]; then
		wait "$SANDBOX_MONITOR_PID" || true
	fi
	for temporary in "$SANDBOX_PROXY_STATE" "$SANDBOX_PROXY_ARGS" \
		"$SANDBOX_MANIFEST" "$SANDBOX_LOCK_READY" "$SANDBOX_LOCK_RELEASE"; do
		[ -z "$temporary" ] || rm -f "$temporary"
	done
	exit "$status"
}

validate_repository() {
	repository=$(jj workspace root) || die "The current directory is not in a Jujutsu workspace"
	REPOSITORY=$(cd "$repository" && pwd -P)
	[ -d "$REPOSITORY/.jj" ] && [ ! -L "$REPOSITORY/.jj" ] || \
		die "The Jujutsu workspace root cannot be safely mounted"
	[ -d "$REPOSITORY/.git" ] || die "Git metadata indirection is not supported"
	[ ! -L "$REPOSITORY/.git" ] || die "Symlinked Git metadata is not supported"
	if find "$REPOSITORY/.jj" "$REPOSITORY/.git" -xdev -type f -links +1 -print -quit | grep . >/dev/null; then
		die "Repository metadata contains hard-linked files"
	fi
	SANDBOX_MANIFEST=$(mktemp)
	python3 "$SANDBOX_PROXY_HELPER" snapshot \
		--repo "$REPOSITORY" --output "$SANDBOX_MANIFEST" \
		--jj-image-command "$DOTFILES/.agents/sandbox/jj-proxy-image"
}

acquire_sandbox_lock() {
	SANDBOX_LOCK_READY=$(mktemp)
	SANDBOX_LOCK_RELEASE=$(mktemp)
	rm -f "$SANDBOX_LOCK_READY" "$SANDBOX_LOCK_RELEASE"
	python3 "$SANDBOX_PROXY_HELPER" hold-lock \
		--repo "$REPOSITORY" --ready "$SANDBOX_LOCK_READY" \
		--release "$SANDBOX_LOCK_RELEASE" --parent-pid "$$" &
	SANDBOX_LOCK_PID=$!
	attempt=0
	while [ "$attempt" -lt 100 ]; do
		[ -e "$SANDBOX_LOCK_READY" ] && return
		if ! kill -0 "$SANDBOX_LOCK_PID" 2>/dev/null; then
			wait "$SANDBOX_LOCK_PID" || true
			die "Could not acquire the sandbox repository lock"
		fi
		attempt=$((attempt + 1))
		sleep 0.05
	done
	die "Timed out acquiring the sandbox repository lock"
}

start_agent_podman_relay() {
	docker network create \
		--internal \
		--opt isolate=true \
		"$RELAY_LINK_NETWORK" >/dev/null
	RELAY_LINK_CREATED=true

	docker network create \
		--opt isolate=true \
		"$RELAY_EGRESS_NETWORK" >/dev/null
	RELAY_EGRESS_CREATED=true

	# The relay has no key or host mounts. It can only carry bytes between its
	# private link and the single validated SSH port on the macOS host gateway.
	docker run --detach \
		--name "$RELAY_CONTAINER" \
		--cap-drop=ALL \
		--security-opt=no-new-privileges \
		--read-only \
		--network "$RELAY_EGRESS_NETWORK" \
		--http-proxy=false \
		--entrypoint /usr/bin/socat \
		"$HASH" \
		-d -d \
		"TCP4-LISTEN:$AGENT_PODMAN_RELAY_PORT,fork,reuseaddr" \
		"TCP4:host.docker.internal:$AGENT_PODMAN_SSH_PORT" >/dev/null
	RELAY_CONTAINER_CREATED=true

	docker network connect "$RELAY_LINK_NETWORK" "$RELAY_CONTAINER"
	RELAY_IP=$(docker inspect \
		--format "{{(index .NetworkSettings.Networks \"$RELAY_LINK_NETWORK\").IPAddress}}" \
		"$RELAY_CONTAINER")
	[ -n "$RELAY_IP" ] || die "Agent Podman relay has no link address"

	AGENT_PODMAN_CONTAINER_HOST="ssh://$AGENT_PODMAN_SSH_USER@$RELAY_IP:$AGENT_PODMAN_RELAY_PORT/$AGENT_PODMAN_SOCKET_PATH"
	printf 'Agent Podman relay ready at %s:%s.\n' "$RELAY_IP" "$AGENT_PODMAN_RELAY_PORT"
}

trap cleanup_relay EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

validate_repository
BASE_IMAGE_BUILDER="$REPOSITORY/.agents/sandbox/base-image"
if [ -x "$BASE_IMAGE_BUILDER" ]; then
	BASE_IMAGE=$(cd "$REPOSITORY" && ./.agents/sandbox/base-image)
else
	BASE_IMAGE=node:slim
fi
HASH=$(ensure_image "$BASE_IMAGE")

ensure_network

acquire_sandbox_lock

SANDBOX_PROXY_STATE=$(mktemp)
python3 "$SANDBOX_PROXY_HELPER" start \
	--repo "$REPOSITORY" --prefix "$SANDBOX_PROXY_PREFIX" \
	--state "$SANDBOX_PROXY_STATE" --helper-image "$HASH" \
	--network "$SANDBOX_NETWORK" --manifest "$SANDBOX_MANIFEST"
python3 "$SANDBOX_PROXY_HELPER" publish --repo "$REPOSITORY" --state "$SANDBOX_PROXY_STATE"

if [ "$AGENT_PODMAN_ENABLED" = true ]; then
	start_agent_podman_relay
fi

set -- "$HASH" --dangerously-bypass-approvals-and-sandbox "$@"
if [ "$AGENT_PODMAN_ENABLED" = true ]; then
	set -- \
		--network "$RELAY_LINK_NETWORK" \
		--env "CONTAINER_HOST=$AGENT_PODMAN_CONTAINER_HOST" \
		--env "CONTAINER_SSHKEY=$CONTAINER_SSHKEY" \
		--env "AGENT_PODMAN_KNOWN_HOSTS=$AGENT_PODMAN_CONTAINER_KNOWN_HOSTS" \
		--mount "type=bind,src=$AGENT_PODMAN_KEY,dst=$CONTAINER_SSHKEY,readonly" \
		--mount "type=bind,src=$AGENT_PODMAN_KNOWN_HOSTS,dst=$AGENT_PODMAN_CONTAINER_KNOWN_HOSTS,readonly" \
		"$@"
fi

if [ "$(uname -s)" = Linux ]; then
	printf '%s\n' \
		'warning: native Linux sandboxing disables sudo elevation with cap-drop=ALL and no-new-privileges.' \
		'warning: a Podman Machine micro-VM would allow container sudo without weakening host isolation.' >&2
	set -- \
		--cap-drop=ALL \
		--security-opt=no-new-privileges \
		"$@"
fi

# some skills might be symlinks. copy them explicitly so they don't leave a dangling path.
SKILLS_TMP=$(mktemp -d)
rsync -aL ~/.agents/skills/ "$SKILLS_TMP/"

SANDBOX_PROXY_ARGS=$(mktemp)
python3 "$SANDBOX_PROXY_HELPER" agent-args \
	--repo "$REPOSITORY" --prefix "$SANDBOX_PROXY_PREFIX" \
	--output "$SANDBOX_PROXY_ARGS" --manifest "$SANDBOX_MANIFEST"
while IFS= read -r proxy_arg; do
	set -- "$proxy_arg" "$@"
done < "$SANDBOX_PROXY_ARGS"

CODEX_CONTAINER_CREATED=true
python3 "$SANDBOX_PROXY_HELPER" monitor \
	--state "$SANDBOX_PROXY_STATE" --agent "$CODEX_CONTAINER" &
SANDBOX_MONITOR_PID=$!
docker run --name "$CODEX_CONTAINER" -it \
  --network "$SANDBOX_NETWORK" \
  --http-proxy=false \
  --secret codex-github-token,type=env,target=GH_TOKEN \
  --env CODEX_SQLITE_HOME=/codex-sqlite \
  --volume "codex-sqlite-$(id -u):/codex-sqlite" \
  --mount "type=bind,src=$SKILLS_TMP,dst=/home/codex/.agents/skills" \
  --volume "$HOME/.codex:$HOME/.codex" \
  --volume "$HOME/.codex/rules:$HOME/.codex/rules:ro" \
  --mount "type=bind,src=$HOME/src,dst=/src,readonly" \
  --mount "type=bind,src=$REPOSITORY,dst=/src/work,bind-nonrecursive=true" \
  --mount "type=bind,src=$REPOSITORY/.git,dst=/src/work/.git,readonly" \
  --mount "type=bind,src=$REPOSITORY/.jj,dst=/src/work/.jj,readonly" \
  "$@"
