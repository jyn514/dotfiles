#!/usr/bin/env python3
"""Launch Codex in the repository sandbox and manage its sibling services."""

from __future__ import annotations

import os
from dataclasses import dataclass
from pathlib import Path
import re
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time


DOTFILES = Path(__file__).resolve().parent.parent
PROXY_HELPER = DOTFILES / "lib" / "sandbox-proxies.py"
SANDBOX_NETWORK = "codex-public-only"
SANDBOX_SUBNET = "10.254.254.0/24"
SANDBOX_GATEWAY = "10.254.254.1"
SANDBOX_IP_RANGE = "10.254.254.128/25"
PROHIBITED_ROUTES = (
    "0.0.0.0/8", "10.0.0.0/8", "100.64.0.0/10", "127.0.0.0/8",
    "169.254.0.0/16", "172.16.0.0/12", "192.0.0.0/24",
    "192.168.0.0/16", "198.18.0.0/15", "224.0.0.0/4", "240.0.0.0/4",
)


class LauncherError(Exception):
    pass


class SignalExit(Exception):
    def __init__(self, signum: int) -> None:
        self.signum = signum
        super().__init__(f"received signal {signum}")


@dataclass
class State:
    codex_arguments: list[str]
    home: Path
    term: str
    uid: int
    gid: int
    suffix: str
    relay_link_network: str
    relay_egress_network: str
    relay_container: str
    codex_container: str
    proxy_prefix: str
    agent_podman_access: Path
    agent_podman_connection: Path
    agent_podman_key: Path
    agent_podman_known_hosts: Path
    container_known_hosts: str = "/run/secrets/agent-podman-known-hosts"
    relay_port: int = 2222
    agent_podman: dict[str, str] | None = None
    repository: Path | None = None
    image: str = ""
    manifest: Path | None = None
    proxy_state: Path | None = None
    proxy_args: Path | None = None
    lock_ready: Path | None = None
    lock_coordinated: Path | None = None
    lock_release: Path | None = None
    skills_tmp: Path | None = None
    lock_process: subprocess.Popen[bytes] | None = None
    monitor_process: subprocess.Popen[bytes] | None = None
    agent_process: subprocess.Popen[bytes] | None = None
    codex_container_created: bool = False
    relay_link_created: bool = False
    relay_egress_created: bool = False
    relay_container_created: bool = False
    cleaned: bool = False


def run(
    arguments: list[str], *, check: bool = True, capture: bool = False,
    cwd: Path | None = None, quiet: bool = False, discard_stdout: bool = False,
    stdout_to_stderr: bool = False, input_text: str | None = None,
) -> subprocess.CompletedProcess[str]:
    stdout = None
    if capture:
        stdout = subprocess.PIPE
    elif quiet or discard_stdout:
        stdout = subprocess.DEVNULL
    elif stdout_to_stderr:
        stdout = sys.stderr
    result = subprocess.run(
        arguments, cwd=cwd, check=False, text=True, input=input_text,
        stdout=stdout,
        stderr=subprocess.DEVNULL if quiet else None,
    )
    if check and result.returncode:
        raise subprocess.CalledProcessError(result.returncode, arguments)
    return result


def helper(*arguments: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return run(["python3", str(PROXY_HELPER), *arguments], check=check)


def temporary_file() -> Path:
    descriptor, name = tempfile.mkstemp()
    os.close(descriptor)
    return Path(name)


def parse_connection(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        if not separator or not re.fullmatch(r"[A-Z][A-Z0-9_]*", key):
            raise LauncherError(f"invalid Agent Podman connection setting: {line!r}")
        values[key] = value
    required = {
        "AGENT_PODMAN_SSH_USER", "AGENT_PODMAN_SSH_PORT",
        "CONTAINER_HOST", "CONTAINER_SSHKEY",
    }
    if not required <= values.keys():
        raise LauncherError("Agent Podman connection settings are incomplete")
    return values


def new_state(codex_arguments: list[str]) -> State:
    home = Path(os.environ["HOME"])
    uid = os.getuid()
    suffix = f"{uid}-{os.getpid()}"
    access = Path(os.environ.get("AGENT_PODMAN_ACCESS_DIR", home / ".agent-podman-access"))
    state = State(
        codex_arguments=codex_arguments,
        home=home,
        term=os.environ.get("TERM", "xterm-256color"),
        uid=uid,
        gid=os.getgid(),
        suffix=suffix,
        relay_link_network=f"codex-agent-podman-link-{suffix}",
        relay_egress_network=f"codex-agent-podman-egress-{suffix}",
        relay_container=f"codex-agent-podman-relay-{suffix}",
        codex_container=f"codex-sandbox-{suffix}",
        proxy_prefix=f"codex-command-proxy-{suffix}",
        agent_podman_access=access,
        agent_podman_connection=access / "connection.env",
        agent_podman_key=access / "id_ed25519",
        agent_podman_known_hosts=access / "known_hosts.sandbox",
    )
    load_agent_podman(state)
    return state


def load_agent_podman(state: State) -> None:
    paths = (
        state.agent_podman_connection, state.agent_podman_key,
        state.agent_podman_known_hosts,
    )
    if not any(path.exists() for path in paths):
        return
    if not all(path.is_file() for path in paths):
        raise LauncherError(f"Agent Podman access state is incomplete: {state.agent_podman_access}")
    values = parse_connection(state.agent_podman_connection)
    prefix = (
        f"ssh://{values['AGENT_PODMAN_SSH_USER']}@host.docker.internal:"
        f"{values['AGENT_PODMAN_SSH_PORT']}/"
    )
    host = values["CONTAINER_HOST"]
    if not host.startswith(prefix):
        raise LauncherError("Agent Podman connection does not use the expected host endpoint")
    values["SOCKET_PATH"] = host.removeprefix(prefix)
    state.agent_podman = values


def validate_repository(state: State) -> None:
    try:
        result = run(["jj", "workspace", "root"], capture=True)
    except subprocess.CalledProcessError as error:
        raise LauncherError("The current directory is not in a Jujutsu workspace") from error
    repository = Path(result.stdout.strip()).resolve(strict=True)
    jj = repository / ".jj"
    git = repository / ".git"
    if not jj.is_dir() or jj.is_symlink():
        raise LauncherError("The Jujutsu workspace root cannot be safely mounted")
    if not (git.is_dir() or git.is_file()):
        raise LauncherError("Git metadata is missing or invalid")
    if git.is_symlink():
        raise LauncherError("Symlinked Git metadata is not supported")
    if git.is_file() and git.lstat().st_nlink != 1:
        raise LauncherError("Git metadata entry must not be hard linked")
    try:
        result = run([
            "git", "-C", str(repository), "rev-parse", "--path-format=absolute",
            "--git-dir", "--git-common-dir",
        ], capture=True)
        lines = result.stdout.splitlines()
        if len(lines) != 2:
            raise LauncherError("Git returned an invalid metadata layout")
        git_roots = [Path(line).resolve(strict=True) for line in lines]
    except (subprocess.CalledProcessError, FileNotFoundError) as error:
        raise LauncherError("Git metadata indirection cannot be resolved safely") from error
    try:
        jj_repo_entry = jj / "repo"
        if jj_repo_entry.is_file() and not jj_repo_entry.is_symlink():
            if jj_repo_entry.lstat().st_nlink != 1:
                raise LauncherError("Jujutsu repository pointer must not be hard linked")
            value = jj_repo_entry.read_text(encoding="utf-8").strip()
            if not value or "\0" in value or "\n" in value or "\r" in value:
                raise LauncherError("Jujutsu repository pointer is invalid")
            target = Path(value)
            if not target.is_absolute():
                target = jj_repo_entry.parent / target
            jj_repo = target.resolve(strict=True)
        else:
            jj_repo = jj_repo_entry.resolve(strict=True)
    except (FileNotFoundError, UnicodeError) as error:
        raise LauncherError("Jujutsu repository metadata cannot be resolved safely") from error
    for root in (jj, jj_repo, *git_roots):
        if not root.is_dir() or root.is_symlink():
            raise LauncherError(f"Repository metadata directory is invalid: {root}")
    state.repository = repository
    state.manifest = temporary_file()
    helper(
        "snapshot", "--repo", str(repository), "--output", str(state.manifest),
        "--jj-image-command", str(DOTFILES / ".agents/sandbox/jj-proxy-image"),
    )


def image_sources() -> list[Path]:
    dockerfile = Path("lib/agent-sandbox/Dockerfile")
    sources = [dockerfile]
    for line in (DOTFILES / dockerfile).read_text(encoding="utf-8").splitlines():
        fields = line.split()
        if not fields or fields[0] != "COPY" or any(field.startswith("--from=") for field in fields[1:-1]):
            continue
        sources.extend(Path(field) for field in fields[1:-1] if not field.startswith(("--", "<<")))
    files: list[Path] = []
    for source in sources:
        absolute = DOTFILES / source
        if absolute.is_dir():
            files.extend(
                path.relative_to(DOTFILES) for path in absolute.rglob("*")
                if stat.S_ISREG(path.lstat().st_mode)
            )
        elif absolute.is_file():
            files.append(source)
    return sorted(set(files), key=lambda path: os.fsencode(path.as_posix()))


def image_cache_key(state: State, base_image: str) -> str:
    lines = [
        f"BASE_IMAGE={base_image}", f"AGENT_UID={state.uid}", f"AGENT_GID={state.gid}",
        f"CODEX_HOME={state.home / '.codex'}", f"TERM={state.term}",
    ]
    for path in image_sources():
        digest = run(["git", "hash-object", str(path)], capture=True, cwd=DOTFILES).stdout.strip()
        lines.append(f"{path.as_posix()} {digest}")
    return run(
        ["git", "hash-object", "--stdin"], capture=True, cwd=DOTFILES,
        input_text="\n".join(lines) + "\n",
    ).stdout.strip()


def ensure_image(state: State, base_image: str) -> str:
    image = f"codex-sandbox:{image_cache_key(state, base_image)}"
    if run(["docker", "image", "inspect", image], check=False, quiet=True).returncode == 0:
        return image
    print(f"Building docker image {image} ...", end="", file=sys.stderr, flush=True)
    iidfile = temporary_file()
    try:
        run([
            "docker", "build", "-f", "lib/agent-sandbox/Dockerfile",
            "--build-arg", f"AGENT_UID={state.uid}",
            "--build-arg", f"AGENT_GID={state.gid}",
            "--build-arg", f"CODEX_HOME={state.home / '.codex'}",
            "--build-arg", f"TERM={state.term}", "--iidfile", str(iidfile),
            "--tag", image, "--build-arg", f"BASE_IMAGE={base_image}", ".",
        ], cwd=DOTFILES, stdout_to_stderr=True)
        built = iidfile.read_text(encoding="utf-8").strip()
        if not built:
            raise LauncherError("Docker did not report the built sandbox image ID")
    finally:
        iidfile.unlink(missing_ok=True)
    print(" done.", file=sys.stderr)
    return built


def ensure_network() -> None:
    if run(["docker", "network", "exists", SANDBOX_NETWORK], check=False, quiet=True).returncode == 0:
        return
    print("Creating sandbox network ...", end="", flush=True)
    arguments = [
        "docker", "network", "create", "--ignore", "--subnet", SANDBOX_SUBNET,
        "--gateway", SANDBOX_GATEWAY, "--ip-range", SANDBOX_IP_RANGE,
        "--opt", "isolate=true",
    ]
    for route in PROHIBITED_ROUTES:
        arguments += ["--route", f"{route},prohibit"]
    arguments.append(SANDBOX_NETWORK)
    if run(arguments, check=False, discard_stdout=True).returncode:
        raise LauncherError("Could not create the sandbox network")
    print(" done.")


def acquire_lock(state: State) -> None:
    state.proxy_state = temporary_file()
    state.lock_ready = temporary_file()
    state.lock_coordinated = temporary_file()
    state.lock_release = temporary_file()
    state.lock_ready.unlink()
    state.lock_coordinated.unlink()
    state.lock_release.unlink()
    state.lock_process = subprocess.Popen([
        "python3", str(PROXY_HELPER), "hold-lock", "--repo", str(state.repository),
        "--ready", str(state.lock_ready), "--coordinated", str(state.lock_coordinated),
        "--release", str(state.lock_release), "--parent-pid", str(os.getpid()),
    ])
    while True:
        if state.lock_ready.exists():
            return
        if state.lock_process.poll() is not None:
            raise LauncherError("Could not join the sandbox proxy session")
        time.sleep(0.05)


def attach_proxies(state: State) -> None:
    try:
        helper(
            "attach", "--repo", str(state.repository), "--prefix", state.proxy_prefix,
            "--session", str(state.lock_ready),
            "--state", str(state.proxy_state), "--helper-image", state.image,
            "--network", SANDBOX_NETWORK, "--manifest", str(state.manifest),
        )
    finally:
        state.lock_coordinated.touch()


def start_relay(state: State) -> list[str]:
    values = state.agent_podman
    run(["docker", "network", "create", "--internal", "--opt", "isolate=true", state.relay_link_network], discard_stdout=True)
    state.relay_link_created = True
    run(["docker", "network", "create", "--opt", "isolate=true", state.relay_egress_network], discard_stdout=True)
    state.relay_egress_created = True
    run([
        "docker", "run", "--detach", "--name", state.relay_container,
        "--cap-drop=ALL", "--security-opt=no-new-privileges", "--read-only",
        "--network", state.relay_egress_network, "--http-proxy=false",
        "--entrypoint", "/usr/bin/socat", state.image, "-d", "-d",
        f"TCP4-LISTEN:{state.relay_port},fork,reuseaddr",
        f"TCP4:host.docker.internal:{values['AGENT_PODMAN_SSH_PORT']}",
    ], discard_stdout=True)
    state.relay_container_created = True
    run(["docker", "network", "connect", state.relay_link_network, state.relay_container])
    relay_ip = run([
        "docker", "inspect", "--format",
        f'{{{{(index .NetworkSettings.Networks "{state.relay_link_network}").IPAddress}}}}',
        state.relay_container,
    ], capture=True).stdout.strip()
    if not relay_ip:
        raise LauncherError("Agent Podman relay has no link address")
    container_host = (
        f"ssh://{values['AGENT_PODMAN_SSH_USER']}@{relay_ip}:"
        f"{state.relay_port}/{values['SOCKET_PATH']}"
    )
    print(f"Agent Podman relay ready at {relay_ip}:{state.relay_port}.")
    return [
        "--network", state.relay_link_network,
        "--env", f"CONTAINER_HOST={container_host}",
        "--env", f"CONTAINER_SSHKEY={values['CONTAINER_SSHKEY']}",
        "--env", f"AGENT_PODMAN_KNOWN_HOSTS={state.container_known_hosts}",
        "--mount", f"type=bind,src={state.agent_podman_key},dst={values['CONTAINER_SSHKEY']},readonly",
        "--mount", f"type=bind,src={state.agent_podman_known_hosts},dst={state.container_known_hosts},readonly",
    ]


def stage_skills(state: State) -> None:
    state.skills_tmp = Path(tempfile.mkdtemp())
    run(["rsync", "-aL", str(state.home / ".agents/skills") + "/", str(state.skills_tmp) + "/"])


def read_proxy_arguments(state: State) -> list[str]:
    state.proxy_args = temporary_file()
    helper(
        "agent-args", "--repo", str(state.repository), "--state", str(state.proxy_state),
        "--output", str(state.proxy_args), "--manifest", str(state.manifest),
    )
    arguments: list[str] = []
    for line in state.proxy_args.read_text(encoding="utf-8").splitlines():
        arguments.insert(0, line)
    return arguments


def run_agent(state: State, arguments: list[str]) -> int:
    state.codex_container_created = True
    state.monitor_process = subprocess.Popen([
        "python3", str(PROXY_HELPER), "monitor", "--state", str(state.proxy_state),
        "--agent", state.codex_container,
    ])
    git_layout = run([
        "git", "-C", str(state.repository), "rev-parse", "--path-format=absolute",
        "--git-dir", "--git-common-dir",
    ], capture=True).stdout.splitlines()
    protected = [state.repository / ".git", state.repository / ".jj"]
    for line in git_layout:
        path = Path(line).resolve(strict=True)
        try:
            path.relative_to(state.repository)
        except ValueError:
            continue
        if path not in protected:
            protected.append(path)
    command = [
        "docker", "run", "--name", state.codex_container, "-it",
        "--network", SANDBOX_NETWORK, "--http-proxy=false",
        "--secret", "codex-github-token,type=env,target=GH_TOKEN",
        "--env", "CODEX_SQLITE_HOME=/codex-sqlite",
        "--volume", f"codex-sqlite-{state.uid}:/codex-sqlite",
        "--mount", f"type=bind,src={state.skills_tmp},dst=/home/codex/.agents/skills",
        "--volume", f"{state.home / '.codex'}:{state.home / '.codex'}",
        "--volume", f"{state.home / '.codex/rules'}:{state.home / '.codex/rules'}:ro",
        "--mount", f"type=bind,src={state.home / 'src'},dst=/src,readonly",
        "--mount", f"type=bind,src={state.repository},dst=/src/work,bind-nonrecursive=true",
        *[
            item
            for path in protected
            for item in (
                "--mount",
                f"type=bind,src={path},dst={Path('/src/work') / path.relative_to(state.repository)},readonly",
            )
        ],
        *arguments,
    ]
    state.agent_process = subprocess.Popen(command)
    try:
        return state.agent_process.wait()
    except SignalExit as error:
        if state.agent_process.poll() is None:
            state.agent_process.send_signal(error.signum)
            try:
                state.agent_process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                state.agent_process.kill()
                state.agent_process.wait()
        raise


def execute(state: State) -> int:
    validate_repository(state)
    builder = state.repository / ".agents/sandbox/base-image"
    if builder.is_file() and os.access(builder, os.X_OK):
        base_image = run([str(builder)], capture=True, cwd=state.repository).stdout.strip()
    else:
        base_image = "node:slim"
    state.image = ensure_image(state, base_image)
    ensure_network()
    acquire_lock(state)
    attach_proxies(state)
    arguments = [state.image, "--dangerously-bypass-approvals-and-sandbox", *state.codex_arguments]
    if state.agent_podman is not None:
        arguments = [*start_relay(state), *arguments]
    system = run(["uname", "-s"], capture=True).stdout.strip()
    if system == "Linux":
        print(
            "warning: native Linux sandboxing disables sudo elevation with cap-drop=ALL and no-new-privileges.\n"
            "warning: a Podman Machine micro-VM would allow container sudo without weakening host isolation.",
            file=sys.stderr,
        )
        arguments = ["--cap-drop=ALL", "--security-opt=no-new-privileges", *arguments]
    stage_skills(state)
    arguments = [*read_proxy_arguments(state), *arguments]
    return run_agent(state, arguments)


def cleanup_resource(label: str, arguments: list[str]) -> None:
    started = time.monotonic()
    try:
        result = run(arguments, check=False, quiet=True)
    except OSError:
        result = None
    elapsed = int(time.monotonic() - started)
    if result is None or result.returncode:
        print(f"warning: Cleaning up {label} failed after {elapsed}s.", file=sys.stderr)
    elif elapsed:
        print(f"Cleaning up {label}: done ({elapsed}s).", file=sys.stderr)


def cleanup(state: State) -> None:
    if state.cleaned:
        return
    state.cleaned = True
    if state.codex_container_created:
        cleanup_resource(
            f"Codex container {state.codex_container}",
            ["docker", "rm", "--force", state.codex_container],
        )
    if state.relay_container_created:
        cleanup_resource(
            f"relay container {state.relay_container}",
            ["docker", "rm", "--force", state.relay_container],
        )
    if state.relay_link_created:
        cleanup_resource(
            f"relay network {state.relay_link_network}",
            ["docker", "network", "rm", state.relay_link_network],
        )
    if state.relay_egress_created:
        cleanup_resource(
            f"relay network {state.relay_egress_network}",
            ["docker", "network", "rm", state.relay_egress_network],
        )
    if state.skills_tmp is not None:
        started = time.monotonic()
        try:
            shutil.rmtree(state.skills_tmp)
        except OSError:
            elapsed = int(time.monotonic() - started)
            print(f"warning: Cleaning up staged skills {state.skills_tmp} failed after {elapsed}s.", file=sys.stderr)
    if state.lock_coordinated is not None:
        state.lock_coordinated.touch()
    if state.lock_release is not None:
        state.lock_release.touch()
    if state.lock_process is not None:
        state.lock_process.wait()
    if state.monitor_process is not None:
        state.monitor_process.wait()
    for path in (
        state.proxy_state, state.proxy_args, state.manifest,
        state.lock_ready, state.lock_coordinated, state.lock_release,
    ):
        if path is not None:
            path.unlink(missing_ok=True)


def main(arguments: list[str]) -> int:
    state: State | None = None
    previous_handlers: dict[int, object] = {}

    def handle_signal(signum: int, _frame: object) -> None:
        raise SignalExit(signum)

    try:
        state = new_state(arguments)
        for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
            previous_handlers[signum] = signal.signal(signum, handle_signal)
        return execute(state)
    except SignalExit as error:
        return 128 + error.signum
    except LauncherError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as error:
        return error.returncode
    except OSError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    finally:
        for signum in previous_handlers:
            signal.signal(signum, signal.SIG_IGN)
        if state is not None:
            cleanup(state)
        for signum, handler in previous_handlers.items():
            signal.signal(signum, handler)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
