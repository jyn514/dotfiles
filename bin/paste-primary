#!/bin/sh

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/paste-primary.XXXXXX") || exit
primary=$tmp_dir/primary
clipboard=$tmp_dir/clipboard
cleanup() { rm -rf "$tmp_dir"; }
trap cleanup 0
trap 'exit 1' 1 2 15

if paste --primary > "$primary" && [ -s "$primary" ]; then
	# hack: pasting from primary works horribly in firefox
	paste > "$clipboard" || exit
	copy < "$primary"
	if command -v ydotool >/dev/null; then
		# see /usr/include/linux/input-event-codes.h
		ydotool key 135:1 135:0
	else
		xdotool key --window "$(xdotool getactivewindow)" XF86Paste
	fi
	sleep .1  # give firefox time to handle the event
	copy < "$clipboard"
fi 2>&1 | logger -t paste-primary
