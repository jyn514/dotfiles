#!/bin/sh

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/paste-primary.XXXXXX") || exit
primary=$tmp_dir/primary
clipboard=$tmp_dir/clipboard
log=$tmp_dir/log
swapped=false
# Called by cleanup through the EXIT trap.
# shellcheck disable=SC2329
restore_clipboard() {
	if $swapped; then
		copy < "$clipboard"
		swapped=false
	fi
}
# Called by the EXIT trap.
# shellcheck disable=SC2329
cleanup() {
	restore_clipboard
	rm -rf "$tmp_dir"
}
trap cleanup 0
trap 'exit 1' 1 2 15

paste_primary() {
	paste --primary > "$primary" || return
	[ -s "$primary" ] || return 0

	# hack: pasting from primary works horribly in firefox
	paste > "$clipboard" || return
	copy < "$primary" || return
	swapped=true
	result=0
	if command -v ydotool >/dev/null; then
		# see /usr/include/linux/input-event-codes.h
		ydotool key 135:1 135:0 || result=$?
	else
		if window=$(xdotool getactivewindow); then
			xdotool key --window "$window" XF86Paste || result=$?
		else
			result=$?
		fi
	fi
	sleep .1  # give firefox time to handle the event
	copy < "$clipboard" || return
	swapped=false
	return "$result"
}

paste_primary > "$log" 2>&1
result=$?
logger -t paste-primary < "$log"
exit "$result"
