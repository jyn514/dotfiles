#!/usr/bin/env python3
"""Print the SSID of the first active NetworkManager Wi-Fi connection."""

from __future__ import annotations

from dataclasses import dataclass
import os
import re
import shlex
import subprocess
import sys
from typing import BinaryIO
from typing import Callable


NMCLI_ARGUMENTS = [
    "nmcli",
    "--terse",
    "--escape",
    "yes",
    "--fields",
    "in-use,ssid",
    "device",
    "wifi",
]


@dataclass(frozen=True)
class Result:
    status: int
    stdout: bytes = b""


def exit_status(returncode: int) -> int:
    return returncode if returncode >= 0 else 128 - returncode


def run(arguments: list[str]) -> Result:
    if os.environ.get("V") == "1":
        print("+ " + shlex.join(arguments), file=sys.stderr)
    try:
        completed = subprocess.run(
            arguments,
            stdout=subprocess.PIPE,
            check=False,
        )
    except OSError as error:
        print(f"ssid: could not execute {arguments[0]!r}: {error}", file=sys.stderr)
        return Result(127 if isinstance(error, FileNotFoundError) else 126)
    return Result(exit_status(completed.returncode), completed.stdout)


def active_ssid(records: bytes) -> bytes | None:
    """Select the first active SSID, rejecting malformed escaped nmcli output."""
    if not records or not records.endswith(b"\n"):
        return None
    # IN-USE is literal '*' or ' '. With --escape yes, every payload colon
    # is quoted, so only real row headers can follow a newline with '*:'/' :'.
    # Remove just the last row terminator; payload newlines must survive.
    fields = re.split(rb"(?:\A|\n)([ *]):", records[:-1])
    if fields[0] or len(fields) == 1:
        return None
    selected = None
    for index in range(1, len(fields), 2):
        marker, payload = fields[index : index + 2]
        # Native string values have no NULs, bare colons, or other escapes.
        # Validate every row before returning, including rows after selection.
        if re.fullmatch(rb"(?:[^:\\\x00]|\\[:\\])*", payload) is None:
            return None
        if marker == b"*" and selected is None:
            selected = re.sub(rb"\\([:\\])", rb"\1", payload)
    return selected


def show_ssid(
    runner: Callable[[list[str]], Result] = run,
    output: BinaryIO | None = None,
) -> int:
    networks = runner(NMCLI_ARGUMENTS)
    if networks.status:
        return networks.status
    ssid = active_ssid(networks.stdout)
    if ssid is None:
        return 0
    destination = output if output is not None else sys.stdout.buffer
    try:
        remaining = memoryview(ssid + b"\n")
        while remaining:
            written = destination.write(remaining)
            if written is None or written == 0:
                raise OSError("short write")
            remaining = remaining[written:]
        destination.flush()
    except OSError as error:
        print(f"ssid: could not write active network: {error}", file=sys.stderr)
        return 1
    return 0


def main(_arguments: list[str]) -> int:
    return show_ssid()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
