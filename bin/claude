#!/bin/sh
# Wrapper: launch Claude Code with the generated standalone system prompt, and
# put this dir on PATH so the agent's shells and tooling resolve the jj/paste
# shims (bare `jj` then hits the author shim, no need to call it by path).
DOTFILES=$(realpath "$(dirname -- "$(realpath -- "$0")")/..")
. "$DOTFILES/lib/shell/lib.sh"
shim_resolve "$0" claude

prompt=$("$DOTFILES/libexec/gen-claude-system-prompt") || fail "claude wrapper: gen-system-prompt failed"
base_settings=$HOME/.config/claude/settings.json
if ! [ -e "$base_settings" ]; then
	base_settings=$DOTFILES/config/claude.json
fi
legacy_settings=$HOME/.claude/settings.json
if [ -L "$legacy_settings" ] && [ "$legacy_settings" -ef "$base_settings" ]; then
	rm "$legacy_settings"
fi

settings_directory=${XDG_CACHE_HOME:-$HOME/.cache}/claude
settings=$settings_directory/generated-settings.json
mkdir -p "$settings_directory" || fail "claude wrapper: cannot create settings cache"
temporary_settings=$(mktemp "$settings_directory/generated-settings.XXXXXX") || \
	fail "claude wrapper: cannot create temporary settings"
trap 'rm -f "$temporary_settings"' EXIT HUP INT TERM
if ! bb --config /dev/null "$DOTFILES/tools/agent-permissions/render.clj" \
	claude "$DOTFILES/tools/agent-permissions/current-policy.clj" \
	"$base_settings" > "$temporary_settings"; then
	fail "claude wrapper: cannot generate settings"
fi
chmod 600 "$temporary_settings" || fail "claude wrapper: cannot secure generated settings"
mv "$temporary_settings" "$settings" || fail "claude wrapper: cannot publish generated settings"
trap - EXIT HUP INT TERM

export PATH="$DOTFILES/libexec/agent-wrappers:$PATH"
exec "$REAL" --settings "$settings" --setting-sources project,local \
	--system-prompt "$prompt" "$@"
