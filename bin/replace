#!/bin/sh
# Replaces $1 with $2 for all files in current directory

if [ $# -ne 2 ]; then
	echo "usage: $(basename "$0") <current> <replace-with>"
	exit 1
elif [ -z "$1" ]; then
	echo "replace: search text must not be empty" >&2
	exit 1
else
	REPLACE_FROM=$1 REPLACE_TO=$2
	export REPLACE_FROM REPLACE_TO
	find . -type f -exec perl -pi -e \
		's/\Q$ENV{REPLACE_FROM}\E/$ENV{REPLACE_TO}/g' {} +
fi
