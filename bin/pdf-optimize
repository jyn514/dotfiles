#!/usr/bin/env python3
"""Stable launcher for quality-preserving PDF optimization.

Usage: pdf-optimize input.pdf [output.pdf]

The default output is ``input.pdf-optimized.pdf``. Existing destinations are
never overwritten.
"""

from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "tools" / "pdf-optimize"))

from pdf_optimize.main import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
