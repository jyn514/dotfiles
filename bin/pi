#!/bin/sh
# Wrapper: launch Pi with the agent command shims available to its shells.
DOTFILES=$(realpath "$(dirname -- "$(realpath -- "$0")")/..")
PACKAGE_ROOT=${XDG_CACHE_HOME:-"$HOME/.cache"}/dotfiles/pi-npm
LOCK_HASH=$(git -C "$DOTFILES" hash-object "$DOTFILES/tools/pi-npm/package-lock.json") || exit
INSTALL_ROOT=$PACKAGE_ROOT/$LOCK_HASH
if ! [ -f "$INSTALL_ROOT/node_modules/pi-mcp-adapter/index.ts" ]; then
	mkdir -p "$PACKAGE_ROOT" || exit
	LOCK_DIR=$INSTALL_ROOT.lock
	if mkdir "$LOCK_DIR" 2>/dev/null; then
		TEMP_ROOT=$(mktemp -d "$PACKAGE_ROOT/.install.XXXXXX") || exit
		trap 'rm -rf "$TEMP_ROOT" "$LOCK_DIR"' EXIT HUP INT TERM
		cp "$DOTFILES/tools/pi-npm/package.json" "$DOTFILES/tools/pi-npm/package-lock.json" "$TEMP_ROOT/" || exit
		npm ci --ignore-scripts --prefix "$TEMP_ROOT" || exit
		mv "$TEMP_ROOT" "$INSTALL_ROOT" || exit
		rmdir "$LOCK_DIR" || exit
		trap - EXIT HUP INT TERM
	else
		attempt=0
		while ! [ -f "$INSTALL_ROOT/node_modules/pi-mcp-adapter/index.ts" ]; do
			attempt=$((attempt + 1))
			if [ "$attempt" -ge 30 ]; then
				echo "pi wrapper: timed out waiting for the locked package install" >&2
				exit 1
			fi
			sleep 1
		done
	fi
fi
export JJ_AGENT=pi
export PATH="$DOTFILES/libexec/agent-wrappers:$PATH"
case ${1:-} in
	auth|config|install|list|remove|uninstall|update)
		exec "$INSTALL_ROOT/node_modules/.bin/pi" "$@"
		;;
esac
exec "$INSTALL_ROOT/node_modules/.bin/pi" \
	--extension "$INSTALL_ROOT/node_modules/pi-mcp-adapter/index.ts" \
	--skill "$INSTALL_ROOT/node_modules/pi-mcp-adapter/skills" \
	"$@"
