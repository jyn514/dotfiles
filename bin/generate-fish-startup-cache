#!/usr/bin/env python3
"""Generate cached Fish startup configuration."""

import re
import subprocess
import sys


def fish_literal(value: str) -> str:
    return "'" + value.replace("\\", "\\\\").replace("'", "\\'") + "'"


def run(command: list[str]) -> str:
    result = subprocess.run(command, check=False, stdout=subprocess.PIPE)
    if result.returncode:
        raise SystemExit(result.returncode if result.returncode > 0 else 128 - result.returncode)
    return result.stdout.decode("utf-8")


def main(arguments: list[str]) -> int:
    if len(arguments) != 5:
        print(
            "usage: generate-fish-startup-cache BAT GIT ATUIN ZOXIDE DIRENV",
            file=sys.stderr,
        )
        return 2
    bat, git, atuin, zoxide, direnv = arguments
    if bat != "-":
        version = run([bat, "--version"])
        match = re.search(r"\b(\d+)\.(\d+)\.", version)
        if match and int(match.group(1)) == 0 and int(match.group(2)) < 20:
            print("set --global --export BAT_STYLE changes,header")

    if git != "-":
        aliases = run([git, "config", "--get-regexp", r"alias\."])
        for line in aliases.splitlines():
            key, value = line.split(None, 1)
            name = key.removeprefix("alias.")
            if value.startswith("!"):
                print(
                    f"abbr --add --global {fish_literal('g' + name)} -- "
                    f"{fish_literal(value[1:])}"
                )
            else:
                print(
                    "abbr --add --global --command git "
                    f"{fish_literal(name)} -- {fish_literal(value)}"
                )

    for command in (
        [atuin, "init", "fish", "--disable-up-arrow"],
        [zoxide, "init", "fish"],
        [direnv, "hook", "fish"],
    ):
        if command[0] == "-":
            continue
        sys.stdout.write(run(command))
        sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
