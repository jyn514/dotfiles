#!/bin/sh

set -eu

fatal() {
  echo "$@" >&2
  exit 1
}

name=$(basename "$0")

if [ $# = 0 ] || [ $# -gt 2 ]; then
  fatal "usage: $name <<repo> <issue>|<url>>"
fi

if [ $# = 2 ]; then
  url="https://github.com/$1/issues/$2"
  issue=$2
else
  case $1 in 
    github.com/*) url="https://$1";;
    https://github.com/*) url=$1;;
    *) fatal "$name: error: <url> must start with github.com/";;
  esac
  issue_url=${url%%[?#]*}
  issue=${issue_url##*/}
fi

case $issue in
  ''|*[!0-9]*) fatal "$name: error: <issue> must be a number";;
esac
url=${url%%[?#]*}
if ! printf '%s\n' "$url" | grep -Eq '^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[0-9]+$'; then
  fatal "$name: error: URL is not a GitHub issue"
fi

if [ -e "$issue.json" ] || [ -e "$issue.txt" ]; then
  fatal "$name: error: $issue.json/txt already exists"
fi

json_pending=.$issue.json.$$
text_pending=.$issue.txt.$$
cleanup() {
  rm -f "$json_pending" "$text_pending"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

gh issue view -c "$url" --json title,createdAt,number,body,state,comments > "$json_pending" &
json_pid=$!
text_status=0
if [ "$(uname -s)" = Darwin ]; then
  script -q /dev/null gh issue view -c "$url" > "$text_pending" || text_status=$?
else
  script --return --quiet -c "gh issue view -c '$url'" /dev/null > "$text_pending" || text_status=$?
fi
json_status=0
wait "$json_pid" || json_status=$?
[ "$text_status" -eq 0 ] || exit "$text_status"
[ "$json_status" -eq 0 ] || exit "$json_status"
# for some reason \r is counted as a newline unless we anchor it
perl -pi -e 's/^.*\r(.)/$1/' "$text_pending"
mv "$json_pending" "$issue.json"
mv "$text_pending" "$issue.txt"
trap - EXIT HUP INT TERM
less "$issue.txt"
echo "saved $issue.txt and $issue.json"
