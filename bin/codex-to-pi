#!/usr/bin/env python3
"""Convert Codex history into a Pi v3 session JSONL file."""

import argparse
import json
import os
import re
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path
import subprocess
from urllib.request import Request, urlopen


def read_history(session, root, archived, branches=False):
    reader = Path(__file__).resolve().parents[1] / "libexec/chat-history.clj"
    if session.endswith((".json", ".jsonl")) and Path(session).is_file():
        mode = "file"
    else:
        mode = "archived-session" if archived else "session"
    command = ["bb", str(reader), mode, session, str(root)]
    if branches:
        command.append("--branches")
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode:
        raise SystemExit(result.stderr.strip())
    return json.loads(result.stdout)


def read_share(url):
    extractor = Path(__file__).with_name("extract-chat-share")
    request = Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urlopen(request, timeout=30) as response:
        html = response.read().decode("utf-8")
    model_match = re.search(r'\\"default_model_slug\\",\\"([^\\"]+)\\"', html)
    model = normalize_model(model_match.group(1)) if model_match else "unknown"
    result = subprocess.run([str(extractor), "--json", url], check=True, capture_output=True, text=True)
    # Markdown headings can also be message text; consume the extractor's turns
    # before presentation formatting instead of reinterpreting their contents.
    turns = [turn for turn in json.loads(result.stdout) if turn["role"] in ("user", "assistant")]
    if not turns:
        raise SystemExit("ChatGPT share page contained no readable user/assistant messages")
    session_id = re.search(r"/share/([^/?#]+)", url).group(1)
    now = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
    return [{"type": "session_meta", "payload": {"session_id": session_id, "cwd": os.getcwd(), "model": model}}] + [
        {"type": "share_message", "role": turn["role"], "text": turn["text"], "timestamp": now}
        for turn in turns]


def content_text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, dict):
        return content.get("text") or content.get("input_text") or content.get("output_text") or ""
    if isinstance(content, list):
        return "\n".join(filter(None, (content_text(part) for part in content)))
    return ""


def normalize_model(model):
    return model[:-3] if model.endswith("-wm") else model


def normalize_cwd(cwd):
    if cwd == "/Users/jyn/src" or cwd.startswith("/Users/jyn/src/"):
        return "/src" + cwd[len("/Users/jyn/src"):]
    return cwd.replace("/Users/jyn", "/home/codex", 1)


def synthetic_user_message(text):
    return text.startswith("# AGENTS.md instructions for ") or text.startswith("<environment_context>")


def messages(events):
    event_messages = []
    response_messages = []
    for event in events:
        payload = event.get("payload", {})
        if event.get("type") == "transcript_message":
            event_messages.append((event["role"], event["text"], event.get("timestamp"), event))
        elif event.get("type") == "share_message":
            event_messages.append((event["role"], event["text"], event.get("timestamp"), event))
        elif event.get("type") == "event_msg":
            kind = payload.get("type")
            if kind == "user_message":
                role, text = "user", payload.get("message", "")
            elif kind == "agent_message":
                if payload.get("phase") not in (None, "final_answer"):
                    continue
                role, text = "assistant", payload.get("message", "")
            else:
                continue
            if text and text.strip():
                event_messages.append((role, text, event.get("timestamp"), event))
        elif event.get("type") == "response_item":
            if payload.get("type") != "message" or payload.get("role") not in ("user", "assistant"):
                continue
            role, text = payload["role"], content_text(payload.get("content"))
            if text.strip() and not (role == "user" and synthetic_user_message(text)):
                response_messages.append((role, text, event.get("timestamp"), event))
    # Modern Codex can retain only a partial event_msg mirror (for example an
    # imported summary). Prefer message records so that mirror cannot hide turns.
    return response_messages or event_messages


def timestamp_ms(value):
    if not value:
        return int(datetime.now(timezone.utc).timestamp() * 1000)
    parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    return int(parsed.timestamp() * 1000)


def session_metadata(segments, normalize):
    events = segments[-1]
    meta = next((event for event in events if event.get("type") == "session_meta"), {})
    payload = dict(meta.get("payload", {}))
    if normalize and isinstance(payload.get("cwd"), str):
        payload["cwd"] = normalize_cwd(payload["cwd"])
    return payload


def branch_messages(branches, normalize):
    """Join original records by physical rollout and ordinal, never by message text."""
    nodes = {}
    turns = []
    tips = {}
    selected_tip = None
    selected_count = 0
    for branch in branches:
        parent = None
        for source_range in branch["ranges"]:
            payload = session_metadata([source_range["events"]], normalize)
            for role, text, timestamp, event in messages(source_range["events"]):
                ordinal = event.get("ordinal")
                if not isinstance(ordinal, int):
                    raise SystemExit("cannot join Codex branch: message has no source ordinal")
                identity = (source_range["rollout_id"], ordinal)
                entry_id = str(uuid.uuid5(uuid.NAMESPACE_URL, f"codex:{identity[0]}:{identity[1]}"))
                if identity in nodes:
                    if nodes[identity] != parent:
                        raise SystemExit("cannot join Codex branch: source record has conflicting parents")
                else:
                    nodes[identity] = parent
                    turns.append((entry_id, parent, role, text, timestamp, payload))
                parent = entry_id
        label = f"Codex {branch['thread_id']} / {branch['rollout_id']}"
        tips.setdefault(parent, []).append(label)
        if branch["selected"]:
            selected_tip = parent
            selected_count += 1
    if selected_count != 1:
        raise SystemExit("cannot join Codex branches: expected one selected rollout")
    return turns, tips, selected_tip


def linear_messages(segments, payload):
    parent = None
    for index, (role, text, timestamp, _) in enumerate(
            (turn for events in segments for turn in messages(events)), 1):
        entry_id = f"{index:08x}"
        yield entry_id, parent, role, text, timestamp, payload
        parent = entry_id


def convert(segments, destination: Path, normalize=False, branches=None):
    payload = session_metadata(segments, normalize)
    session_id = payload.get("session_id") or str(uuid.uuid4())
    now = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
    header = {"type": "session", "version": 3, "id": session_id,
              "timestamp": now, "cwd": payload.get("cwd") or os.getcwd()}
    output = [header]
    if branches is None:
        turns = linear_messages(segments, payload)
    else:
        turns, tips, selected_tip = branch_messages(branches, normalize)
    count = 0
    for entry_id, parent, role, text, timestamp, source_payload in turns:
        content = [{"type": "text", "text": text}] if role == "assistant" else text
        message = {"role": role, "content": content, "timestamp": timestamp_ms(timestamp)}
        if role == "assistant":
            message.update({
                "api": "openai-responses", "provider": "openai-codex", "model": source_payload.get("model", "unknown"),
                "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0,
                          "totalTokens": 0, "cost": {"input": 0, "output": 0,
                          "cacheRead": 0, "cacheWrite": 0, "total": 0}},
                "stopReason": "stop"})
        output.append({"type": "message", "id": entry_id, "parentId": parent,
                       "timestamp": timestamp or now, "message": message})
        count += 1
    if branches is not None:
        labels_by_tip = {}
        for tip, labels in tips.items():
            target_id = tip
            if target_id is None:
                target_id = str(uuid.uuid4())
                output.append({"type": "custom", "id": target_id, "parentId": None,
                               "timestamp": now, "customType": "codex-import-empty", "data": {}})
            label_id = str(uuid.uuid4())
            labels_by_tip[tip] = label_id
            output.append({"type": "label", "id": label_id, "parentId": target_id,
                           "timestamp": now, "targetId": target_id, "label": "; ".join(labels)})
        # Pi reopens at the last entry. This context-free marker selects even an
        # empty branch or a branch whose last message is shared with a longer one.
        output.append({"type": "custom", "id": str(uuid.uuid4()),
                       "parentId": labels_by_tip.get(selected_tip, selected_tip),
                       "timestamp": now, "customType": "codex-import", "data": {"branches": len(branches)}})
    destination.parent.mkdir(parents=True, exist_ok=True)
    with destination.open("w") as target:
        for entry in output:
            target.write(json.dumps(entry, separators=(",", ":")) + "\n")
    return count


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("session", help="Codex session ID, JSONL path, or ChatGPT share URL")
    parser.add_argument("-o", "--output", type=Path, help="Pi JSONL output path (default: Pi's session directory)")
    parser.add_argument("--archived", action="store_true", help="Search archived_sessions")
    parser.add_argument("--branches", action="store_true",
                        help="Import related forks and reverted rollouts into one Pi tree (use /tree)")
    parser.add_argument("--normalize", action="store_true",
                        help="Rewrite /Users/jyn paths to /home/codex for sandbox sessions")
    args = parser.parse_args()
    codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
    is_share = args.session.startswith(("https://chatgpt.com/share/", "https://chat.openai.com/share/"))
    if is_share:
        if args.branches:
            parser.error("--branches requires local paginated Codex history")
        segments = [read_share(args.session)]
        history = {}
    else:
        history = read_history(args.session, codex_home, args.archived, args.branches)
        segments = history["segments"]
    payload = session_metadata(segments, args.normalize)
    if args.output:
        destination = args.output
    else:
        cwd = Path(payload.get("cwd") or os.getcwd()).resolve()
        safe_cwd = "--" + str(cwd).lstrip("/\\").replace("/", "-").replace("\\", "-").replace(":", "-") + "--"
        agent_dir = Path(os.environ.get("PI_CODING_AGENT_DIR", Path.home() / ".pi" / "agent"))
        stamp = datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")
        filename = f"{stamp.replace(':', '-')}_{payload.get('session_id', uuid.uuid4())}.jsonl"
        destination = agent_dir / "sessions" / safe_cwd / filename
    count = convert(segments, destination, args.normalize, history.get("branches"))
    print(f"wrote {count} messages to {destination}")


if __name__ == "__main__":
    main()
