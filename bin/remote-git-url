#!/usr/bin/env python3
"""Stable launcher for source links into GitHub and GitLab repositories."""

from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "tools" / "remote-git-url"))

from remote_git_url.main import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
