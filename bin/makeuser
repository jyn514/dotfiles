#!/bin/sh

# N.B. this script must be run as root
if [ $# -ne 2 ]; then
	echo "usage: $0 <user> <ssh-public-key>" >&2
	exit 2
fi

set -euv

printf 'create user %s with ssh public key %s? y/[n] ' "$1" "$2"
read -r REPLY

if [ "$REPLY" != y ]; then
	echo "error: aborting"
	exit 1
fi

user=$1
adduser "$user"
cd "/home/$user"
mkdir .ssh
printf '%s\n' "$2" > .ssh/authorized_keys
chown -R "$user:$user" .ssh
