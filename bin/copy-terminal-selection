#!/usr/bin/env python3
"""Remove prompt-only right margins before copying terminal selections."""

from __future__ import annotations

import re
import subprocess
import sys


MARKER = "⏱ ".encode()
PROMPT_SUFFIX = re.compile(rb"[ \t]*" + MARKER + rb"[^\r\n]*(?=\r?$)", re.MULTILINE)


def clean(selection: bytes) -> bytes:
    return PROMPT_SUFFIX.sub(b"", selection)


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: copy-terminal-selection <tmux-client>", file=sys.stderr)
        return 2
    selection = clean(sys.stdin.buffer.read())
    try:
        return subprocess.run(
            ["tmux", "load-buffer", "-w", "-t", sys.argv[1], "-"],
            input=selection,
            check=False,
        ).returncode
    except OSError as error:
        print(f"copy-terminal-selection: {error}", file=sys.stderr)
        return 127


if __name__ == "__main__":
    raise SystemExit(main())
