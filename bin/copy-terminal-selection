#!/usr/bin/env python3
"""Remove prompt-only right margins before copying terminal selections."""

from __future__ import annotations

import re
import subprocess
import sys


MARKER = "⏱ ".encode()
TIME = rb"(?:[0-9]{2}:[0-9]{2}|\+[0-9]+(?:\.[0-9]+)?s)"
PROMPT_SUFFIX = re.compile(rb"[ \t]*" + MARKER + TIME + rb"(?=\r?$)", re.MULTILINE)


def clean(selection: bytes) -> bytes:
    return PROMPT_SUFFIX.sub(b"", selection)


def main() -> int:
    selection = clean(sys.stdin.buffer.read())
    try:
        return subprocess.run(["copy"], input=selection, check=False).returncode
    except OSError as error:
        print(f"copy-terminal-selection: {error}", file=sys.stderr)
        return 127


if __name__ == "__main__":
    raise SystemExit(main())
