#!/bin/sh
# Wrapper: launch Codex with this dir on PATH so its shells and tooling resolve
# the jj/paste shims (bare `jj` hits the author shim, which detects Codex via
# CODEX_THREAD_ID). Codex has no system-prompt override — its instruction layer
# is ~/.codex/AGENTS.md + project AGENTS.md — so this only fixes up PATH.
DOTFILES=$(realpath "$(dirname -- "$(realpath -- "$0")")/..")
export PATH="$DOTFILES/lib/agent-wrappers:$PATH"
exec codex-sandbox "$@"
