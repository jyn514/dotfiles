#!/bin/sh
set -eu

# Codex does not expand @ includes. Expand them recursively and inject the
# combined document as developer instructions without generating AGENTS.md.
DOTFILES=$(realpath "$(dirname -- "$(realpath "$0")")/..")
. "$DOTFILES/lib/shell/lib.sh"
shim_resolve "$0" codex
export PATH="$DOTFILES/libexec/agent-wrappers:$PATH"
CODEX_HOME=${CODEX_HOME:-"$HOME/.codex"}
move_generated_config() {
	"$DOTFILES/tools/codex-config/move-generated-config" \
		"$CODEX_HOME/dotfiles.config.toml" "$CODEX_HOME/config.toml" || \
		fail "codex wrapper: cannot move generated config"
}
if [ -z "${DOTFILES_SANDBOX:-}" ]; then
	move_generated_config
fi
RULES=$CODEX_HOME/rules/default.rules
if [ -z "${DOTFILES_SANDBOX:-}" ]; then
	"$DOTFILES/libexec/generate-agent-permissions" codex "$RULES" || \
		fail "codex wrapper: cannot generate rules"
fi
MANIFEST=${CODEX_DEVELOPER_INSTRUCTIONS_FILE:-"$CODEX_HOME/developer-instructions.md"}
COMBINED=$(tmp_file codex-developer-instructions.XXXXXX)
trap 'rm -f "$COMBINED"' 0 1 2 15
"$DOTFILES/libexec/expand-codex-instructions" "$MANIFEST" > "$COMBINED" ||
	fail "codex wrapper: cannot expand developer instructions"
DEVELOPER_INSTRUCTIONS=$(jq -Rs . < "$COMBINED")
rm -f "$COMBINED"
trap - 0 1 2 15
if "$REAL" --profile dotfiles -c "developer_instructions=$DEVELOPER_INSTRUCTIONS" "$@"; then
	status=0
else
	status=$?
fi
if [ -z "${DOTFILES_SANDBOX:-}" ]; then
	move_generated_config
fi
exit "$status"
