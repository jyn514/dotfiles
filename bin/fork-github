#!/usr/bin/env bash
set -eu

if (( $# < 1 || $# > 2 )); then
	echo "usage: $0 <repository> [directory]" >&2
	exit 2
fi

if [[ "$1" =~ ^(https://github\.com/[^/]+/[^/?#]+) ]]; then
	URL=${BASH_REMATCH[1]%.git}.git
else
	case $1 in
		(https://* | ssh://* | git@*) URL=$1  ;;
		(*) URL=https://github.com/$1.git  ;;
	esac
fi

repository=${URL%/}
repository=${repository%.git}
repository=${repository##*/}
DIR=${2:-$repository}
case $URL in
	https://*) host_and_path=${URL#https://}; HOST=${host_and_path%%/*};;
	ssh://*) host_and_path=${URL#ssh://}; host_and_path=${host_and_path#*@}; HOST=${host_and_path%%/*};;
	git@*) host_and_path=${URL#git@}; HOST=${host_and_path%%:*};;
esac
HOST=${HOST%%:*}

git clone --filter=blob:none "$URL" "$DIR"

builtin cd "$DIR"
git remote rename origin upstream
git remote add origin "git@$HOST:jyn514/$repository.git"
printf '%s\n' "$DIR"
