#!/bin/sh
# bandit - will automatically login to last available user in $file
# $file must be of format "$num - $pass"

set -eu

line=$(tail -n1 bandit.txt) || exit
case $line in
	*' - '*)
		num=${line%% - *}
		password=${line#* - }
		;;
	*)
		echo 'bandit: expected "number - password" in bandit.txt' >&2
		exit 1
		;;
esac

sshpass -p "$password" ssh -p 2220 "bandit$num@bandit.labs.overthewire.org"
