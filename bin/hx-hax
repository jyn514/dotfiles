#!/usr/bin/env python3

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
from pathlib import Path
from urllib.parse import quote, urlsplit


EDITOR = os.environ.get("REAL_EDITOR") or "nvim"
DESKTOP = "Helix" if EDITOR == "hx" else EDITOR
LINE_RE = re.compile(r"(.*?)(?::([0-9]+))?(?::([0-9]+))?(:)?$")


def cmdexists(command: str) -> bool:
    return shutil.which(command) is not None


def run_stdout(argv: list[str]) -> str:
    return subprocess.run(
        argv,
        check=False,
        capture_output=True,
        text=True,
    ).stdout


def trim(value: str | None) -> str | None:
    if value is None:
        return None
    return value.strip()


def expand_tilde(path: str) -> str:
    if path == "~" or path.startswith("~/"):
        return os.environ.get("HOME", "") + path[1:]
    return path


def canonicalize(path: str) -> str:
    return str(Path(path).resolve(strict=False))


def split_line(value: str) -> list[str]:
    match = LINE_RE.match(value)
    if not match:
        return [value]

    parts = list(match.groups())
    file = parts[0]
    parsed = urlsplit(file)
    if parsed.scheme.lower() == "file" and parsed.path != file:
        file = quote(parsed.path, safe="/")

    file = expand_tilde(file)
    file = canonicalize(file)
    parts[0] = file
    return [part for part in parts if part is not None]


def join_line(parts: list[str]) -> list[str] | str:
    if len(parts) < 2:
        return parts[0]

    file = parts[0]
    line = parts[1]
    column = parts[2] if len(parts) > 2 else ""

    if EDITOR == "nvim":
        return [f"+normal!{line}G{column}|", file]

    if EDITOR == "kak":
        suffix = f":{column}" if len(parts) > 2 else ""
        return [file, f"+{line}{suffix}"]

    suffix = f":{column}" if len(parts) > 2 else ""
    return f"{file}:{line}{suffix}"


def flatten_editor_args(joined: list[str] | str) -> list[str]:
    if isinstance(joined, list):
        return joined
    return [joined]


def refresh_path_from_profile() -> None:
    path = run_stdout(["bash", "-c", ". ~/.profile; echo $PATH"])
    os.environ["PATH"] = path.rstrip("\n")


def remove_dir_from_path(directory: str) -> None:
    paths = os.environ.get("PATH", "").split(os.pathsep)
    os.environ["PATH"] = os.pathsep.join(path for path in paths if path != directory)


def hxhax(args: list[str]) -> None:
    current_window = trim(run_stdout(["tmux", "display-message", "-p", "#{window_id}"]))
    pane_raw = run_stdout(
        [
            "tmux",
            "list-panes",
            "-a",
            "-f",
            f"#{{&&:#{{==:#{{window_id}},{current_window}}},#{{==:#{{pane_current_command}},{EDITOR}}}}}",
            "-F",
            "#{pane_id}",
        ]
    )
    pane = None if pane_raw == "" else trim(pane_raw)

    if pane is None:
        subprocess.run(
            ["tmux", "split-window", "-h", "-P", "-F", '"#{pane_id}"', EDITOR, *args],
            check=False,
            text=True,
            capture_output=True,
        )
    else:
        target = ["-t"] if pane == "" else ["-t", pane]
        subprocess.run(["tmux", "send-keys", *target, "-X", "cancel"], check=False)
        subprocess.run(["tmux", "send-keys", *target, "Escape"], check=False)
        command = "drop" if EDITOR == "nvim" else "open"
        subprocess.run(
            ["tmux", "send-keys", *target, f": {command} {' '.join(args)}", "Enter"],
            check=False,
        )
        subprocess.run(["tmux", "select-pane", *target, "-Z"], check=False)

    activate_window_if_needed(pane)


def activate_window_if_needed(pane: str | None) -> None:
    if "DISPLAY" in os.environ and cmdexists("xdotool"):
        active = trim(run_stdout(["xdotool", "getactivewindow"])) or ""
        pid = trim(run_stdout(["xdotool", "getwindowpid", active])) or ""
        tree = run_stdout(["pstree", "-p", pid])
        if "tmux" not in tree:
            subprocess.run(
                [
                    "tmux",
                    "run-shell",
                    "-t",
                    "" if pane is None else pane,
                    "xdotool",
                    "windowactivate",
                    os.environ.get("WINDOWID", ""),
                ],
                check=False,
            )
    elif sys.platform == "darwin":
        script = """
tell application "iTerm2"
\tactivate  -- bring background window to foreground
\treopen    -- open window if not yet open
end tell"""
        subprocess.run(["osascript", "-e", script], check=False)


def os_open(args: list[str]) -> None:
    if cmdexists("xdg-open"):
        subprocess.run(["xdg-open", *args], check=False)
    else:
        remove_dir_from_path(str(Path(__file__).parent))
        subprocess.run(["open", *args], check=False)


def duti_default(file: str) -> str:
    basename = os.path.basename(file)
    if "." in basename:
        ext = basename.rsplit(".", 1)[1]
    else:
        ext = file
    return run_stdout(["duti", "-x", ext]).split("\n")[0]


def xdg_default(file: str) -> str:
    mime = run_stdout(["xdg-mime", "query", "filetype", file]).rstrip("\n")
    if cmdexists("gio"):
        first = run_stdout(["gio", "mime", mime]).split("\n")[0]
        return re.sub(r"^Default .*: ", "", first)
    return run_stdout(["xdg-mime", "query", "default", mime])


def default_app(file: str) -> str:
    if cmdexists("duti"):
        return duti_default(file)
    return xdg_default(file)


def default_is_editor(default: str) -> bool:
    return (
        re.search(f"{DESKTOP}\\.desktop", default) is not None
        or re.search(DESKTOP, default) is not None
        or "TextEdit" in default
    )


def xdgopen(argv: list[str]) -> None:
    target = expand_tilde(argv[-1])

    if not re.search(r"^[a-zA-Z]+://", target) and re.search(r":[0-9]+$", target):
        split = split_line(target)
        file = split[0]
        if default_is_editor(default_app(file)):
            joined = join_line(split)
            hxhax(flatten_editor_args(joined))
        else:
            os_open([file])
        return

    os_open([expand_tilde(arg) for arg in argv])


def main(argv: list[str]) -> int:
    name = Path(sys.argv[0]).name
    refresh_path_from_profile()

    if name == "editor-hax":
        if not argv:
            return 1
        os.execvp(EDITOR, [EDITOR, *flatten_editor_args(join_line(split_line(argv[0])))])

    if name == "hx-hax":
        if argv:
            joined = join_line(split_line(argv[0]))
            hxhax(flatten_editor_args(joined))
        else:
            hxhax([""])
        return 0

    if not argv:
        return 1

    xdgopen(argv)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
