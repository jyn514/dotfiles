#!/bin/sh

# .SCRIPTDOC

# A simple script to perform various audio and multimedia control tasks.

# .SYNTAX

# usage: audio VERB [--quiet]
#
# VERB is one of up, down, mute, unmute, play, pause, toggle, next, or prev.
# --quiet suppresses desktop notifications.

# .LICENSE

# Copyright 2018, Charles A. Daniels
# This software is distributed under the BSD 3-clause license. The full text
# of this software's license may be retrieved from this URL:
# https://github.com/charlesdaniels/dotfiles/blob/master/LICENSE

# .ENDOC

set -e
set -u

usage () {
	printf 'usage: %s VERB [--quiet]\n' "$(basename "$0")" >&2
	printf 'VERB: up down mute unmute play pause toggle next prev\n' >&2
}

case "${1:-}" in
	up|down|mute|unmute|play|pause|toggle|next|prev) VERB=$1 ;;
	-h|--help)
		[ "$#" -eq 1 ] || { usage; exit 2; }
		usage
		exit 0
		;;
	*) usage; exit 2 ;;
esac

case "$#:${2:-}" in
	1:) QUIET=NO ;;
	2:--quiet) QUIET=YES ;;
	*) usage; exit 2 ;;
esac

send_notification () {
	if [ "$QUIET" != "YES" ] ; then
		notify-send --urgency=low --expire-time=750 "$@" || true
		printf 'send notification %s\n' "$*"
	fi

}

VOLUME_MANAGER="UNDEFINED"
if command -v amixer >/dev/null 2>&1; then
	VOLUME_MANAGER="amixer"
fi

case "$VERB" in
	play|pause|toggle|next|prev)
		if ! command -v cmus-remote >/dev/null 2>&1; then
			echo "ERROR: no known media player available" >&2
			exit 1
		fi
		;;
esac

case "$VERB" in
	up)
		case "$VOLUME_MANAGER" in
			amixer)
				amixer -q set Master 2+
				amixer -q set Master unmute
				send_notification "raised volume"
				;;
			*)
				echo "ERROR: no known volume manager available" >&2
				exit 1
				;;
		esac
		;;
	down)
		case "$VOLUME_MANAGER" in
			amixer)
				amixer -q set Master 2-
				send_notification "decreased volume"
				;;
			*)
				echo "ERROR: no known volume manager available" >&2
				exit 1
				;;
		esac
		;;
	mute)
		case "$VOLUME_MANAGER" in
			amixer)
				amixer -q set Master mute
				send_notification "muted volume"
				;;
			*)
				echo "ERROR: no known volume manager available" >&2
				exit 1
				;;
		esac
		;;
	unmute)
		case "$VOLUME_MANAGER" in
			amixer)
				amixer -q set Master unmute
				send_notification "unmuted volume"
				;;
			*)
				echo "ERROR: no known volume manager available" >&2
				exit 1
				;;
		esac
		;;
	play)
		cmus-remote --play
		send_notification "playing music"
		;;
	pause)
		cmus-remote --pause
		send_notification "pausing music"
		;;
	toggle)
		cmus-remote --pause
		send_notification "toggled play/pause"
		;;
	next)
		cmus-remote --next
		send_notification "skipping track"
		;;
	prev)
		cmus-remote --prev
		send_notification "previous track"
		;;
	*)
		# The complete command grammar was checked before backend discovery.
		exit 2
		;;
esac
