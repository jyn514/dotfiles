#!/bin/sh
set -eu

case ${1:-} in
	-h|--help)
		printf '%s\n' 'usage: codex-import' \
			'Repairs the session index through Codex thread/list while other sessions run.' \
			'Scans current and archived sessions across providers and sources.' \
			'Uses CODEX_HOME (default: ~/.codex). Requires codex and python3.'
		exit 0
		;;
esac
[ "$#" -eq 0 ] || { printf '%s\n' 'usage: codex-import' >&2; exit 2; }

codex_home=${CODEX_HOME:-"$HOME/.codex"}
[ -d "$codex_home" ] || {
	printf 'codex-import: no Codex home at %s\n' "$codex_home" >&2
	exit 1
}
command_path=$(realpath "$0")
root=$(dirname -- "$command_path")/..
export CODEX_HOME="$codex_home"
exec python3 "$root/libexec/codex-import.py"
