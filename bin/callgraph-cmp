#!/usr/bin/env python3
"""Compare the unique edges in two Graphviz DOT call graphs."""

from __future__ import annotations

import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import tempfile
from typing import Callable


EDGE_PROGRAM = Path(__file__).resolve().parents[1] / "libexec/callgraph-edges.gvpr"


def edge_bytes(path: Path) -> bytes:
    completed = subprocess.run(
        ["gvpr", "-f", str(EDGE_PROGRAM)],
        input=path.read_bytes(),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if completed.stderr:
        sys.stderr.write(completed.stderr.decode("utf-8", errors="replace"))
    completed.check_returncode()
    # gvpr can report a trailing DOT syntax error but still exit successfully.
    if completed.stderr:
        raise ValueError("Graphviz reported diagnostics")

    # libcgraph names are C strings, so NUL cannot occur inside an endpoint.
    names = completed.stdout.split(b"\0")
    if names.pop() != b"" or len(names) % 2:
        raise ValueError("malformed Graphviz edge stream")
    edges = sorted(set(zip(names[::2], names[1::2])))
    # JSON pairs keep arbitrary endpoint bytes and line breaks unambiguous.
    return b"\n".join(
        json.dumps(
            [name.decode("utf-8", errors="surrogateescape") for name in edge]
        ).encode("ascii")
        for edge in edges
    )


def exit_status(returncode: int) -> int:
    return returncode if returncode >= 0 else 128 - returncode


def run_diff(arguments: list[str]) -> int:
    if os.environ.get("V") == "1":
        print("+ " + shlex.join(arguments), file=sys.stderr)
    try:
        completed = subprocess.run(arguments, check=False)
    except OSError as error:
        print(
            f"callgraph-cmp: could not execute {arguments[0]!r}: {error}",
            file=sys.stderr,
        )
        return 127 if isinstance(error, FileNotFoundError) else 126
    return exit_status(completed.returncode)


def compare(
    left_graph: Path,
    right_graph: Path,
    runner: Callable[[list[str]], int] = run_diff,
) -> int:
    try:
        left_edges = edge_bytes(left_graph)
        right_edges = edge_bytes(right_graph)
    except subprocess.CalledProcessError as error:
        print(f"callgraph-cmp: Graphviz could not parse graph: {error}", file=sys.stderr)
        return exit_status(error.returncode)
    except (OSError, ValueError) as error:
        print(f"callgraph-cmp: could not read graph edges: {error}", file=sys.stderr)
        return 1

    try:
        with tempfile.TemporaryDirectory(prefix="callgraph-cmp-") as temporary:
            directory = Path(temporary)
            left = directory / "left.edges"
            right = directory / "right.edges"
            left.write_bytes(left_edges)
            right.write_bytes(right_edges)
            return runner(["diff", "--color=always", "--", str(left), str(right)])
    except OSError as error:
        print(f"callgraph-cmp: could not stage graph edges: {error}", file=sys.stderr)
        return 1


def main(arguments: list[str]) -> int:
    if len(arguments) != 2:
        print("usage: callgraph-cmp <dot1> <dot2>", file=sys.stderr)
        return 1
    return compare(Path(arguments[0]), Path(arguments[1]))


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
