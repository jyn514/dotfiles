#!/bin/sh

set -eu

# replicate the 'drag and drop' directory merge of Windows Explorer

if [ $# -eq 0 ]; then
	echo "Usage: $(basename "$0") <source> [target]"
	exit 1
fi

source="$(realpath "$1")"
if [ $# -gt 1 ]; then
	dest="$2"
else
	dest=.
fi

dest="$(realpath "$dest")"

# -v: verbose
# -n: don't copy files that already exist
# -r: recursive
# Do not use hard links: the source remains unless removal is confirmed later.
FLAGS=vnr

collision=false
for entry in "$source"/* "$source"/.[!.]* "$source"/..?*; do
	if [ ! -e "$entry" ] && [ ! -L "$entry" ]; then
		continue
	fi
	name=${entry##*/}
	if [ -e "$dest/$name" ] || [ -L "$dest/$name" ]; then
		collision=true
	fi
done

set +e
cp -$FLAGS "$source"/. "$dest"
copy_status=$?
set -e

if $collision; then
	echo "Source retained because destination entries were skipped."
	exit "$copy_status"
fi

[ "$copy_status" -eq 0 ] || exit "$copy_status"

printf "Remove old directory? y/[n] "
read -r REPLY
if [ "$REPLY" = y ]; then
	# Refuse prompt-time path drift, but keep lexical symlink removal semantics.
	# This check does not pin an inode or prevent changes after revalidation.
	if ! removal_source="$(realpath "$1" 2>/dev/null)" || [ ! -e "$1" ] || [ "$removal_source" != "$source" ]; then
		echo "Source retained because source path changed or no longer exists." >&2
		exit 1
	fi
	rm -r "$1"
fi
