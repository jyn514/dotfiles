#!/bin/sh

if ! [ $# -eq 1 ]; then
	echo "usage: $(basename "$0") [markdown]"
	exit 1
fi

script=$(realpath "$0") || exit
root=${script%/*}
root=${root%/*}
. "$root/lib/shell/lib.sh"
open_html() {
	if exists open; then open "$1"; return; fi
	for b in x-www-browser firefox google-chrome; do
		if exists $b; then $b "$1"; return; fi
	done
	# probably we're on windows 
	if exists cmd.exe; then
		cmd.exe /c "start $1"
		return
	fi
	# out of ideas
	return 1
}

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/view-markdown.XXXXXX") || exit
trap 'rm -rf "$tmp_dir"' 0
trap 'exit 1' 1 2 15
out=$tmp_dir/page.html

marked --gfm --input "$1" > "$tmp_dir/body.html" || exit
node "$root/libexec/markdown/page.mjs" "$1" "$tmp_dir/body.html" > "$out" || exit
open_html "$out" && sleep 1
