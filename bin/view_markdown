#!/bin/sh

if ! [ $# -eq 1 ]; then
	echo "usage: $(basename "$0") [markdown]"
	exit 1
fi

script=$(realpath "$0") || exit
root=${script%/*}
root=${root%/*}
. "$root/lib/shell/lib.sh"
open_html() {
	if exists open; then open "$1"; return; fi
	for b in x-www-browser firefox google-chrome; do
		if exists $b; then $b "$1"; return; fi
	done
	# probably we're on windows 
	if exists cmd.exe; then
		cmd.exe /c "start $1"
		return
	fi
	# out of ideas
	return 1
}

# Keep the selected source path (including symlinks), but make option-like paths safe.
case $1 in
	/*) source=$1 ;;
	*) source=./$1 ;;
esac
name=${source##*/}
stem=${name%.*}
[ -n "$stem" ] || stem=$name
out=${source%/*}/$stem.preview.html
marker='<!-- Generated by dotfiles view_markdown; safe to replace. -->'

check_output() {
	# Only previews with our final-line marker are eligible for replacement.
	if [ -L "$out" ] || { [ -e "$out" ] &&
		{ [ ! -f "$out" ] || [ "$(tail -n 1 "$out")" != "$marker" ]; }; }; then
		printf 'Refusing to overwrite non-preview: %s\n' "$out" >&2
		return 1
	fi
}
check_output || exit 1

# Generate beside the destination so publication is one rename, never partial output.
tmp_dir=$(mktemp -d "$out.tmp.XXXXXX") || exit
trap 'rm -rf "$tmp_dir"' 0
trap 'exit 1' 1 2 15

marked --gfm --input "$source" > "$tmp_dir/body.html" || exit
node "$root/libexec/markdown/page.mjs" "$source" "$tmp_dir/body.html" > "$tmp_dir/output" || exit
printf '\n%s\n' "$marker" >> "$tmp_dir/output" || exit
check_output || exit 1
mv -f "$tmp_dir/output" "$out" || exit
open_html "$out"
