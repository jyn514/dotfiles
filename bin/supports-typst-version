#!/usr/bin/env python3
"""Print the newest Typst Universe package compatible with a compiler."""

import argparse
import json
import urllib.error
import urllib.request


INDEX_URL = "https://packages.typst.org/preview/index.json"


def version(value: str) -> tuple[int, ...]:
    """Parse the numeric versions used by Typst package manifests."""
    try:
        return tuple(int(part) for part in value.split("."))
    except ValueError as error:
        raise ValueError(f"invalid numeric version: {value!r}") from error


def get(url: str) -> bytes:
    request = urllib.request.Request(
        url,
        headers={
            "Accept": "application/json",
            "User-Agent": "supports-typst-version",
        },
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        return response.read()


def latest_compatible(package: str, compiler: str) -> str:
    target = version(compiler)
    entries = json.loads(get(INDEX_URL))
    compatible: list[tuple[int, ...]] = []

    for entry in entries:
        if entry["name"] != package:
            continue

        package_version = version(entry["version"])
        minimum = version(entry.get("compiler", "0"))

        if minimum <= target:
            compatible.append(package_version)

    if not compatible:
        raise LookupError(
            f"no version of {package!r} supports Typst {compiler}"
        )

    return ".".join(map(str, max(compatible)))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("package", help="Typst Universe package name")
    parser.add_argument("compiler", help="Typst compiler version, e.g. 0.13.1")
    args = parser.parse_args()

    try:
        print(latest_compatible(args.package, args.compiler))
    except (urllib.error.URLError, ValueError, LookupError, KeyError) as error:
        parser.exit(1, f"error: {error}\n")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
