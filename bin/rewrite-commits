#!/usr/bin/env bb

(ns rewrite-commits
  (:require
   [babashka.fs :as fs]
   [clojure.string :as str]))

(load-file (str (fs/path (fs/parent (fs/parent (fs/real-path *file*)))
                         "libexec" "rewrite-history.clj")))
(require '[dotfiles.rewrite-history :as history])

(defn usage []
  (println "Usage: rewrite-commits [--apply]")
  (println)
  (println "Find commits on HEAD whose author is jyn <github@jyn.dev> and whose")
  (println "committer uses breq@jyn.dev. Rewrite them so the agent committer becomes")
  (println "the author and jyn becomes the committer. Other metadata is preserved.")
  (println)
  (println "Without --apply, only prints matching commits."))

(defn candidates []
  (->> (history/commit-records [[:commit "%H"] [:author-name "%an"] [:author-email "%ae"]
                               [:committer-name "%cn"] [:committer-email "%ce"] [:subject "%s"]]
                              ["HEAD"] false)
       (filter (fn [{:keys [author-name author-email committer-email]}]
                 (and (= author-name "jyn")
                      (= author-email "github@jyn.dev")
                      (= committer-email "breq@jyn.dev"))))))

(defn print-candidate [{:keys [commit author-name author-email committer-name committer-email subject]}]
  (println (format "%s  %s <%s> / %s <%s>  %s"
                   (subs commit 0 12)
                   author-name author-email
                   committer-name committer-email
                   subject)))

(defn callback-path []
  (let [script (fs/canonicalize *file*)]
    (str (fs/canonicalize (fs/path (fs/parent script) ".." "libexec"
                                   "rewrite-commits-callback.py")))))

(defn apply-rewrite! []
  (history/require-clean-worktree!)
  (history/sh "jj" "git" "export")
  (let [matches (vec (candidates))]
    (history/preview! matches print-candidate "Nothing to rewrite.")
    (when-not (seq matches)
      (System/exit 0)))
  (history/filter-repo!
   [(str (fs/canonicalize (fs/path (fs/parent (fs/parent (fs/canonicalize *file*)))
                                  "vendor" "git-filter-repo" "git-filter-repo")))]
   {} ["--force"] ["HEAD"]
   (str "exec(open(" (pr-str (callback-path)) ").read())"))
  (history/sh "jj" "git" "import"))

(defn -main [& args]
  (let [apply? (cond
                 (empty? args) false
                 (= args '("--apply")) true
                 (or (= args '("--help")) (= args '("-h"))) :help
                 :else (throw (ex-info (str "Unknown arguments: " (str/join " " args)) {})))]
    (cond
      (= apply? :help) (usage)
      apply? (apply-rewrite!)
      :else (history/preview! (vec (candidates)) print-candidate "No matching commits found."))))

(history/run-main! -main *command-line-args*)
