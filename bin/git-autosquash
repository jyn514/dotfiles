#!/bin/sh

set -eu

cmd=revise
if [ "${1:-}" = --rebase ]; then
	cmd=rebase
	shift
fi

if [ -z "${1:-}" ]; then
	if ! branch=$(git symbolic-ref --short --quiet HEAD); then
		branch=$(git for-each-ref refs/heads/ --format '%(refname:short)' --sort=-committerdate --count=1) || exit
	fi
	remote=$(git config --get branch."${branch}".remote || echo origin)
	base=$(git merge-base HEAD "$remote"/HEAD)
else
	base=$1
	shift
fi

exec git $cmd "$base" -i "$@"
