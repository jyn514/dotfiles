#!/usr/bin/env python3
"""Interactively revise or rebase commits from a branch's upstream base."""

from __future__ import annotations

from dataclasses import dataclass
import os
import shlex
import subprocess
import sys
from typing import Callable


@dataclass(frozen=True)
class Result:
    status: int
    stdout: bytes = b""


def exit_status(returncode: int) -> int:
    return returncode if returncode >= 0 else 128 - returncode


def run(arguments: list[str], *, capture_output: bool = False) -> Result:
    if os.environ.get("V") == "1":
        print("+ " + shlex.join(arguments), file=sys.stderr)
    try:
        completed = subprocess.run(
            arguments,
            stdout=subprocess.PIPE if capture_output else None,
            check=False,
        )
    except OSError as error:
        print(
            f"git-autosquash: could not execute {arguments[0]!r}: {error}",
            file=sys.stderr,
        )
        return Result(127 if isinstance(error, FileNotFoundError) else 126)
    return Result(exit_status(completed.returncode), completed.stdout or b"")


def captured_value(result: Result) -> str:
    return os.fsdecode(result.stdout.rstrip(b"\n"))


def automatic_base(runner: Callable[..., Result]) -> tuple[int, str | None]:
    branch_result = runner(
        ["git", "symbolic-ref", "--short", "--quiet", "HEAD"],
        capture_output=True,
    )
    if branch_result.status:
        branch_result = runner(
            [
                "git",
                "for-each-ref",
                "refs/heads/",
                "--format",
                "%(refname:short)",
                "--sort=-committerdate",
                "--count=1",
            ],
            capture_output=True,
        )
        if branch_result.status:
            return branch_result.status, None
    branch = captured_value(branch_result)

    remote_result = runner(
        ["git", "config", "--get", f"branch.{branch}.remote"],
        capture_output=True,
    )
    if remote_result.status == 1:
        remote = "origin"
    elif remote_result.status:
        return remote_result.status, None
    else:
        remote = captured_value(remote_result)

    base_result = runner(
        ["git", "merge-base", "HEAD", f"{remote}/HEAD"],
        capture_output=True,
    )
    if base_result.status:
        return base_result.status, None
    return 0, captured_value(base_result)


def autosquash(arguments: list[str], runner: Callable[..., Result] = run) -> int:
    remaining = list(arguments)
    command = "revise"
    if remaining and remaining[0] == "--rebase":
        command = "rebase"
        remaining.pop(0)

    if not remaining or remaining[0] == "":
        status, base = automatic_base(runner)
        if status:
            return status
        assert base is not None
    else:
        base = remaining.pop(0)

    result = runner(["git", command, base, "-i", *remaining])
    return result.status


def main(arguments: list[str]) -> int:
    return autosquash(arguments)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
