#!/bin/sh
set -eu

if [ "${1:-}" = --help ] && [ "$#" -eq 1 ]; then
	printf '%s\n' 'usage: mosh-agent HOST [COMMAND...]'
	exit 0
fi
if [ "$#" -eq 0 ]; then
	printf '%s\n' 'usage: mosh-agent HOST [COMMAND...]' >&2
	exit 2
fi
host=$1
case "$host" in
	''|-*) printf '%s\n' 'mosh-agent: HOST must be an SSH destination, not an option' >&2; exit 2 ;;
esac
for tool in autossh mosh ssh ssh-add; do
	command -v "$tool" >/dev/null 2>&1 || {
		printf 'mosh-agent: required command missing: %s\n' "$tool" >&2
		exit 1
	}
done
config=$(ssh -G "$host") || exit
agent=$(printf '%s\n' "$config" | awk '/^identityagent / {sub(/^identityagent /, ""); print; exit}')
case "$agent" in
	none) printf '%s\n' 'mosh-agent: IdentityAgent is disabled for this host' >&2; exit 1 ;;
	''|SSH_AUTH_SOCK) agent=${SSH_AUTH_SOCK:-} ;;
	\$*) agent=$(printenv "${agent#\$}") || agent= ;;
esac
if [ -z "$agent" ] || ! SSH_AUTH_SOCK="$agent" ssh-add -l >/dev/null 2>&1; then
	printf '%s\n' 'mosh-agent: configured IdentityAgent (or SSH_AUTH_SOCK) must point to an available agent with keys' >&2
	exit 1
fi

socket_relative=.ssh/mosh-agent.sock
# Expand HOME on the server, using its login shell rather than parsing account data.
remote_socket=$(ssh -T -o BatchMode=yes -o ConnectTimeout=10 "$host" \
	"printf '%s\\n' \"\$HOME/$socket_relative\"") || exit
case "$remote_socket" in
	/*) ;;
	*) printf '%s\n' 'mosh-agent: SSH did not return an absolute remote socket path' >&2; exit 1 ;;
esac
case "$remote_socket:$agent" in
	*:*:*) printf '%s\n' 'mosh-agent: socket paths cannot contain a colon' >&2; exit 1 ;;
esac
# -R expands ${...}, removes backslash quoting, then expands percent tokens.
# Quote already-resolved paths for those stages, not as new SSH expressions.
forward=$(printf '%s\n' "$remote_socket:$agent" |
	sed 's/\\/\\\\/g; s/\${/$\\{/g; s/%/%%/g') || exit

tunnel_pid=
mosh_pid=
# shellcheck disable=SC2317,SC2329 # Invoked by the EXIT trap.
cleanup() {
	result=$?
	trap - EXIT HUP INT TERM
	for child in "$mosh_pid" "$tunnel_pid"; do
		[ -n "$child" ] || continue
		kill "$child" 2>/dev/null || true
		wait "$child" 2>/dev/null || true
	done
	exit "$result"
}
trap 'cleanup' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# Noninteractive shells reset asynchronous stdin before applying redirections.
# Save it before either child starts, and close the extra descriptor in each.
exec 3<&0
# Own a separate SSH process; autossh terminates it when its supervisor stops.
AUTOSSH_GATETIME=0 autossh -M 0 -N -T \
	-o BatchMode=yes -o ControlMaster=no -o ControlPath=none \
	-o ExitOnForwardFailure=yes -o ConnectTimeout=10 \
	-o ServerAliveInterval=10 -o ServerAliveCountMax=3 \
	-R "$forward" "$host" </dev/null 3<&- &
tunnel_pid=$!
# Explicit stdin preserves the terminal; wait lets shell traps run immediately.
mosh --server="env SSH_AUTH_SOCK=\"\$HOME/$socket_relative\" mosh-server" "$@" <&3 3<&- &
mosh_pid=$!
exec 3<&-
result=0
wait "$mosh_pid" || result=$?
mosh_pid=
exit "$result"
