#!/bin/sh

. "${DOTFILES:-$(dirname "$0")/..}/lib/shell/lib.sh"

## pwd

PROMPT_DIRTRIM=2

display_pwd () {
	# reimplementation of PROMPT_DIRTRIM in pure shell
	# is this good
	# do you like this

	# 1. substitute $HOME with ~
	# 2. first group: match first character (~ or /)
	# 3. anything in the middle
	# 4. second group: last $PROMPT_DIRTRIM directories
	display_path=$PWD
	case $display_path in
		"$HOME") display_path='~';;
		"$HOME"/*) display_path="~/${display_path#"$HOME"/}";;
	esac
	printf '%s\n' "$display_path" | sed "s#^\(~\?/\).*\(\(/[^/]\+\)\{$PROMPT_DIRTRIM\}\)#\1...\2#"
	result=$?
	unset display_path
	return "$result"
}

prompt_hostname () {
	if [ -n "${container:-}" ]; then
		printf %s "$container"
		container_os=$(
			# The path is an argument so this helper can be tested without changing /etc.
			# shellcheck disable=SC1090
			. "${1:-/etc/os-release}" 2>/dev/null || exit
			printf %s "${ID:-}"
		)
		[ -n "$container_os" ] && printf ':%s' "$container_os"
		unset container_os
	else
		hostname | tr -d '\n'
	fi
}

# apparently on macOS `timeout` itself is slow???
# you've got to be kidding me.
if is_macos; then
  timeout() {
    perl -MTime::HiRes=alarm -e 'alarm shift; exec @ARGV' "$@"
  }
fi

## constants

# zsh uses `{%` instead of `\01`: https://zsh.sourceforge.io/Doc/Release/Prompt-Expansion.html#Visual-effects
if [ -n "$ZSH_VERSION" ]; then
	ansi_escape () { printf "%%{$1%%}"; }
else
	ansi_escape () { command printf "\01$1\02"; }
fi

# https://gist.github.com/fnky/458719343aabd01cfb17a3a4f7296797#colors--graphics-mode
# see `dotfiles/bin/ansi --color-table` for an example of how these render

RED="$(ansi_escape "\033[0;31m")"
GREEN="$(ansi_escape "\033[0;32m")"
#YELLOW="$(ansi_escape "\033[0;33m")"
#BLUE="$(ansi_escape "\033[0;34m")"
RESET="$(ansi_escape "\033[0;0m")"

#FAINT_RED="$(ansi_escape "\033[2;31m")"
FAINT_GREEN="$(ansi_escape "\033[2;32m")"
#FAINT_YELLOW="$(ansi_escape "\033[2;33m")"
#FAINT_BLUE="$(ansi_escape "\033[2;34m")"
FAINT_WHITE="$(ansi_escape "\033[2;37m")"

## git handling

is_jj_workspace() {
	candidate=$PWD
	while :; do
		[ -e "$candidate/.jj" ] && return 0
		parent=${candidate%/*}
		[ -n "$parent" ] || parent=/
		[ "$parent" != "$candidate" ] || return 1
		candidate=$parent
	done
}

git_info() {
	# Display probe only: never take optional locks (e.g. git status writing
	# index.lock), so rendering the prompt can't fight a real git command.
	# Scoped here, not exported globally: git_info only ever runs in the
	# `git_info | ...` pipe subshell, so this stays out of the interactive shell.
	export GIT_OPTIONAL_LOCKS=0
	# if this isn't a git repo, we can't show anything useful
	if ! git rev-parse --git-dir >/dev/null 2>&1; then
		if is_jj_workspace; then timeout .2 jj-info 2>/dev/null; fi
		return
	else
		printf ' '
	fi

	# if we have local modifications, show the status in red
	if git diff-index --name-only --quiet --ignore-submodules HEAD -- 2>/dev/null; then
		printf %s "$FAINT_GREEN"
	# weird edge case: this could be a repo with no commits at all
	elif ! git rev-parse --verify HEAD >/dev/null 2>&1; then
		printf %s "$FAINT_GREEN"
	else
		printf %s "$RED"
	fi

	# if HEAD is on a branch, point to that branch
	if git symbolic-ref --short HEAD 2>/dev/null; then
		return
	fi

	# next, see if this is a tag
	t=$(git tag --points-at HEAD)
	if [ "$t" ]; then
		echo "$t"
		return
	fi

	# if this is a jj repo, prefer jj's working-copy description over scanning
	# every git ref in large co-located repositories.
	if is_jj_workspace; then
		timeout .2 jj-info 2>/dev/null
		case $? in
      # 124 is SIGALRM, 142 is what `timeout` returns natively
			124|142) ;;
			*) return ;;
		esac
	fi

	# see if this is a remote branch
	# note this prioritizes origin/HEAD over origin/main
	r=$(git for-each-ref --points-at HEAD --format='%(refname:short)' refs/remotes | grep -v '/gh-readonly-queue/' | head -n1 | sed 's#^refs/remotes/##')
	if [ "$r" ]; then
		echo "$r"
		return
	fi

	# see if this is a detached local branch
	l=$(git for-each-ref --points-at HEAD --format='%(refname:short)' refs/heads | head -n1 | sed 's#^refs/heads/##')
	if [ "$l" ]; then
		echo "(detached at $l)"
		return
	fi

	# give up
	echo "(detached HEAD)"
}

prompt_command() {
	shell=$1
	last_status=$2

	# look don't worry about it
	export ZSH_VERSION

	printf %s "$FAINT_WHITE($(basename -- "$shell")"
	printf "@"; prompt_hostname /etc/os-release
	[ -n "$SSH_TTY" ] && printf '%s[ssh]' "${RED}"
	[ "$(id -u)" -eq 0 ] && printf %s "$RESET,${RED}root"
	printf %s "$FAINT_WHITE) "; display_pwd | tr -d '\n'
	git_info | tr -d '\n'
	echo
	# vscode already shows the cursor indented a bit, as well as the status from the last command
	if ! [ "$VSCODE_SHELL_INTEGRATION" = 1 ]; then
		if [ "$last_status" = 0 ]; then printf %s "$GREEN"; else printf %s "$RED"; fi
		printf '; '
	fi
	printf %s "$RESET"
}

if [ -n "${1:-}" ]; then
	prompt_command "$@"
fi
