what_belongs () {
	if command -v dpkg > /dev/null; then
		dpkg -L "$@"
	elif command -v rpm > /dev/null; then
		rpm -ql "$@"
	else
		echo "no supported package manager found" >&2
		return 1
	fi
}

what_runs () {
	files=$(what_belongs "$@") || return
	[ -n "$files" ] || return 0
	printf '%s\n' "$files" | while IFS= read -r file; do
		if [ -f "$file" ] && [ -x "$file" ]; then
			echo "$file"
		fi
	done
}

what_package () {
	prog=$(command which "$1") || return
	prog=$(realpath "$prog") || return
	shift
	if command -v dpkg > /dev/null; then
		dpkg -S "$prog" "$@"
	elif command -v rpm > /dev/null; then
		rpm -qf "$prog" "$@"
	else
		echo "no supported package manager found" >&2
		return 1
	fi
}

# Do not remove a crontab without warning, even where crontab lacks -i.
crontab() {
	for argument do
		if [ "$argument" = -r ]; then
			printf 'remove crontab? [y/N] '
			IFS= read -r reply || return
			[ "$reply" = y ] || return 0
			break
		fi
	done
	command crontab "$@"
}

# show a makefile as a dependency graph
visualize () (
	command -v makefile2graph > /dev/null || { echo "makefile2graph not found"; return 1; }
	command -v dot > /dev/null || { echo "dot not found"; return 1; }
	command -v xdot > /dev/null || { echo "xdot not found"; return 1; }
	graph=$(makefile2graph) || { result=$?; unset graph; return "$result"; }
	graph=$(printf '%s\n' "$graph" | dot) || { result=$?; unset graph; return "$result"; }
	printf '%s\n' "$graph" | xdot /dev/stdin
	return $?
)

# for use with a makefile in the current directory
tasks () (
	make_data=$(make -npRr) || { result=$?; unset make_data; return "$result"; }
	task_data=$(printf '%s\n' "$make_data" | awk -v RS= -F: '/^# File/,/^# Finished Make data base/ {if ($$1 !~ "^[#.]") {print $$1}}') || { result=$?; unset make_data task_data; return "$result"; }
	task_data=$(printf '%s\n' "$task_data" | awk '!/^[#\t]/') || { result=$?; unset make_data task_data; return "$result"; }
	printf '%s\n' "$task_data" | sed 's/:.*$//'
	return $?
)

# same as tasks, but show body of recipe
recipes () (
	make_data=$(make -npRr) || { result=$?; unset make_data; return "$result"; }
	recipe_data=$(printf '%s\n' "$make_data" | awk -v RS= -F: '/^# File/,/^# Finished Make data base/ {if ($$1 !~ "^[#.]") {print $$1}}') || { result=$?; unset make_data recipe_data; return "$result"; }
	printf '%s\n' "$recipe_data" | awk '!/^#/'
	return $?
)
recipies () { recipes "$@"; }

# launch and disown a command
background () {
	if [ $# -eq 0 ]
		then echo usage: background '<command>'
		return 1
	else
		"$@" &
		disown
	fi
}

