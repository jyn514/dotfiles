if [ "$DISPLAY" ]; then
	if is_wsl; then
		MANOPT=--html=$DOTFILES/bin/firefox.sh
		export MANOPT
	else
		# you know what unix if you can't come up with working hyperlinks in 50 years then fuck you too
		man() {
			local codename http_status man_index section url
			case "$1" in
				-*) command man "$@"; return;;
				*) if [ -r /etc/manpath.config ] &&
				      awk -v arg="$1" 'BEGIN { code=1 } /^SECTION/ {for (i=2; i<=NF; i++) if($i == arg) { code=0 }} END { exit code }' /etc/manpath.config
				   then
					    section=$1
							shift
					 fi
			esac
			if [ $# -ne 1 ]; then
				# oops something went wrong
				if [ "$section" ]; then
					command man "$section" "$@"
				else
					command man "$@"
				fi
				return
			fi

			url=https://man.openbsd.org/$1${section:+.$section}
			http_status=$(curl -I -m 1 -s -o /dev/null -w '%{http_code}' "$url") || http_status=
			if [ "$http_status" = 200 ]; then
				xdg-open "$url"
				return
			fi
			if ! [ "$section" ]; then
				man_index=$(command man -k "$1") || man_index=
				section=$(printf '%s\n' "$man_index" | awk -v arg="$1" '$1 == arg { gsub(/[()]/, "", $2); print $2; exit }')
			fi
			codename=$(lsb_release -cs) || codename=
			url=https://manpages.ubuntu.com/manpages/$codename/man$section/$1.$section.html
			http_status=$(curl -I -m 1 -s -o /dev/null -w '%{http_code}' "$url") || http_status=
			if [ "$codename" ] && [ "$http_status" = 200 ]; then
				xdg-open "$url"
				return
			fi
			if [ "$section" ]; then
				command man "$section" "$@"
			else
				command man "$@"
			fi
		}
	fi
fi

