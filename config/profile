show_conflicts() {
	conflict_diff=$(jj diff --from @-- --to @- --git) || return
	conflict_diff=$(printf '%s\n' "$conflict_diff" | grepdiff --output-matching=hunk '<<<<<<<') || return
	printf '%s\n' "$conflict_diff" | less
	result=$?
	unset conflict_diff
	return "$result"
}

