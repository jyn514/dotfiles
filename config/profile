add_path () {
	case $- in *f*) restore_glob=;; *) set -f; restore_glob=1;; esac
	for p in "$@"; do
		new_path=
		old_ifs=$IFS
		IFS=:
		for existing in ${PATH:-}; do
			if [ "$existing" != "$p" ]; then
				if [ -n "$new_path" ]; then
					new_path="$new_path:$existing"
				else
					new_path=$existing
				fi
			fi
		done
		IFS=$old_ifs
		if [ -n "$new_path" ]; then
			PATH="$p:$new_path"
		else
			PATH=$p
		fi
	done
	[ -z "$restore_glob" ] || set +f
	unset existing new_path old_ifs p restore_glob
}

remove_path () {
	case $- in *f*) restore_glob=;; *) set -f; restore_glob=1;; esac
	new_path=
	old_ifs=$IFS
	IFS=:
	for existing in ${PATH:-}; do
		if [ "$existing" != "$1" ]; then
			new_path=${new_path:+$new_path:}$existing
		fi
	done
	IFS=$old_ifs
	PATH=$new_path
	[ -z "$restore_glob" ] || set +f
	unset existing new_path old_ifs restore_glob
}

add_path_if_present() {
	if [ -d "$1" ]; then
		add_path "$1"
	fi
}

