# Project-independent clojure tools.deps commands
prefix_rule(pattern=["clojure", "-Sdeps"], decision="allow")
prefix_rule(pattern=["clojure", "-Spath"], decision="allow")
prefix_rule(pattern=["bb", "tasks"], decision="allow")

# Read-only jj commands
prefix_rule(pattern=["jj", "status"], decision="allow")
prefix_rule(pattern=["jj", "diff"], decision="allow")
prefix_rule(pattern=["jj", "log"], decision="allow")
prefix_rule(pattern=["jj", "show"], decision="allow")
prefix_rule(pattern=["jj", "interdiff"], decision="allow")
prefix_rule(pattern=["jj", "file", "list"], decision="allow")
prefix_rule(pattern=["jj", "file", "show"], decision="allow")
prefix_rule(pattern=["jj", "help"], decision="allow")
prefix_rule(pattern=["jj", "config", "list"], decision="allow")
prefix_rule(pattern=["jj", "config", "get"], decision="allow")
prefix_rule(pattern=["jj", "--version"], decision="allow")
prefix_rule(pattern=["jj", "bookmark", "list"], decision="allow")
prefix_rule(pattern=["jj", "bookmark", "advance", "--help"], decision="allow")
prefix_rule(pattern=["jj", "workspace", "list"], decision="allow")

# Read-only git commands
prefix_rule(pattern=["git", "ls-remote"], decision="allow")
prefix_rule(pattern=["git", "cherry"], decision="allow")
prefix_rule(pattern=["git", "push", "--dry-run"], decision="allow")
prefix_rule(pattern=["git", "cat-file"], decision="allow")
prefix_rule(pattern=["git", "diff", "--check"], decision="allow")

# Read-only utils
prefix_rule(pattern=["true"], decision="allow")
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["grep"], decision="allow")
prefix_rule(pattern=["jq"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["ps"], decision="allow")
prefix_rule(pattern=["echo"], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
prefix_rule(pattern=["diff"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")
prefix_rule(pattern=["nl"], decision="allow")
prefix_rule(pattern=["sleep"], decision="allow")
prefix_rule(pattern=["diff-check"], decision="allow")

# Misc non-destructive mutating commands
prefix_rule(pattern=["git", "bug"], decision="allow")
prefix_rule(pattern=["podman", "image"], decision="allow")
prefix_rule(pattern=["zola", "build"], decision="allow")
prefix_rule(pattern=["kaocha"], decision="allow")
prefix_rule(pattern=["yt-dlp", "--list-subs"], decision="allow")
prefix_rule(pattern=["woodpecker-cli", "exec"], decision="allow")
prefix_rule(pattern=["act", "pull_request"], decision="allow")
prefix_rule(pattern=["docker"], decision="allow")
prefix_rule(pattern=["tree-sitter"], decision="allow")
prefix_rule(pattern=["cargo"], decision="allow")
prefix_rule(pattern=["go"], decision="allow")
prefix_rule(pattern=["gofmt"], decision="allow")
prefix_rule(pattern=["tea", "issue"], decision="allow")
prefix_rule(pattern=["pgrep"], decision="allow")
prefix_rule(pattern=["jcmd"], decision="allow")
prefix_rule(pattern=["git", "clone"], decision="allow")
prefix_rule(pattern=["jj", "workspace", "add"], decision="allow")
prefix_rule(pattern=["jj", "commit"], decision="allow")
prefix_rule(pattern=["lpstat"], decision="allow")
prefix_rule(pattern=["lpinfo"], decision="allow")
prefix_rule(pattern=["skopeo", "inspect"], decision="allow")
prefix_rule(pattern=["skopeo", "list-tags"], decision="allow")

# Watchman read-only commands
prefix_rule(pattern=["watchman", "watch-list"], decision="allow")
prefix_rule(pattern=["watchman", "version"], decision="allow")
prefix_rule(pattern=["watchman", "get-config"], decision="allow")
prefix_rule(pattern=["watchman", "subscription-list"], decision="allow")
prefix_rule(pattern=["watchman", "since"], decision="allow")
prefix_rule(pattern=["watchman", "query"], decision="allow")
prefix_rule(pattern=["watchman", "debug-get-subscriptions"], decision="allow")
prefix_rule(pattern=["watchman", "find"], decision="allow")

# Tmux read-only commands
prefix_rule(pattern=["tmux", "show-option"], decision="allow")
prefix_rule(pattern=["tmux", "show-hooks"], decision="allow")
prefix_rule(pattern=["tmux", "list-keys"], decision="allow")
prefix_rule(pattern=["tmux", "source-file", "-n"], decision="allow")
prefix_rule(pattern=["tmux", "list-commands"], decision="allow")
prefix_rule(pattern=["tmux", "info"], decision="allow")
prefix_rule(pattern=["tmux", "display-message"], decision="allow")
prefix_rule(pattern=["tmux", "list-panes"], decision="allow")

# Unsorted
