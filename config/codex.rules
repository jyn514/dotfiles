def allow(pattern):
    prefix_rule(pattern=pattern, decision="allow")
def deny(pattern, reason):
    prefix_rule(pattern=pattern, decision="forbidden", justification=reason)

# Can't approve sed generally because the language is complicated and allows rewriting in place.
deny(["sed"], "`sed` is unavailable. Use head/tail for line selection, `perl -pe` for substitutions, or `rg` for searches.")

# Project-independent clojure tools.deps commands
allow(["clojure", "-Spath"])
allow(["bb", "tasks"])

# Read-only jj commands
allow(["jj", ["status", "diff", "log", "show", "interdiff", "root", "help", "--version"]])
allow(["jj", "file", ["list", "show"]])
allow(["jj", "config", ["list", "get"]])
allow(["jj", "bookmark", "list"])
allow(["jj", "bookmark", "advance", "--help"])
allow(["jj", "workspace", "list"])

# Read-only git commands
allow(["git", ["ls-remote", "cherry", "cat-file"]])
allow(["git", "push", "--dry-run"])
allow(["git", "diff", "--check"])

# Read-only utils
allow([[
        "true", "cat", "grep", "rg", "jq", "head", "tail", "ps", "echo", "wc",
        "diff", "ls", "sort", "nl", "sleep", "diff-check",
        "stat", "file", "df", "du", "lsof", "uname", "id"
]])
allow(["mise", "activate"])

# macOS read-only diagnostics
allow([["vm_stat", "iostat", "sw_vers"]])
allow(["sysctl", ["-a", "-n"]])
allow(["launchctl", "print"])
allow(["scutil", "--dns"])
allow(["log", "show"])
allow(["xcrun", "--find"])
allow(["xcode-select", "-p"])

# Misc non-destructive mutating commands
allow(["git", ["bug", "clone"]])
allow(["git", "submodule", "update"])

allow(["jj", ["commit", "split", "squash", "duplicate"]])
allow(["jj", "git", ["clone", "export", "fetch", "init"]])
allow(["jj", "workspace", "add"])
allow(["jj", "bookmark", "create"])
allow(["bb", "agent-split"])

docker_cmds = ["ps", "images", "inspect", "logs", "stats", "version", "info"]
allow([["podman", "docker"], docker_cmds])
allow([["podman", "docker"], "image", "list"])
allow([["podman", "docker"], "network", ["ls", "inspect"]])
allow([["podman", "docker"], "volume", ["ls", "inspect"]])
allow([["podman", "docker"], "system", "df"])
allow([["podman", "docker"], ["port", "top"]])
allow(["podman", "machine", ["list", "inspect"]])

allow([[
        "pgrep", "jcmd", "lpstat", "lpinfo",
]])
allow(["zola", "build"])
allow(["yt-dlp", "--list-subs"])
allow(["tea", "issue", ["list", "ls", "--help", "-h"]])
allow(["skopeo", ["inspect", "list-tags"]])

# Watchman read-only commands
allow(["watchman", [
        "watch-list", "version", "get-config", "subscription-list", "since",
        "query", "debug-get-subscriptions", "find",
]])

# Tmux read-only commands
allow(["tmux", [
        "show-option", "show-hooks", "list-keys", "list-commands", "info",
        "display-message", "list-panes",
]])
allow(["tmux", "source-file", "-n"])

# Unsorted
