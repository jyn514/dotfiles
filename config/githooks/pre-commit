#!/usr/bin/env bash
set -euo pipefail
if git diff --quiet --cached --no-ext-diff --diff-filter=d --; then
	exit 0
else
	status=$?
	[ "$status" -eq 1 ] || exit "$status"
fi

git_dir=$(git rev-parse --git-dir) || exit
GIT_DIR=$(realpath "$git_dir") || exit
unset git_dir
export GIT_DIR
hook_dir=$(realpath "$(dirname "$0")") || exit

# Run local hooks first, since those are more important.
local_hook=$(git rev-parse --git-common-dir)/hooks/$(basename "$0")
if [ -e "$local_hook" ]; then
    # TODO: adopt these hooks to work with the CWD instead?
    "$local_hook"
fi

# Now run global hooks.
tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/$(basename "$(realpath .)")-pre-commit.XXXX")
trap 'rm -r "$tmpdir"' EXIT
git diff --name-only -z --cached --no-ext-diff --diff-filter=d \
	| while IFS= read -r -d '' file; do
		git checkout-index --prefix="$tmpdir/" -- "$file"
	done
cd "$tmpdir"

find . -type l -print0 | xargs -0 python3 "$hook_dir/pre_commit_hooks/check_symlinks.py"
find . -type f -print0 | xargs -0 python3 "$hook_dir/pre_commit_hooks/destroyed_symlinks.py"
for c in case_conflict end_of_file executables_have_shebangs json merge_conflict shebang_scripts_are_executable toml vcs_permalinks; do
    find . -type f -print0 | xargs -0 python3 "$hook_dir/pre_commit_hooks/check_$c.py"
done
find . -type f -name '*.xml' -exec python3 "$hook_dir/pre_commit_hooks/check_xml.py" {} +
find . -type f \( -name '*.yaml' -o -name '*.yml' \) \
	-exec python3 "$hook_dir/pre_commit_hooks/check_yaml.py" {} +
