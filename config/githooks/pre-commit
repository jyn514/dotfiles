#!/usr/bin/env python3
"""Run the repository's Python pre-commit driver."""

from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "tools/git-hooks"))

from git_hooks.pre_commit import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:], hook_directory=Path(__file__).resolve().parent))
