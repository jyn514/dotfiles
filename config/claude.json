{
  "model": "opus",
  "effortLevel": "medium",

  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "prefersReducedMotion" : true,
  "verbose": false,
  "terminalProgressBarEnabled": false,
  "tui": "fullscreen",
  "theme": "auto",

  "worktree": {
    "baseRef": "head"
  },
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": false,

  "sandbox" : {
    "autoAllowBashIfSandboxed" : true,
    "enabled" : true,
    "filesystem": {
      "allowRead": [
        "~/.gitlibs"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Skill(claude-api)",

      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:jyn.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:claude.ai)",
      "WebFetch(domain:*.claude.com)",
      "WebFetch(domain:rustc-dev-guide.rust-lang.org)",
      "WebFetch(domain:*.openai.com)",
      "WebSearch",

      "Read(/tmp/claude/**)",
      "Edit(/tmp/claude/**)",
      "Read(/private/tmp/claude/**)",
      "Edit(/private/tmp/claude/**)",

      "Read(~/.claude/**)",
      "Read(~/.codex/**)",
      "Read(~/src/**)",

      "Bash(bb tasks *)",
      "Bash(clojure -Stree)",
      "Bash(clj-kondo *)",

      "Bash(jj diff *)",
      "Bash(jj status *)",
      "Bash(jj log *)",
      "Bash(jj show *)",
      "Bash(jj file show *)",

      "Bash(git check-ignore *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git status *)",

      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(xxd)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(command -v *)",
      "Bash(python3 -m json.tool)",

      "Bash(typst *)",
      "Bash(podman images *)"
    ],
    "defaultMode": "acceptEdits"
  },

  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'pane_id=\"${WEZTERM_PANE:-unknown}\"; if [[ \"$pane_id\" =~ ^[0-9]+$ ]]; then cat > \"$HOME/.claude/pane-sessions/${pane_id}.json\"; else echo \"resurrect: invalid WEZTERM_PANE: $pane_id\" >&2; cat > /dev/null; fi'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'pane_id=\"${WEZTERM_PANE:-unknown}\"; if [[ \"$pane_id\" =~ ^[0-9]+$ ]]; then cat > \"$HOME/.claude/pane-sessions/${pane_id}.json\"; else echo \"resurrect: invalid WEZTERM_PANE: $pane_id\" >&2; cat > /dev/null; fi'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf 'Stay Lifer. No I/me/my. Drop subject+verb when inferable. Short clauses. Name emotions flat. Act, do not explain.'"
          }
        ]
      }
    ]
  }
}
