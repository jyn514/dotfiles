// Trial config for Niri 26.04 and Noctalia 5; install both before starting.
// Copy to ~/.config/niri/config.kdl. Start `niri` inside Plasma to try nesting,
// or select Niri at login for gestures, portals, and the complete session.
// Nested mode uses Alt for Mod; standalone mode uses Super.
// Noctalia owns the bar, launcher, clipboard, notifications, and lock screen.
// Portals and login keyring unlock must be configured outside this file.
// Noctalia integration: https://docs.noctalia.dev/noctalia/compositor-settings/niri/

spawn-at-startup "noctalia"

input {
    keyboard {
        xkb {}
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 12
    center-focused-column "on-overflow"
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    focus-ring {
        width 2
        active-color "#89b4fa"
        inactive-color "#45475a"
    }
    border { off; }
}

overview { backdrop-color "#1e1e2e"; }

// Four-finger vertical swipe opens overview; three fingers navigate workspaces.
// Mod+left drag inserts a tile; in overview, plain left drag does the same.
// Mod+right drag resizes; right-click during a move toggles floating/tiling.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}
window-rule {
    match app-id="^dev.noctalia.Noctalia$"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}
debug {
    // Noctalia needs this for notification actions and window activation.
    honor-xdg-activation-with-invalid-serial
}

binds {
    // Upstream defaults: niri resources/default-config.kdl at ed22699.
    // Commented upstream conflicts preserve the active custom bindings.
    // KDE alternatives are jyn's translated mappings; replace conflicting
    // active bindings before uncommenting them. H/J/K/L focus, Mod+T terminal
    // and Mod+Q close already match. Clipboard is also in Noctalia's UI.
    // Krohnkite master, rotation, monocle and float-all have no direct equivalent.
    // Niri has no native minimize/restore pair matching Mod+- / Mod+Backspace.

    // Applications and desktop panels
    // The upstream launcher needs fuzzel.
    Mod+Space hotkey-overlay-title="Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+S hotkey-overlay-title="Wi-Fi, Bluetooth, audio and notifications" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Comma hotkey-overlay-title="Noctalia settings" { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+T hotkey-overlay-title="Kitty terminal" { spawn "kitty"; }
    Mod+D hotkey-overlay-title="Run an Application: fuzzel" { spawn "fuzzel"; }
    // Modifications
    Mod+Shift+C { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }

    // Session, power and accessibility
    // The screen-reader shortcut needs orca.
    Super+Alt+L hotkey-overlay-title="Lock screen" { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Shift+E { quit; }
    Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }
    // Modifications
    Mod+Ctrl+Q { spawn "noctalia" "msg" "session" "lock"; }

    // Audio and media
    // Mic mute needs wpctl; pause, stop and track controls need playerctl.
    XF86AudioPlay { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioRaiseVolume { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPause       allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    // Screen brightness
    XF86MonBrightnessUp { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown { spawn "noctalia" "msg" "brightness-down"; }

    // Overview and window switching
    Alt+Tab repeat=false { spawn "noctalia" "msg" "window-switcher" "hold"; }
    Mod+O repeat=false { toggle-overview; }
    // Note: discards old KDE Mod+W binding for toggle-overview

    // Window and column focus
    // Note: unlike upstream, this uses arrow keys for monitors and hjkl for sub-monitor, allowing us to get rid of the extra Shift modifier.
    // We then use the freed-up Shift to rebind Mod+Ctrl->Mod+Shift, which is easier to hit on my moonlander.
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }

    // Window closing and window/column movement
    // Shift moves with keyboard navigation; wheel bindings keep Ctrl because
    // Shift already selects horizontal scrolling.
    Mod+Q repeat=false { close-window; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Modifications
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last; }

    // Modifications
    Mod+Left { focus-monitor-left; }
    Mod+Down { focus-monitor-down; }
    Mod+Up { focus-monitor-up; }
    Mod+Right { focus-monitor-right; }
    Mod+Shift+Left { move-window-to-monitor-left; }
    Mod+Shift+Down { move-window-to-monitor-down; }
    Mod+Shift+Up { move-window-to-monitor-up; }
    Mod+Shift+Right { move-window-to-monitor-right; }

    // Workspace focus
    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }


    // Move windows and columns between workspaces
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    // Modifications
    Mod+Shift+Page_Up { move-window-to-workspace-up; }
    Mod+Shift+Page_Down { move-window-to-workspace-down; }
    Mod+Shift+U         { move-column-to-workspace-down; }
    Mod+Shift+I         { move-column-to-workspace-up; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Workspace ordering
    // Ctrl reorders workspaces; Shift moves windows or columns between them.
    // Mod+Shift+Page_Down { move-workspace-down; }
    // Mod+Shift+Page_Up   { move-workspace-up; }
    // Mod+Shift+U         { move-workspace-down; }
    // Mod+Shift+I         { move-workspace-up; }

    // Modifications
    Mod+Ctrl+Page_Down { move-workspace-down; }
    Mod+Ctrl+Page_Up   { move-workspace-up; }
    Mod+Ctrl+U         { move-workspace-down; }
    Mod+Ctrl+I         { move-workspace-up; }

    // Upstream conflicts:
    // Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    // Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    // Column grouping and tabs
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Period { expel-window-from-column; }
    Mod+W { toggle-column-tabbed-display; }

    // Upstream conflicts:
    // Mod+Comma  { consume-window-into-column; }

    // Window size and layout
    // Column width
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Ctrl+F { expand-column-to-available-width; }

    // Window height
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Maximizing and fullscreen
    Mod+F { maximize-column; }
    Mod+M { maximize-window-to-edges; }
    Mod+Shift+F { fullscreen-window; }

    // Centering
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    // Floating and tiling
    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // KDE alternatives:
    // Mod+F { toggle-window-floating; }
    // Mod+Up { maximize-window-to-edges; }
    // Mod+Ctrl+J { set-window-height "+10%"; }
    // Mod+Ctrl+K { set-window-height "-10%"; }
    // Mod+Alt+H { set-column-width "+10%"; }
    // Mod+Alt+L { set-column-width "-10%"; }

    // Screenshots
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    // Modifications:
    Ctrl+Mod+Shift+4 { screenshot; }

    // Shortcut help and inhibition
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}

include "noctalia.kdl"
// Include monitor configuration generated by nwg-displays
include "monitor.kdl"
