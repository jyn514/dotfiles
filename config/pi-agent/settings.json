{
  "lastChangelogVersion": "1.3.0",
  "transport": "sse",
  "retry": {
    "maxRetries": 20
  },
  "tuiMode": "fullscreen",
  "externalEditor": "open --pi-editor",
  "externalEditorUsesTerminal": false,
  "shellCommandPrefix": "export JJ_AGENT=pi",
  "defaultProjectTrust": "ask",
  "enableInstallTelemetry": false,
  "theme": "light/dark",
  "extensions": [
    "./pi-extensions/index.ts"
  ],
  "packages": [
    "./pi-link",
    "git:github.com/jyn514/pi-codex-goal@main",
    "git:github.com/jyn514/pi-session-search@main",
    {
      "source": "git:github.com/jyn514/pi-extensions@working",
      "extensions": [
        "packages/pi-codex-subagents/index.ts"
      ],
      "skills": []
    }
  ],
  "compaction": {
    "reserveTokens": 80000,
    "enabled": true
  },
  "showCacheMissNotices": true,
  "collapseChangelog": true,
  "quietStartup": true,
  "outputPadY": 0,
  "toolPreviewLines": 3,
  "editContextLines": 2,
  "doubleEscapeAction": "tree",
  "fullscreenExitOutput": "resume-hint",
  "defaultProvider": "openai",
  "defaultThinkingLevel": "medium",
  "defaultModel": "gpt-6.1-sol",
  "hideThinkingBlock": false
}