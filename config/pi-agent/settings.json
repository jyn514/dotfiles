{
  "lastChangelogVersion": "1.3.0",
  "transport": "sse",
  "steeringMode": "all",
  "retry": {
    "maxRetries": 20
  },
  "tuiMode": "fullscreen",
  "externalEditor": "open --pi-editor",
  "externalEditorUsesTerminal": false,
  "shellCommandPrefix": "export JJ_AGENT=pi",
  "defaultProjectTrust": "ask",
  "enableInstallTelemetry": false,
  "theme": "light/dark",
  "defaultTools": ["+codemode"],
  "extensions": [
    "./pi-extensions/index.ts",
    "./pi-extensions/session-tools.ts"
  ],
  "packages": [
    "./pi-link",
    "./packages/pi-codex-goal",
    {
      "source": "./packages/pi-session-search",
      "extensions": []
    },
    {
      "source": "./packages/pi-codex-subagents",
      "extensions": [
        "index.ts"
      ],
      "skills": []
    },
    {
      "source": "./pi-dashboard",
      "skills": []
    }
  ],
  "compaction": {
    "reserveTokens": 80000,
    "enabled": true
  },
  "showCacheMissNotices": true,
  "collapseChangelog": true,
  "quietStartup": true,
  "outputPadY": 0,
  "toolPreviewLines": 3,
  "editContextLines": 2,
  "doubleEscapeAction": "tree",
  "fullscreenExitOutput": "resume-hint",
  "defaultProvider": "openai",
  "defaultThinkingLevel": "medium",
  "defaultModel": "gpt-6.1-sol",
  "hideThinkingBlock": false
}
